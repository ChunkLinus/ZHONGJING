		"evo_barrage_rocketArray": "Roket Dizisi",
		"evo_barrage_rocketArray_desc": "Baraj artık mühimmat çubuğu başına {2} yerine {1} füze ateşleyecek.",
		"evo_barrage_rocketArray_2": "Roket Dizisi II",
		"evo_barrage_seismicMunition": "Sismik Mühimmat",
		"evo_barrage_seismicMunition_desc": "Füzeler patlamak yerine kendilerini yere gömer ve sonraki birkaç saniye boyunca patlayıcı darbeler üretir.",
		"evo_barrage_seismicMunition_2": "Sismik Mühimmat II",
