		"evo_heatray_iceBeam": "Buz Işını",
		"evo_heatray_iceBeam_desc": "Etkiler:\n Isı Hasarı: {1}\n Soğuk Hasarı: {2}\n Donma Şansı: {3}\n\nTemel hasarı etkiler. Isı Işını hasar türü Soğuktur ve Donma etkisi yaratma şansı artar.",
		"evo_heatray_iceBeam_2": "Buz Işını II",
		"evo_heatray_iceBeam_2_desc": "Etkiler:\n Soğuk Hasarı: {1}\n\nTemel hasarı etkiler.",
		"evo_heatray_reflection": "Yansıma",
		"evo_heatray_reflection_desc_2": "Isı Işını artık düşmanların içinden geçer ve ekran kenarından {1} defa yansır.",
		"evo_heatray_reflection_2": "Yansıma II",
		"evo_heatray_reflection_2_desc_2": "Isı Işını artık ekran kenarından {1} yansıyor.",
		"evo_heatray_doubleBladed": "Çift Bıçaklı",
		"evo_heatray_doubleBladed_desc": "Başka bir ışın ters yönde ateş eder. Tüm evrimler ve yükseltmeler her iki ışına da uygulanır.",
		"evo_heatray_blaster": "Patlatıcı",
		"evo_heatray_blaster_desc": "Etkiler:\n Atış Hızı: {1}\n\n Isı Işını sabit bir ışın yerine bağımsız, çok vuruşlu bir lazer mermisi ateşler ve bu hala bir D.O.T. silahı olarak sayılır.",
