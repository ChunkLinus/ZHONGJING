		"evo_barrage_total_saturation_desc": "Küresel Etki:\n Tüm Patlayıcı Etkiler/Silahlar:\n Hasar: {1}",
		"evo_splattershot_bubble": "Balçık Baloncuğu",
		"evo_splattershot_bubble_desc": "Balçık Baloncuğu Sıçrama Bölgeleri içinde ortaya çıkar.\n\nAktifleştirildiğinde, Balçık Baloncuğu patlar, küçük bir yarıçapta hasar verir ve ek Sıçrama Bölgeleri oluşturur.",
		"evo_splattershot_bubble_2": "Balçık Baloncuğu II",
		"evo_splattershot_bubble_2_desc": "Balçık Baloncuğu görülme sıklığı arttı.\n\nBalçık Baloncuğu süresi dolduğunda otomatik olarak patlama olasılığı %50.",
		"evo_splattershot_infestation": "İstila",
		"evo_splattershot_infestation_desc": "Sıçrama Atışı Etkileri:\n Durum Etkisi Şansı: {1}\n Global Etkiler:\n Durum Etkisi Hasarı: {2}",
