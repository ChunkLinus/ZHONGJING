		"boss_poet": "Şair",
		"boss_poet_desc": "Boss'un sunduğu pasajı yazın.\nBunu yaparken düşmanları hedeflemeye devam edebilirsiniz.",
		"boss_cypher": "Parola",
		"boss_cypher_desc": "Bu boss yakınındakilerin mektuplarını mahvediyor.\nSilahlarınızla onu yok edin.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "Bu boss sana yok edilebilir mermi atıyor.\nSilahlarınla ​​üç kafayı da yok et.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Bu boss etrafında sonsuza kadar dolanır.\nYolundaki sabit hedeflere saldırırken zamanlamanı iyi ayarlayıp ona vur.",
		"boss_gemini": "İkizler",
		"boss_gemini_desc": "İkizlere eşit şekilde hasar verin. \nZaman içinde birbirlerini iyileştirecekler.",
		"weapon_repeater_title": "Tekrarlayıcı",
		"weapon_heatray_title": "Isı Lazeri",
		"weapon_barrage_title": "Yayılım Ateşi",
		"weapon_overmind_title": "Overmind",
		"weapon_splattershot_title": "Sıçrayan Atış",
		"weapon_wildcard_title": "Joker",
		"weapon_spectre_title": "Hayalet",
		"weapon_tesla_title": "Tesla Madeni",
		"weapon_sentry_title": "Muhafız",
		"weapon_oscillator_title": "Osilatör",
		"weapon_meteor_title": "Meteor",
		"weapon_hunter_title": "Avcı",
		"weapon_chopper_title": "Kesici",
		"weapon_minefield_title": "Mayın tarlası",
		"weapon_blade_title": "Bıçak Tuzağı",
		"weapon_firestorm_title": "Ateş fırtınası",
		"weapon_guardian_title": "Gardiyan",
		"weapon_orbiter_title": "Yörüngede",
		"weapon_frostbite_title": "Donma",
		"weapon_bleeding_title": "Kanama",
		"weapon_blight_title": "Işık",
		"weapon_static_title": "Statik",
		"weapon_ignite_title": "Tutuştur",
		"weapon_heatray_requirements": "Herhangi bir Alamet seviyesinde Tekrarlayan Mücadeleleri tamamla.",
		"weapon_barrage_requirements": "Alamet Seviye 3'te herhangi bir ana silahla Mücadeleleri tamamla.",
		"weapon_repeater_desc": "Kısa aralıklarla çok sayıda mermi ateşleyen yıkıcı bir silah.",
		"weapon_heatray_desc": "Zamanla hasar veren, isabetli, yoğunlaştırılmış ışıktan oluşan sabit bir ışın ateşler.",
		"weapon_barrage_desc": "Bir hedefe ve çevresine patlayıcı roketlerden oluşan bir yaylım ateşi açar. Zamanla şarj olur.",
		"weapon_overmind_desc": "Düşmanlarınıza enerji hasarı vermek için çeşitli insansız hava araçlarını yönetin.",
		"weapon_splattershot_desc": "Rakiplerinizi sakatlamak ve onlara zarar vermek için yapışkan madde kürelerini ateşleyin.",
		"weapon_wildcard_desc": "Bir sonraki atışınız dört olası silah arasından rastgele seçilecektir, bu nedenle dikkatli ateş edin.",
		"weapon_spectre_desc": "Yukarıda eşleşenlerin sayısına eşdeğer hızlı yakın dövüş dronları üretir.",
		"weapon_sentry_desc": "Menzil içerisine giren tüm düşmanlara ateş eden otomatik bir taret konuşlandırın.",
		"weapon_tesla_desc": "Zamanla hasar veren bir elektrikli taret yerleştirir.",
		"weapon_oscillator_desc": "En son hedefinize doğru salınımlı bir parçacık akışını ateşleyin.",
		"weapon_meteor_desc": "Yörünge bombardımanını başlatmak için etkinleştirilebilecek rastgele konumlarda hedef işaretleyicileri periyodik olarak ortaya çıkarır.",
		"weapon_hunter_desc": "Yukarıdaki eşleşenlerin sayısına eşdeğer elektrik ışınıyla ateşleyen dronlar üretir.",
		"weapon_chopper_desc": "Ana silah ateşinde ekranın kenarına doğru ilerleyen ve yoluna çıkan tüm düşmanlara hasar veren devasa bir dönen bıçak ortaya çıkarır.",
		"weapon_minefield_desc": "Düşmanlarla temas ettiğinde patlayan, yavaş hareket eden mayınlar üretir.",
		"weapon_blade_desc": "dönen dört kollu bir bıçak tuzağı kullanır.",
		"weapon_firestorm_desc": "Kısa menzilli patlayıcı mermilerden oluşan bir baraj ateşleyen bir top. Ana kulenin etrafında döner ve tekrar ateş etmeden önce soğuması gerekir.",
		"weapon_guardian_desc": "Düşmanlara lazer ateşleyen bir Drone'u hemen görevlendir. Yakıt tüketecek ve boşaldığında devre dışı bırakacak olan Guardian'a yakıt ikmali yapmak için Yakıt toplayıcılarını etkinleştir.",
		"weapon_orbiter_desc": "Bir küre fırlatır, küre Ana Silahın yörüngesine girer ve yoluna çıkan her şeye hasar verir.",
		"weapon_frostbite_desc": "Yağma etkisi - silah sayılmaz.\n\nDüşmanlar, dondurulduklarında zamanla hasar alır.",
		"weapon_bleeding_desc": "Durum etkisi - silah sayılmaz.\n\nDüşmanlar, etkinin süresi dolana kadar zamanla Kinetik hasar alırlar.",
		"weapon_blight_desc": "Durum etkisi - silah sayılmaz.\n\nDüşmanlar zamanla Kimyasal hasar alır ve etki sona erene kadar yavaşlar.",
		"weapon_static_desc": "Durum etkisi - silah sayılmaz.\n\nDüşmanlar zamanla Enerji hasarı alır ve etki sona erene kadar yakındaki düşmanlara Enerji hasarı verir.",
		"weapon_ignite_desc": "Durum etkisi - silah sayılmaz.\n\nDüşmanlar, etkinin süresi dolana kadar zamanla Isı hasarı alır.",
		"weapon_caltrops_desc": "Geliştirme etkisi - silah sayılmaz.\n\nUzaktan kumandalı silahlarla kritik vuruşta, geçen düşmanlara hasar veren ve hasarlarına bağlı olarak kanama şansı artan 12 adet Caltrops ortaya çıkar.",
		"weapon_stormBattery_desc": "Geliştirme etkisi - silah sayılmaz.\\in\\Ana Taret yakındaki düşmanlara Elektrik hasarı verir. Takılan her Elektrik Silahı temel hasarı artırır.",
		"weapon_lightningSparks_desc": "Geliştirme etkisi - silah sayılmaz.\n\nElektrikli silahlarla kritik vuruş yapıldığında, hasarları Kritik Şans ve Kritik Çarpanı ile değişen 6 Şimşek Kıvılcımı serbest bırakır.",
		"weapon_darkRelay_desc": "Geliştirme etkisi - silah sayılmaz.\n\nBir mermi, mevcut Taretler arasında rastgele seker ve elektrik hasarı verir",
		"weapon_jester_desc": "Yağma etkisi - silah sayılmaz.\n\nYeniden At seçeneğini aldığında, ekrandaki tüm düşmanlara 0 ile 100 arasında rastgele bir miktarda hasar ver",
		"weapon_necrobomb_desc": "Yağma etkisi - silah sayılmaz.\n\nBir düşman Patlayıcı Kritik hasarla yok edildiğinde, düşmanın düştüğü konumun etrafında bir dizi patlama tetiklenir.",
		"weapon_release_desc": "Yağma etkisi - silah sayılmaz.\n\nHatalı tuşlamada, her x{2} Mükemmel Giriş için tüm düşmanlara {1} Patlayıcı hasar ver.",
		"weapon_retribution_desc": "Geliştirme etkisi - silah sayılmaz.\n\nBir Kalkan yok edildiğinde, mevcut tüm Dronlar kendini imha eder ve patlayıcı hasar verir.",
		"weapon_fireball_desc": "Geliştirme etkisi - silah sayılmaz.\\in\\Ana Silahı ateşlemek aynı zamanda yavaş bir Ateş Topu fırlatır.",
		"contains_characters": "Glifleri içeren kelimeleri tamamlanması",
		"contains_glyphs": "Glifleri içeren kümelerin tamamlanması",
		"starts_with_character": "Gliflerle başlayan kelimeleri tamamlanması",
		"starts_with_glyphs": "Gliflerle başlayan setlerin tamamlanması:",
		"enemy_drone_title": "Dron",
		"enemy_shieldDrone_title": "Kalkan Dronu",
		"enemy_stalker_title": "Takipçi",
		"enemy_shooter_title": "Nişancı",
		"enemy_splitter_title": "Bölücü",
		"enemy_warder_title": "Muhafız",
		"enemy_swarmer_title": "Saldırgan",
		"enemy_drone_desc": "Dronlar, ana silahınıza doğru amansızca hareket eden düşmanlardır. Bazen iki gelişmiş biçimde ortaya çıkabilirler:<br>Genişletilmiş: Canlarını üç katına çıkarır ve onları yenmeyi zorlaştırır.<br>Hızlandırılmış: Hareket hızlarını iki katına çıkarır ve onları ortadan kaldırma aciliyetini artırır.",
		"enemy_shieldDrone_desc": "Kalkan Dronu, yenilenen bir kalkanı olan dron türlerindendir. İki can çubuğu vardır: üstteki, belirli bir süre hasar almazsa yenilenmeye başlayan kalkanı temsil eder.",
		"enemy_stalker_desc": "Takipçi, başlangıçta kelimelerinin çoğunu gizleyen bir dron türüdür. Yazarken kelime yavaş yavaş kendini gösterir ve ortadan kaldırmak için dikkatli bir dikkat ve hızlı yazma gerektirir.",
		"enemy_shooter_desc": "Nişancı, bölümün kenarında duran ve ana silahınız yok olana kadar sürekli olarak ana silahınıza dayanıklı mermiler ateşleyen bir düşmandır.",
		"enemy_splitter_desc": "Bölücü başlangıçta tek bir düşman olarak görünür ancak aslında birden fazla parçadan oluşur. Bir parça yok edildiğinde, Bölücü bütünlüğünü kaybeder ve bileşenleri parçalanır ve ayrı düşmanlar haline gelir.",
		"enemy_warder_desc": "Muhafız, oyunun sonlarında beliren seçkin bir düşmandır. Kalkanın şu anda baktığı yönden gelen hasarı engelleyen dönen bir kalkanı vardır. Ayrıca, Muhafız hayattayken yakındaki düşmanlara koruyucu bir aura sağlar ve yok edilene kadar onları yenilmez kılar.",
		"enemy_swarmer_desc": "Saldırgan, ana silaha periyodik olarak küçük düşman grupları fırlatan seçkin bir düşmandır. Yok edilene kadar yapmaya devam eder.",
