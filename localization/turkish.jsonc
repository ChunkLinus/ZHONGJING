		"item_wither_desc": "Tüm Durum Etkileri: +%35 Ateş Oranı",
		"consumable_medpack": "Sağlık Paketi",
		"consumable_medpack_desc": "Envanterine {1} Sağlık Paketi ekler.\n\nSağlık Paketleri, Ana Taret’in azami sağlığının en fazla {2} kadarını iyileştirir.",
		"consumable_serum": "Serum",
		"consumable_serum_desc": "Envanterine {1} Serum ekler.\n\nSerumlar, {3} saniyeliğine {2} Kritik Vuruş Şansı sağlar.",
		"consumable_warhead": "Savaş Başlığı",
		"consumable_warhead_desc": "Envanterine {1} Savaş Başlıkları ekler.\n\nSavaş Başlıkları, ana silahtan dışa doğru yayılan güçlü bir dizi patlama tetikler.",
		"weapon_warhead_desc": "Tüketilebilir efekt - silah sayılmaz.\n\nAna silahtan dışa doğru yayılan güçlü bir dizi patlama tetikler.",
		"consumable_flameWave": "Alev Dalgası",
		"consumable_flameWave_desc": "Envanterinize {1} Alev Dalgası ekler.\n\nAlev Dalgaları, Ana Kulenin mevcut canının %10'u kadar maliyetle tüm görünür düşmanları tutuşturur.",
		"weapon_flameWave_desc": "Tüketilebilir etki - silah sayılmaz.\n\nAna Kulenin mevcut canının %10'u maliyetine görünürdeki düşmanları tutuşturur.",
		"consumable_cryocore": "Buz Çekirdeği",
		"consumable_cryocore_desc": "Envanterine {1} Buz Çekirdeği ekler.\n\nBuz Çekirdekleri, küresel donma efektini tetikler.",
		"consumable_killPill": "Ölüm Hapı",
		"consumable_killPill_desc": "Envanterine {1} Ölüm Hapı ekler.\n\nÖlüm Hapları, Çift Hasar etkisini küresel olarak tetikler.",
		"consumable_pocketTurret": "Cep Tareti",
		"consumable_pocketTurret_desc": "Envantere {1} Cep Tareti ekler.\n\nCep Tareti, düşman gruplarının yakınında otomatik bir taret oluşturur.",
		"weapon_pocket_turret_desc": "Tüketim etkisi - silah olarak sayılmaz.\n\nDüşman gruplarının yakınında otomatik bir taret oluşturur.",
		"item_plunder": "Yağma",
		"item_plunder_desc": "+1 Ganimet Seçeneği",
		"item_multitargeting": "Çoklu Hedefleme",
		"item_multitargeting_desc": "Tüm Uzaktan Silahlar, sahip olduğunuz her Silah için +%1 Kritik Şansı alır.",
		"item_pickupMagnet": "Dev Mıknatıs",
		"item_pickupMagnet_desc": "Teslim alımları süreleri dolduğunda otomatik olarak toplarsınız.",
		"item_frostbite": "Donma",
		"item_frostbite_desc": "Dondurulmuş durumdayken düşmanlar zamanla hasar alır.",
		"item_necrobomb": "Nekrobomba",
		"item_necrobomb_desc": "Patlayıcı Kritik hasarına sahip bir düşmanı yok ettiğinizde, düşen düşmanın konumu etrafında bir dizi patlama tetikleyin.",
		"item_prize": "Ödül",
		"item_prize_desc": "Kritik hasarla bir düşmanı yok ettiğinizde, Yeniden Atma, Kalkan veya Sağlık kazanımlarının ortaya çıkma şansı {1} olur.",
		"item_aftershock": "Artçı şok",
		"item_aftershock_desc": "Kritik hasar her zaman durum etkisi yaratır.",
		"item_vampirism": "Vampirlik",
		"item_vampirism_desc": "Kinetik Kritik hasarının {1} kadarına eşit can kazan.",
		"item_wisdom": "Bilge",
		"item_wisdom_desc": "Kalkan aldığınızda, tüm silah Evrimlerine 10 Öldürme kazanırsınız.",
		"item_jester": "Soytarı",
		"item_jester_desc": "Zar hakkı kazandığınızda, ekrandaki tüm düşmanlara 0 ile 100 arasında rastgele bir hasar verin.",
		"item_jester_2_desc": "Bir kelime bitirdiğinde, rastgele bir hedefe 0-100% hasar veren bir Yalancı Drone yaratırsın. 10 saniye bekleme süresi vardır.",
		"item_lastStand": "Son Direniş",
		"item_lastStand_desc": "Kalkan yok edildiğinde, İki Kat Hasar kazanırsın.",
		"item_tripleDamage": "Üçlü Hasar",
		"item_tripleDamage_desc": "Tüm Çift Hasar alımları artık Üçlü Hasar.",
		"item_fracture": "Kırık",
		"item_fracture_desc": "Donma sırasında, ortaya çıkacak olan her Donma alma, bunun yerine her Donmuş düşmana hasar veren bir Kırık olur. Ascetic",
		"item_fracture_desc_2": "Donmuş düşmanlara verilen tüm hasar {1} artar. Değiştirici çarpansaldır.",
		"item_ascetic": "Zahit",
		"item_ascetic_desc": "Ganimet ekranından çıktığınızda, 20 saniye boyunca kullanılmayan her zar hakkı için +%10 hasar kazanın.",
		"item_harmonizer": "Harmonizer",
		"item_harmonizer_desc": "Donanımlı tüm silahlar bir Evrim seviyesi kazanır.",
		"item_immortality": "Ölümsüzlük",
		"item_immortality_desc": "Ana Silahınız yok edilmek üzereyse, bunun yerine 1 cana düşürülecektir. Bu yetenek yalnızca her 2 dakikada bir kullanılabilir.",
		"item_immortality_desc_2": "Ana Silahın yok edilmek üzere ise, bunun yerine 1 cana düşürülür ve ana silahın 400 metre içindeki tüm düşmanlara ölümcül Kinetik hasar verilir. Bu yetenek yalnızca her 2 dakikada bir kullanılabilir.",
		"item_enlightenment": "Aydınlanma",
		"item_enlightenment_desc": "Bir düşmanı kritik hasarla yok ettiğinde, tüm silah Evrimlerine +1 öldürme kazandırır.",
		"item_closer": "Yakındı",
		"item_closer_desc": "Bir düşmanın kelimesini yok edildikten sonra tamamlamak, 10 saniye boyunca +%10 hasar verir. 3 defaya kadar birikir.",
		"item_murderous": "Cinayet",
		"item_murderous_desc": "Tüm Dron Silahları: +%50 Hasar",
		"item_executioner": "Cellat",
		"item_executioner_desc": "Tüm Taret Silahları: +%50 Hasar",
		"item_degeneration": "Dejenerasyon",
		"item_degeneration_desc": "Tüm Uzaktan Silahlar: +%50 Hasar",
