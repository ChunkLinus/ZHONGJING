		"item_shatter": "Pirstoa",
		"item_shatter_desc": "Kaikki kineettiset aseet saavat {1} kriittisen mahdollisuutta jäätyneitä vihollisia vastaan.",
		"item_seer": "Näkijä",
		"item_seer_desc": "Uudelleen arvonnan aktivointi kasvattaa sinun kaikkea kantomatkaa 10% seuraavaksi 10 sekunniksi. Kolme efektiä voi olla voimassa yhtäaikaa.",
		"item_seer_desc_2": "Jos sinulla ei ole yhtään uudelleen arvontaa kun saat tason, evoluution tai palkinnon saat yhden udelleen arvonnan käytettäväksi sitä varten.",
		"item_resilience": "Sinnikkyys",
		"item_resilience_desc": "Kilven aktivointi kasvattaa sinun kaikkea kestoaikaa 10% seuraavaksi 10 sekunniksi. Kolme efektiä voi olla voimassa yhtäaikaa.",
		"item_resilience_desc_2": "Jokaista kilpeä kohti saat {1} kaikkeen kestoaikaan.",
		"item_gambler": "Uhkapeluri",
		"item_gambler_desc": "Nostaa uudelleen arvontojen maksimia yhdellä. Maksimi on 6.",
		"item_protector": "Turvamies",
		"item_protector_desc": "Nostaa kilpien maksimia yhdellä. Maksimi on 4.",
		"item_flawless": "Täydellinen",
		"item_flawless_desc": "Joka x{1} täydellinen sana myös nostaa sinun kaikkea tulinopeutta: {2}.",
		"item_release": "Laukaus",
		"item_release_desc": "Kirjoitusvirheet aiheuttavat {1} räjähdysvahinkoa kaikkiin vihollisiin per x{2} täydellinen sana.",
		"item_wasting": "Riuduttava",
		"item_wasting_desc": "Kaikki ajan myötä vahinkoa tekevät aseet:\n  +35% tulinopeus.",
		"item_wither": "Kuihtua",
		"item_wither_desc": "Kaikki status efektit:\n  +35% tulinopeus",
		"consumable_medpack": "Lääkärilaukku",
		"consumable_medpack_desc": "Lisää {1} lääkärilaukkua sinun varastoosi.\n\nNe parantavat {2} pääaseen kestosta.",
		"consumable_serum": "Seerumi",
		"consumable_serum_desc": "Lisää {1} seerumia sinun varastoosi.\n\nSeerumi lisää kriittisen mahdollistuutta {2} {3} sekunniksi.",
		"consumable_warhead": "Taistelukärki",
		"consumable_warhead_desc": "Lisää {1} taistelukärkeä sinun varastoosi.\n\nTaistelukärjet laukaisevat sarjan voimakkaita räjähdyksiä jotka säteilevät pääaseesta ulospäin.",
		"weapon_warhead_desc": "Kulutettavan bonuksen efekti - Ei lasketa aseeksi.\n\nLaukaise sarja voimakkaita räjähdyksiä jotka säteilevät pääaseesta ulospäin.",
		"consumable_flameWave": "Tuliaalto",
		"consumable_flameWave_desc": "Saat {1} tuliaaltoa.\n\nTuliaalto sytyttää kaikki näkyvät viholliset tuleen ja vahingoittaa sinun pääasettasi 10%.",
		"weapon_flameWave_desc": "Bonus efekti - Ei lasketa aseeksi.\n\nSytyttää kaikki näkyvät viholliset tuleen ja vahingoittaa sinun pääasettasi 10%.",
		"consumable_cryocore": "Kryoydin",
		"consumable_cryocore_desc": "Lisää {1} kryoydintä sinun varastoosi.\n\nKryoytimet laukaisevat globaalin jäädytys efektin.",
		"consumable_killPill": "Tappopilleri",
		"consumable_killPill_desc": "Lisää {1} tappopilleriä sinun varastoosi.\n\nTappopilleri triggeröi globaalin tupla vahingon.",
		"consumable_pocketTurret": "Taskutykki",
		"consumable_pocketTurret_desc": "Lisää {1} Taskutykki varastoosi.\n\nTaskutykki luo automaattisen tykin vihollisten lähelle.",
		"weapon_pocket_turret_desc": "Kulutettava efekti - ei lasketa aseeksi.\n\nluo automaatisen tykin vihollisten lähelle.",
		"item_plunder": "Ryöstö",
		"item_plunder_desc": "+1 Palkinto mahdollisuus",
		"item_multitargeting": "Monikohdistus",
		"item_multitargeting_desc": "Kaikki kaukoaseet saavat +1% kriittisen mahdollisuuden per jokainen ase joka sinulla on.",
		"item_pickupMagnet": "Jättimagneetti",
		"item_pickupMagnet_desc": "Sinulla on {1} mahdollisuus automaattisesti kerätä bonukset kun ne häviävät.",
		"item_frostbite": "Paleltuma",
		"item_frostbite_desc": "Viholliset vahingoittuvat jäätymisen aikana.",
		"item_necrobomb": "Räjättävät viholliset",
		"item_necrobomb_desc": "Räjähdysvahinkoon kuolevat viholliset aiheuttavaf sarjan räjähdyksiä ympärilleen.",
		"item_prize": "Pikavoitto",
		"item_prize_desc": "Kriittiseen vahinkoon kuolevilla vihollisilla on {1} mahdollisuus tiputtaa Uudelleen arvonta, Kilpi tai Kesto bonus.",
		"item_aftershock": "Jälkijäristys",
		"item_aftershock_desc": "Kriittinen vahinko aina aiheuttaa status efektin.",
		"item_vampirism": "Vampyyri",
		"item_vampirism_desc": "Kriittiset osumat kineettisellä vahingolla parantavat sinua {1} sen määrästä.",
		"item_wisdom": "Viisaus",
		"item_wisdom_desc": "Kun saat kilven kaikki ase evoluutiot saavat 10 tappoa.",
		"item_jester": "Narri",
		"item_jester_desc": "Kaikki viholliset saavat 0 ja 100 väliltä vahinkoa kun saat uudelleen arvonnan.",
		"item_jester_2_desc": "Kun saat sanan valmiiksi luot narridroonin joka tekee 0-100% vahinkoa satunnaiseen viholliseen. Voi aktivoitua vain 10 sekunnin välein.",
		"item_lastStand": "Viimeiseen mieheen",
		"item_lastStand_desc": "Kun sinun kilpi tuhoutuu sinulla on 30% mahdollisuus saada tuplavahinko.",
		"item_tripleDamage": "Triplavahinko",
		"item_tripleDamage_desc": "Tuplavahingon aikana ilmenevät tuplavahinko bonukset ovat triplavahinko bonuksia.",
		"item_fracture": "Murtuma",
		"item_fracture_desc": "Jäädytyksen aikana kaikki ilmenevät jäädytykset ovat murtuma bonuksia, jotka vahingoittavat kaikkia jäätyneitä vihollisia.",
		"item_fracture_desc_2": "Kaikki vahinko jäätyneisiin vihollisiin kasvaa {}. Muuttuja on kerroin.",
		"item_ascetic": "Askeetikko",
		"item_ascetic_desc": "Kun poistut ruudusta kaikki käyttämättömät uudelleen arvonnat nostavat vahinkoa +10% 20 sekunniksi.",
		"item_harmonizer": "Harmonisoija",
		"item_harmonizer_desc": "Kaikki tämän hetkiset aseet saavat yhden evoluutio tason.",
		"item_immortality": "Kuolemattomuus",
		"item_immortality_desc": "Jos sinun pääaseesi meinaa tuhoutua tuhoutumisen sijaan sen kesto laskee yhteen. Tämä voi tapahtua vain kerran 2 minuutissa.",
		"item_immortality_desc_2": "Jos sinun pääaseesi meinaa tuhoutua sen sijaan se tippuu 1 kestopisteeseen ja kaikki viholliset 400 metrin sisällä saavat kuolettavan määrän kineettistä vahinkoa. Tämä ominaisuus voi aktivoitua vain 2 minuutin välein.",
		"item_enlightenment": "Valaistuminen",
		"item_enlightenment_desc": "Saat +5 tappoa aseen evoluution jos se tappaa vihollisen kriittisellä vahingolla.",
		"item_closer": "Viiimeinen sana",
		"item_closer_desc": "Vihollissanan viimeistely sen tuhoutumisen jälkeen antaa sinulle +10% vahinkoa 10 sekunniksi. Kolme efektiä voi olla voimassa yhtäaikaa.",
		"item_murderous": "Murhamielinen",
		"item_murderous_desc": "Kaikki drooniaseet:\n  +50% vahinko",
		"item_executioner": "Mestaaja",
		"item_executioner_desc": "Kaikki torniaseet:\n  +50% vahinko",
		"item_degeneration": "Rappeutuminen",
		"item_degeneration_desc": "Kaikki kaukoaseet:\n  +50% vahinko",
		"item_clone": "Klooni",
		"item_clone_desc": "Kulutettavilla bonuksilla on 30% mahdollisuus kopioida itsensä kun ne käytetään.",
