		"augment_category_kinetic": "Koodeksi: Kineettinen",
		"augment_armored": "Panssaroitu",
		"augment_armored_desc": "Pääase:\n  Kesto: +50%",
		"augment_eager": "Innokas",
		"augment_eager_desc": "Saat tason haasteen tai loputtoman pelin alussa. Jokaista 4 minuuttia jonka selviät loputtomassa moodissa kohden saat tason.",
		"augment_gambler": "Uhkapeluri",
		"augment_gambler_desc": "Jokainen uudelleen arvonta antaa pääaseellesi +20% vahinkoa 20 sekunniksi.",
		"augment_haze": "Usva",
		"augment_haze_desc": "Kun sinun kesto on alle 50% saat +50% bonuksen tulinopeuteen.",
		"augment_immaculate": "Tahraton",
		"augment_immaculate_desc": "Täydelliset sanat antavat +1.5% kriittisen mahdollisuuteen.",
		"augment_devotion": "Kiintymys",
		"augment_devotion_desc": "Pääase tekee +25% vahinko jokaista tyhjää asetta kohden. Ainakin yksi vaihtoehto tason noustessa on parannus.",
		"augment_armada": "Armada",
		"augment_armada_desc": "Kun luot droonin niin sinulla on 20% mahdollisuus luoda ylimääräinen drooni.",
		"augment_diversity": "Moninaisuus",
		"augment_diversity_desc": "Jokainen ei-drooni ase joka sinulla on nostaa droonien kestoaikaa 20%.",
		"augment_blitzkrieg": "Salamasota",
		"augment_blitzkrieg_desc": "Droonien nopeuden parannukset myös nostavat droonien vahinkoa.",
		"augment_retribution": "Kosto",
		"augment_retribution_desc": "Aina kun sinun kilpi tuhoutuu kaikki sen hetkiset droonit räjähtävät vahingoittaen vihollisia.",
		"augment_scapegoat": "Syntipukki",
		"augment_scapegoat_desc": "Väärin kirjoitetut sanat tuhoavat yhden sinun drooneista eikä niitä lasketa vääriksi sanoiksi.",
		"augment_spoils": "Saalis",
		"augment_spoils_desc": "Droonit voivat tiputtaa bonuksia niiden tuhouduttua.",
		"augment_fortress": "Linnoitus",
		"augment_fortress_desc": "Jokainen torni evoluution antaa myös pääaseelle +50 maksimi kestoa.",
		"augment_networked": "Verkostoitunut",
		"augment_networked_desc": "Jokainen torni antaa +10% tulinopeuteen kaikille torneille, +50% asti.",
		"augment_fieldIntel": "Tiedustelutieto",
		"augment_fieldIntel_desc": "Bonuksen aktivointi antaa +30% kantomatkaa kaikille torneille. Tätä bonusta ei voi aktivoida yhtä aikaa kuin kerran.",
		"augment_darkRelay": "Salainen rele",
		"augment_darkRelay_desc": "Torniesi väillä lentelee satunnaisesti ammus, joka tekee sähkövahinkoa.",
		"augment_observer": "Tarkkailija",
		"augment_observer_desc": "Jos et ole hyökännyt 3 sekunttiin saat +30% vahinkoa torneille siihen asti kunnes hyökkäät.",
		"augment_observer_powerup": "{1} lisävahinkoa torneille",
		"augment_weakness": "Heikkous",
		"augment_weakness_desc": "Tornin kantamassa olevat viholliset ottavat 30% enemmän vahinkoa muista lähteistä.",
		"augment_corrosion": "Korroosio",
		"augment_corrosion_desc": "Ajan myötä vahinkoa tekevät aseet voivat tehdä kriittistä vahinkoa.",
		"augment_lamprey": "Nahkiainen",
		"augment_lamprey_desc": "Pääaseen ajan myötä tekemä vahinko parantaa sitä 1 kestopisteen verran.",
		"augment_tenacity": "Sitkeys",
		"augment_tenacity_desc": "Nostaa kaikkien ajan myötä vahinkoa tekevien aseiden kestoaikaa 35%.",
		"augment_afflictors": "Tuskanaiheuttajat",
		"augment_afflictors_desc": "Lisää Tuskanaiheuttajat bonus mahdollisuuksiin. Jokainen antaa +3% ajan myötä tapahtuvan vahinkoon. Tupla vaikutus pääaseen lähellä.",
		"augment_conviction": "Vakaumus",
		"augment_conviction_desc": "Kun sinulla on täydet uudelleen arvonnat kaikki sinun ajan myötä vahinkoa tekevät aseet saavat +40% tulinopeuteen.",
		"augment_conviction_powerup": "{1} ajan myötä vahinkoa tekevien aseiden tulinopeus",
		"augment_infector": "Tartuttaja",
		"augment_infector_desc": "Ajan myötä vahinkoa tekevillä aseilla on +3% mahdollisuus aiheuttaa status efekti.",
		"augment_closeCombat": "Lähitaistelu",
		"augment_closeCombat_desc": "Kaikki kaukovahinko lasketaan tapahtuvan sinun pääaseen lähellä.",
		"augment_caltrops": "Jalkapiikit",
		"augment_caltrops_desc": "Verenvuodatuksen vahinko nousee {1}. Tämä vaikuttaa kaikkeen veren vuodatukseen  ja vaikuttaa perusvahinkoon.",
		"augment_causticAmmo": "Syövyttävät ammukset",
		"augment_causticAmmo_desc": "Mahdollisuus löytää syövyttäviä ammuksia - lisää 10 kemikaalivahinkoa sinun kaukoaseisiin 20 sekunniksi.",
		"augment_piracy": "Piratismi",
		"augment_piracy_desc": "Jokaista bonus efektiä kohden kaukoaseiden vahinko nousee 15%.",
		"augment_deliverance": "Pelastus",
		"augment_deliverance_desc": "Kaikki kaukoaseet saavat +40% kantomatkaan jos sinulla on maksimi määrä kilpiä.",
		"augment_deliverance_powerup": "{1} Kaukoaseiden kantomatka",
		"augment_sniper": "Tarkka-ampuja",
		"augment_sniper_desc": "Kaukoaseiden kantomatkan parannukset nostavat myös niiden vahinkoa.",
		"augment_voltaicBurst": "Sähköpurkaus",
		"augment_voltaicBurst_desc": "Sähköaseiden kestoaika parannukset vaikuttavat myös staattisen mahdollisuuteen 25% niiden määrästä.",
		"augment_stormBattery": "Myrskypatteri",
		"augment_stormBattery_desc": "Pääase tekee sähkövahinkoa lähellä oleviin vihollisiin. Kaikki sähköaseet nostavat sen perusvahinkoa.",
		"augment_lightningSparks": "Kipinät",
		"augment_lightningSparks_desc": "Kun sähköase tekee kriittisen osuman se vapauttaa 6 sähkökipinää joiden vahinko nousee kriittisen osuman ja kriittisen kertoimen mukaan.",
		"augment_efficientGrid": "Tehokas verkko",
		"augment_EfficientGrid_desc": "Jokaista ei-sähköasetta kohden kaikkien sähköaseiden kestoaika nousee 10%.",
		"augment_violentDischarge": "Väkivaltainen purkaus",
		"augment_violentDischarge_desc": "Staattinen tekee enemmän vahinkoa ja sillä on pidempi kantomatka. Staattisen tappamilla vihollisilla on 50% levittää staattinen isku ympäröiviin vihollisiin.",
		"augment_electrifiedTurret": "Sähköistetty tykki",
		"augment_electrifiedTurret_desc": "Pääase saa +5% perus sähkövahinkoa ja nostaa kaikkien sähköaseiden vahinkoa 10%.",
		"augment_pyromancy": "Tulivelhous",
		"augment_pyromancy_desc": "Nostaa tulivahinkoa 2% jokaista palavaa vihollista kohti. Vihollisten tuleen sytytys tekee bonus tulivahinkoa sytyksen keston ja vahingon perusteella.",
		"augment_cauterization": "Kauterisaatio",
		"augment_cauterization_desc": "Kantomatkan bonus vaikuttaa myös pääaseen lähelle tehtyyn tulivahinkoon ja efekteihin.",
		"augment_furnaceCore": "Tulipesän ydin",
		"augment_furnaceCore_desc": "Pääase saa +5 perus tulivahinkoa. Kaikki tulivahinko kasvaa 10%.",
		"augment_fireball": "Tulipallo",
		"augment_fireball_desc": "Pääase vapauttaa hitaasti liikkuvan tulipallon kun se ampuu joka tekee tulivahinkoa siihen osuviin vihollisiin. Maksimissaan 1 aktiivinen tulipallo.",
		"augment_flameWave": "Tuliaalto",
		"augment_flameWave_desc": "Lisää tuliaalto bonuksen sinun aloitus arsenaaliisi ja mahdollisiin bonuksiin. Sytyttää kaikki näkyvät viholliset tuleen ja tekee 10% vahinkoa sinun pääaseeseen.",
		"augment_blazingGlory": "Suurpalo",
		"augment_blazingGlory_desc": "Pääaseen lähellä olevat viholliset saavat +25% tulivahinkoa ja niillä on 12% lisämahdollisuus syttyä tulee tulivahingosta.",
		"augment_gunslinger": "Revolverisankari",
		"augment_gunslinger_desc": "Maksimi sanatulva nousee viidellä. Jokainen taso Sanatulvaa antaa +2.5% kineettistä vahinkoa.",
		"augment_bloodlust": "Verenhimo",
		"augment_bloodlust_desc": "Kineettisten aseiden tulinopeus nousee 2% ja kantomatka 1% jokaisesta vertavuotavasta vihollisesta.",
		"augment_infusedAmmo": "Infusoidut ammukset",
		"augment_infusedAmmo_desc": "Kineettisen vahinkon kriittisillä osumilla on 40% mahdollisuus lisätä satunnainen Status efekti viholliseen.",
		"augment_scrapArmaments": "Sirpale",
		"augment_scrapArmaments_desc": "Mahdollisuus tiputtaa Sirpaleita - lisää 10 perus kineettistä vahinkoa kineettisille aseille 20 sekunniksi.",
		"augment_combinedArms": "Aselajien yhteistyö",
		"augment_combinedArms_desc": "Jokaista ei-kineettistä asetta joka sinulla on kineettiset aseet saavat 10% lisää vahinkoa.",
		"augment_pocketTurret": "Taskutykki",
		"augment_pocketTurret_desc": "Lisää Taskutykki kulutettavan bonuksen palkinto mahdollisuuksiin. Taskutykki luo tykin ja sen voi kerätä takaisin sen sammuttua.",
		"wiki_tag_label": "Tagit",
		"wiki_name_label": "Nimi",
		"wiki_cost_label": "Hinta",
		"wiki_description_label": "Selitys",
		"wiki_title": "Glyphica Virallinen Wiki",
		"wiki_subtitle": "Glyphica Typing Survival pelin virallinen Wiki",
		"wiki_home_title": "Koti",
		"wiki_landingPage_title": "Tervetuloa näppäilijä",
		"wiki_landingPage_intro": "Tervetuloa Glyphica: Typing Survival pelin viralliseen Wikiin! Testaa kirjoitustaitojasi pelaamalla tätä laumaselvitymispeliä, jossa nopeus ja tarkkuus ovat parhaimmat aseesi. Voimakkaat työkalut muuttavat kirjoitustaitosi tuhoaviksi iskuiksi heltymättömiä vihollisia vastaan. Löydä lisätietoa ja nappaa peli Steamistä: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Tästä wikistä löydät kattavan oppaan pelin ominaisuuksista, mekaniikoista ja sisällöstä, joka on tällä hetkellä saatavilla Glyphical Early Access versiossa. Meidän tavoite on pitää tämä tieto ajantasalla kun pyrimme täyttä julkaisua, versiota 1.0., kohti. Wiki on organisoitu osioihin sisällölistassa ja sitä päivitetään jatkuvasti kun peli kehittyy.",
		"wiki_tableOfContents_title": "Sisältö",
		"wiki_mainWeapons_title": "Pääaseet",
		"wiki_mainWeapons_intro": "Pääaseet ovat *Glyphican* aloitusaseet ja niillä on keskinäinen rooli pelissä. Kun kirjoitat sanan vihollisen yllä, sinun pääaseesti lukittautuu tähän viholliseen. Jokaisella pääaseella on uniikit efektit ja mekaniikat, jotka vaativat eri strategioita jotta saat niistä kaiken irti.",
		"wiki_mainWeapons_intro2": "Jotkin pääaseet keskittyvät kirjoitusnopeuteen ja toiset vaativat taktisempaa lähestymistapaa. Kuten toiset aseet, myös pääaseet voivat saada parannuksia ja evoluutioita, jotka parantavat niiden ominaisuuksia ja tehokkuutta.",
		"wiki_mainWeapons_list_title": "Lista pääaseista",
		"wiki_weapons_title": "Tason noususta saatavat aseet",
		"wiki_weapons_intro": "Jotkin aseet saat kun saat tason. Kun valitset yhden niistä niin se lisätään sinun arsenaaliin. Jokaisella aseella on uniikki aktivoitumistapa, mutta suurin osa niistä laukeaa kun kirjoitat vihollisen ylläolevia sanoja ja pääaseen tähdätessä vihollisia.",
		"wiki_weapons_intro2": "Voit saada maksimissaan 4 näitä aseita. Kun ase on lisätty sinun arsenaaliisi sen parannukset lisätään mahdollisiin tason nousu palkintoihin, mahdollistaen niiden ominaisuuksien parantamisen kun pääset eteenpäin pelissä.",
		"wiki_weapons_list_title": "Lista tason noususta saatavista aseista",
		"wiki_weapon_evolution_title": "Evoluutiot",
		"wiki_weapon_upgrade_title": "Upgrades",
		"wiki_lootItems_title": "Palkinnot",
		"wiki_lootItems_intro": "Palkinto esineet on mahdollista saada pelin aikana aktivoimalla aarrearkku bonukset. Voit valita yhden satunnaisesti arvotun esineen, joka antaa sinulle passiivisen bonuksen koko pelin ajaksi.",
		"wiki_lootItems_intro2": "Palkinto esineet ovat jaettu **yleisiin**, **epätavallisiin**, ja **harvinaisiin* esineisin, joka vaikuttaa niiden todennäköisyyteen ilmestyä. Pomon kukistaminen Haaste moodissa palkitsee sinut arkulla jossa on vain harvinaisia esineitä.",
		"wiki_lootItems_rare_title": "Lista harvinaisista palkinnoista",
		"wiki_lootItems_uncommon_title": "Lista epätavallisista palkinnoista",
		"wiki_lootItems_common_title": "Lista yleisistä palkinnoista",
		"wiki_enemies_title": "Viholliset",
		"wiki_enemies_intro": "**Glyphican** viholliset luodaan pelin sisäisen mekaniikan **uhan** mukaisesti, joka kasvaa pelin edetessä. Haaste moodissa uhka on kerrottu sen hetkisen Haasteen tason mukaisesti, joka tekee jokaisesta tasosta vaikeamman. Loputtomassa moodissa uhka kasvaa pelaajan tason mukaisesti, progressiivisesti kasvattaen vihollisten vaikeutta.",
		"wiki_enemies_intro2": "Viholliset ovat myös jaettu **erikois** ja **eliitti** vihollisiin. Niillä on jokaisella on oma vaikeusaste, joka rajoittaa niiden ilmestymistä. Tätä vaikeusastetta verrataan sen hetkiseen uhkaan.",
		"wiki_enemies_list_title": "Vastustaja listaus",
		"wiki_enemy_variants_title": "Variaatio listaus",
		"wiki_image_label": "Kuva",
		"wiki_splitter_shard_count": "Sirpaleiden määrä",
		"wiki_splitter_shard_health": "Sirpaleiden kesto",
		"wiki_splitter_shard_damage": "Sirpaleiden vahinko",
		"wiki_augments_title": "Augmentaatiot",
		"wiki_augments_intro": "Augmentaatiot ovat pysyviä parannuksia, joita voit ansaita Kolikoilla (§), joita tienaat pelatessaasi. Jokaisen pelin alussa pelaajalla on rajattu määrä tilaa johon hän voi laittaa tienattuja augmentaatioita. Sen hetkinen Enne taso vaikuttaa kuinka paljon pelaajalla on tilaa.",
		"wiki_augments_intro2": "Jokaisella augmentaatiolla on yleensä tietyt ehdot jotka vaikuttavat sen hyötyihin. Jotta saat kaiken irti augmentaatioista harkitse niiden synergioita ja yhdistä ne sinun strategiaasi.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Sinnikkyys",
		"NEW_ACHIEVEMENT_1_0_DESC": "Selviä 20 minuuttia loputtomassa moodissa millä tahansa pääaseella.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Sisu",
		"NEW_ACHIEVEMENT_1_1_DESC": "Selviä 30 minuuttia loputtomassa moodissa millä tahansa pääaseella.",
