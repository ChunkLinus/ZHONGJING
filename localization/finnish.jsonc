		"evo_heatray_solar_tap_desc": "Globaali efekti:\n   Kaikki Tuli efektit/Aseet:\n   Status efektin mahdollisuus: {1}",
		"evo_barrage_rocketArray": "Rakettiryhmä",
		"evo_barrage_rocketArray_desc": "Pommitus ampuu nyt {1} ohjusta per ammus {2} sijaan.",
		"evo_barrage_rocketArray_2": "Rakettiryhmä II",
		"evo_barrage_seismicMunition": "Seismiset ampumistarvikkeet",
		"evo_barrage_seismicMunition_desc": "Ohjukset uppoutuvat nyt maahan räjähtämisen sijaan ja ne tekevät räjähtäviä pulsseja muutaman sekunnin ajan.",
		"evo_barrage_seismicMunition_2": "Seismiset ampumistarvikkeet II",
		"evo_barrage_seismicMunition_2_desc": "Seismiset ampumistarvikkeiden:\n  Kantomatka: {1}\n   Kestoaika: {2}",
		"evo_barrage_resupply": "Täydennys",
		"evo_barrage_resupply_desc": "Täydennyksia voi nyt ilmestyä. Jos aktivoit ne niin ne lataavat sinun pääaseen täysin ja saat {1} vahinkobonuksen seuraavan ammukseen.",
		"evo_barrage_resupply_2": "Täydennys II",
		"evo_barrage_resupply_2_desc": "Täydennykset nyt antavat myös {1} räjähdyksen kantomatkaan seuraavalle ammukselle.",
		"evo_barrage_resupply_pickup": "Täysilipas!",
		"evo_barrage_total_saturation": "Totaalinen pommitus",
		"evo_barrage_total_saturation_desc": "Globaali efekti:\n   Kaikki Räjähdys efektit/Aseet:\n   Vahinko: {1}",
		"evo_splattershot_bubble": "Limakupla",
		"evo_splattershot_bubble_desc": "Pärskytin nyt luo limakuplia sen vahinkoalueelle.\n\nKun limakuplat aktivoidaan ne purkautuvat, aiheuttaen vahinkoa pienelle alueelle ja luovat uusia vahinkoalueita.",
		"evo_splattershot_bubble_2": "Limakupla II",
		"evo_splattershot_bubble_2_desc": "Luo useampia limakuplia.\n\nLimakuplilla on 50% mahdollisuus räjähtää automaattisesti kun niiden aika on loppu.",
		"evo_splattershot_infestation": "Tartunta",
		"evo_splattershot_infestation_desc": "Pärskyttimen efektit:\n  Status efektin mahdollisuus: {1}\n\nGlobaalit efektit:\n  Status efektien vahinko: {2}",
		"evo_splattershot_infestation_2": "Tartunta II",
		"evo_splattershot_infestation_2_desc": "Status efektien tappamat viholliset räjähtävät vahinkoalueiksi.",
		"evo_splattershot_lava": "Laava",
		"evo_splattershot_lava_desc": "Efektit:\n  Kemikaali vahinko: {1}\n  Tulivahinko: {2}\n\nVaikuttaa perusvahinkoon. Pärskyttimen vahinko muuttuu tulivahingoksi.",
