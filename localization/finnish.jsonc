		"weapon_firestorm_title": "Tulimyrsky",
		"weapon_guardian_title": "Suojelija",
		"weapon_orbiter_title": "Satelliitti",
		"weapon_frostbite_title": "Paleltuma",
		"weapon_bleeding_title": "Verenvuodatus",
		"weapon_blight_title": "Vitsaus",
		"weapon_static_title": "Staattinen",
		"weapon_ignite_title": "Sytytys",
		"weapon_heatray_requirements": "Suorita Toistaja Haasteet millä tahansa Enne tasolla.",
		"weapon_barrage_requirements": "Suorita Haasteet Enne taso 3:lla käyttäen mitä tahansa pääasetta.",
		"weapon_repeater_desc": "Tulivoimainen ase joka ampuu useita ammuksia lyhyissä sarjoissa.",
		"weapon_heatray_desc": "Ampuu jatkuvan valosäteen joka tekee vahinkoa jatkuvasti.",
		"weapon_barrage_desc": "Ampuu sarjan raketteja kohteeseen ja sen ympärille. Latautuu ajan kuluessa.",
		"weapon_overmind_desc": "Komenna drooniarmeijaa tuhoamaan vihollisiasi.",
		"weapon_splattershot_desc": "Ammu mönjää vihollistesi päälle ja vammauta ja vahingoita niitä.",
		"weapon_wildcard_desc": "Sinun seuraava ammus on satunnainen neljän eri aseen välillä, tähtää tarkasti.",
		"weapon_spectre_desc": "luo yllämainutun määrän nopeita lähitaisteludrooneja.",
		"weapon_sentry_desc": "Laukaise automaattinen tykkitorni joka ampuu vihollisia kantamansa sisällä.",
		"weapon_tesla_desc": "Laukaisee sähkötornin joka tekee jatkuvasti vahinkoa.",
		"weapon_oscillator_desc": "Ammu oskilloiva partikkelivirta viimeisintä vihollista kohti.",
		"weapon_meteor_desc": "Ajoittain luo tähtäinmerkkejä satunnaisiin paikkoihiin johon ammutaan pommitusta.",
		"weapon_hunter_desc": "Luo yllämainitun määrän drooneja jotka ampuvat sähkösäteitä.",
		"weapon_chopper_desc": "Luo massiivisen pyörivän terän joka matkustaa pitkin näytön laitoja ja pilkkoo vihollisia tiellään.",
		"weapon_minefield_desc": "luo hitaasti liikkuvia kosketuksesta räjähtäviä miinoja.",
		"weapon_blade_desc": "Laukaisee pyörivän neljäteräisen teräansan.",
		"weapon_firestorm_desc": "Kanuuna joka ampuu sarjan lyhyen matkan räjähtäviä ammuksia. Se kiertää pääasetta ja tarvii hetken ennenkuin voi ampua uudestaan.",
		"weapon_guardian_desc": "Laukaisee droonin joka ampuu lasereita vihollisia kohti. Aktivoi polttoaine tankataksesi Suojelijan, jottei se pysähdy.",
		"weapon_orbiter_desc": "laukaisee pallon joka kiertää pääasetta ja vahingoittaa kaikkia tiellään.",
		"weapon_frostbite_desc": "Palkinto efekti - ei lasketa aseeksi.\n\nViholliset saavat vahinkoa kun ne ovat jäätyneet.",
		"weapon_bleeding_desc": "Status efekti - Ei lasketa aseeksi.\n\nViholliset saavat kineettistä vahinkoa kunnes efekti loppuu.",
		"weapon_blight_desc": "Status efekti - Ei lasketa aseeksi.\n\nViholliset saavat kemikaalista vahinkoa ja ovat hidastettu kunnes efekti loppuu.",
		"weapon_static_desc": "Status efekti - Ei lasketa aseeksi.\n\nLähellä olevat viholliset saavat energiavahinkoa kunnes efekti loppuu.",
		"weapon_ignite_desc": "Status efekti - Ei lasketa aseeksi.\n\nViholliset saavat tulivahinkoa kunnes efekti loppuu.",
		"weapon_caltrops_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nKun kaukoase tekee kriittisen osuman se luo 12 piikkiä jotka vahingoittavat ohimeneviä vihollisia ja nostaa verenvuodatuksen mahdollisuutta niiden vahingon perusteella.",
		"weapon_stormBattery_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nPääase iskee lähellä olevia vihollisia sähköllä. Jokainen sähköase nostaa sen perusvahinkoa.",
		"weapon_lightningSparks_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nKun sähköase tekee kriittisen osuman se vapauttaa 6 sähkökipinää joiden vahinko nousee kriittisen osuman ja kriittisen kertoimen mukaan.",
		"weapon_darkRelay_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nTornien välillä kimpoilee ammus joka tekee sähkövahinkoa.",
		"weapon_jester_desc": "Palkinto efekti - ei lasketa aseeksi.\n\nKun saat uudelleen arvonnan teet satunnaisen määrän 0 ja 100 välillä kaikkiin vihollisiin.",
		"weapon_necrobomb_desc": "Palkinto efekti - ei lasketa aseeksi.\n\nKun kriittinen räjähdys tuhoaa vihollisen se laukaisee sarjan räjähdyksiä sen ympärille.",
		"weapon_release_desc": "Palkinto efekti - ei lasketa aseeksi.\n\nKun teet virheen tee {1} räjähdysvahinkoa kaikkiin viholliseen jokaista x{2} täydellistä sanaa kohden.",
		"weapon_retribution_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nKun menetät kilven kaikki sen hetkiset dronet räjähtävät ja tekevät räjähdysvahinkoa.",
		"weapon_fireball_desc": "Augmentaatio efekti - Ei lasketa aseeksi.\n\nPääase ampuu hitaan tulipallon normaali ammuksen lisäksi.",
		"contains_characters": "Suorita sanoja joissa on merkkejä",
		"contains_glyphs": "Suorita settejä joissa on merkkejä",
		"starts_with_character": "Suorita sanoja jotka alkavat merkillä",
		"starts_with_glyphs": "Suorita settejä jotka alkavat merkillä:",
		"enemy_drone_title": "Drooni",
		"enemy_shieldDrone_title": "Kilpidrooni",
		"enemy_stalker_title": "Vaanija",
		"enemy_shooter_title": "Ampuja",
		"enemy_splitter_title": "Jakautuja",
		"enemy_warder_title": "Suojelija",
		"enemy_swarmer_title": "Laumoittaija",
		"enemy_drone_desc": "Droonit ovat vihollisia, jotka tarmokkaasti pyrkivät sinun pääasettasi kohti. Ajoittain ne ilmenevät voimakkaammissa muodoissa:<br>Jätti: Kolminkertainen kesto, joka tekee niistä vaikeampia tuhota.<br>Huippunopea: Tuplaa niiden nopeuden, joten ne täytyy tuhota kiireellisesti.",
		"enemy_shieldDrone_desc": "Kilpidrooni on droonin variaatio jolla on itsestäänparaneva kilpi. Sillä on kahdet kestopisteet: Ylämpi on sen kilpi, joka alkaa paranemaan jos se ei ota hetkeen vahinkoa.",
		"enemy_stalker_desc": "Vaanija on droonin variaatio, jonka kirjaimista osa on aluksi piilossa. Kun kirjoitat sanaa niin se alkaa hitaasti paljastua, joka vaatii tarkkuutta ja nopeaa kirjoittamista sen tuhoamiseksi.",
		"enemy_shooter_desc": "Ampuja on vihollinen joka vaanii tason laitamilla ja ampuu jatkuvasti kestäviä ammuksia sinun pääasettasi kohti kunnes se tuhoutuu.",
		"enemy_splitter_desc": "Jakautuja aluksi ilmenee yksittäisenä vihollisena mutta se on muodostunut monesta osasta. Kun yksi osa tuhoutuu, jakautuja hajoaa eri osiin joista muodostuu uusia yksittäisiä vihollisia.",
		"enemy_warder_desc": "Suojelija on eliitti vihollinen, joka ilmenee pelin loppu puolella. Sillä on pyörivä kilpi, joka suojelee sitä kilven suunnasta tulevia ammuksia vastaan. Kun Suojelija on elossa se myös suojelee muita lähellä olevia vihollisia, jotka eivät voi kuolla niin kauan kuin Suojelija on elossa.",
		"enemy_swarmer_desc": "Laumoittaja on eliitti vihollinen, joka ajoittain laukaisee lauman pienempiä vihollisia pääasettasi kohti. Se jatkaa kunnes se on tuhottu.",
