		"boss_poet": "Runoilija",
		"boss_poet_desc": "Kirjoita pomon vaatima teksti\nVoit tappaa myös vihollisia sen aikana.",
		"boss_cypher": "Salakirjoittaja",
		"boss_cypher_desc": "Tämä pomo sekoittaa kirjamia sen lähellä.\nTuhoa se aseillasi.",
		"boss_cerberus": "Kerberus",
		"boss_cerberus_desc": "Tämä pomo ampuu tuhottavia ammuksia sinua kohti.\nTuhoa kaikki kolme päätä aseillasi.",
		"boss_jormungandr": "Maailmankäärme",
		"boss_jormungandr_desc": "Tämä pomo ympäröi sinua loputtomasti.\nAjoita ammuksesi osumaan sen tielllä oleviin kohteisiin.",
		"boss_gemini": "Kaksonen",
		"boss_gemini_desc": "Vahingoita kaksosia yhtä paljon.\nNe parantavat toisiaan omaan maksimi kestoonsa saakka.",
		"weapon_repeater_title": "Toistaja",
