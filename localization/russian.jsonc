		"overmind_syncronization_desc": "{1} Шанс критического урона, {2} Мультипликатор критического урона",
		"boss_poet": "Поэт",
		"boss_poet_desc": "Наберите отрывок, представленный боссом.\nВы можете продолжать атаковать врагов, пока делаете это.",
		"boss_cypher": "Шифровальщик",
		"boss_cypher_desc": "Этот босс перемешивает буквы у ближайших слов.\nУничтожьте его своим оружием.",
		"boss_cerberus": "Цербер",
		"boss_cerberus_desc": "Этот босс стреляет разрушаемыми снарядами в вас.\nСнесите все три головы своим оружием.",
		"boss_jormungandr": "Ёрмунганд",
		"boss_jormungandr_desc": "Этот босс бесконечно кружит вокруг вас.\nСинхронизируйте выстрелы по фиксированным целям на его пути, чтобы поразить его оружием.",
		"boss_gemini": "Близнецы",
		"boss_gemini_desc": "Наносите урон обоим близнецам равномерно.\nСо временем они будут исцелять друг друга до своего собственного уровня здоровья.",
		"weapon_repeater_title": "Повторитель",
		"weapon_heatray_title": "Тепловой луч",
		"weapon_barrage_title": "Шквал",
		"weapon_overmind_title": "Сверхразум",
		"weapon_splattershot_title": "Брызгострел",
		"weapon_wildcard_title": "Джокер",
		"weapon_spectre_title": "Призрак",
		"weapon_tesla_title": "Мина Теслы",
		"weapon_sentry_title": "Сторож",
		"weapon_oscillator_title": "Осциллятор",
		"weapon_meteor_title": "Метеор",
		"weapon_hunter_title": "Охотник",
		"weapon_chopper_title": "Дробилка",
		"weapon_minefield_title": "Минное поле",
		"weapon_blade_title": "Ловушка-лезвие",
		"weapon_firestorm_title": "Огненный шторм",
		"weapon_guardian_title": "Страж",
		"weapon_orbiter_title": "Орбитер",
		"weapon_frostbite_title": "Обморожение",
		"weapon_bleeding_title": "Кровотечение",
		"weapon_blight_title": "Порча",
		"weapon_static_title": "Статика",
		"weapon_ignite_title": "Поджог",
		"weapon_heatray_requirements": "Пройдите испытания Повторителя на любом уровне Знамения.",
		"weapon_barrage_requirements": "Пройдите испытания на уровне Знамения 3 с любым основным оружием.",
		"weapon_repeater_desc": "Опустошающее оружие, стреляющее сериями пуль короткими очередями.",
		"weapon_heatray_desc": "Выпускает постоянный луч невероятно точного концентрированного света, наносящий урон периодического действия.",
		"weapon_barrage_desc": "Выпускает залп взрывающихся ракет по цели и её окружению. Перезаряжается со временем.",
		"weapon_overmind_desc": "Командуйте отрядом дронов, обрушивающих разрушение на ваших врагов.",
		"weapon_splattershot_desc": "Стреляйте комками слизи по противникам, чтобы ослабить и повредить их.",
		"weapon_wildcard_desc": "Ваш следующий выстрел случайно выбирается из четырёх возможных видов оружия, так что стреляйте осторожно.",
		"weapon_spectre_desc": "Порождает быстрых дронов ближнего боя в количестве, соответствующем указанному выше.",
		"weapon_sentry_desc": "Разворачивает автоматическую турель, которая стреляет по любому врагу, оказавшемуся в радиусе действия.",
		"weapon_tesla_desc": "Разворачивает электрическую турель, наносящую урон периодического действия.",
		"weapon_oscillator_desc": "Выпускает колеблющийся поток частиц в направлении вашей последней цели.",
		"weapon_meteor_desc": "Периодически создаёт метки целей в случайных местах, которые можно активировать для начала орбитальной бомбардировки.",
		"weapon_hunter_desc": "Порождает дронов, стреляющих электрическими лучами, в количестве, соответствующем указанному выше.",
		"weapon_chopper_desc": "При выстреле из главного оружия появляется гигантское вращающееся лезвие, которое движется к краю экрана, нанося урон всем врагам на своём пути.",
		"weapon_minefield_desc": "Создаёт медленно движущиеся мины, которые взрываются при контакте с врагами.",
		"weapon_blade_desc": "Разворачивает вращающуюся четырёхлопастную ловушку-лезвие.",
		"weapon_firestorm_desc": "Пушка, стреляющая шквалом короткодействующих взрывных снарядов. Кружит вокруг основной турели и требует перезарядки перед новым выстрелом.",
		"weapon_guardian_desc": "Мгновенно разворачивает Дрона, стреляющего лазерами по врагам. Активируйте топливные контейнеры, чтобы пополнить запас Стража, который расходует топливо и деактивируется, когда оно заканчивается.",
		"weapon_orbiter_desc": "Разворачивает сферу, вращающуюся вокруг Главного оружия, нанося урон всему на своём пути.",
		"weapon_frostbite_desc": "Эффект лута – не считается оружием.\n\nВраги получают урон периодического действия, находясь в заморозке.",
		"weapon_bleeding_desc": "Эффект статуса – не считается оружием.\n\nВраги получают Кинетический урон периодического действия, пока эффект не истечёт.",
		"weapon_blight_desc": "Эффект статуса – не считается оружием.\n\nВраги получают Химический урон периодического действия и замедляются, пока эффект не истечёт.",
		"weapon_static_desc": "Эффект статуса – не считается оружием.\n\nВраги получают Энергетический урон периодического действия и наносят энергетический урон ближайшим врагам, пока эффект не истечёт.",
		"weapon_ignite_desc": "Эффект статуса – не считается оружием.\n\nВраги получают Тепловой урон периодического действия, пока эффект не истечёт.",
		"weapon_caltrops_desc": "Эффект улучшения – не считается оружием.\n\nПри критическом попадании дистанционного оружия создаются 12 шипов, наносящих урон проходящим врагам.",
		"weapon_stormBattery_desc": "Эффект улучшения – не считается оружием.\n\nГлавная Турель наносит Электрический урон ближайшим врагам. Каждое экипированное Электрическое оружие увеличивает базовый урон.",
		"weapon_lightningSparks_desc": "Эффект улучшения – не считается оружием.\n\nПри критическом попадании Электрического оружия выпускается 6 Искр молнии, урон которых зависит от шанса критического урона и множителя критического урона.",
		"weapon_darkRelay_desc": "Эффект улучшения – не считается оружием.\n\nСнаряд случайным образом отскакивает между существующими турелями, нанося электрический урон.",
		"weapon_jester_desc": "Эффект лута – не считается оружием.\n\nПри поднятии Переброса наносится случайное количество урона от 0 до 100 всем врагам на экране.",
		"weapon_necrobomb_desc": "Эффект лута – не считается оружием.\n\nПри уничтожении врага Взрывным критическим уроном запускается серия взрывов вокруг позиции павшего врага.",
		"weapon_release_desc": "Эффект лута – не считается оружием.\n\nПри ошибке набора наносит {1} Взрывного урона всем врагам за каждые x{2} Идеальных вводов.",
		"weapon_retribution_desc": "Эффект улучшения – не считается оружием.\n\nКаждый раз, когда Щит уничтожается, все существующие Дроны самоуничтожаются, нанося взрывной урон.",
		"weapon_fireball_desc": "Эффект улучшения – не считается оружием.\n\nВыстрел из Главного оружия также выпускает медленно движущийся Огненный шар, наносящий Урон от жара.",
		"contains_characters": "Завершение слов, содержащих глифы",
		"contains_glyphs": "Завершение сетов, содержащих глифы",
		"starts_with_character": "Завершение слов, начинающихся с глифов",
		"starts_with_glyphs": "Завершение сетов, начинающихся с глифов:",
		"enemy_drone_title": "Дрон",
		"enemy_shieldDrone_title": "Дрон-щит",
		"enemy_stalker_title": "Сталкер",
		"enemy_shooter_title": "Стрелок",
		"enemy_splitter_title": "Разделитель",
		"enemy_warder_title": "Хранитель",
		"enemy_swarmer_title": "Роевой",
		"enemy_drone_desc": "Дроны – это враги, которые неустанно движутся к вашему основному оружию. Иногда они могут появляться в двух усиленных формах:<br>Увеличенные: их здоровье утроено, что делает их сложнее для уничтожения.<br>Ускоренные: их скорость движения удвоена, что повышает срочность их ликвидации.",
		"enemy_shieldDrone_desc": "Дрон-щит — это вариант врага-дрона с восстанавливающимся щитом. У него две полосы здоровья: верхняя отображает щит, который начинает восстанавливаться, если по нему не наносят урон в течение определённого времени.",
		"enemy_stalker_desc": "Преследователь — это вариант врага-дрона, который изначально появляется с почти полностью скрытым словом. По мере ввода слово постепенно раскрывается, требуя внимательности и быстрой печати для уничтожения.",
		"enemy_shooter_desc": "Стрелок — это враг, который останавливается на краю уровня и непрерывно стреляет прочными снарядами по вашему основному оружию, пока не будет уничтожен.",
		"enemy_splitter_desc": "Разделитель изначально появляется как один враг, но на самом деле состоит из нескольких частей. Когда одна часть уничтожена, Разделитель теряет целостность, и его компоненты распадаются, становясь отдельными врагами.",
		"enemy_warder_desc": "Хранитель — это элитный враг, появляющийся на поздних этапах игры. У него есть вращающийся щит, блокирующий урон с той стороны, куда он повернут. Кроме того, пока Хранитель жив, он создаёт защитную ауру для ближайших врагов, делая их неуязвимыми, пока Хранитель не будет повержен.",
		"enemy_swarmer_desc": "Роевой — это элитный враг, который периодически запускает группы мелких врагов к основному оружию. Он продолжает делать это, пока не будет уничтожен.",
		"main_upgrade_health_common": "Подкрепление",
