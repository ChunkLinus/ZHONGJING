		"level_up_heal": "Малое исцеление",
		"level_up_heal_desc": "Восстанавливает небольшое количество здоровья",
		"evo_repeater_frostFang": "Морозный клык",
		"evo_repeater_frostFang_desc": "Эффекты:\n Холодный урон: {1}\n Шанс заморозки: {2}\n\nВлияет на базовый урон и модификаторы холодного урона.",
		"evo_repeater_frostFang_2": "Морозный клык II",
		"evo_repeater_frostFang_2_desc": "Эффекты:\n Холодный урон: {1}\n Кинетический урон: {2}\n\nВлияет на базовый урон.",
		"evo_repeater_ricochet": "Рикошет",
		"evo_repeater_ricochet_desc": "Эффекты:\n Цепочка снарядов: {1}\n\nСнаряды Повторителя рикошетят по случайным ближайшим целям, нанося {2} урона при попаданиях после первого.",
		"evo_repeater_ricochet_2": "Рикошет II",
		"evo_repeater_ricochet_2_desc": "Эффекты:\n Цепочка снарядов: {1}",
		"evo_repeater_shotgun": "Дробовик",
		"evo_repeater_shotgun_desc": "Эффекты:\n Количество снарядов: {1}\n Разброс снарядов: {2}\n Кинетический урон: {3}\n\nПовторитель теперь стреляет кластером более слабых снарядов с большим разбросом. Модификатор урона влияет на базовый урон.",
		"evo_repeater_shotgun_2": "Дробовик II",
		"evo_repeater_shotgun_2_desc": "Эффекты:\n Количество снарядов: {1}\n Разброс снарядов: {2}",
		"evo_repeater_explodingBullets": "Взрывные пули",
		"evo_repeater_explodingBullets_desc": "Эффекты:\n Взрывной урон: {1}\n Кинетический урон: {2}\n\nВлияет на базовый урон. Повторитель теперь использует взрывные боеприпасы, наносящие взрывной урон в небольшом радиусе.",
		"evo_repeater_explodingBullets_2": "Взрывные пули II",
		"evo_repeater_explodingBullets_2_desc": "Эффекты:\n Взрывной урон: {1}\n Кинетический урон: {2}\n\nБазовый радиус взрыва для пуль Повторителя немного увеличен.",
		"evo_heatray_iceBeam": "Ледяной луч",
		"evo_heatray_iceBeam_desc": "Эффекты:\n Тепловой урон: {1}\n Холодный урон: {2}\n Шанс заморозки: {3}\n\nВлияет на базовый урон. Тип урона Теплового луча станет Холодным с повышенным шансом заморозки.",
		"evo_heatray_iceBeam_2": "Ледяной луч II",
		"evo_heatray_iceBeam_2_desc": "Эффекты:\n Холодный урон: {1}\n\nВлияет на базовый урон.",
		"evo_heatray_reflection": "Отражение",
		"evo_heatray_reflection_desc_2": "Тепловой луч теперь проходит сквозь врагов и отражается {1} от края экрана.",
		"evo_heatray_reflection_2": "Отражение II",
		"evo_heatray_reflection_2_desc_2": "Тепловой луч теперь отражается {1} от края экрана.",
		"evo_heatray_doubleBladed": "Двойное лезвие",
		"evo_heatray_doubleBladed_desc": "Ещё один луч стреляет в противоположном направлении. Все эволюции и улучшения применяются к обоим лучам.",
		"evo_heatray_blaster": "Бластер",
		"evo_heatray_blaster_desc": "Эффекты:\n Скорострельность: {1}\n\nТепловой луч теперь стреляет независимым, многоразовым лазерным снарядом вместо постоянного луча, при этом оставаясь оружием периодического урона.",
		"evo_heatray_blaster_2": "Бластер II",
		"evo_heatray_blaster_2_desc": "Эффекты:\n Длина снаряда: {1}\n Урон: {2}",
		"evo_heatray_solar_tap": "Солнечный отвод",
		"evo_heatray_solar_tap_desc": "Глобальный эффект:\n  Все тепловые эффекты/Оружие:\n    Шанс эффекта статуса: {1}",
		"evo_barrage_rocketArray": "Ракетная батарея",
		"evo_barrage_rocketArray_desc": "Шквал теперь стреляет {1} ракетами за один боезапас вместо {2}.",
		"evo_barrage_rocketArray_2": "Ракетная батарея II",
		"evo_barrage_seismicMunition": "Сейсмический боеприпас",
		"evo_barrage_seismicMunition_desc": "Ракеты вонзаются в землю вместо взрыва и создают взрывные импульсы в течение следующих нескольких секунд.",
		"evo_barrage_seismicMunition_2": "Сейсмический боеприпас II",
		"evo_barrage_seismicMunition_2_desc": "Эффекты:\n Дальность: {1}\n Длительность: {2}",
		"evo_barrage_resupply": "Пополнение",
		"evo_barrage_resupply_desc": "Теперь будут появляться припасы. Активация этих припасов полностью перезарядит ваше основное оружие и даст {1} бонус урона к следующему выстрелу.",
		"evo_barrage_resupply_2": "Пополнение II",
		"evo_barrage_resupply_2_desc": "Теперь припасы также дают {1} бонус к радиусу взрыва следующего выстрела.",
		"evo_barrage_resupply_pickup": "Максимальный боезапас!",
		"evo_barrage_total_saturation": "Общее насыщение",
		"evo_barrage_total_saturation_desc": "Глобальный эффект:\n  Все взрывные эффекты/Оружие:\n    Урон: {1}",
		"evo_splattershot_bubble": "Слизистый пузырь",
		"evo_splattershot_bubble_desc": "Слизистые пузыри появляются в Зонах брызг.\n\nПри активации Слизистые пузыри лопаются, нанося урон в небольшом радиусе и создавая дополнительные Зоны брызг.",
		"evo_splattershot_bubble_2": "Слизистый пузырь II",
		"evo_splattershot_bubble_2_desc": "Увеличена частота появления Слизистых пузырей.\n\nСлизистые пузыри имеют 50% шанс автоматически лопнуть по истечении времени.",
		"evo_splattershot_infestation": "Заражение",
		"evo_splattershot_infestation_desc": "Эффекты выстрела брызг:\n Шанс эффекта статуса: {1}\n\nГлобальные эффекты:\n Урон от эффектов статуса: {2}",
		"evo_splattershot_infestation_2": "Заражение II",
		"evo_splattershot_infestation_2_desc": "Враги, убитые эффектами статуса, взрываются, создавая Зоны брызг.",
		"evo_splattershot_lava": "Лава",
		"evo_splattershot_lava_desc": "Эффекты:\n Химический урон: {1}\n Тепловой урон: {2}\n\nВлияет на базовый урон. Тип урона выстрела брызг станет Тепловым.",
		"evo_splattershot_lava_2": "Лава II",
		"evo_splattershot_lava_2_desc": "Эффекты:\n Тепловой урон: {1}\n\nВлияет на базовый урон.",
		"evo_splattershot_virulence": "Вирулентность",
		"evo_splattershot_virulence_desc": "Эффекты Зоны брызг:\n Длительность: {1}\n\nЗоны брызг медленно увеличиваются со временем.",
		"evo_splattershot_chemical_catalyst": "Химический катализатор",
		"evo_splattershot_chemical_catalyst_desc": "Глобальный эффект:\n  Все химические эффекты/Оружие:\n    Продолжительность: {1}",
		"evo_overmind_syncronize": "Синхронизация",
		"evo_overmind_syncronize_desc": "Каждое убийство с помощью Сверхразума дает {1} шанс добавить +1 убийство к прогрессу эволюции случайного дронового оружия.",
		"evo_overmind_syncronize_2": "Синхронизация II",
		"evo_overmind_syncronize_2_desc": "Шанс добавить +1 убийство к прогрессу эволюции случайного дронового оружия увеличен до {1}.",
		"evo_overmind_shockSpire": "Ударный шпиль",
		"evo_overmind_shockSpire_desc": "Каждые 3 одновременно выбранных врага порождают между собой ударный шпиль.\n\nУдарные шпили периодически испускают электрические импульсы, которые проходят по всему экрану и наносят электрический урон.",
		"evo_overmind_shockSpire_2": "Ударный шпиль II",
		"evo_overmind_shockSpire_2_desc": "Воздействие:\n  Ударные шпили:\n    Урон: {1}\n    Продолжительность: {2}",
		"evo_overmind_burningOnes": "Пылающие",
		"evo_overmind_burningOnes_desc": "Ввод слов заряжает шкалу, которая при заполнении порождает взрывные дроны. \n\nДроны наводятся на врагов и взрываются при контакте, нанося взрывной урон в небольшом радиусе.",
		"evo_overmind_burningOnes_2": "Пылающие II",
		"evo_overmind_burningOnes_2_desc": "Воздействие:\n  Пылающие: {1}\n  Взрывной урон: {1}\n  Радиус взрыва: {2}",
		"evo_overmind_burningOnes_charge": "Накопление тепла",
		"evo_overmind_burningOnes_charge_desc": "Термическая перегрузка: {1}%",
		"evo_overmind_null_field": "Нулевое поле",
		"evo_overmind_null_field_desc": "Враги, на которых нацелен Сверхразум, замедляются и получают {1} урона от других электрических воздействий и оружия.",
		"evo_overmind_null_field_2": "Нулевое поле II",
		"evo_overmind_null_field_2_desc": "Враги, на которых нацелен Сверхразум, также подвергаются статическому воздействию, пока находятся под прицелом.",
		"evo_wildcard_winter": "Зима",
		"evo_wildcard_winter_desc": "Джокер больше не будет стрелять тепловыми снарядами.\n\nГлобальный эффект:\n  Все холодные эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_winter_2": "Зима II",
		"evo_wildcard_winter_2_desc": "Глобальный эффект:\n  Все холодные эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_warmth": "Тепло",
		"evo_wildcard_warmth_desc": "Джокер больше не будет стрелять холодными снарядами.\n\nГлобальный эффект:\n  Все тепловые эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_warmth_2": "Тепло II",
		"evo_wildcard_warmth_2_desc": "Глобальный эффект:\n  Все тепловые эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_repulsor": "Репульсор",
		"evo_wildcard_repulsor_desc": "Джокер больше не будет стрелять кинетическими снарядами.\n\nГлобальный эффект:\n  Все электрические эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_repulsor_2": "Репульсор II",
		"evo_wildcard_repulsor_2_desc": "Глобальный эффект:\n  Все электрические эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_diamond": "Алмаз",
		"evo_wildcard_diamond_desc": "Джокер больше не будет стрелять электрическими снарядами.\n\nГлобальный эффект:\n  Все кинетические эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_diamond_2": "Алмаз II",
		"evo_wildcard_diamond_2_desc": "Глобальный эффект:\n  Все кинетические эффекты/Оружие:\n    Урон: {1}",
		"evo_wildcard_fragmentation": "Фрагментация",
		"evo_wildcard_fragmentation_desc": "Когда кинетические снаряды попадают в тепловые шары, это вызывает тепловые взрывы.\n\nКогда кинетические снаряды попадают во врагов, замороженных холодными снарядами, это вызывает холодные взрывы.",
		"evo_wildcard_fragmentation_2": "Фрагментация II",
		"evo_wildcard_fragmentation_2_desc": "Когда кинетические снаряды попадают во врагов, это вызывает кинетические взрывы.",
		"evo_wildcard_conduit": "Проводник",
		"evo_wildcard_conduit_desc": "В пределах досягаемости электрических снарядов, тепловые шары и враги, замороженные холодными снарядами, наносят электрический урон врагам, находящимся рядом с ними.",
		"evo_wildcard_conduit_2": "Проводник II",
		"evo_wildcard_conduit_2_desc": "Тепловые шары и враги, замороженные холодными снарядами, всегда наносят электрический урон врагам, находящимся рядом с ними.",
		"evo_wildcard_pestilence": "Эпидемия",
		"evo_wildcard_pestilence_desc": "Джокер:\n  Все статусные эффекты:\n    Шанс: {1}",
		"evo_wildcard_pestilence_2": "Эпидемия",
		"evo_wildcard_pestilence_2_desc": "Глобальный эффект:\n  Все статусные эффекты:\n    Урон: {1}",
		"evo_guardian_toxicWard": "Токсичный барьер",
		"evo_guardian_toxicWard_desc": "Эффекты:\n Тепловой урон: {1}\n Химический урон: {2}\n\nВлияет на базовый урон. Тип урона Стража станет Химическим.",
		"evo_guardian_toxicWard_2": "Токсичный барьер II",
		"evo_guardian_toxicWard_2_desc": "Эффекты:\n Химический урон: {1}\n\nВлияет на базовый урон.",
		"evo_guardian_experimentalFuel": "Экспериментальное топливо",
		"evo_guardian_experimentalFuel_desc": "Будут появляться специальные топливные контейнеры, дающие Стражу временные бонусы. Одновременно может быть активен только один бонус.",
		"evo_guardian_experimentalFuel_2": "Экспериментальное топливо II",
		"evo_guardian_experimentalFuel_2_desc": "Все бонусы специального топлива {1} и увеличивают длительность на {2}.",
		"evo_guardian_experimentalFuel_damage": "Экспериментальное топливо: Урон",
		"evo_guardian_experimentalFuel_speed": "Экспериментальное топливо: Скорость",
		"evo_guardian_experimentalFuel_range": "Экспериментальное топливо: Дальность",
		"evo_guardian_guardianTeam": "Команда Стражей",
		"evo_guardian_guardianTeam_desc": "Эффекты:\n Урон: {1}\n Дроны: {2}\n\nТеперь Страж — это два дрона вместо одного.",
		"evo_guardian_guardianTeam_2": "Команда Стражей II",
		"evo_guardian_guardianTeam_2_desc": "Эффекты:\n Урон: {1}\n Дроны: {2}\n\nТеперь Страж — это три дрона вместо двух.",
		"evo_blade_bladeRepository": "Хранилище клинков",
		"evo_blade_bladeRepository_2": "Хранилище клинков II",
		"evo_blade_bladeRepository_desc": "теперь также создаёт Ловушку-лезвие в дополнение к существующим глифам.",
		"evo_blade_poisonCoating": "Ядовитое покрытие",
		"evo_blade_poisonCoating_desc": "Эффекты:\n Химический урон: {1}\n Шанс порчи: {2}\n\nВлияет на базовый урон и модификаторы химического урона.",
		"evo_blade_poisonCoating_2": "Ядовитое покрытие II",
		"evo_blade_poisonCoating_2_desc": "Эффекты:\n Химический урон: {1}\n Шанс порчи: {2}\n\nВлияет на базовый урон.",
		"evo_blade_sawtoothBlade": "Зазубренные клинки",
		"evo_blade_sawtoothBlade_desc": "Ловушки-лезвия добавляют свой шанс критического урона к шансу наложить Кровотечение.",
		"evo_blade_sawtoothBlade_2": "Зазубренные клинки II",
		"evo_blade_sawtoothBlade_2_desc": "Урон от кровотечения увеличен на {1}. Применяется к кровотечению от всех источников и влияет на базовый урон.",
		"evo_blade_cutting_edge": "Остриё",
		"evo_blade_cutting_edge_desc": "Глобальный эффект:\n  Все эффекты турелей/Оружие:\n    Шанс критического урона: {1}",
		"evo_hunter_hunterElite": "Элитный охотник",
		"evo_hunter_hunterElite_desc": "Каждый 12-й Охотник становится Элитным охотником.\n\nЭлитные охотники:\n +100% Урон\n +50% Длительность\n +50% Скорость\n +50% Дальность",
		"evo_hunter_hunterElite_2": "Элитный охотник II",
		"evo_hunter_hunterElite_2_desc": "Элитные охотники появляются на каждом 10-м Охотнике.\n\nЭлитные охотники:\n +50% Длительность",
		"evo_hunter_electrifiedBolts": "Электрифицированные болты",
		"evo_hunter_electrifiedBolts_desc": "Эффект:\n  Кинетический урон: {1}\n  Электрический урон: {2}\n\nОхотники теперь стреляют снарядами вместо электрических разрядов и они считаются кинетическим оружием.",
		"evo_hunter_electrifiedBolts_2": "Электрифицированные болты II",
		"evo_hunter_electrifiedBolts_2_desc": "Эффекты:\n  Кинетический урон: {1}\n\nГлобальный эффект:\n  Все кинетические эффекты/Оружие:\n    Урон: {2}",
		"evo_hunter_chainLightning": "Цепная молния",
		"evo_hunter_chainLightning_desc": "Атаки Охотника теперь цепляются к 1 дополнительному ближайшему врагу.",
		"evo_hunter_chainLightning_2": "Цепная молния II",
		"evo_hunter_chainLightning_2_desc": "Атаки Охотника теперь цепляются к 2 дополнительным ближайшим врагам.",
		"evo_hunter_predator_strain": "Штамм «Хищник»",
		"evo_hunter_predator_strain_desc": "Глобальный эффект:\n  Все дроновые эффекты/оружие:\n    Продолжительность: {1}",
		"evo_minefield_mineLayer": "Минный заградитель",
		"evo_minefield_mineLayer_2": "Минный заградитель II",
		"evo_minefield_mineLayer_desc": "теперь также создаёт Мины в дополнение к существующим глифам.",
		"evo_minefield_infusion": "Инфузия",
		"evo_minefield_infusion_desc": "Эффект:\n  Химический урон: {1}\n  Взрывной урон: {2}\n\nМинное поле теперь наносит химический урон вместо взрывного и считается химическим оружием.",
		"evo_minefield_infusion_2": "Инфузия II",
		"evo_minefield_infusion_2_desc": "Эффекты:\n  Химический урон: {1}\n  Шанс порчи: {2}\n\nГлобальный эффект:\n  Все химические эффекты/Оружие:\n    Урон: {3}",
		"evo_minefield_hunterSeeker": "Охотник-искатель",
		"evo_minefield_hunterSeeker_desc": "Эффекты:\n Скорость: {1}\n Дальность: {2}\n\nМины получают самонаведение на случайные цели.",
		"evo_minefield_hunterSeeker_2": "Охотник-искатель II",
		"evo_minefield_hunterSeeker_2_desc": "Эффекты:\n Мин создано: {1}\n Скорость: {2}",
		"evo_minefield_dirtyBomb": "Грязная бомба",
		"evo_minefield_dirtyBomb_desc": "Эффекты:\n Химический урон: {1}\n Урон Слиземёта: {2}\n\nМины выпускают 3 лужи слизи при взрыве.",
		"evo_minefield_dirtyBomb_2": "Грязная бомба II",
		"evo_minefield_dirtyBomb_2_desc": "Эффекты:\n Химический урон: {1}\n Урон Слиземёта: {2}\n\nВо время движения мины периодически выпускают лужу слизи.",
		"evo_minefield_recursiveMines": "Рекурсивные мины",
		"evo_minefield_recursiveMines_desc": "Главная турель периодически создаёт количество мин, равное половине количества мин Минного поля, округлённого вниз. Скорость появления определяется характеристикой скорострельности Минного поля.",
		"evo_minefield_recursiveMines_2": "Рекурсивные мины II",
		"evo_minefield_recursiveMines_2_desc": "Рекурсивные мины появляются на {1} быстрее и создают одну дополнительную мину.",
		"evo_sentry_defenseGrid": "Сетевой щит",
		"evo_sentry_defenseGrid_2": "Сетевой щит II",
		"evo_sentry_defenseGrid_desc": "Эффекты:\n Турель: +1",
		"evo_sentry_solidCore": "Твёрдое ядро",
		"evo_sentry_solidCore_desc": "Эффекты:\n Кинетический урон: {1}\n Шанс кровотечения: {2}\n\nВлияет на базовый урон и модификаторы кинетического урона.",
		"evo_sentry_solidCore_2": "Твёрдое ядро II",
		"evo_sentry_solidCore_2_desc": "Эффекты:\n Кинетический урон: {1}\n Тепловой урон: {2}\n\nВлияет на базовый урон.",
		"evo_sentry_watcher_supreme": "Верховный наблюдатель",
		"evo_sentry_watcher_supreme_desc": "Глобальное воздействие:\n  Всё воздействие турелей/оружия:\n    Дальность: {1}",
		"evo_sentry_emergencyProtocol": "Аварийный протокол",
		"evo_sentry_emergencyProtocol_desc": "Каждый раз, когда уничтожается усиление Щита, Сторож переходит в режим Аварийного протокола на {1} секунд.\n\nВо время Аварийного протокола:\n Дальность: {2}\n Скорострельность: {3}",
		"evo_sentry_emergencyProtocol_2": "Аварийный протокол",
		"evo_sentry_emergencyProtocol_2_desc": "Во время Аварийного протокола:\n Урон: {1}\n Скорость вращения: {2}",
		"evo_spectre_supercharged": "Суперзаряд",
		"evo_spectre_supercharged_desc": "Каждый 20-й Призрак становится СУПЕР Призраком.\n\nСупер Призраки:\n +100% Урон\n +50% Длительность\n +50% Скорость",
		"evo_spectre_selfDestruct": "Самоуничтожение",
		"evo_spectre_selfDestruct_desc": "Эффекты:\n Взрывной урон: {1}\n\nКогда действие Призрака истекает, он самоуничтожается, нанося взрывной урон. Влияет на базовый урон и модификаторы взрывного урона.",
		"evo_spectre_selfDestruct_2": "Самоуничтожение II",
		"evo_spectre_selfDestruct_2_desc": "Эффекты:\n Взрывной урон: {1}\n Дальность: {2}\n\nВлияет на базовый урон.",
		"evo_spectre_volatileFuel": "Летучее топливо",
		"evo_spectre_volatileFuel_desc": "Эффекты:\n Скорость: {1}",
		"evo_spectre_volatileFuel_2": "Летучее топливо II",
		"evo_spectre_volatileFuel_2_desc": "Эффекты:\n Скорость: {1}\n Длительность: {2}",
		"evo_spectre_stalking_algorithms": "Алгоритмы слежения",
		"evo_spectre_stalking_algorithms_desc": "Глобальный эффект:\n  Все дроновые эффекты/оружие:\n    Скорость: {1}",
		"evo_tesla_abundantCoils": "Избыточные катушки",
		"evo_tesla_abundantCoils_2": "Избыточные катушки II",
		"evo_tesla_abundantCoils_desc": "теперь также создают Минy Теслы в дополнение к существующим глифам.",
		"evo_tesla_electricalBurn": "Электрический ожог",
		"evo_tesla_electricalBurn_desc": "Эффект:\n  Тепловой урон: {1}\n  Электрический урон: {2}\n\nТеперь Мина Теслы наносит тепловой урон вместо электрического и считается тепловым оружием.",
		"evo_tesla_electricalBurn_2": "Электрический ожог II",
		"evo_tesla_electricalBurn_2_desc": "Эффекты:\n  Тепловой урон: {1}\n\nГлобальный эффект:\n  Все тепловые эффекты/Оружие:\n    Урон: {2}",
		"evo_tesla_restrictedArea": "Закрытая зона",
		"evo_tesla_restrictedArea_desc": "Враги в радиусе Мин Теслы имеют {1} повышенный шанс получить статус Статики от источников электрического урона.",
		"evo_tesla_restrictedArea_2": "Закрытая зона II",
		"evo_tesla_restrictedArea_2_desc": "Урон статики увеличен на {1}, а дальность увеличена на {2}. Применяется к статике от всех источников и влияет на базовый урон.",
		"evo_tesla_storm_sovereign": "Повелитель бури",
		"evo_tesla_storm_sovereign_desc": "Глобальный эффект:\n  Все эффекты турелей/оружие:\n    Скорость стрельбы: {1}",
		"evo_chopper_dualWield": "Двойное оружие",
		"evo_chopper_dualWield_desc": "Эффект:\n +1 Дрон-косилка",
		"evo_chopper_flamingBlades": "Пылающие клинки",
		"evo_chopper_flamingBlades_desc": "Эффект:\n  Кинетический урон: {1}\n  Тепловой урон: {2}\n\nТеперь Дробилка наносит тепловой урон вместо кинетического и считается тепловым оружием.",
		"evo_chopper_flamingBlades_2": "Пылающие клинки II",
		"evo_chopper_flamingBlades_2_desc": "Эффекты:\n  Тепловой урон: {1}\n\nГлобальный эффект:\n  Все тепловые эффекты/Оружие:\n    Урон: {2}",
		"evo_chopper_boomerang": "Бумеранг",
		"evo_chopper_boomerang_desc": "Дробилка теперь возвращается к Главному оружию после достижения края экрана.",
		"evo_chopper_boomerang_2": "Бумеранг II",
		"evo_chopper_boomerang_2_desc": "Эффекты:\n Скорость: {1}\n Скорострельность: {2}",
		"evo_chopper_sawLauncher": "Устройство для запуска пилы",
		"evo_chopper_sawLauncher_desc": "Эффекты:\n Шанс Кровотечения: {1}\n Урон от Кровотечения: {2}\n Шанс Кровотечения Повторителя: {3}\n\nДробилка заменяется двумя меньшими пилами с высокой скоростью атаки, запускаемыми по траектории в виде конуса.",
		"evo_chopper_sawLauncher_2": "Устройство для запуска пилы II",
		"evo_chopper_sawLauncher_2_desc": "Эффекты:\n Шанс Кровотечения: {1}\n Урон от Кровотечения: {2}\n Шанс Кровотечения Повторителя: {3}\n\nУвеличивает количество выпускаемых пил на 2.",
		"evo_chopper_bloodbath": "Кровавая Баня",
		"evo_chopper_bloodbath_desc": "Эффекты:\n Урон по врагам с Кровотечением: {1}\n\nВраги с Кровотечением, убитые Дробилкой, имеют {2} шанс активировать Двойной Урон.",
		"evo_chopper_bloodbath_2": "Кровавая Баня II",
		"evo_chopper_bloodbath_2_desc": "Эффекты:\n Урон по врагам с Кровотечением: {1}\n\nШанс активации Двойного Урона увеличен до {2}.",
		"evo_meteor_surveillance": "Наблюдение",
		"evo_meteor_surveillance_desc": "Метеор теперь получает две цели вместо одной.",
		"evo_meteor_surveillance_2": "Наблюдение II",
		"evo_meteor_surveillance_2_desc": "Метеор получает три цели вместо двух.",
		"evo_meteor_iceRain": "Ледяной дождь",
		"evo_meteor_iceRain_desc": "Эффект:\n  Урон от холода: {1}\n  Взрывной урон: {2}\n\nМетеор теперь наносит урон холодом вместо взрывного урона и считается холодным оружием.",
		"evo_meteor_iceRain_2": "Ледяной дождь II",
		"evo_meteor_iceRain_2_desc": "Эффекты:\n  Урон от холода: {1}\n\nГлобальный эффект:\n  Все холодные эффекты/Оружие:\n    Урон: {2}",
		"evo_meteor_relentless": "Безжалостный",
		"evo_meteor_relentless_desc": "Эффекты:\n Дальность: {1}\n Скорострельность: {2}\n\nМетеоры теперь стреляют непрерывно, двигаясь к последней цели.",
		"evo_meteor_relentless_2": "Безжалостный II",
		"evo_meteor_relentless_2_desc": "Эффекты:\n Скорость: {1}\n Шанс критического урона: {2}",
		"evo_meteor_sky_spotter": "Небесный наблюдатель",
		"evo_meteor_sky_spotter_desc": "Глобальный эффект:\n  Все удаленные эффекты/оружие:\n    Дальность: {1}",
		"evo_oscillator_twinHeaded": "Двуглавый",
		"evo_oscillator_twinHeaded_desc": "Дополнительный поток снарядов Осциллятора стреляет в противоположном направлении.",
		"evo_oscillator_ballLightning": "Шаровая молния",
		"evo_oscillator_ballLightning_desc": "Эффект:\n  Электрический урон: {1}\n  Тепловой урон: {2}\n\nОсциллятор теперь наносит электрический урон вместо теплового и считается электрическим оружием.",
		"evo_oscillator_ballLightning_2": "Шаровая молния II",
		"evo_oscillator_ballLightning_2_desc": "Эффекты:\n  Электрический урон: {1}\n\nГлобальный эффект:\n  Все электрические эффекты/Оружие:\n    Урон: {2}",
		"evo_oscillator_stabilizedPlasma": "Стабилизированная плазма",
		"evo_oscillator_stabilizedPlasma_desc": "Снаряды Осциллятора теперь проникают сквозь врагов. Враги, поражённые после первого, получают {1} урона.",
		"evo_oscillator_stabilizedPlasma_2": "Стабилизированная плазма II",
		"evo_oscillator_stabilizedPlasma_2_desc": "Урон поджога увеличен на {1}. Применяется к поджогу от всех источников и влияет на базовый урон.",
		"evo_oscillator_prime_resonance": "Первичный резонанс",
