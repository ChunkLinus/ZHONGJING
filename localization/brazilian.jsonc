		"evo_minefield_infusion_2": "Infusão II",
		"evo_minefield_infusion_2_desc": "Efeitos:\n Dano Químico: {1}\n Chance de Praga: {2}\n\nEfeito Global:\n Todos os Efeitos/Armas Químicas:\n Dano: {3}",
		"evo_minefield_hunterSeeker": "Busca do Caçador",
		"evo_minefield_hunterSeeker_desc": "Efeitos:\n Velocidade: {1}\n Alcance: {2}\n\nMinas ganham movimento teleguiado a alvos aleatórios.",
