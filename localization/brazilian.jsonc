		"evo_wildcard_conduit": "Conduto",
		"evo_wildcard_conduit_desc": "Dentro do alcance de projéteis Elétricos, Orbes Quentes e inimigos Congelados por projéteis Gelados causarão dano Elétrico aos inimigos próximos.",
		"evo_wildcard_conduit_2": "Conduto II",
