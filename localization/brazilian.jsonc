		"item_regeneration": "Regeneração",
		"item_regeneration_desc": "Você recupera {1} do máximo de vida quando você ativa um item de Prêmio, Congelar, Dobro de Dano, Rolar Novamente ou Escudo",
		"item_DOTCanCrit": "Erosão",
		"item_DOTCanCrit_desc": "Armas D.C.T. podem dar Críticos.",
		"item_cryotechnics": "Criotécnica",
		"item_cryotechnics_desc": "Itens de Congelar:\n Chance de Aparecer: {1}\n\nItens de Dobro de Dano:\n -100% de Chance de Aparecer",
		"item_warlike": "Tipo Guerra",
		"item_warlike_desc": "Itens de Dobro de Dano:\n Chance de Aparecer: {1}\n\nItens de Congelar:\n -100% de Chance de Aparecer",
		"item_pinata": "Pinhata",
		"item_pinata_desc": "Efeito Global:\n  Frequência de Prêmios: {1}",
		"item_point_blank": "À Queima-Roupa",
		"item_point_blank_desc": "Inimigos acertados próximo da Arma Principal receberão {1} de dano.",
		"item_shatter": "Despedaçar",
		"item_shatter_desc": "Todas as Armas Cinéticas ganham {1} de Chance de Crítico contra Inimigos Congelados.",
		"item_seer": "Vidente",
		"item_seer_desc": "Ativar um item de Rolar Novamente aumenta o seu Alcance global em 10% por 10 segundos. O efeito se empilha até 3 vezes.",
		"item_seer_desc_2": "Se você tiver 0 Rolar Novamentes ao entrar em uma tela de aumento de nível, evolução ou prêmio, você irá ter 1 Rolar Novamente.",
		"item_resilience": "Resiliência",
		"item_resilience_desc": "Ativar itens de Escudo aumenta a sua Duração global em 10% por 10 segundos. O efeito se empilha até 3 vezes.",
		"item_resilience_desc_2": "Por cada Escudo que tiver, ganha {1} de Duração global.",
		"item_gambler": "Apostador",
		"item_gambler_desc": "Adiciona 1 Rolar Novamente e aumenta o máximo de Rolar Novamente, para um total de 6.",
		"item_protector": "Protetor",
		"item_protector_desc": "Adiciona 1 Escudo e aumenta o máximo de Escudos, para um total de 4.",
		"item_flawless": "Impecável",
		"item_flawless_desc": "Cada x{1} Apertar Perfeito também aumenta a sua Taxa de Tiro global em {2}.",
		"item_release": "Liberar",
		"item_release_desc": "Ao errar a tecla, causa {1} de dano Explosivo para todos os inimigos por cada x{2} Apertar Perfeito.",
		"item_wasting": "Desperdício",
		"item_wasting_desc": "Todas as Armas D.C.T.: +35% de Taxa de Tiro",
		"item_wither": "Murchar",
		"item_wither_desc": "Todos os Efeitos de Estado: +35% de Taxa de Tiro",
		"consumable_medpack": "Medpack",
		"consumable_medpack_desc": "Adiciona {1} Medpacks ao seu inventário.\n\nMedpacks recuperam até {2} do máximo de vida da Torreta Principal.",
		"consumable_serum": "Soro",
		"consumable_serum_desc": "Adiciona {1} Soro ao seu inventário.\n\nSoros dão {2} de Chance de Crítico por {3} segundos.",
		"consumable_warhead": "Ogiva",
		"consumable_warhead_desc": "Adiciona {1} Ogiva ao seu inventário.\n\nOgivas causam uma série de explosões poderosas que radiam a frente da arma principal.",
		"weapon_warhead_desc": "Efeito de Item – Não é considerado uma arma.\n\nCausa uma série de explosões poderosas que radiam a frente da arma principal.",
		"consumable_flameWave": "Onda de Chamas",
		"consumable_flameWave_desc": "Adiciona {1} Ondas de Chamas ao seu inventário.\n\nOndas de Chamas incendeiam todos os inimigos visíveis ao custo de 10% da vida atual da Torreta Principal.",
		"weapon_flameWave_desc": "Efeito de Item – Não é considerado uma arma.\n\nIncendeia todos os inimigos visíveis ao custo de 10% da vida atual da Torreta Principal.",
		"consumable_cryocore": "Núcleo Gelado",
		"consumable_cryocore_desc": "Adiciona {1} Núcleo Gelado ao seu inventário.\n\nNúcleos Gelados ativam um efeito global de Congelar.",
		"consumable_killPill": "Pílula da Morte",
		"consumable_killPill_desc": "Adiciona {1} Pílula da Morte ao seu inventário.\n\nPílulas da Morte ativam um efeito global de Dano Duplo.",
		"consumable_pocketTurret": "Torreta Portátil",
		"consumable_pocketTurret_desc": "Adiciona {1} Torreta Portátil ao seu inventário.\n\nA Torreta Portátil invoca uma torreta automática perto de grupos de inimigos.",
		"weapon_pocket_turret_desc": "Efeito de Item – não é considerado uma arma.\n\nInvoca uma torreta automática perto de grupos de inimigos.",
		"item_plunder": "Presenteado",
		"item_plunder_desc": "+1 Opções de Prêmio",
		"item_multitargeting": "Multi-Mira",
		"item_multitargeting_desc": "Todas as Armas Remotas recebem +1% de Chance de Crítico por cada arma que você possui.",
		"item_pickupMagnet": "Imã Gigante",
		"item_pickupMagnet_desc": "Você automaticamente coleta itens quando eles expiram.",
		"item_frostbite": "Queimadura de Gelo",
		"item_frostbite_desc": "Inimigos recebem dano ao passar do tempo quando Congelados.",
		"item_necrobomb": "Necrobomba",
		"item_necrobomb_desc": "Ao destruir um inimigo com dano Crítico Explosivo, causa uma série de explosões ao redor da posição do inimigo caído.",
		"item_prize": "Premiação",
		"item_prize_desc": "Ao destruir um inimigo com dano Crítico, {1} de chance de aparecer um item Rolar Novamente, Escudo ou de Vida.",
		"item_aftershock": "Pós-Choque",
		"item_aftershock_desc": "Dano Crítico sempre irá causar efeitos de estado.",
		"item_vampirism": "Vampirismo",
		"item_vampirism_desc": "Ganha vida igual a {1} do dano Cinético Crítico.",
		"item_wisdom": "Sabedoria",
		"item_wisdom_desc": "Ao pegar um Escudo, ganha 10 Mortes para todas as Evoluções de armas.",
		"item_jester": "Coringa",
		"item_jester_desc": "Ao pegar um Rolar Novamente, causa uma quantidade aleatória de dano entre 0 a 100 a todos os inimigos na tela.",
		"item_jester_2_desc": "Ao completar uma palavra, invoca um Drone Coringa que causa 0-100% de dano para um alvo aleatório. Tempo de recarga de 10 segundos entre ativações.",
		"item_lastStand": "Última Batalha",
		"item_lastStand_desc": "Ganha Dobro de Dano quando um Escudo for destruído.",
		"item_tripleDamage": "Triplo de Dano",
		"item_tripleDamage_desc": "Todos os itens de Dobro de Dano agora serão Triplo de Dano.",
		"item_fracture": "Fractura",
		"item_fracture_desc": "Durante Congelar, cada item de Congelar que teria aparecido será um item de Fractura, que causa dano a todos os inimigos Congelados.",
		"item_fracture_desc_2": "Todos os danos para inimigos Congelados são aumentados em {1}. Modificador é multiplicativo.",
		"item_ascetic": "Ascético",
		"item_ascetic_desc": "Ao sair da tela de Prêmios, recebe +10% de dano para cada item Rolar Novamente não utilizado por 20 segundos.",
		"item_harmonizer": "Harmonizador",
		"item_harmonizer_desc": "Todas as armas equipadas recebem um nível de Evolução.",
		"item_immortality": "Imortalidade",
		"item_immortality_desc": "Se a sua Arma Principal estiver prestes a ser destruída, ficará com 1 de vida ao invés dela ser destruída. Essa habilidade apenas pode ser usada uma vez a cada 2 minutos.",
		"item_immortality_desc_2": "Se a sua Arma Principal estiver prestes a ser destruída, ficará com 1 de vida ao invés dela ser destruída, e todos os inimigos dentro dos 400 metros da arma principal irão receber dano Cinético letal. Essa habilidade pode ser usada uma vez a cada 2 minutos.",
		"item_enlightenment": "Elucidação",
		"item_enlightenment_desc": "Ao destruir um inimigo com dano Crítico, ganha +1 de mortes para todas as Evoluções de armas.",
		"item_closer": "Mais Próximo",
		"item_closer_desc": "Completar uma palavra do inimigo após ele ser destruído lhe dá +10% de dano por 10 segundos. O efeito se empilha até 3 vezes.",
		"item_murderous": "Homicida",
		"item_murderous_desc": "Todas as Armas Drone: +50% de Dano",
		"item_executioner": "Executador",
		"item_executioner_desc": "Todas as Armas Torreta: +50% de Dano",
		"item_degeneration": "Degeneração",
		"item_degeneration_desc": "Todas as Armas Remotas: +50% de Dano",
		"item_clone": "Clone",
		"item_clone_desc": "Consumíveis tem 30% de chance de se autorreplicar ao ser usado.",
		"augment_category_mainWeapon": "Registro: Arma Principal",
		"augment_category_turret": "Registro: Torreta",
		"augment_category_drones": "Registro: Drones",
		"augment_category_dot": "Registro: D.C.T.",
		"augment_category_remote": "Registro: Remoto",
		"augment_category_electric": "Registro: Elétrico",
		"augment_category_heat": "Registro: Calor",
		"augment_category_kinetic": "Registro: Cinético",
		"augment_armored": "Impenetrável",
		"augment_armored_desc": "Arma Principal:\n Vida: +50%",
		"augment_eager": "Disposto",
		"augment_eager_desc": "No começo de cada jogo de Teste ou Infinito, ganha um nível. Por cada 4 minutos sobrevividos no Modo Infinito, ganha um nível.",
		"augment_gambler": "Apostador",
		"augment_gambler_desc": "Cada Rolar Novamente a qual você usa dá a sua Arma Principal +20% de dano por 20 segundos.",
		"augment_haze": "Nebuloso",
		"augment_haze_desc": "Se estiver com menos de 50% de vida, ganha um bônus de +50% de Taxa Global de Tiro.",
		"augment_immaculate": "Imaculado",
		"augment_immaculate_desc": "Apertar Perfeito agora dá +1.5% de Chance de Crítico por cada empilha.",
		"augment_devotion": "Devoção",
		"augment_devotion_desc": "Arma Principal ganha +25% de dano por cada espaço vazio de arma. Ao menos uma opção no aumentar de nível será uma aprimoração.",
		"augment_armada": "Armada",
		"augment_armada_desc": "20% de chance de ativar um drone adicionar sempre que um for ativado.",
		"augment_diversity": "Diversidade",
		"augment_diversity_desc": "Para cada Arma não-Drone equipada, aumenta a duração de todos os drones em 20%.",
		"augment_blitzkrieg": "Blitzkrieg",
		"augment_blitzkrieg_desc": "Aprimorações de velocidade para Drones também se aplicam ao dano do Drone,",
		"augment_retribution": "Retribuição",
		"augment_retribution_desc": "Sempre que um Escudo for destruído, todos os Drones existentes se autodestroem, causando dano explosivo.",
		"augment_scapegoat": "Bode Expiatório",
		"augment_scapegoat_desc": "Erros de Digitação aleatoriamente destroem um Drone existente ao invés de serem contados como um erro de digitação.",
		"augment_spoils": "Pilhagem",
		"augment_spoils_desc": "Drones podem pegar itens quando expirarem.",
		"augment_fortress": "Fortaleza",
		"augment_fortress_desc": "Cada Evolução de Torreta também provém +50 de vida máxima para a Arma Principal.",
		"augment_networked": "Conectado",
		"augment_networked_desc": "Cada outra Torreta provém +10% de Taxa de Tiro para todas as Torretas, até um máximo de +50%.",
		"augment_fieldIntel": "Informações da Batalha",
		"augment_fieldIntel_desc": "Ativar um item provém +40% de Alcance para todas as Torretas existentes. Este efeito não pode ser empilhado.",
		"augment_darkRelay": "Relé Escuro",
		"augment_darkRelay_desc": "Um projétil se ricocheteia entre as Torretas existentes de forma aleatória, causando dano elétrico.",
		"augment_observer": "Observador",
		"augment_observer_desc": "Se você não atacou por 3 segundos, ganha +30% de Dano de Torreta até o seu próximo ataque.",
		"augment_observer_powerup": "{1} de Dano de Torreta",
		"augment_weakness": "Fraqueza",
		"augment_weakness_desc": "Inimigos dentro do Alcance de uma Torra recebem 30% mais dano de outras fontes.",
		"augment_corrosion": "Corrosão",
		"augment_corrosion_desc": "Dano D.C.T. agora pode ser crítico.",
		"augment_lamprey": "Lampreia",
		"augment_lamprey_desc": "Dano D.C.T. causado próximo da Arma Principal cura a Arma Principal em 1 de Vida.",
		"augment_tenacity": "Tenacidade",
		"augment_tenacity_desc": "Aumenta a duração de todas as armas D.C.T. em 35%.",
		"augment_afflictors": "Aflitores",
		"augment_afflictors_desc": "Adiciona Aflitores aos possíveis Prêmios. Cada um provém +4% de Dano D.C.T. Efeito é duplicado quando estiver próximo da Arma Principal.",
		"augment_conviction": "Convicção",
		"augment_conviction_desc": "Armas D.C.T. recebem +40% de Taxa de Tiro enquanto tiver o máximo de Rolar Novamentes.",
		"augment_conviction_powerup": "{1} de Taxa de Tiro D.C.T.",
		"augment_infector": "Infectador",
		"augment_infector_desc": "Armas D.C.T. tem +3% de chance de inflingir efeito de estado.",
		"augment_closeCombat": "Combate Próximo",
		"augment_closeCombat_desc": "Todos os Danos Remotos são considerados danos próximo à Arma Principal.",
		"augment_caltrops": "Estrepe",
		"augment_caltrops_desc": "Num acerto crítico com armas de longo alcance, invoca 12 Estrepes que causam dano a inimigos passantes, com chance de sangramento aumentada com base no dano.",
		"augment_causticAmmo": "Munição Cáustica",
		"augment_causticAmmo_desc": "Chance de aparecer Munição Cáustica - adiciona 10 de Dano Químico base para Armas Remotas por 20 segundos.",
		"augment_piracy": "Premiado",
		"augment_piracy_desc": "Para cada Efeito de Prêmio equipado, aumenta todos os Danos Remotos em 15%.",
		"augment_deliverance": "Libertação",
		"augment_deliverance_desc": "Todas as armas Remotas recebem +10% de Alcance enquanto tiver o máximo de Escudos.",
		"augment_deliverance_powerup": "{1} de Alcance Remoto",
		"augment_sniper": "Atirador",
		"augment_sniper_desc": "Aprimorações de Alcance Remoto também se aplicam ao Dano Remoto.",
		"augment_voltaicBurst": "Explosão Voltaica",
		"augment_voltaicBurst_desc": "Melhorias de Duração Elétrica também aplicam 25% de seu valor à Chance de Efeito Estático Elétrico.",
		"augment_stormBattery": "Bateria de Tempestade",
		"augment_stormBattery_desc": "A Torreta Principal causa dano Elétrico aos inimigos próximos. Cada Arma Elétrica equipada aumenta o dano base.",
		"augment_lightningSparks": "Faíscas",
		"augment_lightningSparks_desc": "Em um acerto crítico com armas Elétricas, dispara 6 Faíscas Elétricas cujo dano escala com a Chance de Crítico e o Multiplicador de Crítico.",
		"augment_efficientGrid": "Rede Eficiente",
		"augment_EfficientGrid_desc": "Para cada arma não-Elétrica equipada, aumenta toda a duração dos efeitos Elétricos em 10%.",
		"augment_violentDischarge": "Descarga Violenta",
		"augment_violentDischarge_desc": "Estático causa mais dano e tem maior alcance. Inimigos mortos por Estático têm 50% de chance de espalhar Estático para inimigos próximos.",
		"augment_electrifiedTurret": "Torreta Eletrificada",
		"augment_electrifiedTurret_desc": "A Arma Principal recebe +5 de Dano Elétrico base e aumenta o dano de todas as armas Elétricas em 10%.",
		"augment_pyromancy": "Piromancia",
		"augment_pyromancy_desc": "Aumenta o Dano de Calor em 2% para cada inimigo em chamas. Aplicar Incineração causa dano adicional de Calor com base na duração e no dano da Incineração.",
		"augment_cauterization": "Cauterização",
		"augment_cauterization_desc": "Bônus de Alcance também se aplicam à dano causado próximo da Arma Principal para Armas/Efeitos de Calor.",
		"augment_furnaceCore": "Núcleo de Fornalha",
		"augment_furnaceCore_desc": "A Torreta Principal recebe +5 de Dano de Calor base. Todo o dano de Calor é aumentado em 10%.",
		"augment_fireball": "Bola de Fogo",
		"augment_fireball_desc": "Disparar a Arma Principal libera uma Bola de Fogo lenta que causa Dano de Calor aos inimigos em seu caminho. Máximo de 1 Bola de Fogo ativa.",
		"augment_flameWave": "Onda de Chamas",
		"augment_flameWave_desc": "Adiciona o consumível Onda de Chamas ao inventário inicial e aos possíveis prêmios. Incendeia todos os inimigos visíveis e consome 10% da vida atual da Torreta Principal.",
		"augment_blazingGlory": "Glória Ardente",
		"augment_blazingGlory_desc": "Inimigos próximos à Arma Principal recebem +25% de Dano de Calor e têm 12% de chance adicional de serem incendiados por Dano de Calor.",
		"augment_gunslinger": "Pistoleiro",
		"augment_gunslinger_desc": "Aumenta o Máximo da Corrida de Palavras em 5. Cada nível da Corrida de Palavras dá +2,5% de dano cinético.",
		"augment_bloodlust": "Sede de Sangue",
		"augment_bloodlust_desc": "Aumenta a Taxa de Tiro Cinético em 2% e o Alcance em 1% para cada inimigo Sangrando.",
		"augment_infusedAmmo": "Munição Infundida",
		"augment_infusedAmmo_desc": "Acertos Críticos de Dano Cinético têm 40% de chance de aplicar um Estado aleatório no inimigo.",
		"augment_scrapArmaments": "Estilhaços",
		"augment_scrapArmaments_desc": "Chance de derrubar Estilhaços - adiciona 10 Dano Cinético base nas Armas Cinéticas por 20 segundos.",
		"augment_combinedArms": "Armas Combinadas",
		"augment_combinedArms_desc": "Para cada Arma não Cinética equipada, aumenta todo o dano Cinético em 10%.",
		"augment_pocketTurret": "Torreta Portátil",
		"augment_pocketTurret_desc": "Adiciona o item Torreta Portátil ao inventário e para os possíveis prêmios. A Torreta Portátil invoca uma torreta que pode ser coletada ao expirar.",
		"wiki_tag_label": "Tags",
		"wiki_name_label": "Nome",
		"wiki_cost_label": "Custo",
		"wiki_description_label": "Descrição",
		"wiki_title": "Wiki Oficial Glyphica",
		"wiki_subtitle": "Wiki Oficial do Glyphica Typing Survival",
		"wiki_home_title": "Página Inicial",
		"wiki_landingPage_title": "Bem Vindo Digitador",
		"wiki_landingPage_intro": "Bem vindo ao wiki oficial do Glyphica: Typing Survival! Teste as suas habilidades de digitação nesse jogo de sobrevivência de horda onde a sua velocidade e precisão são as suas armas supremas. Equipe poderosas ferramentas que transformam os seus poderes de digitação em ataques devastadores contra inimigos implacáveis. Descubra mais e pegue o jogo na Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Este wiki serve como um guia compreensivo para as funcionalidades, mecânicas e conteúdos disponíveis na versão Acesso Antecipado de Glyphica. Nosso objetivo é manter as informações atualizadas enquanto progredimos ao lançamento do lançamento completo, versão 1.0. O wiki é organizado em seção listadas nas tabelas de conteúdos e será regularmente atualizada enquanto o jogo evolui.",
		"wiki_tableOfContents_title": "Tabela de Conteúdos",
		"wiki_mainWeapons_title": "Armas Principais",
		"wiki_mainWeapons_intro": "Armas principais são as armas de início em *Glyphica* e desempenham um papel principal no gameplay. Quando você digita uma palavra mostrada acima de um inimigo, a arma principal mira naquele inimigo como seu alvo. Cada arma principal tem efeitos e mecânicas únicas, necessitando estratégias diferentes para serem usadas de forma eficiente.",
		"wiki_mainWeapons_intro2": "Enquanto algumas armas principais enfatizam a velocidade de digitação (PPM), outras demandam um método mais tático. Como outras armas no jogo, armas principais podem ser aprimoradas e evoluídas, melhorando as suas capacidades e eficácias enquanto avança.",
		"wiki_mainWeapons_list_title": "Lista de Armas Principais",
		"wiki_weapons_title": "Armas de Aumento de Nível",
		"wiki_weapons_intro": "Armas de aumento de nível são obtidas durante uma partida quando aumenta de nível. Quando selecionado, a arma é adicionada ao seu arsenal. Cada arma tem um método único de ativação, mas a maioria pode ser ativada enquanto digita e mira com a arma principal.",
		"wiki_weapons_intro2": "Um máximo de quatro armas podem ser obtidas desta maneira. Quando uma arma for adicionada ao seu arsenal, suas aprimorações ficam disponíveis no reservatório de aprimorações de aumento de nível, permitindo que você melhore as suas habilidades enquanto progride.",
		"wiki_weapons_list_title": "Lista de Armas de Aumento de Nível",
		"wiki_weapon_evolution_title": "Evoluções",
		"wiki_weapon_upgrade_title": "Aprimorações",
		"wiki_lootItems_title": "Itens de Prêmios",
		"wiki_lootItems_intro": "Itens de prêmios são obtidos durante uma partida ao ativar um item de baú de tesouro. Uma seleção aleatória de itens de prêmios serão mostrados, e escolhendo um irá lhe dar um bônus passivo que se mantém ativo pelo resto da partida.",
		"wiki_lootItems_intro2": "Itens de prêmios são categorizados como **comum**, **incomum**, e **raro**, a qual determinam a probabilidade de aparecerem nas seleções de prêmios. Derrotar um chefe no Modo Desafio te dará um baú de tesouro contendo apenas itens raros.",
		"wiki_lootItems_rare_title": "Lista de Prêmios Raros",
		"wiki_lootItems_uncommon_title": "Lista de Prêmios Incomuns",
		"wiki_lootItems_common_title": "Lista de Prêmios Comuns",
		"wiki_enemies_title": "Inimigos",
		"wiki_enemies_intro": "Inimigos em *Glyphica* são gerados proceduralmente baseados em uma métrica interna chamada **perigo**, a qual é aumentado enquanto a partida progride. No Modo Desafio, o perigo é multiplicado pelo Nível atual de Perigo, deixando cada nível gradualmente mais difícil. No Modo Infinito, o perigo é comparável com um sistema adaptativo de escala baseado no nível do jogador, com o valor maior determinando a dificuldade de aparecimento.",
		"wiki_enemies_intro2": "Inimigos também são categorizados em **especiais** e **elites**, cada um com os seus limites de classe que limitam a sua taxa de aparecimento dentro do nível geral de perigo.",
		"wiki_enemies_list_title": "Lista de Inimigos",
		"wiki_enemy_variants_title": "Lista de Variantes",
		"wiki_image_label": "Imagem",
		"wiki_splitter_shard_count": "Quantidade de Fragmentos",
		"wiki_splitter_shard_health": "Vida de Fragmentos",
		"wiki_splitter_shard_damage": "Dano de Fragmentos",
		"wiki_augments_title": "Aprimorações",
		"wiki_augments_intro": "Aprimorações são melhorias permanentes a qual podem ser desbloqueadas usando Moedas (§), um dinheiro obtido dentro de uma partida. No início de cada partida, jogadores tem um número limitado de espaços para equiparem aprimorações desbloqueadas, com o número de espaços disponíveis variam dependendo do nível selecionado de Presságio.",
		"wiki_augments_intro2": "Cada aprimoração costumam ter condições específicas que determinam os seus benefícios. Para aproveitar ao máximo as suas aprimorações, considere as sinergias entre eles e as alinhe nas suas estratégias preferidas.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Determinação",
		"NEW_ACHIEVEMENT_1_0_DESC": "Sobreviva 20 minutos no Modo Infinito com qualquer arma principal.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Persistência",
		"NEW_ACHIEVEMENT_1_1_DESC": "Sobreviva 30 minutos no Modo Infinito com qualquer arma principal.",
