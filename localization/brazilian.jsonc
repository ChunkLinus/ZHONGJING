		"evo_repeater_frostFang_2_desc": "Efeitos:\n Dano Gelado: {1}\n Dano Cinético: {2}\n\nAfeta dano base.",
		"evo_repeater_ricochet": "Ricochete",
		"evo_repeater_ricochet_desc": "Efeitos:\n Corrente de Projéteis: {1}\n\nProjéteis de Repetidor ricocheteiam para alvos aleatórios, causando {2} de dano no acertar após o primeiro.",
		"evo_repeater_ricochet_2": "Ricochete II",
		"evo_repeater_ricochet_2_desc": "Efeitos:\n Corrente de Projéteis: {1}",
		"evo_repeater_shotgun": "Espingarda",
		"evo_repeater_shotgun_desc": "Efeitos:\n Quantidade de Projéteis: {1}\n Dispersão de Projéteis: {2}\n Dano Cinético: {3}\n\nRepetidor agora atira um grupo de projéteis mais fracos com uma dispersão maior. Modificador de dano afeta o dano base.",
		"evo_repeater_shotgun_2": "Espingarda II",
		"evo_repeater_shotgun_2_desc": "Efeitos:\n Quantidade de Projéteis: {1}\n Dispersão de Projéteis: {2}",
		"evo_repeater_explodingBullets": "Munição Explosiva",
		"evo_repeater_explodingBullets_desc": "Efeitos:\n Dano Explosivo: {1}\n Dano Cinético: {2}\n\nAfeta dano base. Repetidor agora usa munições explosivas que causam dano explosivo em uma área pequena.",
		"evo_repeater_explodingBullets_2": "Munição Explosiva II",
		"evo_repeater_explodingBullets_2_desc": "Efeitos:\n Dano Explosivo: {1}\n Dano Cinético: {2}\n\n O alcance das explosões das munições do Repetidor é levemente aumentado.",
		"evo_heatray_iceBeam": "Raio de Gelo",
		"evo_heatray_iceBeam_desc": "Efeitos:\n Dano Quente: {1}\n Dano Gelado: {2}\n Chance de Congelar: {3}\n\nAfeta o dano base. Dano de Raio de Calor irá se tornar Gelado e terá uma chance maior de causar Congelar.",
		"evo_heatray_iceBeam_2": "Raio de Gelo II",
		"evo_heatray_iceBeam_2_desc": "Efeitos:\n Dano Gelado: {1}\n\nAfeta dano base.",
		"evo_heatray_reflection": "Reflexão",
		"evo_heatray_reflection_desc_2": "Raio Quente agora atravessa pelos inimigos e reflete {1} na borda fora da tela.",
		"evo_heatray_reflection_2": "Reflexão II",
		"evo_heatray_reflection_2_desc_2": "Raio Quente agora reflete {1} na borda fora da tela.",
		"evo_heatray_doubleBladed": "Lâmina Dupla",
		"evo_heatray_doubleBladed_desc": "Outro raio atira na direção oposta. Todas as evoluções e aprimorações se aplicam aos dois raios.",
		"evo_heatray_blaster": "Rebatedor",
		"evo_heatray_blaster_desc": "Efeitos:\n Taxa de Tiro: {1}\n\nRaio de Calor agora atira um projétil laser independente e multi-acerto ao invés de um raio constante, a qual ainda é considerada uma arma D.C.T.",
		"evo_heatray_blaster_2": "Rebatedor II",
		"evo_heatray_blaster_2_desc": "Efeitos:\n Tamanho do Projétil: {1}\n Dano: {2}",
		"evo_heatray_solar_tap": "Toque Solar",
		"evo_heatray_solar_tap_desc": "Efeito Global:\n  Todos os Efeitos/Armas Quentes:\n  Chance de Efeito de Estado: {1}",
		"evo_barrage_rocketArray": "Matriz de Foguetes",
		"evo_barrage_rocketArray_desc": "Barragem irá agora atirar {1} mísseis por cada barra de munição ao invés de {2}.",
		"evo_barrage_rocketArray_2": "Matriz de Foguetes II",
		"evo_barrage_seismicMunition": "Munição Sísmica",
		"evo_barrage_seismicMunition_desc": "Misseis se incorporam a si mesmos ao solo ao invés de se detonarem e causam pulsos explosivos por alguns segundos.",
		"evo_barrage_seismicMunition_2": "Munição Sísmica II",
		"evo_barrage_seismicMunition_2_desc": "Pulsos de Munição Sísmica:\n  Alcance: {1}\n  Duração: {2}",
		"evo_barrage_resupply": "Reabastecimento",
		"evo_barrage_resupply_desc": "Itens de Abastecimento irão aparecer agora. Ativando esses itens irá recarregar totalmente a sua arma principal e lhe dar um {1} de bônus de dano ao próximo tiro.",
		"evo_barrage_resupply_2": "Reabastecimento II",
		"evo_barrage_resupply_2_desc": "Itens de Abastecimento agora irão também lhe dar {1} de bônus de alcance de explosão ao próximo tiro.",
		"evo_barrage_resupply_pickup": "Munição Máxima!",
		"evo_barrage_total_saturation": "Saturação Total",
		"evo_barrage_total_saturation_desc": "Efeito Global:\n  Todos os Efeitos/Armas Explosivas:\n    Dano: {1}",
		"evo_splattershot_bubble": "Bolha de Slime",
		"evo_splattershot_bubble_desc": "Itens de Bolha de Slime aparecem dentro das Zonas de Respingo.\n\nQuando ativado, a Bolha de Slime estoura, causando dano em uma área pequena e criando Zonas de Respingos adicionais.",
		"evo_splattershot_bubble_2": "Bolha de Slime II",
		"evo_splattershot_bubble_2_desc": "Aumenta a ocorrência de Bolhas de Slima.\n\nBolhas de Slimes tem 50% de chance de estourar automaticamente quando expirarem.",
		"evo_splattershot_infestation": "Infestação",
		"evo_splattershot_infestation_desc": "Efeitos de Tiro Espalhado:\n Chance de Efeito de Estado: {1}\n\nEfeitos Globais:\n Dano de Estado de Efeito: {2}",
		"evo_splattershot_infestation_2": "Infestação II",
		"evo_splattershot_infestation_2_desc": "Inimigos mortos por Estados de Efeito explodem em Zonas de Respingo.",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Efeitos:\n Dano Químico: {1}\n Dano Quente: {2}\n\nAfeta dano base. Dano do tipo Tiro Espalhado se tornará Quente.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Efeitos:\n Dano Quente: {1}\n\nAfeta dano base.",
		"evo_splattershot_virulence": "Virulência",
		"evo_splattershot_virulence_desc": "Efeitos de Zona de Respingo:\n Duração: {1}\n\nZona de Respingo lentamente fica maior ao passar do tempo.",
		"evo_splattershot_chemical_catalyst": "Catalisador Químico",
		"evo_splattershot_chemical_catalyst_desc": "Efeito Global:\n  Todos os Efeitos/Armas Químicas:\n    Duração: {1}",
		"evo_overmind_syncronize": "Sincronização",
		"evo_overmind_syncronize_desc": "Cada morte com a Mente Superior tem {1} de chance de adicionar +1 morte para a progresso de Evolução de uma Arma de Drone aleatória.",
		"evo_overmind_syncronize_2": "Sincronização II",
		"evo_overmind_syncronize_2_desc": "Chance de adicionar +1 morte para a progresso de Evolução de uma Arma de Drone aleatória é aumentado para {1}.",
		"evo_overmind_shockSpire": "Espiral Elétrica",
		"evo_overmind_shockSpire_desc": "Cada 3 inimigos mirados simultaneamente invocam uma Espiral Elétrica entre eles.\n\nEspirais Elétricas periodicamente emitem pulsos elétricos que passam pela tela inteira e causam dano Elétrico.",
		"evo_overmind_shockSpire_2": "Espiral Elétrica II",
		"evo_overmind_shockSpire_2_desc": "Efeitos:\n Espirais Elétricas:\n Dano: {1}\nDuração: {2}",
		"evo_overmind_burningOnes": "Os em Chamas",
		"evo_overmind_burningOnes_desc": "Digitar palavras carrega um medidor que invoca Drones explosivos quando cheio.\n\nDrones vão em direção a inimigos e explodem no contato, causando dano Explosivo em uma área pequena.",
		"evo_overmind_burningOnes_2": "Os em Chamas II",
		"evo_overmind_burningOnes_2_desc": "Efeitos:\n Os em Chamas: {1}\n Dano Explosivo: {1}\n Alcance da Explosão: {2}",
