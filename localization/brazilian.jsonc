		"evo_minefield_hunterSeeker_2_desc": "Efeitos:\n Minas Invocadas: {1}\n Velocidade: {2}",
		"evo_minefield_dirtyBomb": "Bomba Suja",
		"evo_minefield_dirtyBomb_desc": "Efeitos:\n Dano Químico: {1}\n Dano da Arma de Respingo: {2}\n\nMinas liberam 3 poças de gosma quando elas explodem.",
		"evo_minefield_dirtyBomb_2": "Bomba Suja",
		"evo_minefield_dirtyBomb_2_desc": "Efeitos:\n Dano Químico: {1}\n Dano da Arma de Respingo: {2}\n\nEnquanto move, as minas periodicamente atiram uma poça de gosma.",
		"evo_minefield_recursiveMines": "Minas Recursivas II",
		"evo_minefield_recursiveMines_desc": "A Torreta Principal periodicamente invoca uma quantidade de minas com base na metade da quantidade de minas do Campo Minado, arredondado. A taxa de invocação é determinada pela estatística de Taxa de Tiro do Campo Minado.",
		"evo_minefield_recursiveMines_2": "Minas Recursivas II",
