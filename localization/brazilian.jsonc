		"evo_sentry_solidCore_2": "Núcleo Sólido II",
		"evo_sentry_solidCore_2_desc": "Efeitos:\n Dano Cinético: {1}\n\nEfeito Global:\n Todas as Armas/Efeitos Cinético:\n Dano: {2}",
		"evo_sentry_watcher_supreme": "Observador Supremo",
		"evo_sentry_watcher_supreme_desc": "Efeito Global:\n Todas as Armas/Efeitos de Torreta:\nAlcance:{1}",
		"evo_sentry_emergencyProtocol": "Protocolo de Emergência",
		"evo_sentry_emergencyProtocol_desc": "Sempre que uma aprimoração de Escudo for destruído, a Torreta irá entrar em modo de Protocolo de Emergência por {1} segundos.\n\nDurante o Protocolo de Emergência:\n Alcance: {2}\n Taxa de Tiro: {3}",
		"evo_sentry_emergencyProtocol_2": "Protocolo de Emergência II",
		"evo_sentry_emergencyProtocol_2_desc": "Durante o Protocolo de Emergência:\n Dano: {1}\n Velocidade de Giro: {2}",
		"evo_spectre_supercharged": "Sobrecarregado",
		"evo_spectre_supercharged_desc": "Cada 20º Espectro invocado é um SUPER Espectro.\n\nSuper Espectros:\n +100% de Dano\n +50% de Duração\n +50% de Velocidade",
		"evo_spectre_selfDestruct": "Autodestruição",
		"evo_spectre_selfDestruct_desc": "Efeitos:\n Dano Explosivo: {1}\n\nQuando o Espectro expirar, ele se autodestrói, causando Dano Explosivo. Afeta dano base e é afetado por modificadores de dano Explosivo.",
