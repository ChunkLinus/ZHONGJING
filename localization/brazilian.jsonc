		"overmind_constructing_drone": "Montando Drone",
		"overmind_constructing_drone_desc": "{1} Drones na Fila",
		"overmind_syncronization": "Sincronização",
		"overmind_syncronization_desc": "{1} Chance de Crítico, {2} Multi-Crítico",
		"boss_poet": "O Poeta",
		"boss_poet_desc": "Digite o trecho apresentado pelo chefe.\nVocê pode continuar a mirar nos inimigos enquanto faz isso.",
		"boss_cypher": "O Cifrão",
		"boss_cypher_desc": "Esse chefe embaralha as letras daqueles perto dele.\nDestrua-o com as suas armas.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "Esse chefe atira projéteis destrutíveis à você.\nDestrua todas as três cabeças com as suas armas.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Esse chefe fica te circulando infinitamente.\nMire seus tiros nos alvos fixos no seu caminho para acertá-lo com as suas armas.",
		"boss_gemini": "Gêmeos",
		"boss_gemini_desc": "Causa dano uniforme aos dois gêmeos.\nUm irá curar o outro ao passar do tempo até o seu total de vida.",
		"weapon_repeater_title": "Repetidor",
		"weapon_heatray_title": "Raio de Calor",
		"weapon_barrage_title": "Barragem",
		"weapon_overmind_title": "Poder de Mente",
		"weapon_splattershot_title": "Tiro Espalhado",
		"weapon_wildcard_title": "Coringa",
		"weapon_spectre_title": "Espectro",
		"weapon_tesla_title": "Mina Tesla",
		"weapon_sentry_title": "Sentinela",
		"weapon_oscillator_title": "Oscilador",
		"weapon_meteor_title": "Meteoro",
		"weapon_hunter_title": "Caçador",
		"weapon_chopper_title": "Picador",
		"weapon_minefield_title": "Campo Minado",
		"weapon_blade_title": "Armadilha de Lâminas",
		"weapon_firestorm_title": "Tormenta de Fogo",
		"weapon_guardian_title": "Guardião",
		"weapon_orbiter_title": "Orbitador",
		"weapon_frostbite_title": "Tormenta de Gelo",
		"weapon_bleeding_title": "Sangramento",
		"weapon_blight_title": "Praga",
		"weapon_static_title": "Estática",
		"weapon_ignite_title": "Incendiar",
		"weapon_heatray_requirements": "Complete os Testes de Repetidor em qualquer nível de Presságio.",
		"weapon_barrage_requirements": "Complete Testes de Presságio Nível 3 com qualquer arma principal.",
		"weapon_repeater_desc": "Arma devastante que atira um número de balas em sequências curtas.",
		"weapon_heatray_desc": "Atira um raio constante de luz concentrada muito preciso que causa dano ao passar do tempo.",
		"weapon_barrage_desc": "Atira uma onda de foguetes explosivos em um alvo e ao seu redor. Recarrega ao passar do tempo.",
		"weapon_overmind_desc": "Comande um conjunto de drones para causar dano de energia ao seus inimigos.",
		"weapon_splattershot_desc": "Atira gotas de gosma nos seus oponentes para paralisar e causar dano a eles.",
		"weapon_wildcard_desc": "O seu próximo tiro será aleatoriamente selecionado de quatro possíveis armas, então atire com cuidado.",
		"weapon_spectre_desc": "Invoca drones rápidos de curta distância equivalentes ao número do acima combinado.",
		"weapon_sentry_desc": "Aciona uma torreta automática que atira em qualquer inimigo que chega perto do seu alcance.",
		"weapon_tesla_desc": "Aciona uma torreta elétrica que causa dano ao passar do tempo.",
		"weapon_oscillator_desc": "Atira um fluxo oscilante de partículas na direção do seu alvo mais recente.",
		"weapon_meteor_desc": "Periodicamente invoca marcadores de alvo em locais aleatórios a qual podem ativados para iniciar um bombardeio orbital.",
		"weapon_hunter_desc": "Invoca drones que atiram raios elétricos equivalentes ao número do acima combinado.",
		"weapon_chopper_desc": "Invoca uma imensa lâmina giratória no tiro da arma principal que segue para a borda da tela, causando dano a todos os inimigos no seu caminho.",
		"weapon_minefield_desc": "Invoca minas de movimento lento que explodem ao entrar em contato com inimigos.",
		"weapon_blade_desc": "Ativa uma armadilha de lâmina giratória quadrifacetada.",
		"weapon_firestorm_desc": "Um canhão que atira uma barragem de balas explosivas de curta distância. Ela circula a torreta principal e precisa recarregar antes de atirar novamente.",
		"weapon_guardian_desc": "Instantaneamente aciona um Drone que atira lasers aos inimigos. Ativa itens de Combustível para recarregar o Guardião, a qual irá consumir combustível e se desativa quando o combustível acabar.",
		"weapon_orbiter_desc": "aciona uma orbe que orbita a Arma Principal, causando dano a tudo no seu caminho.",
		"weapon_frostbite_desc": "Efeito de Prêmio – Não é considerado uma arma.\n\nInimigos recebem dano ao passar do tempo enquanto estiverem Congelados.",
		"weapon_bleeding_desc": "Efeito de estado – não é considerado uma arma.\n\nInimigos recebem dano Cinético ao passar do tempo até o efeito acabar.",
		"weapon_blight_desc": "Efeito de estado – não é considerado uma arma.\n\nInimigos recebem dano Químico ao passar do tempo e ficam mais lentos até o efeito acabar.",
		"weapon_static_desc": "Efeito de estado – não é considerado uma arma.\n\nInimigos recebem dano Energético ao passar do tempo, e causa dano Energético para inimigos próximos até o efeito acabar.",
		"weapon_ignite_desc": "Efeito de estado – não é considerado uma arma.\n\nInimigos recebem dano Quente ao passar do tempo até o efeito acabar.",
		"weapon_caltrops_desc": "Efeito de aprimoramento – não é considerado uma arma.\n\nEm um acerto crítico com armas de longo alcance, gera 12 Estrepes que causam dano a inimigos que passarem por elas, com chance de sangramento aumentada com base no dano.",
		"weapon_stormBattery_desc": "Efeito de aprimoramento – não é considerado uma arma.\n\nA Torreta Principal causa dano Elétrico a inimigos próximos. Cada Arma Elétrica equipada aumenta o dano base.",
		"weapon_lightningSparks_desc": "Efeito de aprimoramento – não é considerado uma arma.\n\nEm um acerto crítico com armas Elétricas, dispara 6 Faíscas Elétricas com danos que escalam com a Chance de Crítico e o Multiplicador de Crítico.",
		"weapon_darkRelay_desc": "Efeito de Aprimoração – Não é considerado uma arma.\n\nUm projétil ricocheteia entre Torretas existentes de forma aleatória, causando dano elétrico.",
		"weapon_jester_desc": "Efeito de Prêmio – Não é considerado uma arma.\n\nAo pegar um Rolar Novamente, causando uma quantidade aleatória de dano entre 0 e 100 para todos os inimigos na tela.",
		"weapon_necrobomb_desc": "Efeito de Prêmio – Não é considerado uma arma.\n\nAo destruir um inimigo com dano Crítico Explosivo, ativa uma série de explosões em volta da posição do inimigo caído.",
		"weapon_release_desc": "Efeito de Prêmio – Não é considerado uma arma.\n\nAo errar a tecla, causa {1} de dano Explosivo para todos os inimigos por cada x{2} Apertar Perfeito.",
		"weapon_retribution_desc": "Efeito de Aprimoração – Não é considerado uma arma.\n\nSempre que um Escudo for destruído, todos os Drones existente se autodestroem causando dano explosivo.",
		"weapon_fireball_desc": "Efeito de aprimoramento – não é considerado uma arma.\n\nNo disparar da Arma Principal, também lança uma Bola de Fogo lenta que causa dano de Calor.",
		"contains_characters": "Completando mundos contendo os glifos",
		"contains_glyphs": "Completando conjuntos contendo os glifos",
		"starts_with_character": "Completando palavras começando com glifos",
		"starts_with_glyphs": "Completando conjuntos começando com glifos:",
		"enemy_drone_title": "Drone",
		"enemy_shieldDrone_title": "Drone de Escudo",
		"enemy_stalker_title": "Perseguidor",
		"enemy_shooter_title": "Atirador",
		"enemy_splitter_title": "Repartidor",
		"enemy_warder_title": "Guardião",
		"enemy_swarmer_title": "Avassalador",
		"enemy_drone_desc": "Drones são inimigos que implacavelmente se movem em direção a sua arma principal. Eles podem as vezes aparecerem em duas versões melhoradas: <br>Grandão: As vidas deles são triplicadas, sendo mais difíceis de serem derrotados. <br>Acelerado: A velocidade de movimento deles é duplicada, logo aumentando a urgência em eliminar eles.",
		"enemy_shieldDrone_desc": "O Drone de Escudo é uma variante do inimigo Drone que possui um escudo regenerativo. Ele tem duas barras de vida: a do topo representa o escudo, a qual começa a regenerar se não receber dano por um certo período de tempo.",
		"enemy_stalker_desc": "O Perseguidor é uma variante do inimigo Drone que aparece inicialmente com a maioria da sua palavra escondida. Enquanto digita, a palavra gradualmente é revelada, necessitando cuidado e digitação rápida para eliminá-los.",
		"enemy_shooter_desc": "O Atirador é um inimigo que para nas bordas do nível e, de forma contínua, atira projéteis resilientes em direção a sua arma principal até ser destruído.",
		"enemy_splitter_desc": "O Repartidor inicialmente aparece como um único inimigo, mas na verdade é composto de múltiplas partes. Quando uma parte é destruída, o Repartidor perde a sua integridade, fazendo com que os seus componentes se quebrem e tornando eles inimigos individuais.",
		"enemy_warder_desc": "O Guardião é um inimigo de elite que aparece após um certo tempo na partida. Ele possui um escudo giratório que bloqueia dano da direção que o escudo estiver de frente. Adicionalmente, quando o Guardião estiver vivo, ele provém uma aura protetiva aos inimigos próximos, deixando eles invulneráveis até que o Guardião seja derrotado.",
		"enemy_swarmer_desc": "O Avassalador é um inimigo de elite que periodicamente lança grupos de inimigos menos em direção a arma principal. Ele irá continuar fazendo isso até ser destruído.",
