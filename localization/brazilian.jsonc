		"evo_guardian_guardianTeam_2_desc": "Efeitos:\n Dano: {1}\n Drones: {2}\n\nGuardião é agora três drones ao invés de dois.",
		"evo_blade_bladeRepository": "Repositório de Lâminas",
		"evo_blade_bladeRepository_2": "Repositório de Lâminas II",
		"evo_blade_bladeRepository_desc": "irá invocar também uma Armadilha de Lâmina em adição aos glifos existentes.",
		"evo_blade_poisonCoating": "Revestimento Venenoso",
		"evo_blade_poisonCoating_desc": "Efeitos:\n Dano Químico: {1}\n Chance de Praga: {2}\n\nAfeta dano base e é afetado pelos modificadores de dano Químico.",
		"evo_blade_poisonCoating_2": "Revestimento Venenoso II",
		"evo_blade_poisonCoating_2_desc": "Efeitos:\n Dano Químico: {1}\n Chance de Praga: {2}\n\nAfeta dano base.",
		"evo_blade_sawtoothBlade": "Lâminas de Serra",
		"evo_blade_sawtoothBlade_desc": "Armadilhas de Lâmina adiciona as suas Chances de Crítico para as suas chances de causar Sangramento.",
		"evo_blade_sawtoothBlade_2": "Lâminas de Serra II",
		"evo_blade_sawtoothBlade_2_desc": "Dano de Sangramento é aumentado em {1}. Isso aplica para o Sangramento causado por todas as fontes e afeta o dano base.",
		"evo_blade_cutting_edge": "De Última Geração",
		"evo_blade_cutting_edge_desc": "Efeito Global:\n Todos os Efeitos/Armas de Torreta:\n    Chance de Crítico: {1}",
		"evo_hunter_hunterElite": "Caçador de Elite",
		"evo_hunter_hunterElite_desc": "Cada 12° Caçador invocado é um Caçador de Elite. \n\nCaçadores de Elite:\n +100% de Dano\n +50% de Duração\n +50% de Velocidade\n +50% de Alcance",
		"evo_hunter_hunterElite_2": "Caçador de Elite II",
		"evo_hunter_hunterElite_2_desc": "Caçador de Elites agora são invocados após 10 Caçadores.\n\nCaçadores de Elite:\n +50% de Duração",
		"evo_hunter_electrifiedBolts": "Ferrolhos Elétricos",
		"evo_hunter_electrifiedBolts_desc": "Efeito:\n  Dano Cinético: {1}\n  Dano Elétrico: {2}\n\nCaçadores agora atiram projéteis ao invés de uma corrente elétrica e é considerado uma Arma Cinética.",
		"evo_hunter_electrifiedBolts_2": "Ferrolhos Elétricos II",
