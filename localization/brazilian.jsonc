		"evo_guardian_experimentalFuel": "Combustível Experimental",
		"evo_guardian_experimentalFuel_desc": "Itens de Combustível Especial irão aparecer a qual oferecem bônus temporários ao Guardião. Apenas um destes bônus pode se permanecer ativo em qualquer momento.",
		"evo_guardian_experimentalFuel_2": "Combustível Experimental II",
		"evo_guardian_experimentalFuel_2_desc": "Todos os bônus de itens de Combustível {1} e duração do bônus {2}.",
