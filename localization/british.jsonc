		"boss_poet": "The Poet",
		"boss_poet_desc": "Type the passage presented by the boss.\nYou can continue to target enemies while doing so.",
		"boss_cypher": "The Cipher",
		"boss_cypher_desc": "This boss scrambles the letters of those near it.\nDestroy it with your weapons.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "This boss shoots destructible projectiles at you.\nDestroy all three heads with your weapons.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "This boss circles you endlessly.\nTime your shots at fixed targets in its path to hit it with your weapons.",
		"boss_gemini": "Gemini",
		"boss_gemini_desc": "Damage both the twins evenly.\nThey will heal each other over time up to their own health total.",
