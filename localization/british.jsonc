		"evo_repeater_frostFang": "Frost Fang",
		"evo_repeater_frostFang_desc": "Effects:\n  Cold Damage: {1}\n  Freeze Chance: {2}\n\nAffects base damage and affected by Cold damage modifiers.",
		"evo_repeater_frostFang_2": "Frost Fang II",
		"evo_repeater_frostFang_2_desc": "Effects:\n  Cold Damage: {1}\n  Kinetic Damage: {2}\n\nAffects base damage.",
		"evo_repeater_ricochet": "Ricochet",
		"evo_repeater_ricochet_desc": "Effects:\n  Projectile Chain: {1}\n\nRepeater projectiles ricochet to random nearby targets, dealing {2} damage on hits after the first one.",
		"evo_repeater_ricochet_2": "Ricochet II",
		"evo_repeater_ricochet_2_desc": "Effects:\n  Projectile Chain: {1}",
		"evo_repeater_shotgun": "Shotgun",
		"evo_repeater_shotgun_desc": "Effects:\n  Projectile Count: {1}\n  Projectile Spread: {2}\n  Kinetic Damage: {3}\n\nRepeater now fires a cluster of weaker projectiles with a large spread. Damage modifier affects base damage.",
		"evo_repeater_shotgun_2": "Shotgun II",
		"evo_repeater_shotgun_2_desc": "Effects:\n  Projectile Count: {1}\n  Projectile Spread: {2}",
		"evo_repeater_explodingBullets": "Exploding Bullets",
		"evo_repeater_explodingBullets_desc": "Effects:\n  Explosive Damage: {1}\n  Kinetic Damage: {2}\n\nAffects base damage. Repeater now uses explosive munitions that deal explosive damage in a small radius.",
		"evo_repeater_explodingBullets_2": "Exploding Bullets II",
		"evo_repeater_explodingBullets_2_desc": "Effects:\n  Explosive Damage: {1}\n  Kinetic Damage: {2}\n\nThe base explosion range for Repeater bullets is slightly increased.",
		"evo_heatray_iceBeam": "Ice Beam",
		"evo_heatray_iceBeam_desc": "Effects:\n  Heat Damage: {1}\n  Cold Damage: {2}\n  Freeze Chance: {3}\n\nAffects base damage. Heat Ray damage type will become Cold and have a increased chance to inflict Freeze.",
		"evo_heatray_iceBeam_2": "Ice Beam II",
		"evo_heatray_iceBeam_2_desc": "Effects:\n  Cold Damage: {1}\n\nAffects base damage.",
		"evo_heatray_reflection": "Reflection",
		"evo_heatray_reflection_desc_2": "Heat Ray now passes through enemies and reflects {1} off screen edge.",
		"evo_heatray_reflection_2": "Reflection II",
		"evo_heatray_reflection_2_desc_2": "Heat Ray now reflects {1} off screen edge.",
		"evo_heatray_doubleBladed": "Double-Bladed",
		"evo_heatray_doubleBladed_desc": "Another beam fires in the opposite direction. All evolutions and upgrades apply to both beams.",
		"evo_heatray_blaster": "Blaster",
		"evo_heatray_blaster_desc": "Effects:\n  Rate of Fire: {1}\n\nHeat Ray now fires an independent, multi-hit laser projectile instead of a constant beam, that still counts as a D.O.T. weapon.",
		"evo_heatray_blaster_2": "Blaster II",
		"evo_heatray_blaster_2_desc": "Effects:\n  Projectile Length: {1}\n  Damage: {2}",
		"evo_heatray_solar_tap": "Solar Tap",
		"evo_heatray_solar_tap_desc": "Global Effect:\n  All Heat Effects/Weapons:\n    Status Effect Chance: {1}",
		"evo_barrage_rocketArray": "Rocket Array",
		"evo_barrage_rocketArray_desc": "Barrage will now fire {1} missiles per ammo bar instead of {2}.",
		"evo_barrage_rocketArray_2": "Rocket Array II",
		"evo_barrage_seismicMunition": "Seismic Munition",
		"evo_barrage_seismicMunition_desc": "Missiles embed themselves into the ground instead of detonating and generate explosive pulses for the next few seconds.",
		"evo_barrage_seismicMunition_2": "Seismic Munition II",
		"evo_barrage_seismicMunition_2_desc": "Seismic Munition Pulses:\n  Range: {1}\n  Duration: {2}",
		"evo_barrage_resupply": "Resupply",
		"evo_barrage_resupply_desc": "Supply pickups will now spawn. Activating these pickups will fully reload your main weapon and give a {1} damage boost to the next shot.",
		"evo_barrage_resupply_2": "Resupply II",
		"evo_barrage_resupply_2_desc": "Supply pickups now also award {1} explosion range boost to the next shot.",
		"evo_barrage_resupply_pickup": "Max Ammo!",
		"evo_barrage_total_saturation": "Total Saturation",
		"evo_barrage_total_saturation_desc": "Global Effect:\n  All Explosive Effects/Weapons:\n    Damage: {1}",
		"evo_splattershot_bubble": "Slime Bubble",
		"evo_splattershot_bubble_desc": "Slime Bubble pickups spawn within Splatter Zones.\n\nWhen activated, Slime Bubbles burst, dealing damage in a small radius and creating additional Splatter Zones.",
		"evo_splattershot_bubble_2": "Slime Bubble II",
		"evo_splattershot_bubble_2_desc": "Increased occurence of Slime Bubbles.\n\nSlime bubbles have a 50% chance of automatically bursting when it expires.",
		"evo_splattershot_infestation": "Infestation",
		"evo_splattershot_infestation_desc": "Splatter Shot Effects:\n  Status Effect Chance: {1}\n\nGlobal Effects:\n  Status Effect Damage: {2}",
		"evo_splattershot_infestation_2": "Infestation II",
		"evo_splattershot_infestation_2_desc": "Enemies killed by Status Effects explode into Splatter Zones.",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Effects:\n  Chemical Damage: {1}\n  Heat Damage: {2}\n\nAffects base damage. Splatter Shot damage type will become Heat.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Effects:\n  Heat Damage: {1}\n\nAffects base damage.",
		"evo_splattershot_virulence": "Virulence",
		"evo_splattershot_virulence_desc": "Splatter Zone Effects:\n  Duration: {1}\n\nSplatter Zones slowly grow larger over time.",
		"evo_splattershot_chemical_catalyst": "Chemical Catalyst",
		"evo_splattershot_chemical_catalyst_desc": "Global Effect:\n  All Chemical Effects/Weapons:\n    Duration: {1}",
		"evo_overmind_syncronize": "Syncronize",
		"evo_overmind_syncronize_desc": "Every kill with Overmind has a {1} chance to add +1 kill to a random Drone Weapon's Evolution progress.",
		"evo_overmind_syncronize_2": "Syncronize II",
		"evo_overmind_syncronize_2_desc": "Chance to add +1 kill to a random Drone Weapon's Evolution progress increased to {1}.",
		"evo_overmind_shockSpire": "Shock Spire",
		"evo_overmind_shockSpire_desc": "Every 3 enemies targeted simultaneously spawns a Shock Spire between them.\n\nShock Spires emit periodic electrical pulses that traverses the entire screen and deal Electric damage.",
		"evo_overmind_shockSpire_2": "Shock Spire II",
		"evo_overmind_shockSpire_2_desc": "Effects:\n  Shock Spires:\n    Damage: {1}\n    Duration: {2}",
		"evo_overmind_burningOnes": "Burning Ones",
		"evo_overmind_burningOnes_desc": "Typing words charges up a meter that spawns explosive Drones when full.\n\nDrones home in on enemies and explode on contact, dealing Explosive damage in a small radius.",
