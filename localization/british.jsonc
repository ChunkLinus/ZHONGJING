		"weapon_blade_title": "Blade Trap",
		"weapon_firestorm_title": "Firestorm",
		"weapon_guardian_title": "Guardian",
		"weapon_orbiter_title": "Orbiter",
		"weapon_frostbite_title": "Frostbite",
		"weapon_bleeding_title": "Bleeding",
		"weapon_blight_title": "Blight",
		"weapon_static_title": "Static",
		"weapon_ignite_title": "Ignite",
		"weapon_heatray_requirements": "Complete Repeater Trials on any Omen level.",
		"weapon_barrage_requirements": "Complete Trials on Omen Level 3 with any main weapon.",
		"weapon_repeater_desc": "Devastating weapon that fires a number of bullets in short bursts.",
		"weapon_heatray_desc": "Fires a constant beam of incredibly accurate concentrated light that does damage over time.",
		"weapon_barrage_desc": "Fires a volley of explosive rockets at a target and its surroundings. Recharges over time.",
		"weapon_overmind_desc": "Command an assortment of drones to rain devastation on your foes.",
		"weapon_splattershot_desc": "Fire globs of goo at your opponents to cripple and damage them.",
		"weapon_wildcard_desc": "Your next shot is randomly selected from four possible weapons, so fire carefully.",
		"weapon_spectre_desc": "spawns fast melee drones equivalent to number of the above matched.",
		"weapon_sentry_desc": "Deploy an automated turret that fires at any enemy that comes within range.",
		"weapon_tesla_desc": "deploys an electrical turret that deals damage over time.",
		"weapon_oscillator_desc": "Fire an oscillating stream of particles in the direction of your most recent target.",
		"weapon_meteor_desc": "Periodically spawns target markers in random locations that can be activated to start an orbital bombardment.",
		"weapon_hunter_desc": "spawns electrical beam firing drones equivalent to number of the above matched.",
		"weapon_chopper_desc": "Spawns a massive spinning blade on main weapon fire that travels to the screen edge, damaging all enemies in its path.",
		"weapon_minefield_desc": "spawns slow-moving mines that explode on contact with enemies.",
		"weapon_blade_desc": "deploys a spinning four-spoked blade trap.",
		"weapon_firestorm_desc": "A cannon that fires a barrage of short-range explosive rounds. It circles the main turret and needs to cooldown before firing again.",
		"weapon_guardian_desc": "Instantly deploy a Drone that fires lasers at enemies. Activate Fuel pickups to refuel Guardian, which will consume fuel and deactivate when empty.",
		"weapon_orbiter_desc": "deploys an orb that orbits the Main Weapon, damaging everything in its path.",
		"weapon_frostbite_desc": "Loot effect - does not count as a weapon.\n\nEnemies take damage over time when Frozen.",
		"weapon_bleeding_desc": "Status effect - does not count as a weapon.\n\nEnemies take Kinetic damage over time until effect expires.",
		"weapon_blight_desc": "Status effect - does not count as a weapon.\n\nEnemies take Chemical damage over time and is slowed until effect expires.",
		"weapon_static_desc": "Status effect - does not count as a weapon.\n\nEnemies take Energy damage over time, and deals Energy damage to nearby enemies until effect expires.",
		"weapon_ignite_desc": "Status effect - does not count as a weapon.\n\nEnemies take Heat damage over time until effect expires.",
		"weapon_caltrops_desc": "Augment effect - does not count as a weapon.\n\nOn a critical hit by remote weapons, spawn 12 Caltrops that damage passing enemies, with increased bleed chance based on their damage.",
		"weapon_stormBattery_desc": "Augment effect - does not count as a weapon.\n\nMain Turret deals Electrical damage to nearby enemies. Each Electric Weapon equipped raises base damage.",
		"weapon_lightningSparks_desc": "Augment effect - does not count as a weapon.\n\nOn a critical hit by Electric weapons, release 6 Lightning Sparks that scale their damage with Crit Chance and Crit Multiplier.",
		"weapon_darkRelay_desc": "Augment effect - does not count as a weapon.\n\nA projectile bounces between existing Turrets randomly, dealing electrical damage.",
		"weapon_jester_desc": "Loot effect - does not count as a weapon.\n\nOn picking up Re-roll, deal a random amount of damage between 0 and 100 to all enemies on screen.",
		"weapon_necrobomb_desc": "Loot effect - does not count as a weapon.\n\nOn destroying an enemy with Explosive Crit damage, trigger a series of explosions around the position of the fallen enemy.",
		"weapon_release_desc": "Loot effect - does not count as a weapon.\n\nOn mistype, deal {1} Explosive damage to all enemies for every x{2} Perfect Input.",
		"weapon_retribution_desc": "Augment effect - does not count as a weapon.\n\nWhenever a Shield is destroyed, all existing Drones self-destruct dealing explosive damage.",
		"weapon_fireball_desc": "Augment effect - does not count as a weapon.\n\nFiring the Main Weapon also releases a slow Fireball that deals Heat damage.",
		"contains_characters": "Completing words containing the glyphs",
		"contains_glyphs": "Completing sets containing the glyphs",
		"starts_with_character": "Completing words starting with glyphs",
		"starts_with_glyphs": "Completing sets starting with glyphs:",
		"enemy_drone_title": "Drone",
		"enemy_shieldDrone_title": "Shield Drone",
		"enemy_stalker_title": "Stalker",
		"enemy_shooter_title": "Shooter",
		"enemy_splitter_title": "Splitter",
		"enemy_warder_title": "Warder",
		"enemy_swarmer_title": "Swarmer",
		"enemy_drone_desc": "Drones are enemies that relentlessly move toward your main weapon. They can occasionally appear in two enhanced forms:<br>Enlarged: Triples their health, making them harder to defeat.<br>Hastened: Doubles their movement speed, increasing the urgency to eliminate them.",
		"enemy_shieldDrone_desc": "The Shield Drone is a variant of the Drone enemy that features a regenerating shield. It has two health bars: the top one represents the shield, which begins to regenerate if it does not take damage for a certain period.",
		"enemy_stalker_desc": "The Stalker is a variant of the Drone enemy that initially appears with most of its word hidden. As you type, the word gradually reveals itself, requiring careful attention and quick typing to eliminate.",
		"enemy_shooter_desc": "The Shooter is an enemy that halts at the edge of the level and continuously fires durable projectiles toward your main weapon until it is destroyed.",
		"enemy_splitter_desc": "The Splitter initially appears as a single enemy but is actually composed of multiple parts. When one part is destroyed, the Splitter loses its integrity, causing its components to break apart and become individual enemies.",
		"enemy_warder_desc": "The Warder is an elite enemy that appears in the late game. It features a revolving shield that blocks damage from the direction the shield is currently facing. Additionally, while the Warder is alive, it provides a protective aura to nearby enemies, making them invulnerable until the Warder is defeated.",
		"enemy_swarmer_desc": "The Swarmer is an elite enemy that periodically launches groups of smaller enemies toward the main weapon. It continues to do so until it is destroyed.",
		"main_upgrade_health_common": "Reinforcement",
		"main_upgrade_health_uncommon": "Fortification",
