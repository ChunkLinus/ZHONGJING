		"augment_stormBattery": "Storm Battery",
		"augment_stormBattery_desc": "Main Turret deals Electrical damage to nearby enemies. Each Electric Weapon equipped raises base damage.",
		"augment_lightningSparks": "Sparks",
		"augment_lightningSparks_desc": "On a critical hit by Electric weapons, release 6 Lightning Sparks that scale their damage with Crit Chance and Crit Multiplier.",
		"augment_efficientGrid": "Efficient Grid",
		"augment_EfficientGrid_desc": "For every non-Electric Weapon equipped, increase all Electric duration by 10%.",
		"augment_violentDischarge": "Violent Discharge",
		"augment_violentDischarge_desc": "Static deals more damage and has greater range. Enemies killed by Static have a 50% chance to spread Static to nearby enemies.",
		"augment_electrifiedTurret": "Electrified Turret",
		"augment_electrifiedTurret_desc": "Main Weapon gains +5 Base Electric Damage and increases all Electric weapon damage by 10%.",
		"augment_pyromancy": "Pyromancy",
		"augment_pyromancy_desc": "Increase Heat Damage by 2% for every Ignited enemy. Applying Ignite deals bonus Heat damage based on Ignite duration and damage.",
		"augment_cauterization": "Cauterization",
		"augment_cauterization_desc": "Range bonuses also apply to damage dealt close to Main Weapon by Heat Weapons/Effects.",
		"augment_furnaceCore": "Furnace Core",
		"augment_furnaceCore_desc": "Main Turret gains +5 base Heat Damage. All Heat damage increased by 10%.",
		"augment_fireball": "Fireball",
		"augment_fireball_desc": "Firing the Main Weapon releases a slow-moving Fireball that deals Heat damage to enemies in its path. Max 1 Fireball active.",
		"augment_flameWave": "Flame Wave",
		"augment_flameWave_desc": "Adds Flame Wave consumable to starting inventory and loot pool. Ignites all visible enemies and consumes 10% of Main Turret's current health.",
		"augment_blazingGlory": "Blazing Glory",
		"augment_blazingGlory_desc": "Enemies close to Main Weapon take +25% Heat Damage and have additional 12% chance of being Ignited from Heat Damage.",
		"augment_gunslinger": "Gunslinger",
		"augment_gunslinger_desc": "Raise Max Word Rush by 5. Each rank of Word Rush gives +2.5% kinetic damage.",
		"augment_bloodlust": "Bloodlust",
		"augment_bloodlust_desc": "Increase Kinetic Rate of Fire by 2% and Range by 1% for every Bleeding enemy.",
		"augment_infusedAmmo": "Infused Ammo",
		"augment_infusedAmmo_desc": "Crits with Kinetic Damage have 40% chance to apply a random Status on the enemy.",
		"augment_scrapArmaments": "Shrapnel",
		"augment_scrapArmaments_desc": "Chance to drop Shrapnels - adds 10 base Kinetic Damage to Kinetic Weapons for 20 seconds.",
		"augment_combinedArms": "Combined Arms",
		"augment_combinedArms_desc": "For every non-Kinetic Weapon equipped, increase all Kinetic damage by 10%.",
		"augment_pocketTurret": "Pocket Turret",
		"augment_pocketTurret_desc": "Adds Pocket Turret consumable to inventory and loot pool. Pocket Turret spawns a turret and can be picked up on expiry.",
		"wiki_tag_label": "Tags",
		"wiki_name_label": "Name",
		"wiki_cost_label": "Cost",
		"wiki_description_label": "Description",
		"wiki_title": "Glyphica Official Wiki",
		"wiki_subtitle": "Official Wiki of Glyphica Typing Survival",
		"wiki_home_title": "Home",
		"wiki_landingPage_title": "Welcome Typist",
		"wiki_landingPage_intro": "Welcome to the official wiki for Glyphica: Typing Survival! Test your typing skills in this horde survival game where speed and accuracy are your ultimate weapons. Equip powerful tools that transform your typing prowess into devastating attacks against relentless foes. Discover more and grab the game on Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "This wiki serves as a comprehensive guide to the features, mechanics, and content available in the Early Access version of Glyphica. Our goal is to keep the information up-to-date as we progress toward the full release, version 1.0. The wiki is organised into sections listed in the table of contents and will be updated regularly as the game evolves.",
		"wiki_tableOfContents_title": "Table of Contents",
		"wiki_mainWeapons_title": "Main Weapons",
		"wiki_mainWeapons_intro": "Main weapons are the starting weapons in *Glyphica* and play a central role in gameplay. When you type a word displayed above an enemy, the main weapon locks onto that enemy as its target. Each main weapon has unique effects and mechanics, requiring different strategies to use effectively.",
		"wiki_mainWeapons_intro2": "While some main weapons emphasize typing speed (WPM), others demand a more tactical approach. Like other weapons in the game, main weapons can be upgraded and evolved, enhancing their abilities and effectiveness as you progress.",
		"wiki_mainWeapons_list_title": "List of Main Weapons",
		"wiki_weapons_title": "Level-Up Weapons",
		"wiki_weapons_intro": "Level-up weapons are obtained during a run as you level up. Once selected, the weapon is added to your arsenal. Each weapon has a unique activation method, but most can be triggered through typing and targeting with the main weapon.",
		"wiki_weapons_intro2": "A maximum of four weapons can be obtained this way. Once a weapon is added to your arsenal, its upgrades become available in the level-up upgrade pool, allowing you to enhance its abilities as you progress.",
		"wiki_weapons_list_title": "List of Level-Up Weapons",
		"wiki_weapon_evolution_title": "Evolutions",
		"wiki_weapon_upgrade_title": "Upgrades",
		"wiki_lootItems_title": "Loot Items",
		"wiki_lootItems_intro": "Loot items are obtained during a run by activating a treasure chest pickup. A randomised selection of loot items will be displayed, and choosing one grants a passive bonus that remains active for the rest of the run.",
		"wiki_lootItems_intro2": "Loot items are categorised as **common**, **uncommon**, and **rare**, which determine their likelihood of appearing in loot selections. Defeating a boss in Trial Mode rewards a treasure chest containing only rare items.",
		"wiki_lootItems_rare_title": "List of Rare Loot",
		"wiki_lootItems_uncommon_title": "List of Uncommon Loot",
		"wiki_lootItems_common_title": "List of Common Loot",
		"wiki_enemies_title": "Enemies",
		"wiki_enemies_intro": "Enemies in *Glyphica* are procedurally spawned based on an internal metric called **threat**, which increases as the run progresses. In Trial Mode, the threat is multiplied by the current Trial Level, making each level progressively harder. In Endless Mode, the threat is compared to an adaptive scaling system based on the player's level, with the higher value determining the spawn difficulty.",
		"wiki_enemies_intro2": "Enemies are also categorised into **specials** and **elites**, each with its own class cap that limits their spawn rate within the overall threat level.",
		"wiki_enemies_list_title": "List of Enemies",
		"wiki_enemy_variants_title": "List of Variants",
		"wiki_image_label": "Image",
		"wiki_splitter_shard_count": "Shard Count",
		"wiki_splitter_shard_health": "Shard Health",
		"wiki_splitter_shard_damage": "Shard Damage",
		"wiki_augments_title": "Augments",
		"wiki_augments_intro": "Augments are permanent upgrades that can be unlocked using Coins (§), a currency earned during a run. At the start of each run, players have a limited number of slots to equip unlocked augments, with the number of available slots varying based on the selected Omen level.",
		"wiki_augments_intro2": "Each augment usually has specific conditions that determine its benefits. To get the most out of your augments, consider the synergies between them and align them with your preferred strategy.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Determination",
		"NEW_ACHIEVEMENT_1_0_DESC": "Survive 20 minutes in Endless Mode with any main weapon.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Persistence",
		"NEW_ACHIEVEMENT_1_1_DESC": "Survive 30 minutes in Endless Mode with any main weapon.",
