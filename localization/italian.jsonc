		"evo_repeater_explodingBullets": "Proiettili Esplosivi",
		"evo_repeater_explodingBullets_desc": "Effetti:\n Danno Esplosivo: {1}\n Danno Cinetico: {2}\n\nInfluenza il danno base. Il Ripetitore ora usa munizioni esplosive che infliggono danno esplosivo in ​​un piccolo raggio.",
		"evo_repeater_explodingBullets_2": "Proiettili Esplosivi II",
		"evo_repeater_explodingBullets_2_desc": "Effetti:\n Danno Esplosivo: {1}\n Danno Cinetico: {2}\n\nIl raggio di esplosione dei proiettili del Ripetitore è leggermente aumentato.",
		"evo_heatray_iceBeam": "Raggio di Ghiaccio",
		"evo_heatray_iceBeam_desc": "Effetti:\n  Danno da Calore: {1}\n  Danno da Freddo: {2}\n  Chance di Congelamento: {3}\n\nInfluisce sul danno base. Il danno da Raggio di Calore diventerà Freddo e ha una possibilità aggiuntiva di infliggere Congelamento.",
		"evo_heatray_iceBeam_2": "Raggio di Ghiaccio II",
		"evo_heatray_iceBeam_2_desc": "Effetti:\n  Danno da Freddo: {1}\n\nInfluisce sul danno base.",
		"evo_heatray_reflection": "Riflesso",
		"evo_heatray_reflection_desc_2": "Il Raggio di Calore ora passa attraverso i nemici e si riflette {1} sul bordo dello schermo.",
		"evo_heatray_reflection_2": "Riflesso II",
		"evo_heatray_reflection_2_desc_2": "Il Raggio di Calore ora si riflette {1} sul bordo dello schermo.",
		"evo_heatray_doubleBladed": "Doppia Lama",
		"evo_heatray_doubleBladed_desc": "Un altro raggio spara in direzione opposta. Tutte le evoluzioni e potenziamenti si applicano su entrambi i raggi.",
		"evo_heatray_blaster": "Demolitore",
		"evo_heatray_blaster_desc": "Effetti:\n Velocità di Fuoco: {1}\n\nIl Raggio di Calore ora spara un proiettile laser indipendente e multi-colpo invece di un raggio costante, che conta comunque come arma D.N.T.",
