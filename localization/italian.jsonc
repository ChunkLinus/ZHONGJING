		"evo_barrage_rocketArray": "Gruppo di Razzi",
		"evo_barrage_rocketArray_desc": "Lo Sbarramento ora sparerà {1} missili per barra munizione invece di {2}.",
		"evo_barrage_rocketArray_2": "Gruppo di Razzi II",
		"evo_barrage_seismicMunition": "Munizioni Sismiche",
		"evo_barrage_seismicMunition_desc": "Invece di esplodere, i missili si conficcano nel terreno e generano impulsi esplosivi per i successivi secondi.",
		"evo_barrage_seismicMunition_2": "Munizioni Sismiche II",
		"evo_barrage_seismicMunition_2_desc": "Impulsi di munizioni sismiche:\n Raggio: {1}\n Durata: {2}",
		"evo_barrage_resupply": "Rifornimento",
		"evo_barrage_resupply_desc": "Ora verranno generate risorse di rifornimento. Attivando queste risorse ricaricherai completamente la tua arma principale e darai {1} di danno in più al colpo successivo.",
		"evo_barrage_resupply_2": "Rifornimento II",
