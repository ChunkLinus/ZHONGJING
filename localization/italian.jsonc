		"evo_barrage_total_saturation": "Saturazione Totale",
		"evo_barrage_total_saturation_desc": "Effetto Globale:\n  Tutti gli Effetti/Armi Esplosive:\n   Danno: {1}",
		"evo_splattershot_bubble": "Bolla di Melma",
		"evo_splattershot_bubble_desc": "Le risorse della Bolla di Melma compaiono nelle Zone di Schizzo.\n\nQuando attivate, le Bolle di Melma scoppiano, infliggendo danni in un piccolo raggio e creando ulteriori Zone di Schizzo.",
		"evo_splattershot_bubble_2": "Bolla di Melma II",
		"evo_splattershot_bubble_2_desc": "Aumento della frequenza delle Bolle di Melma.\n\nLe Bolle di Melma hanno il 50% di possibilità di scoppiare automaticamente quando scadono.",
		"evo_splattershot_infestation": "Infestazione",
		"evo_splattershot_infestation_desc": "Effetti dello Sparaschizzi:\n Chance di Effetto di Stato: {1}\n\nEffetti Globali:\n  Danno da Effetto di Stato: {2}",
		"evo_splattershot_infestation_2": "Infestazione II",
		"evo_splattershot_infestation_2_desc": "I nemici uccisi dagli Effetti di Stato esplodono nelle Zone di Schizzo.",
		"evo_splattershot_lava": "Lava",
