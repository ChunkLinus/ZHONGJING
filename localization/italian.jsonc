		"evo_overmind_burningOnes_charge": "Accumulo di Calore",
		"evo_overmind_burningOnes_charge_desc": "Sovraccarico termico: {1}%",
		"evo_overmind_null_field": "Campo Nullo",
		"evo_overmind_null_field_desc": "I nemici presi di mira da Super-Mente vengono rallentati e subiscono {1} danni da altri effetti ed armi Elettriche.",
