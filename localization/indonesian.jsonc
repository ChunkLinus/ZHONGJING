		"item_regeneration": "Regenerasi",
		"item_regeneration_desc": "Menyembuhkan {1} kesehatan maksimal saat mengaktifkan Loot, Beku, Kerusakan Ganda, Re-roll, atau Perisai.",
		"item_DOTCanCrit": "Erosi",
		"item_DOTCanCrit_desc": "Senjata DOT bisa Kritikal.",
		"item_cryotechnics": "Krioteknik",
		"item_cryotechnics_desc": "Pengambilan Beku:\n Peluang Jatuh: {1}\n\nPenjemputan Kerusakan Ganda:\n -100% Peluang Jatuh",
		"item_warlike": "Suka berperang",
		"item_warlike_desc": "Pengambilan Kerusakan Ganda:\n Peluang Jatuh: {1}\n\nPengambilan Beku:\n -100% Peluang Jatuh",
		"item_pinata": "Pinata",
		"item_pinata_desc": "Efek Global:\n  Frekuensi Jarahan: {1}",
		"item_point_blank": "Titik Kosong",
		"item_point_blank_desc": "Musuh yang terkena serangan dekat dengan Senjata Utama menerima {1} kerusakan.",
		"item_shatter": "Pecah",
		"item_shatter_desc": "Semua Senjata Kinetik mendapatkan {1} Peluang Kritikal melawan musuh Beku.",
		"item_seer": "Peramal",
		"item_seer_desc": "Mengaktifkan Pengambilan Re-roll akan meningkatkan Jangkauan global Kamu sebesar 10% selama 10 detik. Tumpukan hingga 3 kali.",
		"item_seer_desc_2": "Jika Kamu memiliki 0 Re-roll saat memasuki layar kenaikan level, evolusi, atau jarahan, Kamu akan mendapatkan 1 Re-roll.",
		"item_resilience": "Ketahanan",
		"item_resilience_desc": "Mengaktifkan Pengambilan Perisai meningkatkan Durasi global Kamu sebesar 10% selama 10 detik. Tumpukan hingga 3 kali.",
		"item_resilience_desc_2": "Untuk setiap Perisai yang kamu miliki, mendapatkan {1} Durasi global.",
		"item_gambler": "Penjudi",
		"item_gambler_desc": "Menambahkan 1 Re-roll dan meningkatkan Max Re-roll, menjadi total 6.",
		"item_protector": "Pelindung",
		"item_protector_desc": "Menambahkan 1 Perisai dan meningkatkan Max Perisai, menjadi total 4.",
		"item_flawless": "Sempurna",
		"item_flawless_desc": "Setiap x{1} Input Sempurna juga meningkatkan Laju Tembakan global Kamu sebesar {2}.",
		"item_release": "Lepaskan",
		"item_release_desc": "Saat salah ketik, berikan {1} Kerusakan ledakan ke semua musuh untuk setiap x{2} Input Sempurna.",
		"item_wasting": "Pemborosan",
		"item_wasting_desc": "Semua Senjata D.O.T: +35% Laju Tembakan",
		"item_wither": "Layu",
		"item_wither_desc": "Semua Efek Status: +35% Laju Tembakan",
		"consumable_medpack": "Obat Medis",
		"consumable_medpack_desc": "Menambahkan {1} Obat Medis ke inventaris Anda.\n\nObat Medis menyembuhkan hingga {2} dari kesehatan maksimal Turret Utama.",
		"consumable_serum": "Serum",
		"consumable_serum_desc": "Menambahkan {1} Serum ke dalam inventori kamu.\n\nSerum memberikan {2} Peluang Kritik selama {3} detik.",
		"consumable_warhead": "Hulu Ledak",
		"consumable_warhead_desc": "Menambahkan {1} Hulu ledak ke inventaris Anda.\n\nHulu ledak melepaskan serangkaian ledakan dahsyat yang memancar keluar dari senjata utama.",
		"weapon_warhead_desc": "Efek yang dapat dikonsumsi - tidak dihitung sebagai senjata.\n\nMelepaskan serangkaian ledakan dahsyat yang memancar keluar dari senjata utama.",
		"consumable_flameWave": "Gelombang Api",
		"consumable_flameWave_desc": "Menambahkan {1} Gelombang Api ke inventaris Anda.\n\nGelombang Api membakar semua musuh yang terlihat dengan biaya 10% dari kesehatan Turret Utama saat ini.",
		"weapon_flameWave_desc": "Efek yang dapat dikonsumsi - tidak dihitung sebagai senjata.\n\nMenghancurkan semua musuh yang terlihat dengan biaya 10% dari kesehatan Turret Utama saat ini.",
		"consumable_cryocore": "Cryocore",
		"consumable_cryocore_desc": "\n\nMenambahkan {1} Cryocores ke inventarismu.\n\nCryocores memicu efek pembekuan global.",
		"consumable_killPill": "Kill Pill",
		"consumable_killPill_desc": "Menambahkan {1} Kill Pills ke inventaris Anda.\n\nKill Pills memicu efek global Kerusakan Ganda.",
		"consumable_pocketTurret": "Pocket Turret",
		"consumable_pocketTurret_desc": "Menambahkan {1} Pocket Turret ke inventori.\n\nPocket Turret memunculkan menara otomatis di dekat musuh.",
		"weapon_pocket_turret_desc": "Efek konsumsi - tidak dihitung sebagai senjata.\n\nMemunculkan turret otomatis di dekat kelompok musuh.",
		"item_plunder": "Menjarah",
		"item_plunder_desc": " +1 Opsi Penjarahan",
		"item_multitargeting": "Multi-Penargetan",
		"item_multitargeting_desc": "Semua Senjata Jarak Jauh mendapatkan +1% Peluang Kritik untuk setiap Senjata yang Kamu miliki.",
		"item_pickupMagnet": "Magnet Raksasa",
		"item_pickupMagnet_desc": "Kamu mendapat {1} kesempatan secara otomatis mengumpulkan pengambilan saat habis masa berlakunya.",
		"item_frostbite": "Radang dingin",
		"item_frostbite_desc": "Musuh menerima kerusakan seiring waktu saat Beku.",
		"item_necrobomb": "Necrobomb",
		"item_necrobomb_desc": "Saat menghancurkan musuh dengan kerusakan Ledakan Kritikal, memicu serangkaian ledakan di sekitar posisi musuh yang tewas.",
		"item_prize": "Hadiah",
		"item_prize_desc": "Saat menghancurkan musuh dengan kerusakan Kritikal, {1} peluang untuk memunculkan Re-roll, Perisai, atau pengambilan Health.",
		"item_aftershock": "Gempa susulan",
		"item_aftershock_desc": "Kerusakan kritikal akan selalu menimbulkan efek status.",
		"item_vampirism": "Vampirisme",
		"item_vampirism_desc": "Dapatkan Health yang setara dengan {1} dari kerusakan Kritikal Kinetik.",
		"item_wisdom": "Kebijaksanaan",
		"item_wisdom_desc": "Saat mengambil Perisai, dapatkan 10 Kill untuk semua Evolusi senjata.",
		"item_jester": "Jester",
		"item_jester_desc": "Saat mengambil Re-roll, berikan jumlah kerusakan acak antara 0 dan 100 ke semua musuh di layar.",
		"item_jester_2_desc": "Saat menyelesaikan kata, mengeluarkan Jester Drone yang memberikan 0-100% kerusakan pada target acak. Cooldown 10 detik di antara aktivasi.",
		"item_lastStand": "Yang Terakhir",
		"item_lastStand_desc": "Mendapatkan Kerusakan Ganda, Pada saat Perisai hancur.",
		"item_tripleDamage": "Kerusakan Tiga Kali Lipat",
		"item_tripleDamage_desc": "Semua Kerusakan Ganda sekarang menjadi Kerusakan Tiga Kali Lipat.",
		"item_fracture": "Patah tulang",
		"item_fracture_desc": "Selama Pembekuan, setiap pickup Pembekuan yang seharusnya muncul adalah Patah Tulang, yang memberikan kerusakan pada setiap musuh yang dibekukan.",
		"item_fracture_desc_2": "Semua kerusakan pada musuh yang dibekukan meningkat sebesar {1}. Pengubah memiliki sifat penggandaan.",
		"item_ascetic": "Pertapa",
		"item_ascetic_desc": "Saat keluar dari layar Loot, dapatkan +10% kerusakan untuk setiap Re-roll yang tidak terpakai selama 20 detik.",
		"item_harmonizer": "Harmonizer",
		"item_harmonizer_desc": "Semua senjata yang digunakan mendapatkan satu level Evolusi.",
		"item_immortality": "Keabadian",
		"item_immortality_desc": "Jika Senjata Utama Kamu akan dihancurkan, maka akan berkurang menjadi 1 health. Kemampuan ini hanya dapat digunakan setiap 2 menit sekali.",
		"item_immortality_desc_2": "Jika Senjata Utama Kamu akan dihancurkan, maka akan berkurang menjadi 1 HP, dan semua musuh yang berada dalam jarak 400 meter dari senjata utama akan terkena kerusakan kinetik yang mematikan. Kemampuan ini hanya dapat digunakan sekali setiap 2 menit.",
		"item_enlightenment": "Pencerahan",
		"item_enlightenment_desc": "Saat menghancurkan musuh dengan kerusakan Kritikal, mendapatkan +1 kill untuk semua Evolusi senjata.",
		"item_closer": "Lebih dekat",
		"item_closer_desc": "Menyelesaikan kata musuh setelah dihancurkan memberikan +10% kerusakan selama 10 detik. Tumpukan hingga 3 kali.",
		"item_murderous": "Pembunuhan",
		"item_murderous_desc": "Semua Senjata Drone: +50% Kerusakan",
		"item_executioner": "Algojo",
		"item_executioner_desc": "Semua Senjata Turret: +50% Kerusakan",
		"item_degeneration": "Degenerasi",
		"item_degeneration_desc": "Semua Senjata Jarak Jauh: +50% Kerusakan",
		"item_clone": "Klon",
		"item_clone_desc": "Barang konsumsi memiliki peluang 30% untuk mereplikasi diri saat digunakan.",
		"augment_category_mainWeapon": "Codex: Senjata Utama",
		"augment_category_turret": "Codex: Turret",
		"augment_category_drones": "Codex: Drone",
		"augment_category_dot": "Codex: D.O.T.",
		"augment_category_remote": "Codex: Remot",
		"augment_category_electric": "Codex: Electrik",
