		"boss_poet": "Poet",
		"boss_poet_desc": "Ketik bagian yang ditampilkan oleh bos. \nKamu dapat terus mengincar musuh sambil melakukannya.",
		"boss_cypher": "Cipher",
		"boss_cypher_desc": "Bos ini mengacak-acak huruf yang ada di dekatnya. \nHancurkan dengan senjata yang kamu miliki.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "Bos ini menembakkan proyektil yang dapat dihancurkan ke arahmu. Hancurkan ketiga kepala dengan senjatamu.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Bos ini mengitarimu tanpa henti.\nAtur tembakanmu pada target tetap di jalurnya untuk menghantamnya dengan senjata milikmu.",
		"boss_gemini": "Gemini",
		"boss_gemini_desc": "Menghancurkan kedua anak kembar secara merata. \nMereka akan saling menyembuhkan satu sama lain dari waktu ke waktu hingga total kesehatan mereka sendiri.",
		"weapon_repeater_title": "Repeater",
		"weapon_heatray_title": "Sinar Panas",
		"weapon_barrage_title": "Rentetan",
		"weapon_overmind_title": "Overmind",
		"weapon_splattershot_title": "Tembakan Lendir",
		"weapon_wildcard_title": "Wildcard",
		"weapon_spectre_title": "Hantu",
		"weapon_tesla_title": "Ranjau Tesla",
		"weapon_sentry_title": "Penjaga",
		"weapon_oscillator_title": "Osilator",
		"weapon_meteor_title": "Meteor",
		"weapon_hunter_title": "Pemburu",
		"weapon_chopper_title": "Pemotong",
		"weapon_minefield_title": "Ladang Ranjau",
		"weapon_blade_title": "Perangkap Pisau",
		"weapon_firestorm_title": "Badai Api",
		"weapon_guardian_title": "Pelindung",
		"weapon_orbiter_title": "Pengorbit",
		"weapon_frostbite_title": "Radang Dingin",
		"weapon_bleeding_title": "Pendarahan",
		"weapon_blight_title": "Hawar",
		"weapon_static_title": "Statis",
		"weapon_ignite_title": "Terbakar",
		"weapon_heatray_requirements": "Selesaikan Trial Repeater di level Omen apa pun.",
		"weapon_barrage_requirements": "Selesaikan Trial di Omen Level 3 dengan senjata utama apa pun.",
		"weapon_repeater_desc": "Senjata penghancur yang menembakkan sejumlah peluru dalam semburan pendek.",
		"weapon_heatray_desc": "Menembakkan seberkas cahaya terkonsentrasi yang sangat akurat dan konstan yang menimbulkan kerusakan seiring waktu.",
		"weapon_barrage_desc": "Menembakkan rentetan roket peledak ke target dan sekitarnya. Mengisi ulang daya seiring waktu.",
		"weapon_overmind_desc": "Memerintahkan berbagai macam drone untuk menimbulkan kerusakan energi pada musuh.",
		"weapon_splattershot_desc": "Menembakkan gumpalan lendir ke lawan untuk melumpuhkan dan merusak mereka.",
		"weapon_wildcard_desc": "Tembakanmu berikutnya dipilih secara acak dari empat senjata yang memungkinkan, jadi tembaklah dengan hati-hati.",
		"weapon_spectre_desc": "Memunculkan drone cepat jarak dekat yang setara dengan jumlah drone yang cocok.",
		"weapon_sentry_desc": "Menerjunkan menara otomatis yang menembaki musuh di dalam jangkauan.",
		"weapon_tesla_desc": "Menerjunkan turret listrik yang menimbulkan kerusakan seiring waktu.",
		"weapon_oscillator_desc": "Menembakkan aliran partikel yang berosilasi ke arah target terakhir kamu.",
		"weapon_meteor_desc": "Secara berkala memunculkan penanda target di lokasi acak yang dapat diaktifkan untuk memulai pemboman orbital.",
		"weapon_hunter_desc": "memunculkan drone yang menembakkan sinar listrik dengan jumlah setara dengan jumlah yang cocok di atas.",
		"weapon_chopper_desc": "Memunculkan pedang berputar yang besar pada tembakan senjata utama yang bergerak ke tepi layar, melukai semua musuh yang dilewatinya.",
		"weapon_minefield_desc": "Memunculkan ranjau yang bergerak lambat yang meledak saat bersentuhan dengan musuh.",
		"weapon_blade_desc": "Menyebarkan perangkap bilah empat jari yang berputar.",
		"weapon_firestorm_desc": "Meriam yang menembakkan rentetan peluru peledak jarak pendek. Meriam ini mengitari turret utama dan memerlukan jeda sebelum menembak lagi.",
		"weapon_guardian_desc": "Gunakan Drone secara instan untuk menembakkan laser ke arah musuh. Aktifkan pengambilan bahan bakar untuk mengisi bahan bakar Guardian, yang akan mengonsumsi bahan bakar dan menonaktifkannya saat kosong.",
		"weapon_orbiter_desc": "menyebarkan Orb yang mengorbitkan Senjata Utama, merusak semua yang dilewatinya.",
		"weapon_frostbite_desc": "Efek Loot - tidak dihitung sebagai senjata.\n\nMusuh menerima kerusakan dari waktu ke waktu saat dibekukan.",
		"weapon_bleeding_desc": "Efek status - tidak dihitung sebagai senjata.\n\nMusuh menerima kerusakan Kinetik seiring waktu hingga efeknya berakhir.",
		"weapon_blight_desc": "Efek status - tidak dihitung sebagai senjata.\n\nMusuh menerima kerusakan Kimia dari waktu ke waktu dan diperlambat hingga efeknya berakhir.",
		"weapon_static_desc": "Efek status - tidak dihitung sebagai senjata.\n\nMusuh menerima kerusakan Energi seiring waktu, dan memberikan kerusakan Energi ke musuh di sekitar hingga efeknya berakhir.",
		"weapon_ignite_desc": "Efek status - tidak dihitung sebagai senjata.\n\nMusuh menerima kerusakan Panas seiring waktu hingga efeknya berakhir.",
		"weapon_caltrops_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nPada serangan kritis oleh senjata jarak jauh, memunculkan 12 Caltrop yang merusak musuh yang lewat, dengan peningkatan peluang pendarahan berdasarkan kerusakannya.",
		"weapon_stormBattery_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nTurret Utama memberikan kerusakan listrik kepada musuh di dekatnya. Setiap Senjata Listrik yang dilengkapi akan meningkatkan kerusakan dasar.",
		"weapon_lightningSparks_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nPada serangan kritis oleh senjata Listrik, melepaskan 6 Percikan Petir yang meningkatkan kerusakannya dengan Peluang Kritik dan Pengganda Kritik.",
		"weapon_darkRelay_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nProyektil memantul di antara Turret yang ada secara acak, memberikan kerusakan listrik.",
		"weapon_jester_desc": "Efek Loot - tidak dihitung sebagai senjata.\n\nSaat mengambil Re-roll, berikan jumlah kerusakan acak antara 0 dan 100 ke semua musuh di layar.",
		"weapon_necrobomb_desc": "Efek Loot - tidak dihitung sebagai senjata.\n\nSaat menghancurkan musuh dengan kerusakan Ledakan Kritis, memicu serangkaian ledakan di sekitar posisi musuh yang jatuh.",
		"weapon_release_desc": "Efek jarahan - tidak dihitung sebagai senjata.\n\nKetika salah ketik, berikan {1} Kerusakan eksplosif ke semua musuh untuk setiap x{2} Input Sempurna.",
		"weapon_retribution_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nSetiap kali Perisai dihancurkan, semua Drone yang ada akan hancur dengan sendirinya dan memberikan kerusakan ledakan.",
		"weapon_fireball_desc": "Efek Augment - tidak dihitung sebagai senjata.\n\nMenembakkan Senjata Utama juga melepaskan Bola Api lambat yang memberikan kerusakan Panas.",
		"contains_characters": "Melengkapi kata yang mengandung glif",
		"contains_glyphs": "Melengkapi set yang mengandung glif",
		"starts_with_character": "Melengkapi kata yang dimulai dengan glif",
		"starts_with_glyphs": "Melengkapi himpunan yang dimulai dengan glif:",
