		"evo_repeater_frostFang_desc": "Efek:\n Kerusakan Dingin: {1}\nPeluang Membekukan: {2}\n\nMempengaruhi kerusakan dasar dan dipengaruhi oleh pengubah kerusakan Dingin.",
		"evo_repeater_frostFang_2": "Taring Es II",
		"evo_repeater_frostFang_2_desc": "Efek:\n Kerusakan Dingin: {1}\nKerusakan Kinetik: {2}\n\nMempengaruhi kerusakan dasar.",
		"evo_repeater_ricochet": "Rikoset",
		"evo_repeater_ricochet_desc": "Efek:\n Rantai Proyektil: {1}\n\nProyektil Repeater memantul ke target terdekat secara acak, memberikan {2} kerusakan pada serangan setelah yang pertama.",
		"evo_repeater_ricochet_2": "Rikoset II",
		"evo_repeater_ricochet_2_desc": "Efek:\n Rantai Proyektil: {1}",
		"evo_repeater_shotgun": "Shotgun",
		"evo_repeater_shotgun_desc": "Efek:\n Jumlah Proyektil: {1}\n Penyebaran Proyektil: {2}\n Kerusakan Kinetik: {3}\n\nRepeater sekarang menembakkan beberapa proyektil yang lebih lemah dengan penyebaran yang besar. Pengubah kerusakan mempengaruhi kerusakan dasar.",
		"evo_repeater_shotgun_2": "Shotgun II",
		"evo_repeater_shotgun_2_desc": "Efek:\n Jumlah Proyektil: {1}\n Penyebaran Proyektil: {2}",
		"evo_repeater_explodingBullets": "Peluru Ledak",
		"evo_repeater_explodingBullets_desc": "Efek:\n Kerusakan Akibat Ledakan: {1}\nKerusakan Kinetik: {2}\n\nMempengaruhi kerusakan dasar. Repeater sekarang menggunakan amunisi peledak yang memberikan kerusakan eksplosif dalam radius kecil.",
		"evo_repeater_explodingBullets_2": "Peluru Ledak II",
		"evo_repeater_explodingBullets_2_desc": "Efek:\n Kerusakan Eksplosif: {1}\nKerusakan Kinetik: {2}\nJangkauan ledakan untuk peluru Repeater sedikit meningkat.",
		"evo_heatray_iceBeam": "Tembakan Es",
		"evo_heatray_iceBeam_desc": "Efek:\n Kerusakan Panas: {1}\n Kerusakan Dingin: {2}\nPeluang Membekukan: {3}\n\nMempengaruhi kerusakan dasar. Jenis kerusakan Sinar Panas akan menjadi Dingin dan memiliki peluang lebih besar untuk menimbulkan Freeze.",
		"evo_heatray_iceBeam_2": "Tembakan Es II",
		"evo_heatray_iceBeam_2_desc": "Efek:\n Kerusakan Dingin: {1}\n\nMempengaruhi kerusakan dasar.",
		"evo_heatray_reflection": "Refleksi",
		"evo_heatray_reflection_desc_2": "Sinar Panas sekarang dapat melewati musuh dan memantulkan {1} dari tepi layar.",
		"evo_heatray_reflection_2": "Refleksi II",
		"evo_heatray_reflection_2_desc_2": "Sinar Panas sekarang memantulkan {1} dari tepi layar.",
		"evo_heatray_doubleBladed": "Pedang Dua Mata",
		"evo_heatray_doubleBladed_desc": "Tembakan ke arah yang berlawanan. Semua evolusi dan peningkatan berlaku untuk kedua tembakan.",
		"evo_heatray_blaster": "Blaster",
		"evo_heatray_blaster_desc": "Efek:\n Laju Tembakan: {1}\n\nSinar Panas sekarang menembakkan proyektil laser multi-pukulan independen, bukan sinar konstan, yang masih dihitung sebagai senjata D.O.T..",
		"evo_heatray_blaster_2": "Blaster II",
		"evo_heatray_blaster_2_desc": "Efek:\n Panjang Proyektil: {1}\nKerusakan: {2}",
		"evo_heatray_solar_tap": "Solar Tap",
		"evo_heatray_solar_tap_desc": "Efek Global:\n Semua Efek Panas/Senjata:\n Peluang Efek Status: {1}",
		"evo_barrage_rocketArray": "Rangkaian Roket",
		"evo_barrage_rocketArray_desc": "Rentetan serangan sekarang akan menembakkan {1} rudal per bar amunisi, bukan {2}.",
		"evo_barrage_rocketArray_2": "Rangkaian Roket II",
		"evo_barrage_seismicMunition": "Munisi Seismik",
		"evo_barrage_seismicMunition_desc": "Rudal menancapkan diri ke dalam tanah alih-alih meledak dan menghasilkan denyut ledakan selama beberapa detik berikutnya.",
		"evo_barrage_seismicMunition_2": "Munisi Seismik II",
		"evo_barrage_seismicMunition_2_desc": "Denyut Amunisi Seismik:\n Jarak: {1}\n Durasi: {2}",
		"evo_barrage_resupply": "Pasokan ulang",
		"evo_barrage_resupply_desc": "Pengambil Pasokan sekarang akan muncul. Mengaktifkan Pengambilan ini akan mengisi ulang senjata utama kamu sepenuhnya dan memberikan dorongan kerusakan {1} untuk tembakan berikutnya.",
		"evo_barrage_resupply_2": "Pasokan ulang II",
		"evo_barrage_resupply_2_desc": "Pengambil Pasokan sekarang juga memberikan {1} peningkatan jangkauan ledakan untuk tembakan berikutnya.",
		"evo_barrage_resupply_pickup": "Amunisi Maksimal!",
		"evo_barrage_total_saturation": "Saturasi Total",
		"evo_barrage_total_saturation_desc": "Efek Global:\n Semua Efek Ledakan/Senjata:\n Kerusakan: {1}",
		"evo_splattershot_bubble": "Gelembung Slime",
		"evo_splattershot_bubble_desc": "Gelembung Slime muncul dalam Zona Percikan.\n\nSaat diaktifkan, Gelembung Slime akan meledak, menimbulkan kerusakan dalam radius kecil dan menciptakan Zona Percikan tambahan.",
		"evo_splattershot_bubble_2": "Gelembung Slime II",
		"evo_splattershot_bubble_2_desc": "Meningkatkan terjadinya Gelembung Slime.\n\nGelembung Slime memiliki peluang 50% untuk meledak secara otomatis saat habis masa berlakunya.",
		"evo_splattershot_infestation": "Infestasi",
		"evo_splattershot_infestation_desc": "Efek Tembakan Percikan:\n Peluang Efek Status: {1}\n\nEfek Global:\n Kerusakan Efek Status: {2}",
		"evo_splattershot_infestation_2": "Infestasi II",
		"evo_splattershot_infestation_2_desc": "Musuh yang terbunuh oleh Efek Status akan meledak ke dalam Zona Percikan.",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Efek:\n Kerusakan Kimia: {1}\n Kerusakan Panas: {2}\n\nMempengaruhi kerusakan dasar. Jenis kerusakan Tembakan Percikan akan menjadi Panas.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Efek:\n Kerusakan Panas: {1}\n\nMempengaruhi kerusakan dasar.",
		"evo_splattershot_virulence": "Virulensi",
		"evo_splattershot_virulence_desc": "Efek Zona Percikan:\n Durasi: {1}\n\nZona Percikan secara perlahan-lahan bertambah besar dari waktu ke waktu.",
		"evo_splattershot_chemical_catalyst": "Katalis Kimia",
		"evo_splattershot_chemical_catalyst_desc": "",
		"evo_overmind_syncronize": "Sinkronisasi",
		"evo_overmind_syncronize_desc": "Setiap kill yang dilakukan dengan Overmind memiliki peluang {1} untuk menambahkan +1 kill ke progres evolusi senjata Drone secara acak.",
		"evo_overmind_syncronize_2": "Sinkronisasi II",
		"evo_overmind_syncronize_2_desc": "Peluang untuk menambahkan +1 kill ke progres evolusi senjata drone acak ditingkatkan menjadi {1}.",
		"evo_overmind_shockSpire": "Shock Spire",
		"evo_overmind_shockSpire_desc": "Setiap 3 musuh yang ditargetkan secara bersamaan akan memunculkan sebuah Shock Spire di antara mereka.\n\nShock Spires memancarkan gelombang listrik periodik yang melintasi seluruh layar dan menyebabkan kerusakan listrik.",
		"evo_overmind_shockSpire_2": "Shock Spire II",
		"evo_overmind_shockSpire_2_desc": "Efek:\n Shock Spires:\n Kerusakan: {1}\n Durasi: {2}",
		"evo_overmind_burningOnes": "Burning Ones",
		"evo_overmind_burningOnes_desc": "Mengetik kata-kata mengisi meter yang akan menghasilkan Drone ledak saat penuh.\n\nDrone akan mengunci target musuh dan meledak saat bersentuhan, menyebabkan kerusakan ledak dalam radius kecil.",
		"evo_overmind_burningOnes_2": "Burning Ones II",
		"evo_overmind_burningOnes_2_desc": "Efek:\n Burning Ones: {1}\n Kerusakan Ledakan: {1}\n Jarak Ledakan: {2}",
		"evo_overmind_burningOnes_charge": "Penumpukan Panas",
		"evo_overmind_burningOnes_charge_desc": "Kelebihan Beban Termal: {1}%",
		"evo_overmind_null_field": "Null Field",
		"evo_overmind_null_field_desc": "Musuh yang menjadi target Overmind akan melambat dan menerima {1} kerusakan dari efek listrik dan senjata lainnya.",
		"evo_overmind_null_field_2": "Null Field II",
		"evo_overmind_null_field_2_desc": "Musuh yang menjadi target Overmind juga terpengaruh oleh Static saat menjadi target.",
		"evo_wildcard_winter": "Musim Dingin",
		"evo_wildcard_winter_desc": "Wildcard tidak lagi menembakkan proyektil panas.\n\nEfek Global:\n  Semua Efek Dingin/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_winter_2": "Musim Dingin II",
		"evo_wildcard_winter_2_desc": "Efek Global:\n  Semua Efek Dingin/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_warmth": "Kehangatan",
		"evo_wildcard_warmth_desc": "Wildcard tidak lagi menembakkan proyektil dingin.\n\nEfek Global:\n  Semua Efek Panas/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_warmth_2": "Kehangatan II",
		"evo_wildcard_warmth_2_desc": "Efek Global:\n  Semua Efek Panas/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_repulsor": "Repulsor",
		"evo_wildcard_repulsor_desc": "Wildcard tidak lagi menembakkan proyektil kinetik.\n\nEfek Global:\n  Semua Efek/Senjata Listrik:\n    Kerusakan: {1}",
		"evo_wildcard_repulsor_2": " Repulsor II",
		"evo_wildcard_repulsor_2_desc": "Efek Global:\n  Semua Efek Listrik/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_diamond": "Berlian",
		"evo_wildcard_diamond_desc": "Wildcard tidak lagi menembakkan proyektil listrik.\n\nEfek Global:\n  Semua Efek Kinetik/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_diamond_2": "Berlian II",
		"evo_wildcard_diamond_2_desc": "Efek Global:\n  Semua Efek Kinematik/Senjata:\n    Kerusakan: {1}",
		"evo_wildcard_fragmentation": "Fragmentasi",
		"evo_wildcard_fragmentation_desc": "Ketika proyektil kinetik mengenai Bola Panas, picu ledakan panas.\n\nKetika proyektil kinetik mengenai musuh yang dibekukan oleh proyektil dingin, picu ledakan dingin.",
		"evo_wildcard_fragmentation_2": "Fragmentasi II",
		"evo_wildcard_fragmentation_2_desc": "Ketika proyektil kinetik mengenai musuh, memicu ledakan kinetik.",
		"evo_wildcard_conduit": "Saluran",
		"evo_wildcard_conduit_desc": "Dalam jangkauan proyektil listrik, Bola Panas, dan musuh yang dibekukan oleh proyektil dingin akan menyebabkan kerusakan listrik pada musuh di sekitarnya.",
		"evo_wildcard_conduit_2": "Saluran II",
		"evo_wildcard_conduit_2_desc": "Orb Panas dan musuh yang dibekukan oleh proyektil Dingin akan selalu memberikan kerusakan Listrik kepada musuh yang berada di dekatnya.",
		"evo_wildcard_pestilence": "Wabah",
		"evo_wildcard_pestilence_desc": "Wildcard:\n  Semua Efek Status:\n    Peluang: {1}",
		"evo_wildcard_pestilence_2": "Wabah II",
		"evo_wildcard_pestilence_2_desc": "Efek Global:\n  Semua Efek Status:\n    Kerusakan: {1}",
		"evo_guardian_toxicWard": "Bangsal Beracun",
		"evo_guardian_toxicWard_desc": "Efek:\n Kerusakan Panas: {1}\nKerusakan Kimia: {2}\n\nMempengaruhi kerusakan basa. Jenis kerusakan Guardian akan menjadi Chemical.",
		"evo_guardian_toxicWard_2": "Bangsal Beracun II",
		"evo_guardian_toxicWard_2_desc": "Efek:\n Kerusakan Kimia: {1}\n\nMempengaruhi kerusakan dasar.",
		"evo_guardian_experimentalFuel": "Bahan Bakar Eksperimental",
		"evo_guardian_experimentalFuel_desc": "Pengambilan Bahan Bakar Khusus akan muncul yang memberikan bonus sementara kepada Guardian. Hanya satu dari bonus ini yang dapat aktif setiap saat.",
		"evo_guardian_experimentalFuel_2": "Bahan Bakar Eksperimental II",
		"evo_guardian_experimentalFuel_2_desc": "Semua bonus pengambilan Bahan Bakar khusus {1} dan durasi peningkatan {2}.",
		"evo_guardian_experimentalFuel_damage": "Bahan Bakar Eksperimental",
		"evo_guardian_experimentalFuel_speed": "Bahan Bakar Eksperimental",
		"evo_guardian_experimentalFuel_range": "Bahan Bakar Eksperimental",
		"evo_guardian_guardianTeam": "Tim Penjaga",
		"evo_guardian_guardianTeam_desc": "Efek:\n Kerusakan: {1}\nDrone: {2}\n\nGuardian sekarang menjadi dua drone, bukan satu.",
		"evo_guardian_guardianTeam_2": "Tim Penjaga II",
		"evo_guardian_guardianTeam_2_desc": "Efek:\n Kerusakan: {1}\nDrone: {2}\n\nGuardian sekarang menjadi tiga drone, bukan dua.",
		"evo_blade_bladeRepository": "Tempat Penyimpanan Pedang",
		"evo_blade_bladeRepository_2": "Tempat Penyimpanan Pedang II",
		"evo_blade_bladeRepository_desc": "juga akan memunculkan Perangkap Pisau sebagai tambahan dari mesin terbang yang sudah ada.",
		"evo_blade_poisonCoating": "Lapisan Racun",
		"evo_blade_poisonCoating_desc": "Efek:\n Kerusakan Kimia: {1}\nPeluang Hawar: {2}\n\nMempengaruhi kerusakan dasar dan dipengaruhi oleh pengubah kerusakan Kimia.",
		"evo_blade_poisonCoating_2": "Lapisan Racun II",
		"evo_blade_poisonCoating_2_desc": "Efek:\n Kerusakan Kimia: {1}\nPeluang Hawar: {2}\n\nMempengaruhi kerusakan dasar.",
		"evo_blade_sawtoothBlade": "Pedang Sawtooth",
		"evo_blade_sawtoothBlade_desc": "Perangkap Pisau menambahkan Peluang Kritikal untuk menimbulkan Pendarahan.",
		"evo_blade_sawtoothBlade_2": "Pedang Sawtooth II",
		"evo_blade_sawtoothBlade_2_desc": "Kerusakan Pendarahan meningkat sebesar {1}. Ini berlaku untuk Pendarahan yang ditimbulkan oleh semua sumber dan mempengaruhi kerusakan dasar.",
		"evo_blade_cutting_edge": "Teknologi Mutakhir",
		"evo_blade_cutting_edge_desc": "Efek Global:\n Semua Efek Menara/Senjata:\n Peluang Kritis: {1}",
		"evo_hunter_hunterElite": "Pemburu Elit",
		"evo_hunter_hunterElite_desc": "Setiap Pemburu ke-12 yang muncul adalah Pemburu Elit.\n\nPemburu Elit:\n +100% Damage\n +50% Durasi\n +50% Kecepatan\n +50% Jangkauan",
		"evo_hunter_hunterElite_2": "Pemburu Elit II",
		"evo_hunter_hunterElite_2_desc": "Pemburu Elit muncul di setiap Hunter ke-10 sebagai gantinya.\n\nPemburu Elit:\n +50% Durasi",
		"evo_hunter_electrifiedBolts": "Pasak Listrik",
		"evo_hunter_electrifiedBolts_desc": "Efek:\n  Kerusakan Kinetik: {1}\n  Kerusakan Listrik: {2}\n\nPemburu kini menembakkan proyektil alih-alih aliran listrik dan dianggap sebagai Senjata Kinetik.",
		"evo_hunter_electrifiedBolts_2": "Pasak Listrik II",
		"evo_hunter_electrifiedBolts_2_desc": "Efek:\n  Kerusakan Kinetik: {1}\n\nEfek Global:\n  Semua Efek/Senjata Kinetik:\n    Kerusakan: {2}",
		"evo_hunter_chainLightning": "Rantai Petir",
		"evo_hunter_chainLightning_desc": "Serangan Pemburu sekarang berantai ke 1 musuh terdekat.",
		"evo_hunter_chainLightning_2": "Rantai Petir II",
		"evo_hunter_chainLightning_2_desc": "Serangan Pemburu sekarang berantai ke 2 musuh terdekat.",
		"evo_hunter_predator_strain": "Predator Strain",
		"evo_hunter_predator_strain_desc": "Efek Global:\n Semua Efek/Senjata Drone:\n Durasi: {1}",
		"evo_minefield_mineLayer": "Minelayer",
		"evo_minefield_mineLayer_2": "Minelayer II",
		"evo_minefield_mineLayer_desc": "juga akan memunculkan Ranjau sebagai tambahan dari glif yang ada.",
		"evo_minefield_infusion": "Infusi",
		"evo_minefield_infusion_desc": "Efek:\n  Kerusakan Kimia: {1}\n  Kerusakan Ledakan: {2}\n\nLadang ranjau kini menyebabkan Kerusakan Kimia alih-alih Kerusakan Ledakan dan dianggap sebagai Senjata Kimia.",
		"evo_minefield_infusion_2": "Infus II",
		"evo_minefield_infusion_2_desc": "Efek:\n  Kerusakan Kimia: {1}\n  Peluang Penyakit: {2}\n\nEfek Global:\n  Semua Efek Kimia/Senjata:\n    Kerusakan: {3}",
		"evo_minefield_hunterSeeker": "Pencari Pemburu ",
		"evo_minefield_hunterSeeker_desc": "Efek: \n Kecepatan: {1}\n Jangkauan: {2}\n\nRanjau mendapatkan gerakan mengejar ke arah target acak.",
		"evo_minefield_hunterSeeker_2": "Pencari Pemburu II",
		"evo_minefield_hunterSeeker_2_desc": "Efek:\n Ranjau Muncul: {1}\n Kecepatan: {2}",
		"evo_minefield_dirtyBomb": "Bom Kotoran",
		"evo_minefield_dirtyBomb_desc": "Efek:\n Kerusakan Kimia: {1}\nKerusakan Senjata Percikan: {2}\n Ranjau melepaskan 3 genangan lumpur saat meledak.",
		"evo_minefield_dirtyBomb_2": "Bom Kotoran II",
		"evo_minefield_dirtyBomb_2_desc": "Efek:\n Kerusakan Kimia: {1}\nKerusakan Senjata Percikan: {2}\nSaat bergerak, ranjau menembakkan genangan lumpur secara berkala.",
		"evo_minefield_recursiveMines": "Ranjau Rekursif",
		"evo_minefield_recursiveMines_desc": "Turret Utama secara berkala memunculkan sejumlah ranjau berdasarkan setengah dari jumlah ranjau Minefield, dibulatkan ke bawah. Tingkat pemijahan ditentukan oleh stat Laju Tembakan Minefield.",
		"evo_minefield_recursiveMines_2": "Ranjau Rekursif II",
		"evo_minefield_recursiveMines_2_desc": "Ranjau Rekursif memunculkan {1} lebih cepat dan menghasilkan satu ranjau tambahan.",
		"evo_sentry_defenseGrid": "Jaringan Pertahanan",
		"evo_sentry_defenseGrid_2": "Jaringan Pertahanan II",
		"evo_sentry_defenseGrid_desc": "Efek:\n Turret: +1",
		"evo_sentry_solidCore": "Inti Padat",
		"evo_sentry_solidCore_desc": "Efek:\n Kerusakan Kinetik: {1}\n Kerusakan Panas: {2}\n\nSentry kini menimbulkan Kerusakan Kinetik alih-alih Kerusakan Panas dan dianggap sebagai Senjata Kinetik.",
		"evo_sentry_solidCore_2": "Inti Padat II",
		"evo_sentry_solidCore_2_desc": "Efek:\n  Kerusakan Kinetik: {1}\n\nEfek Global:\n  Semua Efek/Senjata Kinetik:\n    Kerusakan: {2}",
		"evo_sentry_watcher_supreme": "Pengawas Agung",
		"evo_sentry_watcher_supreme_desc": "Efek Global:\n Semua Efek Menara/Senjata:\n Jarak: {1}",
		"evo_sentry_emergencyProtocol": "Protokol Darurat",
		"evo_sentry_emergencyProtocol_desc": "Setiap kali Perisai Daya dihancurkan, Penjaga akan masuk ke mode Protokol Darurat selama {1} detik.\n\nSelama Protokol Darurat:\n Jangkauan: {2}\n Laju Tembakan: {3}",
		"evo_sentry_emergencyProtocol_2": "Protokol Darurat II",
		"evo_sentry_emergencyProtocol_2_desc": "Selama Protokol Darurat:\n Kerusakan: {1}\n Kecepatan Rotasi: {2}",
		"evo_spectre_supercharged": "Supercharged",
		"evo_spectre_supercharged_desc": "Setiap Hantu ke-20 yang muncul adalah Hantu SUPER.\n\nHantu Super:\n +100% Kerusakan\n +50% Durasi\n +50% Kecepatan",
		"evo_spectre_selfDestruct": "Penghancur Diri",
		"evo_spectre_selfDestruct_desc": "Efek:\n Kerusakan Eksplosif: {1}\n\nSaat Hantu berakhir, ia akan menghancurkan dirinya sendiri, menghasilkan Kerusakan Eksplosif. Mempengaruhi kerusakan dasar dan dipengaruhi oleh pengubah kerusakan Ledakan.",
		"evo_spectre_selfDestruct_2": "Penghancur Diri II",
		"evo_spectre_selfDestruct_2_desc": "Efek:\n Kerusakan Eksplosif: {1}\nJangkauan: {2}\n\nMempengaruhi kerusakan dasar.",
