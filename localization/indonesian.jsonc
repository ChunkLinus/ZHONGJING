		"evo_spectre_stalking_algorithms_desc": "Efek Global:\n Semua Efek Drone/Senjata:\n Kecepatan: {1}",
		"evo_tesla_abundantCoils": "Tumpukan Koil",
		"evo_tesla_abundantCoils_2": "Tumpukan Koil II",
		"evo_tesla_abundantCoils_desc": "juga akan memunculkan Tambang Tesla sebagai tambahan dari glif yang sudah ada.",
		"evo_tesla_electricalBurn": "Luka Bakar Setrum",
		"evo_tesla_electricalBurn_desc": "Efek:\n  Kerusakan Panas: {1}\n  Kerusakan Listrik: {2}\n\nRanjau Tesla kini menimbulkan Kerusakan Panas alih-alih Kerusakan Listrik dan dianggap sebagai Senjata Panas.",
		"evo_tesla_electricalBurn_2": "Luka Bakar Setrum II",
		"evo_tesla_electricalBurn_2_desc": "Efek:\n  Kerusakan Panas: {1}\n\nEfek Global:\n  Semua Efek Panas/Senjata:\n    Kerusakan: {2}",
		"evo_tesla_restrictedArea": "Area Terlarang",
		"evo_tesla_restrictedArea_desc": "Musuh dalam jangkauan Ranjau Tesla memiliki {1} peningkatan peluang untuk mendapatkan status Statis dari sumber kerusakan Listrik.",
		"evo_tesla_restrictedArea_2": "Area Terlarang II",
		"evo_tesla_restrictedArea_2_desc": "Kerusakan statis meningkat sebesar {1} dan jangkauan meningkat sebesar {2}. Ini berlaku untuk Statis yang ditimbulkan oleh semua sumber dan mempengaruhi kerusakan dasar.",
		"evo_tesla_storm_sovereign": "Penguasa Badai",
