		"augment_category_kinetic": "Codex: Kintetik",
		"augment_armored": "Lapis Baja",
		"augment_armored_desc": "Senjata Utama: Health: +50%",
		"augment_eager": "Bersemangat",
		"augment_eager_desc": "Di awal setiap permainan Trial atau Endless, dapatkan satu level. Untuk setiap 4 menit bertahan dalam Mode Tanpa Akhir, dapatkan satu level.",
		"augment_gambler": "Penjudi",
		"augment_gambler_desc": "Setiap Re-roll yang Kamu gunakan memberikan Senjata Utama +20% kerusakan selama 20 detik.",
		"augment_haze": "Kabut",
		"augment_haze_desc": "Jika Kamu memiliki kesehatan kurang dari 50%, dapatkan bonus Rate of Fire global +50%.",
		"augment_immaculate": "Bersih",
		"augment_immaculate_desc": "Perfect Input memberikan +1.5% Kesempatan Kritikal per stack.",
		"augment_devotion": "Pengabdian",
		"augment_devotion_desc": "Senjata Utama mendapatkan +25% kerusakan untuk setiap slot senjata yang kosong. Setidaknya satu opsi selama kenaikan level adalah peningkatan.",
		"augment_armada": "Armada",
		"augment_armada_desc": "20% peluang untuk mengeluarkan drone tambahan, setiap kali ada drone yang dikeluarkan.",
		"augment_diversity": "Keanekaragaman",
		"augment_diversity_desc": "Untuk setiap Senjata non-Drone yang digunakan, meningkatkan semua durasi Drone sebesar 20%.",
		"augment_blitzkrieg": "Serangan Kilat",
		"augment_blitzkrieg_desc": "Peningkatan kecepatan Drone juga berlaku untuk serangan Drone.",
		"augment_retribution": "Retribusi",
		"augment_retribution_desc": "Setiap kali sebuah Perisai dihancurkan, semua Drone yang ada akan hancur dengan sendirinya dan memberikan kerusakan eksplosif.",
		"augment_scapegoat": "Kambing hitam",
		"augment_scapegoat_desc": "Kesalahan ketik secara acak menghancurkan Drone yang ada dan tidak dihitung sebagai kesalahan ketik.",
		"augment_spoils": "Rampasan",
		"augment_spoils_desc": "Drone dapat menjatuhkan pickups pada saat kedaluwarsa.",
		"augment_fortress": "Benteng",
		"augment_fortress_desc": "Setiap Evolusi Turret juga memberikan +50 kesehatan maksimal Senjata Utama.",
		"augment_networked": "Jaringan",
		"augment_networked_desc": "Setiap Turret lainnya memberikan +10% Tingkat Serangan ke semua Turret, hingga maksimum +50%.",
		"augment_fieldIntel": "Intel Lapangan",
		"augment_fieldIntel_desc": "Mengaktifkan pickup akan memberikan +30% Range ke semua Turret yang ada. Efek ini tidak bertumpuk.",
		"augment_darkRelay": "Relai Gelap",
		"augment_darkRelay_desc": "Proyektil memantul di antara Turret yang ada secara acak, memberikan kerusakan listrik.",
		"augment_observer": "Pengamat",
		"augment_observer_desc": "Jika kamu tidak menyerang selama 3 detik, dapatkan +30% Turret Damage hingga serangan berikutnya.",
		"augment_observer_powerup": "{1} Kerusakan Turret",
		"augment_weakness": "Kelemahan",
		"augment_weakness_desc": "Musuh yang berada dalam Jangkauan Turret menerima 30% lebih banyak kerusakan dari sumber lain.",
		"augment_corrosion": "Korosi",
		"augment_corrosion_desc": "D.O.T. Kerusakan sekarang dapat menimbulkan kritikal.",
		"augment_lamprey": "Lamprey",
		"augment_lamprey_desc": "D.O.T. Kerusakan yang terjadi di dekat Senjata Utama menyembuhkan Senjata Utama sebesar 1 Health.",
		"augment_tenacity": "Kegigihan",
		"augment_tenacity_desc": "Meningkatkan durasi semua senjata D.O.T. sebesar 35%.",
		"augment_afflictors": "Afflictors",
		"augment_afflictors_desc": "Menambahkan Afflictors ke Loot pool. Masing-masing memberikan +4% Kerusakan D.O.T. Efek berganda di dekat Senjata Utama.",
		"augment_conviction": "Keyakinan",
		"augment_conviction_desc": "Senjata D.O.T. mendapatkan +40% Tingkat Serangan selama Kamu memiliki Re-roll maksimal.",
		"augment_conviction_powerup": "{1} D.O.T. Tingkat Serangan",
		"augment_infector": "Infektor",
		"augment_infector_desc": "Senjata D.O.T. memiliki peluang efek status +3%.",
		"augment_closeCombat": "Pertarungan Jarak Dekat",
		"augment_closeCombat_desc": "Semua Serangan Jarak Jauh dianggap dekat dengan Senjata Utama.",
		"augment_caltrops": "Caltrops",
		"augment_caltrops_desc": "Serangan kritis jarak jauh memunculkan 12 Caltrops yang melukai musuh yang lewat dan menaikkan peluang pendarahan sesuai kerusakan.",
		"augment_causticAmmo": "Amunisi Kaustik",
		"augment_causticAmmo_desc": "Peluang untuk menjatuhkan Amunisi Kaustik - menambahkan 10 Kerusakan Kimia dasar ke Senjata Jarak Jauh selama 20 detik.",
		"augment_piracy": "Pembajakan",
		"augment_piracy_desc": "Untuk setiap Efek Jarahan yang dilengkapi, tingkatkan semua Kerusakan Jarak Jauh sebesar 15%.",
		"augment_deliverance": "Pembebasan",
		"augment_deliverance_desc": "Semua senjata jarak jauh mendapatkan +40% Jangkauan selama Kamu memiliki Perisai maksimal.",
		"augment_deliverance_powerup": "{1} Jangkauan Jarak Jauh",
		"augment_sniper": "Sniper",
		"augment_sniper_desc": "Peningkatan Jangkauan Jarak Jauh juga berlaku untuk Serangan Jarak Jauh.",
		"augment_voltaicBurst": "Ledakan Volta",
		"augment_voltaicBurst_desc": "Peningkatan Durasi Listrik juga berlaku 25% dari nilainya untuk Peluang Listrik Statis.",
		"augment_stormBattery": "Baterai Badai",
		"augment_stormBattery_desc": "Turret Utama memberikan kerusakan listrik kepada musuh di dekatnya. Setiap Senjata Listrik yang dilengkapi meningkatkan kerusakan dasar.",
		"augment_lightningSparks": "Percikan",
		"augment_lightningSparks_desc": "Pada serangan kritis oleh senjata listrik, lepaskan 6 Percikan Petir yang meningkatkan kerusakannya dengan Peluang Kritik dan Pengganda Kritik.",
		"augment_efficientGrid": "Grid yang Efisien",
		"augment_EfficientGrid_desc": "Untuk setiap Senjata non-Listrik yang dilengkapi, tingkatkan semua durasi Listrik sebesar 10%.",
		"augment_violentDischarge": "Melepaskan Kekerasan",
		"augment_violentDischarge_desc": "Statis lebih kuat dan jauh, dengan 50% peluang menyebar ke musuh terdekat saat membunuh.\n\n",
		"augment_electrifiedTurret": "Turret Listrik",
		"augment_electrifiedTurret_desc": "Senjata Utama mendapatkan +5 Kerusakan Listrik Dasar dan meningkatkan semua kerusakan senjata listrik sebesar 10%.",
		"augment_pyromancy": "Pyromancy",
		"augment_pyromancy_desc": "Menambah serangan Panas 2% setiap musuh yang terbakar. Serangan bakar memberi bonus sesuai durasi dan kerusakannya.",
		"augment_cauterization": "Kauterisasi",
		"augment_cauterization_desc": "Bonus jangkauan juga berlaku untuk kerusakan yang ditimbulkan di dekat Senjata Utama untuk Senjata/Efek Panas.",
		"augment_furnaceCore": "Inti Tungku",
		"augment_furnaceCore_desc": "Turret Utama mendapatkan +5 kerusakan panas dasar. Semua kerusakan Panas meningkat sebesar 10%.",
		"augment_fireball": "Bola Api",
		"augment_fireball_desc": "Menembakkan Senjata Utama akan melepaskan Bola Api yang bergerak lambat yang memberikan kerusakan Panas pada musuh yang dilewatinya. Maksimal 1 Bola Api aktif.",
		"augment_flameWave": "Gelombang Api",
		"augment_flameWave_desc": "Menambah gelombang api ke inventaris dan loot, membakar musuh yang terlihat dan menguras 10% HP Turret Utama.",
		"augment_blazingGlory": "Kemuliaan yang Berkobar",
		"augment_blazingGlory_desc": "Musuh yang dekat dengan Senjata Utama menerima +25% Kerusakan Panas dan memiliki peluang tambahan 12% untuk tersulut dari Kerusakan Panas.",
		"augment_gunslinger": "Penembak Jitu",
		"augment_gunslinger_desc": "Tingkatkan Maksimum Kata Serbu sebesar 5. Setiap tingkatan Kata Serbu memberikan +2,5% kerusakan kinetik.",
		"augment_bloodlust": "Haus Darah",
		"augment_bloodlust_desc": "Tingkatkan laju tembakan kinetik sebesar 2% dan jangkauan sebesar 1% untuk setiap musuh yang terluka.",
		"augment_infusedAmmo": "Peluru Terisi",
		"augment_infusedAmmo_desc": "Serangan dengan Kerusakan Kinetik memiliki peluang 40% untuk menerapkan status acak pada musuh.",
		"augment_scrapArmaments": "Pecahan peluru",
		"augment_scrapArmaments_desc": "Kesempatan untuk melepaskan pecahan peluru - menambah 10 kerusakan kinetik dasar pada senjata kinetik selama 20 detik.",
		"augment_combinedArms": "Senjata Terkombinasi",
		"augment_combinedArms_desc": "Untuk setiap senjata non-Kinetic yang dilengkapi, tingkatkan semua kerusakan Kinetic sebesar 10%.",
		"augment_pocketTurret": "Pocket Turret",
		"augment_pocketTurret_desc": "Menambahkan Pocket Turret ke inventaris dan loot. Item ini memanggil turret yang bisa diambil lagi setelah durasinya habis.",
