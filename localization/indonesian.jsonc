		"evo_chopper_dualWield": "Dual Wield",
		"evo_chopper_dualWield_desc": "Efek:\n +1 Pemotong",
		"evo_chopper_flamingBlades": "Pedang Api",
		"evo_chopper_flamingBlades_desc": "Efek:\n  Kerusakan Kinetik: {1}\n  Kerusakan Panas: {2}\n\nChopper kini menimbulkan Kerusakan Panas alih-alih Kerusakan Kinetik dan dianggap sebagai Senjata Panas.",
		"evo_chopper_flamingBlades_2": "Pedang Api II",
		"evo_chopper_flamingBlades_2_desc": "Efek:\n  Kerusakan Panas: {1}\n\nEfek Global:\n  Semua Efek Panas/Senjata:\n    Kerusakan: {2}",
		"evo_chopper_boomerang": "Bumerang",
		"evo_chopper_boomerang_desc": "Pemotong sekarang kembali ke Senjata Utama setelah mencapai tepi layar.",
		"evo_chopper_boomerang_2": "Bumerang II",
		"evo_chopper_boomerang_2_desc": "Efek:\n Kecepatan: {1}\n Laju Tembakan: {2}",
		"evo_chopper_sawLauncher": "Peluncur Gergaji",
		"evo_chopper_sawLauncher_desc": "Efek:\n Peluang Pendarahan: {1}\n Kerusakan Pendarahan: {2}\nPeluang Pendarahan berulang: {3}\n\nPemotong diganti dengan dua mata gergaji yang lebih kecil dengan kecepatan serangan tinggi, ditembakkan dalam pola kerucut.",
		"evo_chopper_sawLauncher_2": "Peluncur Gergaji II",
		"evo_chopper_sawLauncher_2_desc": "Efek:\n Peluang Pendarahan: {1}\n Kerusakan Pendarahan: {2}\n Peluang Pendarahan berulang: {3}\n\nMeningkatkan jumlah mata gergaji yang ditembakkan sebanyak 2.",
		"evo_chopper_bloodbath": "Pertumpahan darah",
		"evo_chopper_bloodbath_desc": "Efek:\n Kerusakan pada Musuh yang Mengalami Pendarahan: {1}\nMusuh yang mengalami pendarahan yang terbunuh oleh Pemotong memiliki {2} kesempatan untuk mengaktifkan Kerusakan Ganda.",
		"evo_chopper_bloodbath_2": "Pertumpahan darah II",
		"evo_chopper_bloodbath_2_desc": "Efek:\n Kerusakan pada Musuh yang Mengalami Pendarahan: {1}\n\nPeluang untuk mendapatkan Kerusakan Ganda menjadi {2}.",
		"evo_meteor_surveillance": "Pengawasan",
