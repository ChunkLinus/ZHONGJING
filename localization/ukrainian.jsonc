		"NEW_ACHIEVEMENT_1_30_DESC": "Досягни 250 шкоди в секунду з Різаком.",
		"NEW_ACHIEVEMENT_1_31_NAME": "Адепт Орбітера",
		"NEW_ACHIEVEMENT_1_31_DESC": "Досягни 250 шкоди в секунду з Орбітером.",
		"NEW_ACHIEVEMENT_4_0_NAME": "Майстерність Орбітера",
		"NEW_ACHIEVEMENT_4_0_DESC": "Досягни 500 шкоди в секунду з Орбітером.",
		"NEW_ACHIEVEMENT_4_1_NAME": "Розпилюй і молись",
		"NEW_ACHIEVEMENT_4_1_DESC": "Пройди Режим Випробувань на Знаменні VI з Транслятором.",
		"NEW_ACHIEVEMENT_4_2_NAME": "Лазерне фокусування",
		"NEW_ACHIEVEMENT_4_2_DESC": "Пройди Режим Випробувань на Знаменні VI з тепловим променем.",
		"NEW_ACHIEVEMENT_4_3_NAME": "Бомбардир",
		"NEW_ACHIEVEMENT_4_3_DESC": "Пройди Режим Випробувань на Знаменні VI з Залпом.",
		"NEW_ACHIEVEMENT_4_4_NAME": "Митець Графіті",
		"NEW_ACHIEVEMENT_4_4_DESC": "Пройди Режим Випробувань на Знаменні VI з Розбризкувачем.",
		"NEW_ACHIEVEMENT_4_5_NAME": "Швидкостріл",
