		"NEW_ACHIEVEMENT_1_10_NAME": "Майстерність Тесла-Міни",
		"NEW_ACHIEVEMENT_1_10_DESC": "Досягни 500 шкоди в секунду з Тесла-Міною.",
		"NEW_ACHIEVEMENT_1_11_NAME": "Друкач",
		"NEW_ACHIEVEMENT_1_11_DESC": "Досягни 500 Ідеальних введень.",
		"NEW_ACHIEVEMENT_1_12_NAME": "Перфекціоніст",
		"NEW_ACHIEVEMENT_1_12_DESC": "Досягни 1000 Ідеальних введень.",
		"NEW_ACHIEVEMENT_1_13_NAME": "Майстерність теплового променя",
