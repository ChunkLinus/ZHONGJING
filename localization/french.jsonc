		"item_seer": "Oracle",
		"item_seer_desc": "Les apparitions de re-lancer activées augmenteront votre portée globale de 10% pour 10 secondes. S'accumule jusqu'à 3 fois.",
		"item_seer_desc_2": "Si vous avez 0 re-lancer lorsque vous montez de niveau, évoluez ou obtenez du butin, vous aurez toujours 1 re-lancer.",
		"item_resilience": "Résilience",
