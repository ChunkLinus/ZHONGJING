		"evo_wildcard_diamond_2_desc": "Effet Global :\n  Tous les Effets/Armes cinétiques :\n   Dégâts : {1}",
		"evo_wildcard_fragmentation": "Fragmentation",
		"evo_wildcard_fragmentation_desc": "Quand les projectiles cinétiques frappent les Orbes Thermiques, des explosions thermiques.\n\nLorsque les projectiles Cinétiques frappent les ennemis gelés par des projectiles de gel, des explosions de Gel sont déclenchées.",
		"evo_wildcard_fragmentation_2": "Fragmentation II",
		"evo_wildcard_fragmentation_2_desc": "Lorsque les projectiles Cinétiques frappent les ennemis, des explosions cinétiques sont déclenchées.",
		"evo_wildcard_conduit": "Conduit",
		"evo_wildcard_conduit_desc": "Dans la portée des projectiles Électriques, les Orbes Thermiques et les ennemis Gelés  par des projectiles de gel infligeront des dégâts électriques aux ennemis proches.",
		"evo_wildcard_conduit_2": "Conduit II",
		"evo_wildcard_conduit_2_desc": "Les Orbes Thermiques et les ennemis Gelés par des projectiles de gel infligeront toujours des dégâts Électriques aux ennemis proches.",
