		"consumable_medpack": "Kit premiers secours",
		"consumable_medpack_desc": "Ajoute {1} kits de premiers secours à votre inventaire.\n\nLes kits de premiers secours soignent jusqu'à {2} de santé de la tourelle principale.\nAdds {1} Medpacks to your inventory.\n\nMedpacks heal up to {2} of Main Turret's max health.",
		"consumable_serum": "Sérum",
		"consumable_serum_desc": "Ajoute {1} sérums à votre inventaire.\n\nLes sérums offrent {2} de chance de critique pendant {3} secondes.",
		"consumable_warhead": "Ogive",
		"consumable_warhead_desc": "Ajoute {1} ogives à votre inventaire.\n\nLes ogives déchaînent de puissantes explosions qui se propagent depuis l'arme principale.",
		"weapon_warhead_desc": "Effet consommable - ne compte pas comme une arme.\n\nDéchaîne de puissantes explosions qui se propagent depuis l'arme principale.",
		"consumable_flameWave": "Vague de flammes",
		"consumable_flameWave_desc": "Ajoute {1} vagues de flammes à votre inventaire.\n\nLes vagues de flammes enflamment tous les ennemis visibles au coût de 10% de la santé actuelle de la tourelle principale.",
		"weapon_flameWave_desc": "Efffet consommable -  ne compte pas comme une arme.\n\nEnflamme tous les ennemis visibles au coût de 10% de la santé actuelle de la tourelle principale.",
		"consumable_cryocore": "Cryocœur ",
		"consumable_cryocore_desc": "Ajoute {1} cryo-cœur à votre inventaire.\n\nLes cryo-cœurs déclenchent un effet de gel global.",
		"consumable_killPill": "Élimi-Pastille",
		"consumable_killPill_desc": "Ajoute {1} élimi-pastille à votre inventaire.\n\nLes élimi-pastilles doublent globalement les dégâts.",
		"consumable_pocketTurret": "Tourelle de Poche",
		"consumable_pocketTurret_desc": "Ajoute  {1} Tourelle de Poche à votre inventaire :\n\nLa Tourelle de Poche fait apparaître une tourelle automatique auprès des groupes d'ennemis.",
		"weapon_pocket_turret_desc": "Effet Consommable - ne compte pas comme une arme.\n\nfait apparaître une tourelle automatique auprès des groupes d'ennemis.",
		"item_plunder": "Pillage",
		"item_plunder_desc": "+1 option de butin",
		"item_multitargeting": "Multi-ciblage",
