		"weapon_wildcard_title": "Carte chance",
		"weapon_spectre_title": "Spectre",
		"weapon_tesla_title": "Mine Tesla",
		"weapon_sentry_title": "Sentinelle",
		"weapon_oscillator_title": "Oscillateur",
		"weapon_meteor_title": "Météore",
		"weapon_hunter_title": "Chasseur",
		"weapon_chopper_title": "Hachoir",
		"weapon_minefield_title": "Champ de mines",
		"weapon_blade_title": "Piège à lames",
		"weapon_firestorm_title": "Tempête de balles",
		"weapon_guardian_title": "Gardien",
		"weapon_orbiter_title": "Orbiteur",
		"weapon_frostbite_title": "Gel",
		"weapon_bleeding_title": "Saignement",
		"weapon_blight_title": "Corrosion",
		"weapon_static_title": "Statique",
		"weapon_ignite_title": "Ignition",
		"weapon_heatray_requirements": "Compléter Défis Répéteur sur n'importe quel niveau Présage.",
		"weapon_barrage_requirements": "Compléter Défis au niveau Présage Niveau 3 avec n'importe quelle arme.",
		"weapon_repeater_desc": "Arme dévastatrice qui tire plusieurs balles en courtes rafales.",
		"weapon_heatray_desc": "Tire un faisceau de lumière concentré avec une précision parfaite qui inflige des dégâts progressifs.",
		"weapon_barrage_desc": "Tire une volée de roquettes explosives sur une cible et ses environs. Se recharge progressivement.",
		"weapon_overmind_desc": "Commande un assortiment de drones qui infligent des dégâts énergétiques à vos ennemis.",
		"weapon_splattershot_desc": "Tirez des boules gluantes sur vos adversaires pour les paralyser et leur infliger des dégâts.",
		"weapon_wildcard_desc": "Votre prochain tir est choisi au hasard parmi quatre armes possibles, alors soyez prudent.",
		"weapon_spectre_desc": "Invoque des drones de mêlée rapides dont le nombre est équivalent à celui des armes déjà présentes.",
		"weapon_sentry_desc": "Déploie une tourelle automatisée qui tire sur tout ennemi à portée.",
		"weapon_tesla_desc": "Déploie une tourelle électrique qui inflige des dégâts progressifs.",
		"weapon_oscillator_desc": "Tire un rayon de particules en direction de votre cible la plus récente.",
		"weapon_meteor_desc": "Fait apparaître par à-coups et à des endroits aléatoires, des marqueurs pouvant être activés pour déclencher une pluie de météores.",
		"weapon_hunter_desc": "Fait apparaître des drones qui tirent des rayons électriques, dont le nombre est équivalent à celui des drones déjà présents.",
		"weapon_chopper_desc": "Fait apparaître une énorme lame tournante sur l'arme principale qui traverse jusqu'au bord de l'écran, attaquant tout sur son chemin.",
		"weapon_minefield_desc": "Invoque des mines qui se déplacent lentement qui explosent au contact des ennemis.",
		"weapon_blade_desc": "Déploie un piège à quatre lames qui tourne sur lui-même.",
		"weapon_firestorm_desc": "Un canon qui tire une rafale de balles explosives à courte portée. Il tourne autour de la tourelle principale et a besoin de se recharger avant de tirer à nouveau.",
		"weapon_guardian_desc": "Déploie instantanément un drone qui tire sur les ennemis avec des lasers. Active les apparitions d'essence pour ravitailler le gardien, il consomme de l'essence et se désactive si il n'en a plus.",
		"weapon_orbiter_desc": "Déploie une orbe orbitant autour de l'arme principale, endommageant tout sur son chemin.",
		"weapon_frostbite_desc": "Effet de butin - ne compte pas comme une arme.\n\nLes ennemis subissent des dégâts progressifs lorsque s'ils sont gelés.",
		"weapon_bleeding_desc": "Effet de statut - ne compte pas comme une arme.\n\nLes ennemis subissent des dégâts cinétiques progressifs jusqu'à ce que l'effet expire.",
		"weapon_blight_desc": "Effet de statut - ne compte pas comme une arme.\n\nLes ennemis subissent des dégâts chimiques progressifs jusqu'à ce que l'effet expire.",
		"weapon_static_desc": "Effet de statut - ne compte pas comme une arme.\n\nLes ennemis subissent des dégâts d'énergie progressifs et infligent des dégâts d'énergie aux ennemis proches jusqu'à ce que l'effet expire.",
		"weapon_ignite_desc": "Effet de statut - ne compte pas comme une arme.\n\nLes ennemis subissent des dégâts thermiques progressifs jusqu'à ce que l'effet expire.",
		"weapon_caltrops_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nLes coups critiques des armes à distance créent 12 chausse-trappes pour heurter les ennemis passant, et ont une chance de saignement accrue selon leurs dégâts.",
		"weapon_stormBattery_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nLa tourelle principale inflige des dégâts électriques aux ennemis proches. Chaque arme électrique équipée augmente les dégâts de base.",
		"weapon_lightningSparks_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nLes coups critiques des armes électriques relâchent 6 éclairs dont les dégâts augmentent avec la chance et le multiplicateur critique.",
		"weapon_darkRelay_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nUn projectile rebondit aléatoirement entre vos tourelles, infligeant des dégâts électriques.",
		"weapon_jester_desc": "Effet de butin - ne compte pas comme une arme.\n\nLorsque vous obtenez un re-lancement, infligez des dégâts aléatoires entre 0 et 100 à tous les ennemis visibles.",
		"weapon_necrobomb_desc": "Effet de butin - ne compte pas comme une arme.\n\nLorsque vous détruisez un ennemi avec des dégâts explosifs critiques, déclenchez une série d'explosions autour de l'ennemi vaincu.",
		"weapon_release_desc": "Effet de butin - ne compte pas comme une arme.\n\nLes fautes de frappes infligent {1} dégâts explosifs à tous les ennemis toutes les x{2} saisies parfaites.",
		"weapon_retribution_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nChaque fois qu'un bouclier est détruit, tous les drones s'autodétruisent pour infliger des dégâts explosifs.",
		"weapon_fireball_desc": "Effet d'augmentation - ne compte pas comme une arme.\n\nL'arme principale relâche une boule de feu lente qui inflige des dégâts thermiques.",
		"contains_characters": "Compléter les mots contenant les glyphes",
		"contains_glyphs": "Compléter les chaînes contenant les glyphes",
		"starts_with_character": "Compléter les mots commençant par les glyphes :",
		"starts_with_glyphs": "Compléter les chaînes commençant par les glyphes :",
		"enemy_drone_title": "Drone",
		"enemy_shieldDrone_title": "Drone Bouclier",
		"enemy_stalker_title": "Rôdeur",
		"enemy_shooter_title": "Tireur",
		"enemy_splitter_title": "Scissioniste",
		"enemy_warder_title": "Gardien",
		"enemy_swarmer_title": "Essaimeur",
		"enemy_drone_desc": "Les Drones sont des ennemis visant votre arme principale. Ils peuvent parfois apparaître sous deux formes améliorées : <br>Agrandi : triple la santé, rendant les ennemis plus coriaces. <br>Hâté : Double la vitesse de mouvement, faisant d'eux des cibles plus urgentes.",
		"enemy_shieldDrone_desc": "Le Drone Bouclier est une variante du drone ennemi doté d'un bouclier renouvelable. Il a deux barres de santé : celle au-dessus représente le bouclier, qui se régénérera s'il ne subit de dégâts après  un certain temps.",
		"enemy_stalker_desc": "Le Rôdeur est une variante du drone ennemi qui cache la majorité de son mot. Le mot se révélera au fur et à mesure que vous tapez, demandant donc une dactylographie attentive et rapide.",
		"enemy_shooter_desc": "Le Tireur est un ennemi qui s'arrête au bord du niveau pour continuellement tirer sur votre arme principale jusqu'à ce qu'elle soit détruite.",
		"enemy_splitter_desc": "Le Scissioniste est un seul ennemi composé de plusieurs parties. Lorsqu'une partie est détruite, le Scissioniste se désassemble et chaque partie devient un ennemi individuel.",
		"enemy_warder_desc": "Le Gardien est un ennemi d'élite qui apparaît en fin de partie. Il possède un bouclier rotatif bloquant les dégâts dans la direction pointée. Le Gardien fournit également une aura protectrice aux ennemis proches, les rendant invulnérable tant que le Gardien est en vie.",
		"enemy_swarmer_desc": "L'Essaimeur est un ennemi d'élite qui envoie périodiquement des groupes de petits ennemis vers l'arme principale jusqu'à ce qu'elle soit détruite.",
