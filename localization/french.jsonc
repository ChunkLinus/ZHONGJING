		"item_wisdom": "Sagesse",
		"item_wisdom_desc": "Obtenir un bouclier contribue 10 éliminations aux évolutions de toutes les armes.",
		"item_jester": "Joker",
		"item_jester_desc": "Obtenir un re-lancer inflige des dégâts aléatoire entre 0 et 100 à tous les ennemis visibles à l'écran.",
		"item_jester_2_desc": "Lorsque vous complétez un mot, un drone bouffon apparaît pour infliger 0-100% dégâts à une cible aléatoire. 10 secondes de recharge.",
		"item_lastStand": "Dernier Souffle",
		"item_lastStand_desc": "Lorsqu'un bouclier est détruit, doublez vos dégâts.",
		"item_tripleDamage": "Triple dégâts",
		"item_tripleDamage_desc": "Toutes les apparitions de double dégâts vont désormais tripler vos dégâts.",
		"item_fracture": "Fracture",
		"item_fracture_desc": "Durant Gel, chaque apparition de gel est remplacé par fracture, infligeant des dégâts à tous les ennemis gelés.",
		"item_fracture_desc_2": "Tous les dégâts aux ennemis gelés sont augmentés de {1}. Les modificateurs sont multiplicatifs.",
		"item_ascetic": "Ascétique",
		"item_ascetic_desc": "Quitter l'écran de butin offre 10% de dégâts bonus pendant 20 secondes pour chaque re-lancer inutilisé.",
		"item_harmonizer": "Harmoniseur",
		"item_harmonizer_desc": "Toutes les armes équipées obtiennent un niveau d'évolution",
		"item_immortality": "Immortalité",
		"item_immortality_desc": "Au lieu d'être détruite, la santé de votre arme principale sera réduite à 1. Cette capacité n'est utilisable qu'une fois toutes les 2 minutes.",
		"item_immortality_desc_2": "Si votre arme principale est sur le point d'être détruite, sa santé sera plutôt réduite à 1, et tous les ennemis dans un rayon de 400 mètres recevront des dégâts cinétiques létaux. Cette capacité est utilisable une fois toutes les 2 minutes.",
		"item_enlightenment": "Eclaircissement",
