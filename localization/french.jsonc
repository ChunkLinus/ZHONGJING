		"evo_wildcard_pestilence_2_desc": "Effet Global :\n  Tous les effets de statut :\n   Dégâts : {1}",
		"evo_guardian_toxicWard": "Garde Toxique",
		"evo_guardian_toxicWard_desc": "Effets :\n  Dégâts thermiques : {1}\n  Dégâts chimiques : {2}\n\nAffecte les dégâts de base. Le type de dégâts du gardien devient chimique.",
		"evo_guardian_toxicWard_2": "Garde Toxique II",
		"evo_guardian_toxicWard_2_desc": "Effets :\n  Dégâts chimiques : {1}\n\nAffecte les dégâts de base.",
		"evo_guardian_experimentalFuel": "Carburant Expérimental",
		"evo_guardian_experimentalFuel_desc": "Des apparitions de carburant spécial vont apparaitre, offrant des bonus temporaires au gardien. Seul un de ces bonus peut être actif à la fois.",
		"evo_guardian_experimentalFuel_2": "Carburant Expérimental II",
		"evo_guardian_experimentalFuel_2_desc": "Tous les effets du carburant spécial reçoivent {1} bonus et hausse de durée {2}.",
		"evo_guardian_experimentalFuel_damage": "Carburant Expérimental",
		"evo_guardian_experimentalFuel_speed": "Carburant Expérimental",
		"evo_guardian_experimentalFuel_range": "Carburant Expérimental",
		"evo_guardian_guardianTeam": "Equipe Gardien",
		"evo_guardian_guardianTeam_desc": "Effets:\n  Dégâts : {1}\n  Drones : {2}\n\nGardien est maintenant deux drones au lieu d'un seul.",
		"evo_guardian_guardianTeam_2": "Equipe Gardien II",
		"evo_guardian_guardianTeam_2_desc": "Effets:\n  Dégâts : {1}\n  Drones : {2}\n\nGardien est maintenant trois drones au lieu de deux.",
