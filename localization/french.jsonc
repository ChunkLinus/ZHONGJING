		"item_frostbite": "Gel",
		"item_frostbite_desc": "Les ennemis subissent des dégâts progressifs lorsqu'ils sont gelés.",
		"item_necrobomb": "Nécrobombe",
		"item_necrobomb_desc": "Détruire un ennemi avec des dégâts critiques explosifs déclenchera une série d'explosions autour de l'ennemi abattu.",
		"item_prize": "Prix",
		"item_prize_desc": "Détruire un ennemi avec des dégâts critiques a {1} chance d'offrir une apparition de re-lancer, bouclier ou santé.",
		"item_aftershock": "Après-coup",
