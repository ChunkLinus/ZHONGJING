		"evo_blade_bladeRepository_desc": "génère également un piège de lames en plus des glyphes existants.",
		"evo_blade_poisonCoating": "Lame corrodée",
		"evo_blade_poisonCoating_desc": "Effets:\n  Dégâts chimiques : {1}\n  Chance de corrosion : {2}\n\nAffecte les dégâts de base et est affecté par les modificateurs de dégâts chimiques.",
		"evo_blade_poisonCoating_2": "Lame corrodée II",
		"evo_blade_poisonCoating_2_desc": "Effets:\n  Dégâts chimiques : {1}\n  Chance de corrosion : {2}\n\nAffecte les dégâts de base.",
		"evo_blade_sawtoothBlade": "Lames coupantes",
		"evo_blade_sawtoothBlade_desc": "Les pièges de lames ajoutent leurs chances de critique à leurs chances de saignement.",
		"evo_blade_sawtoothBlade_2": "Lames coupantes II",
		"evo_blade_sawtoothBlade_2_desc": "Les dégâts de saignement sont augmentés de {1}. Ceci s'applique aux saignements infligés par toutes les sources et affecte les dégâts de base.",
		"evo_blade_cutting_edge": "Dernier Cri",
		"evo_blade_cutting_edge_desc": "Effet global :\n  Tous les effets/armes tourelles :\n    Chance de coup critique : {1}\n",
		"evo_hunter_hunterElite": "Chasseur d'élite",
		"evo_hunter_hunterElite_desc": "Tous les 12 chasseurs créés, un chasseur d'élite est invoqué.\n\nChasseurs d'élite :\n  +100% de dégâts\n  +50% de durée\n  +50% de vitesse\n  +50% de portée",
		"evo_hunter_hunterElite_2": "Chasseur d'élite II",
		"evo_hunter_hunterElite_2_desc": "Les chasseurs d'élite apparaissent désormais tous les 10 chasseurs invoqués.\n\nÉlites chasseurs :\n  +50% de durée",
		"evo_hunter_electrifiedBolts": "Carreaux électrifiés",
		"evo_hunter_electrifiedBolts_desc": "Effet :\n  Dégâts Cinétiques : {1}\n  Dégâts Électriques : {2}\n\nLes Chasseurs tirent désormais des projectiles au lieu de courants électriques, ils sont maintenant considérés comme armes cinétiques.",
		"evo_hunter_electrifiedBolts_2": "Carreaux électrifiés II",
		"evo_hunter_electrifiedBolts_2_desc": "Effets :\n  Dégâts Cinétiques : {1}\n\n Effet Global :\n  Tous Effets/Armes Cinétiques :\n  Dégâts : {2}",
		"evo_hunter_chainLightning": "Chaîne d'éclairs",
		"evo_hunter_chainLightning_desc": "Les attaques du chasseur s'enchaînent désormais à 1 ennemi proche supplémentaire.",
