		"evo_hunter_predator_strain_desc": "Effet global :\n  Tous les effets/armes de drones:\n    Durée : {1}\n",
		"evo_minefield_mineLayer": "Mines supplémentaires",
		"evo_minefield_mineLayer_2": "Mines supplémentaires II",
		"evo_minefield_mineLayer_desc": "génère également des mines en plus des glyphes existants.",
		"evo_minefield_infusion": "Infusion",
		"evo_minefield_infusion_desc": "Effet :\n  Dégâts Chimiques : {1}\n  Dégâts Explosifs : {2}\n\nLe Champ de mines inflige maintenant des Dégâts Chimiques au lieu des Dégâts Explosifs et est considéré comme une Arme Chimique.",
		"evo_minefield_infusion_2": "Infusion II",
		"evo_minefield_infusion_2_desc": "Effets :\n  Dégâts Chimiques :  {1}\n  Chance de Corrosonion : {2}\n\nEffet Global :\n  Tous les Effets/Armes Chimiques :\n   Dégâts : {3}",
		"evo_minefield_hunterSeeker": "Traqueurs du chasseur",
		"evo_minefield_hunterSeeker_desc": "Effets :\n  Vitesse : {1}\n  Portée : {2}\n\nLes mines se déplacent vers des cibles aléatoires.",
		"evo_minefield_hunterSeeker_2": "Traqueurs du chasseur II",
		"evo_minefield_hunterSeeker_2_desc": "Effets :\n  Mines générées : {1}\n  Vitesse : {2}",
		"evo_minefield_dirtyBomb": "Bombe sale",
		"evo_minefield_dirtyBomb_desc": "Effets :\n  Dégâts chimiques : {1}\n  Dégâts Éclabou-tir : {2}\n\nLes mines relâchent 3 flaques de vase lorsqu'elles explosent.",
		"evo_minefield_dirtyBomb_2": "Bombe sale II",
		"evo_minefield_dirtyBomb_2_desc": "Effets :\n  Dégâts chimiques : {1}\n  Dégâts Éclabou-tir : {2}\n\nLorsque vous bougez, les mines lancet périodiquement des flaques de vase.",
		"evo_minefield_recursiveMines": "Mines récursives",
		"evo_minefield_recursiveMines_desc": "La tourelle principale tire périodiquement un nombre de mines basé sur la moitié de la limite du champ de mines, puis arrondi au chiffre le plus proche. Le taux d'apparition est déterminé par la statistique de cadence de tir du champ de mines.",
		"evo_minefield_recursiveMines_2": "Mines récursives II",
		"evo_minefield_recursiveMines_2_desc": "Les mines récursives apparaissent {1} plus rapidement et avec une mine supplémentaire.",
		"evo_sentry_defenseGrid": "Grille de défense",
		"evo_sentry_defenseGrid_2": "Grille de défense II",
		"evo_sentry_defenseGrid_desc": "Effets:\n  Tourelle : +1",
		"evo_sentry_solidCore": "Noyau solide",
		"evo_sentry_solidCore_desc": "Effets :\n  Dégâts Cinétiques : {1}\n  Dégâts Thermiques : {2}\n\nLa Sentinelle inflige maintenant des Dégâts Cinétiques au lieu de Dégâts Thermiques et est considérée comme une Arme Cinétique.",
		"evo_sentry_solidCore_2": "Noyau solide II",
		"evo_sentry_solidCore_2_desc": "Effets :\n  Dégâts Cinétiques : {1}\n\nEffet Global :\n  Toutes Armes/Effets Cinétiques :\n   Dégâts : {2}",
		"evo_sentry_watcher_supreme": "Panoptique",
		"evo_sentry_watcher_supreme_desc": "Effet Global :\n  Tous Effets/Armes de Tourelle :\n   Portée : {1}",
		"evo_sentry_emergencyProtocol": "Protocole d'urgence",
		"evo_sentry_emergencyProtocol_desc": "Chaque fois qu'un bouclier est détruit, la Sentinelle passe en mode Protocole d'urgence pendant {1} secondes.\n\nPendant le Protocole d'urgence :\n  Portée : {2}}\n  Cadence de tir : {3}",
		"evo_sentry_emergencyProtocol_2": "Protocole d'urgence II",
		"evo_sentry_emergencyProtocol_2_desc": "Pendant le protocole d'urgence :\n  Dégâts : {1}\n  Vitesse de rotation : {2}",
		"evo_spectre_supercharged": "Superchargée",
		"evo_spectre_supercharged_desc": "Chaque 20e Spectre invoqué est un Super Spectre.\n\nSuper Spectres:\n  +100% de dégâts\n  +50% de durée\n  +50% de vitesse",
		"evo_spectre_selfDestruct": "Autodestruction",
