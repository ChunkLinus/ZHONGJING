		"boss_poet": "Le poète",
		"boss_poet_desc": "Tapez le passage présenté par le boss.\nVous pouvez quand même continuer de cibler des ennemis.",
		"boss_cypher": "L'Encodeur",
		"boss_cypher_desc": "Ce boss mélange les lettres de ceux qui l'approchent.\nDétruisez le avec vos armes.",
		"boss_cerberus": "Cerbère",
		"boss_cerberus_desc": "Ce boss tire des projectiles destructible.\nDétruisez ses trois têtes avec vos armes.",
		"boss_jormungandr": "Jörmugand",
		"boss_jormungandr_desc": "Ce boss vous encerclera incessamment.\nPlanifiez vos tirs sur les cibles sur son chemin pour que vos armes l'atteignent.",
		"boss_gemini": "Gemini",
		"boss_gemini_desc": "Attaquez les jumeaux de manière égale.\nIls se régénèrent mutuellement au fil du temps jusqu'à leur santé maximale.",
		"weapon_repeater_title": "Répéteur",
		"weapon_heatray_title": "Rayon thermique",
