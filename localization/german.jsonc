		"overmind_syncronization_desc": "{1} Kritische Chance, {2} Kritischer Mult",
		"boss_poet": "Der Dichter",
		"boss_poet_desc": "Tippe die vom Boss vorgegebene Passage ein. Du kannst dabei weiterhin Feinde anvisieren.",
		"boss_cypher": "Die Geheimschrift",
		"boss_cypher_desc": "Dieser Boss verschlüsselt die Buchstaben derer, die sich in seiner Nähe befinden. Zerstöre ihn mit deinen Waffen.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "Dieser Boss schießt zerstörbare Projektile auf dich. Zerstöre alle drei Köpfe mit deinen Waffen.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Dieser Boss kreist unerlässlich um deine Waffe. Plane deine Schüsse um den Boss zu treffen.",
		"boss_gemini": "Zwilling",
		"boss_gemini_desc": "Schade den Zwillingen gleichmäßig.\nSie heilen sich gegenseitig bis zu ihrem eigenen Leben.",
		"weapon_repeater_title": "Repeater",
		"weapon_heatray_title": "Heat Ray",
		"weapon_barrage_title": "Barrage",
		"weapon_overmind_title": "Overmind",
		"weapon_splattershot_title": "Splatter Shot",
		"weapon_wildcard_title": "Joker",
		"weapon_spectre_title": "Gespenst",
		"weapon_tesla_title": "Tesla-Mine",
		"weapon_sentry_title": "Wache",
		"weapon_oscillator_title": "Oszillator",
		"weapon_meteor_title": "Meteorit",
		"weapon_hunter_title": "Jäger",
		"weapon_chopper_title": "Häcksler",
		"weapon_minefield_title": "Minenfeld",
		"weapon_blade_title": "Klingenfalle",
		"weapon_firestorm_title": "Feuersturm",
		"weapon_guardian_title": "Wächter",
		"weapon_orbiter_title": "Raumgleiter",
		"weapon_frostbite_title": "Frostbeulen",
		"weapon_bleeding_title": "Blutungen",
		"weapon_blight_title": "Feuerbrand",
		"weapon_static_title": "Statisch",
		"weapon_ignite_title": "Verbrennung",
		"weapon_heatray_requirements": "Schließe die Repeater- Versuche auf einem beliebigen Omen-Level ab.",
		"weapon_barrage_requirements": "Schließe Versuche auf Omen-Level 3 mit einer beliebigen Hauptwaffe ab.",
		"weapon_repeater_desc": "Verheerende Waffe, die eine Reihe von Kugeln in kurzen Stößen abfeuert.",
		"weapon_heatray_desc": "Feuert einen konstanten Strahl aus unglaublich präzisem, konzentriertem Licht ab, der mit der Zeit Schaden anrichtet.",
		"weapon_barrage_desc": "Feuert eine Reihe von explosiven Raketen auf ein Ziel und dessen Umgebung. Lädt sich mit der Zeit wieder auf.",
		"weapon_overmind_desc": "Befehle eine Reihe von Drohnen, um deinen Feinden Energieschaden zuzufügen.",
		"weapon_splattershot_desc": "Feuern Sie Glibberkugeln auf Ihre Gegner, um sie zu verkrüppeln und zu schädigen.",
		"weapon_wildcard_desc": "Dein nächster Schuss wird zufällig aus vier möglichen Waffen ausgewählt, also schieße vorsichtig.",
		"weapon_spectre_desc": "Bringt schnelle Nahkampfdrohnen hervor, die der Anzahl der oben genannten entsprechen.",
		"weapon_sentry_desc": "Setze einen automatischen Geschützturm ein, der auf jeden Feind feuert, der in Reichweite kommt.",
		"weapon_tesla_desc": "Setzt einen elektrischen Geschützturm ein, der mit der Zeit Schaden verursacht.",
		"weapon_oscillator_desc": "Feuere einen oszillierenden Partikelstrom in Richtung deines letzten Ziels.",
		"weapon_meteor_desc": "Bringt in regelmäßigen Abständen Zielmarkierungen an zufälligen Orten hervor, die aktiviert werden können, um ein orbitales Bombardement zu starten.",
		"weapon_hunter_desc": "Bringt elektrische Strahlen feuernde Drohnen hervor, die der Anzahl der oben genannten entsprechen.",
		"weapon_chopper_desc": "Erzeugt beim Abfeuern der Hauptwaffe eine massive, sich drehende Klinge, die sich bis zum Bildschirmrand bewegt und alle Gegner in ihrem Weg beschädigt.",
		"weapon_minefield_desc": "Bringt langsam bewegte Minen hervor, die bei Kontakt mit Feinden explodieren.",
		"weapon_blade_desc": "Setzt eine sich drehende vierspeichige Klingenfalle ein.",
		"weapon_firestorm_desc": "Eine Kanone, die ein Sperrfeuer aus Explosivgeschossen mit kurzer Reichweite abfeuert. Sie kreist um den Hauptturm und muss sich abkühlen, bevor sie erneut feuert.",
		"weapon_guardian_desc": "Sofortige Entsendung einer Drohne, die Laser auf Feinde abfeuert. Aktiviere Treibstoffpakete, um den Guardian aufzutanken, der Treibstoff verbraucht und sich deaktiviert, wenn er leer ist.",
		"weapon_orbiter_desc": "Setzt ein Orb ein, welches die Hauptwaffe umkreist und alles in seinem Weg beschädigt",
		"weapon_frostbite_desc": "Beuteeffekt - zählt nicht als Waffe.\n\nGegner nehmen Schaden über Zeit wenn sie gefroren sind.",
		"weapon_bleeding_desc": "Statuseffekt - zählt nicht als Waffe.\n\nFeinde erleiden kinetischen Schaden über Zeit, bis der Effekt abläuft.",
		"weapon_blight_desc": "Statuseffekt - zählt nicht als Waffe.\n\nFeinde erleiden chemischen Schaden über Zeit und werden verlangsamt, bis der Effekt abläuft.",
		"weapon_static_desc": "Statuseffekt - zählt nicht als Waffe.\n\nFeinde erleiden mit der Zeit Energieschaden und fügen Gegnern in der Nähe Energieschaden zu, bis der Effekt abläuft.",
		"weapon_ignite_desc": "Statuseffekt - zählt nicht als Waffe.\n\nFeinde erleiden Hitzeschaden über Zeit, bis der Effekt abläuft.",
		"weapon_caltrops_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nNach einem kritischen Treffer durch Fernwaffen spawnen 12 Krähenfüße, die vorbeikommenden Feinden Schaden zufügen, mit erhöhter Blutungschance basierend auf ihrem Schaden.",
		"weapon_stormBattery_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nDer Hauptturm fügt Gegnern in der Nähe elektrischen Schaden zu. Jede ausgerüstete Elektro-Waffe erhöht den Basisschaden.",
		"weapon_lightningSparks_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nBei einem kritischen Treffer durch elektrische Waffen werden 6 Blitzfunken freigesetzt, deren Schaden mit der Kritischen Chance und dem Kritischen Multiplikator skaliert.",
		"weapon_darkRelay_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nEin Projektil springt zwischen Türmen hin und her und fügt elektrischen Schaden zu.",
		"weapon_jester_desc": "Beuteeffekt - zählt nicht als Waffe.\n\nWenn ein neu Würfeln ausgehoben wird, füge allen Gegner auf dem Bildschirm Schaden zwischen 0 und 100 zu.",
		"weapon_necrobomb_desc": "Beuteeffekt - zählt nicht als Waffe.\n\nWenn ein Feind mit Explosiv-Krit-Schaden getötet wird, werden eine Reihe von explosionen um ihn herum erzeugt.",
		"weapon_release_desc": "Beuteeffekt - zählt nicht als Waffe.\n\nBei Fehleingabe, füge allen Gegner {1} Explosivschaden zu für jede x{2} perfekte Eingabe.",
		"weapon_retribution_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nImmer wenn ein Schild zerstört wird, werden alle Drohnen zerstört und fügen Eplosivschaden zu.",
		"weapon_fireball_desc": "Erweiterungseffekt - zählt nicht als Waffe.\n\nDas Abfeuern der Hauptwaffe setzt außerdem einen langsamen Feuerball frei, der Hitzeschaden verursacht.",
		"contains_characters": "Vervollständigung von Wörtern, die die Glyphen enthalten",
		"contains_glyphs": "Vervollständigung von Sets, die die Glyphen enthalten",
		"starts_with_character": "Vervollständigung von Wörtern, die mit Glyphen beginnen",
		"starts_with_glyphs": "Vervollständigung von Sets, die mit Glyphen beginnen:",
		"enemy_drone_title": "Drohne",
		"enemy_shieldDrone_title": "Schild-Drohne",
		"enemy_stalker_title": "Stalker",
		"enemy_shooter_title": "Schütze",
		"enemy_splitter_title": "Splitter",
		"enemy_warder_title": "Wächter",
		"enemy_swarmer_title": "Schwärmer",
		"enemy_drone_desc": "Drohnen sind Feinde, die sich unerbittlich auf deine Hauptwaffe zubewegen. Sie können gelegentlich in zwei erweiterten Formen auftreten:<br>Vergrößert: Verdreifacht ihre Gesundheit, wodurch sie schwerer zu besiegen sind.<br>Eilig: Verdoppelt ihre Bewegungsgeschwindigkeit und erhöht die Dringlichkeit, sie zu eliminieren.",
		"enemy_shieldDrone_desc": "Die Schilddrohne ist eine Variante des Drohnengegners, die über einen sich regenerierenden Schild verfügt. Sie hat zwei Gesundheitsbalken: Der obere stellt den Schild dar, der sich zu regenerieren beginnt, wenn er eine bestimmte Zeit lang keinen Schaden erleidet.",
		"enemy_stalker_desc": "Der Stalker ist eine Variante des Drohnengegners, bei der anfangs der größte Teil des Wortes verborgen ist. Während du tippst, wird das Wort allmählich enthüllt, so dass du aufpassen und schnell tippen musst, um es zu eliminieren.",
		"enemy_shooter_desc": "Der Schütze ist ein Feind, der am Rande des Levels stehen bleibt und ständig haltbare Geschosse auf Ihre Hauptwaffe abfeuert, bis er zerstört ist.",
		"enemy_splitter_desc": "Der Splitter erscheint zunächst als ein einziger Feind, besteht aber in Wirklichkeit aus mehreren Teilen. Wenn ein Teil zerstört wird, verliert der Splitter seine Integrität, wodurch seine Komponenten auseinanderbrechen und zu einzelnen Gegnern werden.",
		"enemy_warder_desc": "Der Wächter ist ein Elite-Gegner, der im späten Spiel erscheint. Er verfügt über einen sich drehenden Schild, der Schaden aus der Richtung blockiert, in die der Schild gerade gerichtet ist. Solange der Wächter am Leben ist, umgibt er außerdem Feinde in der Nähe mit einer schützenden Aura, die sie unverwundbar macht, bis der Wächter besiegt ist.",
		"enemy_swarmer_desc": "Der Schwärmer ist ein Elite-Feind, der in regelmäßigen Abständen Gruppen kleinerer Feinde auf die Hauptwaffe loslässt. Er tut dies so lange, bis er zerstört wird.",
