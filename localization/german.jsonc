		"evo_repeater_frostFang": "Frostzahn",
		"evo_repeater_frostFang_desc": "Effekte:\n Kälteschaden: {1}\n Einfrierchance: {2}\n\nWirkt auf den Grundschaden und wird von Kälteschadensmodifikatoren beeinflusst.",
		"evo_repeater_frostFang_2": "Frostzahn II",
		"evo_repeater_frostFang_2_desc": "Effekte:\n Kälteschaden: {1}\n Kinetischer Schaden: {2}\n\nWirkt auf den Basisschaden.",
		"evo_repeater_ricochet": "Querschläger",
		"evo_repeater_ricochet_desc": "Effekte:\n Projektilkette: {1}\n\nWiederholungsprojektile prallen an zufälligen Zielen in der Nähe ab und verursachen bei Treffern nach dem ersten {2} Schaden.",
		"evo_repeater_ricochet_2": "Abprall II",
		"evo_repeater_ricochet_2_desc": "Effekte:\n Projektilkette: {1}",
		"evo_repeater_shotgun": "Schrotflinte",
		"evo_repeater_shotgun_desc": "Effekte:\n Projektilanzahl: {1}\n Projektilverteilung: {2}\n Kinetischer Schaden: {3}\n\nWiederholer feuert jetzt ein Bündel schwächerer Projektile mit großer Streuung ab. Der Schadensmodifikator beeinflusst den Grundschaden.",
		"evo_repeater_shotgun_2": "Schrotflinte II",
		"evo_repeater_shotgun_2_desc": "Effekte:\n Projektilanzahl: {1}\n Projektilverteilung: {2}",
		"evo_repeater_explodingBullets": "Explodierende Projektile",
		"evo_repeater_explodingBullets_desc": "Effekte:\n  Explosionsschaden: {1}\n  Kinetischer Schaden: {2}\n\nWirkt auf den Basisschaden. Repeater nutzt nun explosive Munition, die eine Explosion in einem kleinen Radius verursacht.",
		"evo_repeater_explodingBullets_2": "Explodierende Projektile II",
		"evo_repeater_explodingBullets_2_desc": "Effekte:\n  Explosionsschaden: {1}\n  Kinetischer Schaden: {2}\n\nDer Explosionsradius für den Repeater ist größer.",
		"evo_heatray_iceBeam": "Eisstrahl",
		"evo_heatray_iceBeam_desc": "Effekte:\n Hitzeschaden: {1}\n Kälteschaden: {2}\n Einfrierchance: {3}\n\nWirkt sich auf den Basisschaden aus. Der Schadenstyp Hitzestrahl wird zu Kälte und hat eine erhöhte Chance, Einfrieren zu bewirken.",
		"evo_heatray_iceBeam_2": "Eisstrahl II",
		"evo_heatray_iceBeam_2_desc": "Effekte:\n Kälteschaden: {1}\n\nWirkt auf den Grundschaden.",
		"evo_heatray_reflection": "Reflexion",
		"evo_heatray_reflection_desc_2": "Hitzestrahl geht jetzt durch Feinde hindurch und reflektiert {1} vom Bildschirmrand.",
		"evo_heatray_reflection_2": "Reflexion II",
		"evo_heatray_reflection_2_desc_2": "Wärmestrahl reflektiert jetzt {1} vom Bildschirmrand.",
		"evo_heatray_doubleBladed": "Doppelladig",
		"evo_heatray_doubleBladed_desc": "Ein weiterer Strahl feuert in die entgegengesetzte Richtung. Alle Weiterentwicklungen und Upgrades gelten für beide Strahlen.",
		"evo_heatray_blaster": "Sprengmeister",
		"evo_heatray_blaster_desc": "Effekte:\n Feuerrate: {1}\n\nHeat Ray feuert nun ein unabhängiges Laserprojektil mit mehreren Treffern anstelle eines konstanten Strahls ab, das immer noch als D.O.T.-Waffe zählt.",
		"evo_heatray_blaster_2": "Sprengmeister II",
		"evo_heatray_blaster_2_desc": "Effekte:\n  Projektillänge: {1}\n  Schaden: {2}",
		"evo_heatray_solar_tap": "Solarhahn",
		"evo_heatray_solar_tap_desc": "Globaler Effekt:\n Alle Hitzeeffekte/Waffen:\n Status-Chance: {1}",
		"evo_barrage_rocketArray": "Raketenfeld",
		"evo_barrage_rocketArray_desc": "Sperrfeuer feuert jetzt {1} Raketen pro Munitionsleiste statt {2}.",
		"evo_barrage_rocketArray_2": "Raketenfeld II",
		"evo_barrage_seismicMunition": "Seismische Munition",
		"evo_barrage_seismicMunition_desc": "Raketen verankern sich im Boden, anstatt zu explodieren, und erzeugen in den nächsten Sekunden explosive Impulse.",
		"evo_barrage_seismicMunition_2": "Seismische Munition II",
		"evo_barrage_seismicMunition_2_desc": "Seismische Munitionsimpulse:\n Reichweite: {1}\n Dauer: {2}",
		"evo_barrage_resupply": "Nachschub:",
		"evo_barrage_resupply_desc": "Es spawnen nun Nachschub-Pickups. Wenn du diese Pickups aktivierst, lädst du deine Hauptwaffe vollständig nach und erhältst einen Schadensschub von {1} für den nächsten Schuss.",
		"evo_barrage_resupply_2": "Nachschub II",
		"evo_barrage_resupply_2_desc": "Vorratspickups gewähren jetzt auch {1} Explosionsreichweitenverstärkung für den nächsten Schuss.",
		"evo_barrage_resupply_pickup": "Maximale Munition!",
		"evo_barrage_total_saturation": "Gesättigkeit",
		"evo_barrage_total_saturation_desc": "Globaler Effekt:\n Alle Explosiveffekte/Waffen:\n Schaden: {1}",
		"evo_splattershot_bubble": "Schleimblase",
		"evo_splattershot_bubble_desc": "Schleimblasen-Pickups spawnen innerhalb von Splatter-Zonen.\n\nWenn sie aktiviert werden, zerplatzen Schleimblasen, verursachen Schaden in einem kleinen Radius und schaffen zusätzliche Splatter-Zonen.",
		"evo_splattershot_bubble_2": "Schleimblase II",
		"evo_splattershot_bubble_2_desc": "Erhöhtes Auftreten von Schleimblasen.\n\nSchleimblasen haben eine 50%ige Chance, automatisch zu platzen, wenn sie auslaufen.",
		"evo_splattershot_infestation": "Befall",
		"evo_splattershot_infestation_desc": "Splatter Shot Effekte:\n  Statuseffekt-Chance: {1}\n\nGlobale Effekte:\n  Statuseffekt-Schaden: {2}",
		"evo_splattershot_infestation_2": "Befall II",
		"evo_splattershot_infestation_2_desc": "Feinde, die durch Statuseffekte getötet werden, explodieren in Splatter-Zonen.",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Effekte:\n  Chemischer Schaden: {1}\n  Hitzeschaden: {2}\n\nWirkt sich auf den Basisschaden aus. Splatter Shots Schadenstyp wird zu Hitze.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Effekte:\n  Hitzeschaden: {1}\n\nWirkt sich auf den Basisschaden aus.",
		"evo_splattershot_virulence": "Ansteckungsgefahr",
		"evo_splattershot_virulence_desc": "Splatter Zone Effekte:\n  Dauer: {1}\n\nSplatter Zones wachsen stätig über Zeit.",
		"evo_splattershot_chemical_catalyst": "Chemischer Katalysator",
		"evo_splattershot_chemical_catalyst_desc": "Globaler Effekt:\n Alle Chemieeffekte/Waffen:\n Dauer: {1}",
		"evo_overmind_syncronize": "Synchronisieren",
		"evo_overmind_syncronize_desc": "Jeder Kill mit Overmind hat eine {1} Chance, +1 Kill zum Evolutionsfortschritt einer zufälligen Drohnenwaffe hinzuzufügen.",
		"evo_overmind_syncronize_2": "Synchronisieren II",
		"evo_overmind_syncronize_2_desc": "Die Chance, +1 Kill zum Evolutionsfortschritt einer zufälligen Drohnenwaffe hinzuzufügen, wurde auf {1} erhöht.",
		"evo_overmind_shockSpire": "Schock-Spitze",
		"evo_overmind_shockSpire_desc": "Alle 3 gleichzeitig anvisierten Gegner erzeugen zwischen sich einen Schockspitzen. \n\nSchockspitzen senden regelmäßig elektrische Impulse aus, die den gesamten Bildschirm durchqueren und elektrischen Schaden verursachen.",
		"evo_overmind_shockSpire_2": "Schock-Spitze II",
		"evo_overmind_shockSpire_2_desc": "Effekte:\n  Schockspitzen:\n    Schaden: {1}\n    Dauer: {2}",
		"evo_overmind_burningOnes": "Die Brennenden",
		"evo_overmind_burningOnes_desc": "Durch das Eingeben von Wörtern wird ein Zähler aufgeladen, der bei Erreichen der maximalen Füllmenge explosive Drohnen erzeugt. \n\nDie Drohnen steuern auf Feinde zu und explodieren bei Kontakt, wodurch sie in einem kleinen Umkreis Explosionsschaden verursachen.",
		"evo_overmind_burningOnes_2": "Die Brennenden II",
		"evo_overmind_burningOnes_2_desc": "Effekte:\n  Brennende: {1}\n  Explosionsschaden: {1}\n  Explosionsreichweite: {2}",
		"evo_overmind_burningOnes_charge": "Wärmeakkumulation",
		"evo_overmind_burningOnes_charge_desc": "Thermische Überlastung: {1} %",
		"evo_overmind_null_field": "Nullfeld",
		"evo_overmind_null_field_desc": "Von Overmind anvisierte Gegner werden verlangsamt und erleiden {1} Schaden durch andere elektrische Effekte und Waffen.",
		"evo_overmind_null_field_2": "Nullfeld II",
		"evo_overmind_null_field_2_desc": "Von Overmind anvisierte Gegner sind ebenfalls von Static betroffen, solange sie anvisiert sind.",
		"evo_wildcard_winter": "Winter",
		"evo_wildcard_winter_desc": "Wildcard feuert keine Hitze-Projektile mehr ab.\n\nGlobaler Effekt:\n  Alle Kälteeffekte/-waffen:\n Schaden: {1}",
		"evo_wildcard_winter_2": "Winter II",
		"evo_wildcard_winter_2_desc": "Globaler Effekt:\n Alle Kälteeffekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_warmth": "Wärme",
		"evo_wildcard_warmth_desc": "Wildcard feuert keine Frost Projektile mehr ab. \n\nGlobaler Effekt:\n Alle Hitzeeffekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_warmth_2": "Wärme II",
		"evo_wildcard_warmth_2_desc": "Globaler Effekt:\n Alle Hitzeeffekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_repulsor": "Repulsor",
		"evo_wildcard_repulsor_desc": "Wildcard feuert keine kinetischen Projektile mehr ab. \n\nGlobaler Effekt:\n Alle elektrischen Effekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_repulsor_2": "Repulsor II",
		"evo_wildcard_repulsor_2_desc": "Globaler Effekt:\n Alle elektrischen Effekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_diamond": "Diamant",
		"evo_wildcard_diamond_desc": "Wildcard feuert keine elektrischen Projektile mehr ab. \n\nGlobaler Effekt:\n  Alle kinetischen Effekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_diamond_2": "Diamant II",
		"evo_wildcard_diamond_2_desc": "Globaler Effekt:\n Alle kinetischen Effekte/Waffen:\n Schaden: {1}",
		"evo_wildcard_fragmentation": "Fragmentierung",
		"evo_wildcard_fragmentation_desc": "Wenn kinetische Projektile Hitze-Kugeln treffen, lösen sie Hitze-Explosionen aus. Wenn kinetische Projektile auf gefrorene Gegner treffen, lösen sie eine Kälte-Explosionen aus.",
		"evo_wildcard_fragmentation_2": "Fragmentierung II",
		"evo_wildcard_fragmentation_2_desc": "Wenn kinetische Projektile auf Gegner treffen, lösen sie kinetische Explosionen aus.",
		"evo_wildcard_conduit": "Leitung",
		"evo_wildcard_conduit_desc": "In Reichweite von elektrischen Projektilen, Hitze-Kugeln und eingefrorenen Gegnern fügen anderen Gegnern in ihrer Nähe elektrischen Schaden zu.",
		"evo_wildcard_conduit_2": "Leitung II",
		"evo_wildcard_conduit_2_desc": "Hitze-Kugeln und eingefrore Gegner fügen Gegnern in ihrer Nähe immer Elektrizitätsschaden zu.",
		"evo_wildcard_pestilence": "Seuche",
		"evo_wildcard_pestilence_desc": "Wildcard:\n Alle Statuseffekte:\n Chance: {1}",
		"evo_wildcard_pestilence_2": "Seuche II",
		"evo_wildcard_pestilence_2_desc": "Globaler Effekt:\n Alle Statuseffekte:\n Schaden: {1}",
		"evo_guardian_toxicWard": "Giftiger Schutzwall",
		"evo_guardian_toxicWard_desc": "Effekte:\n Hitzeschaden: {1}\n Chemieschaden: {2}\n\nWirkt sich auf den Basisschaden aus. Der Schadenstyp des Wächters wird zu chemisch.",
		"evo_guardian_toxicWard_2": "Giftige Wache II",
		"evo_guardian_toxicWard_2_desc": "Effekte:\n Chemieschaden: {1}\n\nBeeinflusst den Grundschaden.",
		"evo_guardian_experimentalFuel": "Experimenteller Treibstoff",
		"evo_guardian_experimentalFuel_desc": "Es spawnen spezielle Treibstoff-Pickups, die dem Wächter temporäre Vorteile verleihen. Es kann immer nur einer dieser Vorteile aktiv sein.",
		"evo_guardian_experimentalFuel_2": "Experimenteller Treibstoff II",
		"evo_guardian_experimentalFuel_2_desc": "Alle speziellen Treibstoff-Pickups erhalten einen Vorteil von {1} und eine Verstärkungsdauer von {2}.",
		"evo_guardian_experimentalFuel_damage": "Experimenteller Treibstoff",
		"evo_guardian_experimentalFuel_speed": "Experimenteller Treibstoff",
		"evo_guardian_experimentalFuel_range": "Experimenteller Treibstoff",
		"evo_guardian_guardianTeam": "Wächter-Team",
		"evo_guardian_guardianTeam_desc": "Effekte:\n Schaden: {1}\n Drohnen: {2}\n\nDer Guardian besteht jetzt aus zwei Drohnen statt einer.",
		"evo_guardian_guardianTeam_2": "Wächter-Team II",
		"evo_guardian_guardianTeam_2_desc": "Effekte:\n Schaden: {1}\n Drohnen: {2}\n\nDer Wächter besteht jetzt aus drei statt zwei Drohnen.",
		"evo_blade_bladeRepository": "Klingen-Repository",
		"evo_blade_bladeRepository_2": "Klingenlager II",
		"evo_blade_bladeRepository_desc": "erzeugt zusätzlich zu den bestehenden Glyphen eine Klingenfalle.",
		"evo_blade_poisonCoating": "Giftige Beschichtung",
		"evo_blade_poisonCoating_desc": "Effekte:\n Chemischer Schaden: {1}\n Brand-Chance: {2}\n\nWirkt auf den Grundschaden und wird von chemischen Schadensmodifikatoren beeinflusst.",
		"evo_blade_poisonCoating_2": "Giftmantel II",
		"evo_blade_poisonCoating_2_desc": "Effekte:\n Chemischer Schaden: {1}\n Brand-Chance: {2}\n\nWirkt auf den Grundschaden.",
		"evo_blade_sawtoothBlade": "Sägezahnklingen",
		"evo_blade_sawtoothBlade_desc": "Klingenfallen addieren ihre Kritische Chance zu ihrer Chance, Blutungen zu verursachen.",
		"evo_blade_sawtoothBlade_2": "Sägezahnklingen II",
		"evo_blade_sawtoothBlade_2_desc": "Der Blutungsschaden wird um {1} erhöht. Dies gilt für Blutungen aus allen Quellen und beeinflusst den Grundschaden.",
		"evo_blade_cutting_edge": "Schnittkante",
		"evo_blade_cutting_edge_desc": "Globaler Effekt:\n Alle Turmeffekte/Waffen:\n Kritische Chance: {1}",
		"evo_hunter_hunterElite": "Jäger-Elite",
		"evo_hunter_hunterElite_desc": "Jeder 12. gespawnte Jäger ist eine Jäger-Elite.\n\nJäger-Eliten:\n +100% Schaden\n +50% Dauer\n +50% Geschwindigkeit\n +50% Reichweite",
		"evo_hunter_hunterElite_2": "Jäger-Elite II",
		"evo_hunter_hunterElite_2_desc": "Jäger-Eliten spawnen stattdessen bei jedem 10. Jäger.\n\nJäger-Eliten:\n +50% Dauer",
		"evo_hunter_electrifiedBolts": "Elektrisierte Bolzen",
		"evo_hunter_electrifiedBolts_desc": "Effekte:\n Kinetischer Schaden: {1}\n Elektrischer Schaden: {2}\n\nJäger feuern nun Projektile statt elektrischer Ströme ab und gelten als kinetische Waffen.",
		"evo_hunter_electrifiedBolts_2": "Elektrisierte Bolzen II",
		"evo_hunter_electrifiedBolts_2_desc": "Effekte:\n Kinetischer Schaden: {1}\n\nGlobaler Effekt:\n Alle kinetischen Effekte/Waffen:\n Schaden: {2}",
		"evo_hunter_chainLightning": "Kettenblitz",
		"evo_hunter_chainLightning_desc": "Die Angriffe des Jägers ketten sich nun an 1 zusätzlichen Gegner in der Nähe.",
		"evo_hunter_chainLightning_2": "Kettenblitz II",
		"evo_hunter_chainLightning_2_desc": "Angriffe des Jägers ketten sich nun an 2 zusätzliche Gegner in der Nähe.",
		"evo_hunter_predator_strain": "Raubtierstamm",
		"evo_hunter_predator_strain_desc": "Globaler Effekt:\n Alle Drohneneffekte/Waffen:\n Dauer: {1}",
		"evo_minefield_mineLayer": "Minenleger",
		"evo_minefield_mineLayer_2": "Minenleger II",
		"evo_minefield_mineLayer_desc": "spawnen jetzt auch Minen zusätzlich zu den bestehenden Glyphen.",
		"evo_minefield_infusion": "Aufguss",
		"evo_minefield_infusion_desc": "Effekte:\n Chemischer Schaden: {1}\n Explosionsschaden: {2}\n\nDas Minenfeld verursacht nun chemischen Schaden anstelle von Explosionsschaden und gilt als chemische Waffe.",
		"evo_minefield_infusion_2": "Aufguss II",
		"evo_minefield_infusion_2_desc": "Effekte:\n Chemischer Schaden: {1}\n Brandwahrscheinlichkeit: {2}\n\nGlobaler Effekt:\n Alle chemischen Effekte/Waffen:\n Schaden: {3}",
		"evo_minefield_hunterSeeker": "Jäger Sucher",
		"evo_minefield_hunterSeeker_desc": "Effekte:\n Geschwindigkeit: {1}\n Reichweite: {2}\n\nMinen erhalten eine zielsuchende Bewegung auf zufällige Ziele.",
		"evo_minefield_hunterSeeker_2": "Jäger Sucher II",
		"evo_minefield_hunterSeeker_2_desc": "Effekte:\n Gesprengte Minen: {1}\n Geschwindigkeit: {2}",
		"evo_minefield_dirtyBomb": "Miese Bombe",
		"evo_minefield_dirtyBomb_desc": "Effekte:\n Chemischer Schaden: {1}\n Splattergun-Schaden: {2}\n\nMinen hinterlassen 3 Glibber Flächen, wenn sie explodieren.",
		"evo_minefield_dirtyBomb_2": "Miese Bombe II",
		"evo_minefield_dirtyBomb_2_desc": "Effekte:\n Chemischer Schaden: {1}\n Splattergun-Schaden: {2}\n\nWährend sich die Minen bewegen, verschießen sie Glibber.",
		"evo_minefield_recursiveMines": "Rekursive Minen",
		"evo_minefield_recursiveMines_desc": "Der Hauptturm legt in regelmäßigen Abständen eine Anzahl von Minen ab, die auf der Hälfte der Minenanzahl des Minenfelds basiert, abgerundet. Die Spawn-Rate wird durch die Feuerrate des Minenfelds bestimmt.",
		"evo_minefield_recursiveMines_2": "Rekursive Minen II",
		"evo_minefield_recursiveMines_2_desc": "Rekursive Minen spawnen {1} schneller und spawnen eine zusätzliche Mine.",
		"evo_sentry_defenseGrid": "Verteidigungsgitter",
		"evo_sentry_defenseGrid_2": "Verteidigungsgitter II",
		"evo_sentry_defenseGrid_desc": "Effekte:\n Geschützturm: +1",
		"evo_sentry_solidCore": "Solider Kern",
		"evo_sentry_solidCore_desc": "Effekte:\n  Kinetischer Schaden: {1}\n  Hitzeschaden: {2}\n\nSentry verursacht nun kinetischen Schaden anstelle von Hitzeschaden und gilt als kinetische Waffe.",
		"evo_sentry_solidCore_2": "Fester Kern II",
		"evo_sentry_solidCore_2_desc": "Effekte:\n  Kinetischer Schaden: {1}\n\nGlobaler Effekt:\n  Alle kinetischen Effekte/Waffen:\n    Schaden: {2}",
		"evo_sentry_watcher_supreme": "Oberster Wächter",
		"evo_sentry_watcher_supreme_desc": "Globaler Effekt:\n  Alle Geschützturm-Effekte/Waffen:\n    Reichweite: {1}",
		"evo_sentry_emergencyProtocol": "Notfall-Protokoll",
		"evo_sentry_emergencyProtocol_desc": "Immer wenn ein Schild-Powerup zerstört wird, wechselt die Wache für {1} Sekunden in den Notfallprotokoll-Modus.\n\nWährend des Notfallprotokolls:\n Reichweite: {2}\n Feuerrate: {3}",
		"evo_sentry_emergencyProtocol_2": "Notfallprotokoll II",
		"evo_sentry_emergencyProtocol_2_desc": "Während des Notfallprotokolls:\n Schaden: {1}\n Rotationsgeschwindigkeit: {2}",
		"evo_spectre_supercharged": "Supergeladen",
		"evo_spectre_supercharged_desc": "Jeder 20. gespawnte Spektre ist ein SUPER-Spektre.\n\nSuper-Spektren:\n +100% Schaden\n +50% Dauer\n +50% Geschwindigkeit",
		"evo_spectre_selfDestruct": "Selbstzerstörung",
		"evo_spectre_selfDestruct_desc": "Effekte:\n Explosionsschaden: {1}\n\nWenn das Gespenst abläuft, zerstört es sich selbst und verursacht Explosionsschaden. Wirkt sich auf den Grundschaden aus und wird von Explosivschaden-Modifikatoren beeinflusst.",
		"evo_spectre_selfDestruct_2": "Selbstzerstörung II",
		"evo_spectre_selfDestruct_2_desc": "Effekte:\n Explosionsschaden: {1}\n Reichweite: {2}\n\nWirkt auf den Grundschaden.",
		"evo_spectre_volatileFuel": "Flüchtiger Brennstoff",
		"evo_spectre_volatileFuel_desc": "Effekte:\n Geschwindigkeit: {1}",
		"evo_spectre_volatileFuel_2": "Flüchtiger Treibstoff II",
		"evo_spectre_volatileFuel_2_desc": "Effekte:\n Geschwindigkeit: {1}\n Dauer: {2}",
		"evo_spectre_stalking_algorithms": "Stalking-Algorithmen",
		"evo_spectre_stalking_algorithms_desc": "Globaler Effekt:\n Alle Drohneneffekte/Waffen:\n Geschwindigkeit: {1}",
		"evo_tesla_abundantCoils": "Üppige Spulen",
		"evo_tesla_abundantCoils_2": "Reichhaltige Spulen II",
		"evo_tesla_abundantCoils_desc": "Spawnen zusätzlich zu den bestehenden Glyphen eine Tesla-Mine.",
		"evo_tesla_electricalBurn": "Elektrische Verbrennung",
		"evo_tesla_electricalBurn_desc": "Effekt:\n Hitzeschaden: {1}\n Elektrosaden: {2}\n\nDie Tesla-Mine verursacht nun Hitzeschaden statt Elektroschaden und gilt als Hitzewaffe.",
		"evo_tesla_electricalBurn_2": "Elektrische Verbrennung II",
		"evo_tesla_electricalBurn_2_desc": "Effekte:\n Hitzeschaden: {1}\n\nGlobaler Effekt:\n Alle Hitzeeffekte/Waffen:\n Schaden: {2}",
		"evo_tesla_restrictedArea": "Eingeschränktes Gebiet",
		"evo_tesla_restrictedArea_desc": "Feinde in der Reichweite von Tesla-Mine haben eine um {1} erhöhte Chance, von elektrischen Schadensquellen den Status Statisch zu erhalten.",
		"evo_tesla_restrictedArea_2": "Eingeschränktes Gebiet II",
		"evo_tesla_restrictedArea_2_desc": "Der statische Schaden wird um {1} und die Reichweite um {2} erhöht. Dies gilt für Statik, die von allen Quellen zugefügt wird, und wirkt sich auf den Grundschaden aus.",
		"evo_tesla_storm_sovereign": "Sturmfürst",
		"evo_tesla_storm_sovereign_desc": "Globaler Effekt:\n Alle Turmeffekte/Waffen:\n Feuerrate: {1}",
		"evo_chopper_dualWield": "Doppelter Schwinger",
		"evo_chopper_dualWield_desc": "Effekt:\n +1 Häcksler",
		"evo_chopper_flamingBlades": "Flammende Klingen",
		"evo_chopper_flamingBlades_desc": "Effekt:\n Kinetischer Schaden: {1}\n Hitzeschaden: {2}\n\nHäcksler verursacht nun Hitzeschaden statt kinetischen Schaden und gilt als Hitzewaffe.",
		"evo_chopper_flamingBlades_2": "Flammende Klingen II",
		"evo_chopper_flamingBlades_2_desc": "Effekte:\n Hitzeschaden: {1}\n\nGlobaler Effekt:\n Alle Hitzeeffekte/Waffen:\n Schaden: {2}",
		"evo_chopper_boomerang": "Bumerang",
		"evo_chopper_boomerang_desc": "Zerhacker reist nun zurück zur Hauptwaffe, nachdem er den Bildschirmrand erreicht hat.",
		"evo_chopper_boomerang_2": "Bumerang II",
		"evo_chopper_boomerang_2_desc": "Effekte:\n Geschwindigkeit: {1}\n Feuerrate: {2}",
		"evo_chopper_sawLauncher": "Sägen-Werfer",
		"evo_chopper_sawLauncher_desc": "Effekte:\n Chance auf Blutung: {1}\n Blutungsschaden: {2}\n Repeater Blutungschance: {3}\n\nHäcksler wird durch zwei kleinere Sägeblätter mit hoher Angriffsgeschwindigkeit ersetzt, die in einem Kegelmuster abgefeuert werden.",
		"evo_chopper_sawLauncher_2": "Sägen-Werfer II",
		"evo_chopper_sawLauncher_2_desc": "Effekte:\n Chance auf Blutung: {1}\n Blutungsschaden: {2}\n Repeater Blutungschance: {3}\n\nErhöht die abgefeuerten Sägeblätter um 2.",
		"evo_chopper_bloodbath": "Blutbad",
		"evo_chopper_bloodbath_desc": "Effekte:\n Schaden an blutenden Feinden: {1}\n\nBlutende Feinde, die durch den Häcksler getötet werden, haben eine Chance von {2} doppelten Schaden zu aktivieren.",
		"evo_chopper_bloodbath_2": "Blutbad II",
		"evo_chopper_bloodbath_2_desc": "Effekte:\n Schaden an blutenden Gegnern: {1}\n\nErhöhte Chance auf doppelten Schaden auf {2}.",
		"evo_meteor_surveillance": "Überwachung:",
		"evo_meteor_surveillance_desc": "Meteor hat jetzt zwei Zieloptionen statt nur einer.",
		"evo_meteor_surveillance_2": "Überwachung II",
		"evo_meteor_surveillance_2_desc": "Meteor erhält drei Zieloptionen anstelle von zwei.",
		"evo_meteor_iceRain": "Eisregen",
		"evo_meteor_iceRain_desc": "Effekt:\n Kälteschaden: {1}\n Explosionsschaden: {2}\n\nMeteor verursacht nun Kälteschaden statt Explosionsschaden und gilt als Kältewaffe.",
		"evo_meteor_iceRain_2": "Eisregen II",
		"evo_meteor_iceRain_2_desc": "Effekte:\n Kälteschaden: {1}\n\nGlobaler Effekt:\n Alle Kälteeffekte/Waffen:\n Schaden: {2}",
		"evo_meteor_relentless": "Unerbittlich",
		"evo_meteor_relentless_desc": "Effekte:\n Reichweite: {1}\n Feuerrate: {2}\n\nMeteore feuern nun kontinuierlich und bewegen sich auf das letzte Ziel zu.",
		"evo_meteor_relentless_2": "Unerbittlich II",
		"evo_meteor_relentless_2_desc": "Effekte: \n Geschwindigkeit: {1}\n Kritische Chance: {2}",
		"evo_meteor_sky_spotter": "Himmelsbeobachter",
		"evo_meteor_sky_spotter_desc": "Globaler Effekt:\n Alle Ferneffekte/Waffen:\n Reichweite: {1}",
		"evo_oscillator_twinHeaded": "Doppelköpfig",
		"evo_oscillator_twinHeaded_desc": "Ein zusätzlicher Strom von Oszillator-Geschossen wird in die entgegengesetzte Richtung abgefeuert.",
		"evo_oscillator_ballLightning": "Kugelblitz",
		"evo_oscillator_ballLightning_desc": "Effekt:\n Elektrischer Schaden: {1}\n Hitzeschaden: {2}\n\nDer Oszillator verursacht nun elektrischen Schaden anstelle von Hitzeschaden und gilt als elektrische Waffe.",
		"evo_oscillator_ballLightning_2": "Kugelblitz II",
		"evo_oscillator_ballLightning_2_desc": "Effekte:\n Elektrischer Schaden: {1}\n\nGlobaler Effekt:\n Alle elektrischen Effekte/Waffen:\n Schaden: {2}",
		"evo_oscillator_stabilizedPlasma": "Stabilisiertes Plasma",
		"evo_oscillator_stabilizedPlasma_desc": "Oszillator-Projektile durchdringen jetzt Gegner. Feinde, die nach dem ersten Treffer getroffen werden, erleiden {1} Schaden.",
		"evo_oscillator_stabilizedPlasma_2": "Stabilisiertes Plasma II",
		"evo_oscillator_stabilizedPlasma_2_desc": "Der Verbrennungsschaden wird um {1} erhöht. Dies gilt für Entzündung, die von allen Quellen verursacht wird, und beeinflusst den Grundschaden.",
		"evo_oscillator_prime_resonance": "Primäre Resonanz",
		"evo_oscillator_prime_resonance_desc": "Globaler Effekt:\n Alle Ferneffekte/Waffen:\n Schaden: {1}",
		"evo_orbiter_continuum": "Kontinuität",
		"evo_orbiter_continuum_2": "Kontinuität II",
		"evo_orbiter_continuum_desc": "es werden zusätzlich Raumgleiter eingesetzt zu bestehenden Glyphen.",
		"evo_orbiter_stormRing": "Sturmring",
		"evo_orbiter_stormRing_desc": "Effekte:\n Chemischer Schaden: {1}\n Elektrischer Schaden: {2}\n\nWirkt sich auf den Grundschaden aus und wird von Elektroschadensmodifikatoren beeinflusst.",
		"evo_orbiter_stormRing_2": "Sturmring II",
		"evo_orbiter_stormRing_2_desc": "Effekte:\n Elektrischer Schaden: {1}\n Statische Effektchance: {2}\n\nWirkt sich auf den Grundschaden aus.",
		"evo_orbiter_doppelganger": "Doppelgänger",
