		"item_glassCannon_desc": "Alle Waffen:\n Schaden: {2}\n\nHauptwaffe:\n Maximale Leben: {1}",
		"item_carapace": "Panzer",
		"item_carapace_desc": "Alle Waffen:\n Beuteabwurf-Chance: {2}\n\nChance auf:\n Vergrößerte Feinde: {1}",
		"item_regeneration": "Regeneration",
		"item_regeneration_desc": "Du heilst {1} deiner maximalen Gesundheit, wenn du eine Beute-, Einfrier-, Doppelschadens-, Wiederholungsrolle oder Schild-Aufnahme aktivierst.",
		"item_DOTCanCrit": "Erosion",
		"item_DOTCanCrit_desc": "D.O.T.-Waffen können kritisch sein.",
		"item_cryotechnics": "Kryotechnik",
		"item_cryotechnics_desc": "Eingefrorene Pickups:\n Abwurf-Chance: {1}\n\nPickups mit doppeltem Schaden:\n -100% Abwurfchance",
		"item_warlike": "Kriegerisch",
		"item_warlike_desc": "Doppelte Schaden-Pickups:\n Abwurfchance: {1}\n\nEingefrorene Pickups:\n -100% Abwurfchance",
		"item_pinata": "Pinata",
		"item_pinata_desc": "Globaler Effekt:\n Beutehäufigkeit: {1}",
		"item_point_blank": "Scharfschützen",
		"item_point_blank_desc": "Feinde, die in der Nähe der Hauptwaffe getroffen werden, erleiden {1} Schaden.",
		"item_shatter": "Zerschmettern",
		"item_shatter_desc": "Alle kinetischen Waffen erhalten {1} kritische Trefferchance gegen gefrorene Gegner.",
		"item_seer": "Seher",
		"item_seer_desc": "Das Aktivieren von „Neu würfeln“ erhöht deine globale Reichweite 10 Sekunden lang um 10%. Kann bis zu 3 Mal gestapelt werden.",
		"item_seer_desc_2": "Wenn du beim Betreten eines Level-Up-, Evolutions- oder Beutebildschirms 0x \"Neu Würfeln\" hast, hast du stattdessen 1x \"Neu Würfeln\".",
		"item_resilience": "Unverwüstlichkeit",
		"item_resilience_desc": "Das Aktivieren von Schildaufsammlungen erhöht deine globale Dauer 10 Sekunden lang um 10%. Kann bis zu 3 Mal gestapelt werden.",
		"item_resilience_desc_2": "Für jedes Schild was du hast, bekomme {1} globale Dauer.",
		"item_gambler": "Glücksspieler",
		"item_gambler_desc": "Fügt 1 Wiederholungswurf hinzu und erhöht den maximalen Wiederholungswurf auf insgesamt 6.",
		"item_protector": "Beschützer",
		"item_protector_desc": "Fügt 1 Schild hinzu und erhöht die maximalen Schilde auf insgesamt 4.",
		"item_flawless": "Makellos",
		"item_flawless_desc": "Jede x{1} perfekte Eingabe erhöht auch deine globale Feuerrate um {2}.",
		"item_release": "Loslassen",
		"item_release_desc": "Fügt bei einem Fehltritt {1} Explosionsschaden an allen Feinden für je x{2} perfekte Eingabe.",
		"item_wasting": "Vergeuden",
		"item_wasting_desc": "Alle D.O.T.-Waffen: +35% Feuerrate",
		"item_wither": "Verdorren",
		"item_wither_desc": "Alle Status-Effekte: +35% Feuerrate",
		"consumable_medpack": "Medikit",
		"consumable_medpack_desc": "Fügt {1} Medikits deinem Inventar zu. Medikits heilen bis zu {2} der maximalen Gesundheit des Hauptturms.",
		"consumable_serum": "Serum",
		"consumable_serum_desc": "Fügt {1} Seren deinem Inventar zu.\n\nSeren geben {2} Krit-Chance für {3} Sekunden.",
		"consumable_warhead": "Sprengkörper",
		"consumable_warhead_desc": "Fügt {1} Sprengkörper deinem Inventar zu.\n\nSprengkörper lösen eine Reihe mächtiger Explosionen aus, die von der Hauptwaffe ausgehen.",
		"weapon_warhead_desc": "Verbrauchseffekt - zählt nicht als Waffe.\n\nLöst eine Reihe mächtiger Explosionen aus, die von der Hauptwaffe ausgehen.",
		"consumable_flameWave": "Flammenwelle",
		"consumable_flameWave_desc": "Fügt {1} Flammenwellen zu deinem Inventar.\n\nFlammenwellen entzündet alle sichtbaren Feinde auf Kosten von 10 % der aktuellen Gesundheit des Hauptturms.",
		"weapon_flameWave_desc": "Verbrauchseffekt - zählt nicht als Waffe.\n\nEntzündet alle sichtbaren Feinde auf Kosten von 10% der aktuellen Gesundheit des Hauptturms.",
		"consumable_cryocore": "Kryokern",
		"consumable_cryocore_desc": "Fügt {1} Kryokerne deinem Inventar zu.\n\nKryokerne lösen den globalen Effekt Einfrieren aus.",
		"consumable_killPill": "Tötungspille",
		"consumable_killPill_desc": "Fügt {1} Tötungspillen deinem Inventar zu.\n\nTötungspillen lösen den globalen Effekt „Doppelter Schaden“ aus.",
		"consumable_pocketTurret": "Taschenturm",
		"consumable_pocketTurret_desc": "Fügt {1} Taschenturm zu deinem Inventar hinzu.\n\nTaschenturm spawnt einen automatischen Turm in der Nähe von Gruppen von Feinden.",
		"weapon_pocket_turret_desc": "Verbrauchbarer Effekt – zählt nicht als Waffe.\n\nErzeugt einen automatischen Geschützturm in der Nähe von Feindengruppen.",
		"item_plunder": "Plündern",
		"item_plunder_desc": "1 Beute Option",
		"item_multitargeting": "Mehrfachzieleinrichtung",
		"item_multitargeting_desc": "Alle Fernkampfwaffen erhalten +1% kritische Chance für jede Waffe, die du besitzt.",
		"item_pickupMagnet": "Riesiger Magnet",
		"item_pickupMagnet_desc": "Du sammelst automatisch Pickups ein, wenn sie ablaufen.",
		"item_frostbite": "Einfrieren",
		"item_frostbite_desc": "Feinde erleiden Schaden über Zeit, wenn sie eingefroren sind.",
		"item_necrobomb": "Nekrobombe",
		"item_necrobomb_desc": "Wenn du einen Feind mit explosivem Krit-Schaden vernichtest, löst du eine Reihe von Explosionen um die Position des gefallenen Feindes herum aus.",
		"item_prize": "Preis",
		"item_prize_desc": "Bei der Zerstörung eines Gegners mit kritischem Schaden besteht eine Chance von {1}, dass Wiederholungsrollen, Schilde oder Lebenspunkte aufgesammelt werden.",
		"item_aftershock": "Nachbeben",
		"item_aftershock_desc": "Kritischer Schaden führt immer zu einem Statuseffekt.",
		"item_vampirism": "Vampirismus",
		"item_vampirism_desc": "Erhalte Gesundheit in Höhe von {1} des kinetischen Kritischen Schadens.",
		"item_wisdom": "Weisheit",
		"item_wisdom_desc": "Wenn du Schild aufnimmst, erhältst du 10 Kills auf alle Waffenentwicklungen.",
		"item_jester": "Narr",
		"item_jester_desc": "Wenn du „Neu würfeln“ aufnimmst, fügst du allen Gegnern auf dem Bildschirm eine zufällige Menge Schaden zwischen 0 und 100 zu.",
		"item_jester_2_desc": "Beim Abschließen eines Wortes wird eine Narren-Drohne erzeugt, die einem zufälligen Ziel 0-100% Schaden zufügt. 10 Sekunden Abklingzeit zwischen den Aktivierungen.",
		"item_lastStand": "Letzter Stand",
		"item_lastStand_desc": "Wenn ein Schild zerstört wird, erleidet er doppelten Schaden.",
		"item_tripleDamage": "Dreifacher Schaden",
		"item_tripleDamage_desc": "Alle Treffer mit doppeltem Schaden sind jetzt stattdessen dreifacher Schaden.",
		"item_fracture": "Fraktur",
		"item_fracture_desc": "Während des Einfrierens wird jeder Einfrier-Pickup, der gespawnt hätte, zu einem Bruch, der allen eingefrorenen Gegnern Schaden zufügt.",
		"item_fracture_desc_2": "Alle Schäden an gefrorenen Feinden werden um {1} erhöht. Der Modifikator ist multiplikativ.",
		"item_ascetic": "Asket",
		"item_ascetic_desc": "Wenn ihr den Beutebildschirm verlasst, erhaltet ihr 20 Sekunden lang +10% Schaden für jede ungenutzte Wiederholungsrolle.",
		"item_harmonizer": "Harmonisierer",
		"item_harmonizer_desc": "Alle ausgerüsteten Waffen erhalten eine Evolutionsstufe.",
		"item_immortality": "Unsterblichkeit",
		"item_immortality_desc": "Wenn deine Hauptwaffe kurz davor ist, zerstört zu werden, wird sie stattdessen auf 1 Lebenspunkt reduziert. Diese Fähigkeit kann nur einmal alle 2 Minuten eingesetzt werden.",
		"item_immortality_desc_2": "Wenn deine Hauptwaffe kurz davor ist, zerstört zu werden, wird sie stattdessen auf 1 Lebenspunkt reduziert und alle Gegner im Umkreis von 400 Metern um die Hauptwaffe erleiden tödlichen kinetischen Schaden. Diese Fähigkeit kann nur einmal alle 2 Minuten eingesetzt werden.",
		"item_enlightenment": "Erleuchtung",
		"item_enlightenment_desc": "Wenn du einen Gegner mit kritischem Schaden zerstörst, erhältst du +1 Kills für alle Waffenentwicklungen.",
		"item_closer": "Näher",
		"item_closer_desc": "Das Vervollständigen eines gegnerischen Wortes, nachdem es zerstört wurde, gibt +10% Schaden für 10 Sekunden. Stacks bis zu 3 mal.",
		"item_murderous": "Mörderisch",
		"item_murderous_desc": "All Drohnenwaffen: +50% Schaden",
		"item_executioner": "Scharfrichter",
		"item_executioner_desc": "Alle Turmwaffen: +50% Schaden",
		"item_degeneration": "Degenerierung",
		"item_degeneration_desc": "Alle Fernwaffen: +50% Schaden",
		"item_clone": "Klon",
		"item_clone_desc": "Verbrauchsgüter haben eine 30% Chance, sich bei Verwendung selbst zu replizieren.",
		"augment_category_mainWeapon": "Kodex: Hauptwaffe",
		"augment_category_turret": "Kodex: Geschützturm",
		"augment_category_drones": "Kodex: Drohnen",
		"augment_category_dot": "Kodex: D.O.T.",
		"augment_category_remote": "Kodex: Fernwaffen",
		"augment_category_electric": "Kodex: Elektrisch",
		"augment_category_heat": "Kodex: Hitze",
		"augment_category_kinetic": "Kodex: Kinetisch",
		"augment_armored": "Gepanzert",
		"augment_armored_desc": "Hauptwaffe:\nLeben: +50%",
		"augment_eager": "Eifrig",
		"augment_eager_desc": "Zu Beginn eines jeden Trial- oder Endlos-Spiels erhältst du eine Stufe. Für alle 4 Minuten, die du im Endlosmodus überlebst, erhältst du eine Stufe.",
		"augment_gambler": "Zocker",
		"augment_gambler_desc": "Erneutes Würfeln verleiht deiner Hauptwaffe für 20 Sekunden +20% Schaden.",
		"augment_haze": "Dunst",
		"augment_haze_desc": "Wenn du weniger als 50% Leben hast, erhältst du einen globalen Bonus von +50% auf die Feuerrate.",
		"augment_immaculate": "Unbefleckt",
		"augment_immaculate_desc": "Perfekte Eingabe gibt +1,5% kritische Chance pro Stapel.",
		"augment_devotion": "Hingabe",
		"augment_devotion_desc": "Die Hauptwaffe erhält +25% Schaden für jeden leeren Waffenslot. Mindestens eine Option während des Stufenaufstiegs wird ein Upgrade sein.",
		"augment_armada": "Armee",
		"augment_armada_desc": "20% Chance, eine zusätzliche Drohne zu spawnen, wenn eine gespawnt wird.",
		"augment_diversity": "Vielfältigkeit",
		"augment_diversity_desc": "Für jede ausgerüstete Nicht-Drohnenwaffe wird die Dauer aller Drohnen um 20% erhöht.",
		"augment_blitzkrieg": "Blitzkrieg",
		"augment_blitzkrieg_desc": "Verbesserung der Drohnengeschwindigkeit verbessert auch Drohnenschaden.",
		"augment_retribution": "Vergeltung",
		"augment_retribution_desc": "Immer wenn ein Schild zerstört wird, zerstören sich alle vorhandenen Drohnen selbst und verursachen explosiven Schaden.",
		"augment_scapegoat": "Sündenbock",
		"augment_scapegoat_desc": "Fehleingaben zerstören zufällig eine vorhandene Drohne, anstatt als Tippfehler zu zählen.",
		"augment_spoils": "Beute",
		"augment_spoils_desc": "Drohnen können bei Ablauf Pickups abwerfen.",
		"augment_fortress": "Festung",
		"augment_fortress_desc": "Jede Geschützturm-Evolution gewährt außerdem +50 maximales Leben für die Hauptwaffe.",
		"augment_networked": "Vernetzt",
		"augment_networked_desc": "Jeder weitere Geschützturm gewährt allen Geschütztürmen +10% Feuerrate, bis zu einem Maximum von +50%.",
		"augment_fieldIntel": "Feld-Information",
		"augment_fieldIntel_desc": "Das Aktivieren eines Pickups gewährt +30% Reichweite für alle vorhandenen Geschütztürme. Dieser Effekt ist nicht stapelbar.",
		"augment_darkRelay": "Dunkle Staffel",
		"augment_darkRelay_desc": "Ein Projektil springt zufällig zwischen den vorhandenen Türmen hin und her und verursacht elektrischen Schaden.",
		"augment_observer": "Beobachter",
		"augment_observer_desc": "Wenn du 3 Sekunden lang nicht angegriffen hast, erhältst du bis zu deinem nächsten Angriff +30% Turmschaden.",
		"augment_observer_powerup": "{1} Geschützturmschaden",
		"augment_weakness": "Schwäche",
		"augment_weakness_desc": "Feinde in der Reichweite eines Geschützturms erleiden 30% mehr Schaden aus anderen Quellen.",
		"augment_corrosion": "Korrosion",
		"augment_corrosion_desc": "D.O.T.-Schaden kann jetzt kritisch sein.",
		"augment_lamprey": "Neunauge",
		"augment_lamprey_desc": "D.O.T.-Schaden, der in der Nähe der Hauptwaffe verursacht wird, heilt die Hauptwaffe um 1 Lebenspunkt.",
		"augment_tenacity": "Zähigkeit",
		"augment_tenacity_desc": "Erhöht die Dauer aller D.O.T.-Waffen um 35%.",
		"augment_afflictors": "Betroffener",
		"augment_afflictors_desc": "Fügt Betroffene zum Beutetopf hinzu. Jeder gibt +4% D.O.T.-Schaden. Doppelte Wirkung in der Nähe der Hauptwaffe.",
		"augment_conviction": "Verurteilung",
		"augment_conviction_desc": "D.O.T.-Waffen erhalten +40% Feuerrate, solange du maximale Wiederholungswürfe hast.",
		"augment_conviction_powerup": "{1} D.O.T. Feuerrate",
		"augment_infector": "Infizierung",
		"augment_infector_desc": "D.O.T.-Waffen haben eine Chance von +3% auf Statuseffekte.",
		"augment_closeCombat": "Nahkampf",
		"augment_closeCombat_desc": "Der gesamte Fernwaffenschaden wird als nahe an der Hauptwaffe betrachtet.",
		"augment_caltrops": "Krähenfüße",
		"augment_caltrops_desc": "Bei einem kritischen Treffer durch Fernwaffen werden 12 Krähenfüße gespawnt, die mit erhöhter Blutungschance Gegnern Schaden zufügen.",
		"augment_causticAmmo": "Ätzende Munition",
		"augment_causticAmmo_desc": "Chance, ätzende Munition fallen zu lassen - fügt Fernwaffen 20 Sekunden lang 10 Basis-Chemieschaden zu.",
		"augment_piracy": "Piraterie",
		"augment_piracy_desc": "Erhöht für jeden Beuteeffekt, der ausgerüstet wird, den gesamten Fernschaden um 15%.",
		"augment_deliverance": "Erlösung",
		"augment_deliverance_desc": "Alle Fernwaffen erhalten +40% Reichweite, solange du maximale Schilde hast.",
		"augment_deliverance_powerup": "{1} Fernkampf-Reichweite",
		"augment_sniper": "Scharfschütze",
		"augment_sniper_desc": "Verbesserungen der Reichweite von Fernwaffen gilt auch für den Fernwaffenschaden.",
		"augment_voltaicBurst": "Voltaischer Ausbruch",
		"augment_voltaicBurst_desc": "Aufwertungen der elektrischen Dauer wenden ebenfalls 25% ihres Wertes auf die elektrische statische Chance an.",
		"augment_stormBattery": "Sturmbatterie",
		"augment_stormBattery_desc": "Der Hauptturm fügt Gegnern in der Nähe elektrischen Schaden zu. Jede ausgerüstete Elektro-Waffe erhöht den Basisschaden.",
		"augment_lightningSparks": "Funken",
		"augment_lightningSparks_desc": "Bei einem kritischen Treffer durch elektrische Waffen werden 6 Funken freigesetzt, die ihren Schaden mit der Kritischen Chance und dem Kritischen Multiplikator skalieren.",
		"augment_efficientGrid": "Effizientes Raster",
		"augment_EfficientGrid_desc": "Für jede nicht-elektrische Waffe, die ausgerüstet wird, wird die Dauer aller elektrischen Waffen um 10% erhöht.",
		"augment_violentDischarge": "Gewaltsame Entladung",
		"augment_violentDischarge_desc": "Statik verursacht mehr Schaden und hat eine größere Reichweite. Feinde, die von Statik getötet werden, haben eine Chance von 50%, Statik auf Feinde in der Nähe zu übertragen.",
		"augment_electrifiedTurret": "Elektrifizierter Turm",
		"augment_electrifiedTurret_desc": "Die Hauptwaffe erhält +5 Basis-Elektroschaden und erhöht den gesamten Elektrowaffenschaden um 10%.",
		"augment_pyromancy": "Pyromantie",
		"augment_pyromancy_desc": "Erhöht den Hitzeschaden um 2% für jeden entzündeten Gegner. Verwendung von „Entzünden“ verursacht zusätzlichen Hitzeschaden, in Höhe von Dauer und Schaden.",
		"augment_cauterization": "Kauterisieren",
		"augment_cauterization_desc": "Reichweitenboni gelten bei Hitzewaffen/Effekten auch für Schaden, der in der Nähe der Hauptwaffe zugefügt wird.",
		"augment_furnaceCore": "Kern des Ofens",
		"augment_furnaceCore_desc": "Der Hauptturm erhält +5 Basis-Hitzeschaden. Der gesamte Hitzeschaden wird um 10% erhöht.",
		"augment_fireball": "Feuerball",
		"augment_fireball_desc": "Beim Abfeuern der Hauptwaffe wird ein sich langsam bewegender Feuerball freigesetzt, der an Feinden in seinem Weg Hitzeschaden verursacht. Maximal 1 Feuerball aktiv.",
		"augment_flameWave": "Flammenwelle",
		"augment_flameWave_desc": "Fügt das Verbrauchsmaterial Flammenwelle hinzu. Entzündet alle sichtbaren Feinde und verbraucht 10 % der aktuellen Gesundheit des Hauptturms.",
		"augment_blazingGlory": "Lodernder Ruhm",
		"augment_blazingGlory_desc": "Feinde in der Nähe der Hauptwaffe erleiden +25% Hitzeschaden und haben eine zusätzliche Chance von 12%, durch Hitzeschaden entzündet zu werden.",
		"augment_gunslinger": "Revolverheld",
		"augment_gunslinger_desc": "Erhöhe maximales Wörterrausch um 5. Jeder Rang von Wörterrausch gewährt +2,5 % kinetischen Schaden.",
		"augment_bloodlust": "Blutlust",
		"augment_bloodlust_desc": "Erhöht die kinetische Feuerrate um 2 % und die Reichweite um 1 % für jeden blutenden Gegner.",
		"augment_infusedAmmo": "Angereicherte Munition",
		"augment_infusedAmmo_desc": "Kritische Treffer mit kinetischem Schaden haben eine Chance von 40 %, dem Gegner einen zufälligen Status zuzufügen.",
		"augment_scrapArmaments": "Schrapnell",
		"augment_scrapArmaments_desc": "Chance, Granatsplitter fallen zu lassen – fügt kinetischen Waffen 20 Sekunden lang 10 Basiskinetikschaden hinzu.",
		"augment_combinedArms": "Kombinierte Waffen",
		"augment_combinedArms_desc": "Für jede nicht-kinetische Waffe, die ausgerüstet ist, wird der gesamte kinetische Schaden um 10 % erhöht.",
		"augment_pocketTurret": "Taschenturm",
		"augment_pocketTurret_desc": "Fügt das Verbrauchsgegenstand Taschenturm zum Inventar und zum Beutesortiment hinzu. Taschenturm spawnt einen Turm und kann nach Ablauf der Wirkungsdauer aufgehoben werden.",
		"wiki_tag_label": "Tags",
		"wiki_name_label": "Name",
		"wiki_cost_label": "Kosten",
		"wiki_description_label": "Beschreibung",
		"wiki_title": "Glyphica Offizielles Wiki",
		"wiki_subtitle": "Offizielles Wiki von Glyphica Typing Survival",
		"wiki_home_title": "Startseite",
		"wiki_landingPage_title": "Willkommen Tipper",
		"wiki_landingPage_intro": "Willkommen auf dem offiziellen Wiki für Glyphica: Typing Survival! Teste deine Tippfähigkeiten in diesem Horden-Survival-Spiel, in dem Geschwindigkeit und Genauigkeit deine ultimativen Waffen sind. Rüste mächtige Werkzeuge aus, die deine Tippfähigkeiten in verheerende Angriffe gegen unerbittliche Feinde verwandeln. Entdecken Sie mehr und holen Sie sich das Spiel auf Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Dieses Wiki dient als umfassender Leitfaden zu den Funktionen, Mechaniken und Inhalten, die in der Early-Access-Version von Glyphica verfügbar sind. Unser Ziel ist es, die Informationen auf dem neuesten Stand zu halten, während wir uns der Vollversion 1.0 nähern. Das Wiki ist in die im Inhaltsverzeichnis aufgeführten Abschnitte gegliedert und wird regelmäßig aktualisiert, wenn sich das Spiel weiterentwickelt.",
		"wiki_tableOfContents_title": "Inhaltsübersicht",
		"wiki_mainWeapons_title": "Hauptwaffen",
		"wiki_mainWeapons_intro": "Hauptwaffen sind die Startwaffen in *Glyphica* und spielen eine zentrale Rolle im Gameplay. Wenn Sie ein Wort eingeben, das über einem Feind angezeigt wird, wird die Hauptwaffe auf diesen Feind als Ziel ausgerichtet. Jede Hauptwaffe hat einzigartige Effekte und Mechaniken und erfordert unterschiedliche Strategien, um sie effektiv einzusetzen.",
		"wiki_mainWeapons_intro2": "Während bei einigen Hauptwaffen die Tippgeschwindigkeit (WPM) im Vordergrund steht, erfordern andere ein eher taktisches Vorgehen. Wie andere Waffen im Spiel können auch Hauptwaffen aufgerüstet und weiterentwickelt werden, um ihre Fähigkeiten und Effektivität im Laufe des Spiels zu verbessern.",
		"wiki_mainWeapons_list_title": "Liste der Hauptwaffen",
		"wiki_weapons_title": "Level-Up-Waffen",
		"wiki_weapons_intro": "Level-Up-Waffen erhält man während eines Laufs, wenn man aufsteigt. Sobald die Waffe ausgewählt ist, wird sie zu deinem Arsenal hinzugefügt. Jede Waffe hat eine eigene Aktivierungsmethode, aber die meisten können durch Tippen und Zielen mit der Hauptwaffe ausgelöst werden.",
		"wiki_weapons_intro2": "Maximal vier Waffen können auf diese Weise erworben werden. Sobald Sie eine Waffe zu Ihrem Arsenal hinzugefügt haben, werden ihre Upgrades im Level-Up-Up-Pool verfügbar, so dass Sie ihre Fähigkeiten im Laufe des Spiels verbessern können.",
		"wiki_weapons_list_title": "Liste der Level-Up-Waffen",
		"wiki_weapon_evolution_title": "Weiterentwicklungen",
		"wiki_weapon_upgrade_title": "Aufwertungen",
		"wiki_lootItems_title": "Beutegegenstände",
		"wiki_lootItems_intro": "Beutegegenstände erhält man während eines Laufs, indem man eine Schatztruhe aktiviert. Es wird eine zufällige Auswahl an Beutegegenständen angezeigt, und die Auswahl eines davon gewährt einen passiven Bonus, der für den Rest des Laufs aktiv bleibt.",
		"wiki_lootItems_intro2": "Beutegegenstände werden in die Kategorien **Gewöhnlich**, **Ungewöhnlich** und **Selten** eingeteilt, die die Wahrscheinlichkeit bestimmen, dass sie in der Beuteauswahl auftauchen. Das Besiegen eines Bosses im Probe-Modus belohnt mit einer Schatztruhe, die nur seltene Gegenstände enthält.",
		"wiki_lootItems_rare_title": "Liste der seltenen Beute",
		"wiki_lootItems_uncommon_title": "Liste der nicht-gewöhnlichen Beute",
		"wiki_lootItems_common_title": "Liste der gewöhnlichen Beute",
		"wiki_enemies_title": "Feinde",
		"wiki_enemies_intro": "Die Feinde in *Glyphica* werden prozedural auf der Grundlage einer internen Metrik namens **Bedrohung** erzeugt, die mit dem Fortschreiten des Laufs zunimmt. Im Versuchsmodus wird die Bedrohung mit der aktuellen Versuchsstufe multipliziert, wodurch jede Stufe zunehmend schwieriger wird. Im Endlosmodus wird die Bedrohung mit einem adaptiven Skalierungssystem verglichen, das auf der Stufe des Spielers basiert, wobei der höhere Wert die Schwierigkeit des Spawnens bestimmt.",
		"wiki_enemies_intro2": "Feinde werden außerdem in **Spezialisten** und **Eliten** eingeteilt, die jeweils eine eigene Klassenobergrenze haben, die ihre Spawn-Rate innerhalb der Gesamtbedrohungsstufe begrenzt.",
		"wiki_enemies_list_title": "Liste der Feinde",
		"wiki_enemy_variants_title": "Liste der Varianten",
		"wiki_image_label": "Bild",
		"wiki_splitter_shard_count": "Anzahl der Scherben",
		"wiki_splitter_shard_health": "Scherben-Gesundheit",
		"wiki_splitter_shard_damage": "Scherben-Schaden",
		"wiki_augments_title": "Upgrades",
		"wiki_augments_intro": "Erweiterungen sind permanente Upgrades, die mit Münzen (§), einer Währung, die während eines Laufs verdient wird, freigeschaltet werden können. Zu Beginn eines jeden Laufs haben die Spieler eine begrenzte Anzahl von Slots, um freigeschaltete Augments auszurüsten, wobei die Anzahl der verfügbaren Slots von der gewählten Omen-Stufe abhängt.",
		"wiki_augments_intro2": "Jedes Upgrade hat in der Regel bestimmte Bedingungen, die seine Vorteile bestimmen. Um das Beste aus Ihren Augmentierungen herauszuholen, sollten Sie die Synergien zwischen ihnen berücksichtigen und sie auf Ihre bevorzugte Strategie abstimmen.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Entschlossenheit",
		"NEW_ACHIEVEMENT_1_0_DESC": "Überlebe 20 Minuten im Endlosmodus mit einer beliebigen Hauptwaffe.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Beharrlichkeit",
		"NEW_ACHIEVEMENT_1_1_DESC": "Überlebe 30 Minuten im Endlosmodus mit einer beliebigen Hauptwaffe.",
