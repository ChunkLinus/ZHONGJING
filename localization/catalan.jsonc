		"evo_blade_bladeRepository_desc": "També farà aparèixer una Trampa de fulla a més dels glifs existents.",
		"evo_blade_poisonCoating": "Revestiment tòxic",
		"evo_blade_poisonCoating_desc": "Efectes:\n  Dany químic: {1}\n  Prob. d'infligir plaga: {2}\n\nAfecta al dany base i es veu afectat pels modificadors de dany químic.",
		"evo_blade_poisonCoating_2": "Revestiment tòxic II",
		"evo_blade_poisonCoating_2_desc": "Efectes:\n  Dany químic: {1}\n  Prob. d'infligir plaga: {2}\n\nAfecta al dany base.",
		"evo_blade_sawtoothBlade": "Fulles dents de serra",
		"evo_blade_sawtoothBlade_desc": "Les Trampes de fulles afegeixen la seva Prob. crític a la Prob. d'infligir sagnat.",
		"evo_blade_sawtoothBlade_2": "Fulles dents de serra II",
		"evo_blade_sawtoothBlade_2_desc": "El dany de sagnat augmenta en {1}. Això s'aplica al sagnat aplicat per qualsevol font i afecta al dany base.",
		"evo_blade_cutting_edge": "Avantguarda",
		"evo_blade_cutting_edge_desc": "Efecte Global:\n  Tots els efectes/armes de Torreta:\n    Prob. crític: {1}",
		"evo_hunter_hunterElite": "Caçador elit",
		"evo_hunter_hunterElite_desc": "Cada 12 Caçadors invocats apareixerà un Caçadors elit.\n\nCaçador elit:\n  +100% Dany\n  +50% Duració\n  +50% Velocitat\n  +50% Abast",
		"evo_hunter_hunterElite_2": "Caçador elit II",
		"evo_hunter_hunterElite_2_desc": "Els Caçadors elit ara apareixen cada 10 Caçadors.\n\nCaçadors elit:\n  +50% Duració",
		"evo_hunter_electrifiedBolts": "Projectils electrificats",
		"evo_hunter_electrifiedBolts_desc": "Efecte:\n  Dany Cinètic: {1}\n  Dany Elèctric: {2}\n\nEls Caçadors ara disparen projectils en comptes de raigs elèctrics i es consideren una arma Cinètica.",
		"evo_hunter_electrifiedBolts_2": "Projectils electrificats II",
		"evo_hunter_electrifiedBolts_2_desc": "Efectes:\n  Dany Cinètic: {1}\n\nEfecte Global:\n  Tots els efectes/armes Cinètics:\n    Dany: {2}",
		"evo_hunter_chainLightning": "Llamp encadenat",
