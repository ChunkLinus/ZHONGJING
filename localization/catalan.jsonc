		"evo_wildcard_pestilence_2_desc": "Efecte Global:\n  Tots els Efectes d'estat:\n    Dany: {1}",
		"evo_guardian_toxicWard": "Guàrdia Tòxica",
		"evo_guardian_toxicWard_desc": "Efectes:\n  Dany de calor: {1}\n  Dany químic: {2}\n\nAfecta al dany base. El tipus de dany del Guardià passarà a químic.",
		"evo_guardian_toxicWard_2": "Guàrdia Tòxica II",
		"evo_guardian_toxicWard_2_desc": "Efectes:\n  Dany químic: {1}\n\nAfecta al dany base.",
		"evo_guardian_experimentalFuel": "Combustible experimental",
		"evo_guardian_experimentalFuel_desc": "Apareixeràn millores de combustible especial que donaràn bonificacions temporals al Guardià. Només es pot tenir una bonificació activa alhora.",
		"evo_guardian_experimentalFuel_2": "Combustible experimental II",
		"evo_guardian_experimentalFuel_2_desc": "Augmenta les bonificacions de les millores de combustible un {1} i la seva duració {2}.",
		"evo_guardian_experimentalFuel_damage": "Combustible experimental",
		"evo_guardian_experimentalFuel_speed": "Combustible experimental",
		"evo_guardian_experimentalFuel_range": "Combustible experimental",
		"evo_guardian_guardianTeam": "Equip de guardians",
		"evo_guardian_guardianTeam_desc": "Efectes:\n  Dany: {1}\n  Drons: {2}\n\nEl Guardià passa a ser dos drons en comptes de un.",
		"evo_guardian_guardianTeam_2": "Equip de guardians II",
		"evo_guardian_guardianTeam_2_desc": "Efectes:\n  Dany: {1}\n  Drons: {2}\n\nEl Guardià passa a ser tres drons en comptes de dos.",
		"evo_blade_bladeRepository": "Dipòsit de fulles",
