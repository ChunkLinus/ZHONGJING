		"evo_minefield_mineLayer_desc": "També farà aparèixer Mines a més dels glifs existents.",
		"evo_minefield_infusion": "Infusió",
		"evo_minefield_infusion_desc": "Efecte:\n  Dany Químic: {1}\n  Dany Explosiu: {2}\n\nEl Camp de mines ara infligeix Dany Químic en lloc de Dany Explosiu i es considerat una arma Química.",
		"evo_minefield_infusion_2": "Infusió II",
		"evo_minefield_infusion_2_desc": "Efectes:\n  Dany Químic: {1}\n  Prob. d'infligir plaga: {2}\n\nEfecte Global:\n  Tots els efectes/armes Químics:\n    Dany: {3}",
		"evo_minefield_hunterSeeker": "Mines depredadores",
		"evo_minefield_hunterSeeker_desc": "Efectes:\n  Velocitat: {1}\n  Abast: {2}\n\nLes mines es dirigiràn automàticament a objectius aleatoris.",
		"evo_minefield_hunterSeeker_2": "Mines depredadores II",
		"evo_minefield_hunterSeeker_2_desc": "Efectes:\n  Mines desplegades: {1}\n  Velocitat: {2}",
		"evo_minefield_dirtyBomb": "Explosius bruts",
		"evo_minefield_dirtyBomb_desc": "Efectes:\n  Dany químic: {1}\n  Dany del Llençababes: {2}\n\nLes mines alliberen 3 bassals de babes quan exploten.",
		"evo_minefield_dirtyBomb_2": "Explosius bruts II",
		"evo_minefield_dirtyBomb_2_desc": "Efectes:\n  Dany químic: {1}\n  Dany del Llençababes: {2}\n\nMentre es mouen, les mines disparen periòdicament bassals de babes.",
		"evo_minefield_recursiveMines": "Mines recursives",
		"evo_minefield_recursiveMines_desc": "La torreta principal invoca una quantitat de mines igual a la mitat de les que desplega el Camp de mines, arrodonit a la baixa. La freqüencia d'invocació depèn de l'estadística de Cadència de foc del Camp de mines.",
		"evo_minefield_recursiveMines_2": "Mines recursives",
		"evo_minefield_recursiveMines_2_desc": "Els mines recursives apareixen un {1} més ràpid i invoquen una mina adicional.",
		"evo_sentry_defenseGrid": "Matriu defensiva",
		"evo_sentry_defenseGrid_2": "Matriu defensiva II",
		"evo_sentry_defenseGrid_desc": "Efectes:\n  Torretes: +1",
		"evo_sentry_solidCore": "Munició sòlida",
		"evo_sentry_solidCore_desc": "Efectes:\n  Dany cinètic: {1}\n  Dany de calor: {2}\n\nEl dany del Sentinella ara serà cinètic en comptes de calor i es considerat una arma cinètica.",
		"evo_sentry_solidCore_2": "Munició sòlida II",
		"evo_sentry_solidCore_2_desc": "Efectes:\n  Dany cinètic: {1}\n\nEfecte global:\n  Tots els efectes/armes cinètics:\n    Dany: {2}",
		"evo_sentry_watcher_supreme": "Vigilant suprem",
		"evo_sentry_watcher_supreme_desc": "Efecte global:\n  Tots els efectes/armes de torreta:\n    Abast: {1}",
		"evo_sentry_emergencyProtocol": "Protocol d'emergència",
		"evo_sentry_emergencyProtocol_desc": "Quan una millora d'escut es destruida, el Sentinella entrarà en el mode Protocol d'emergència durant {1} segons.\n\nDurant el Protocol d'emergència:\n  Abast: {2}\n  Cadència de foc: {3}",
		"evo_sentry_emergencyProtocol_2": "Protocol d'emergència II",
		"evo_sentry_emergencyProtocol_2_desc": "Durant el Protocol d'emergència:\n  Dany: {1}\n  Vel. de rotació: {2}",
		"evo_spectre_supercharged": "Supercàrrega",
		"evo_spectre_supercharged_desc": "Cada 20 Espectres invocats apareixerà un SUPER Espectre.\n\nSuper Espectres:\n  +100% Dany\n  +50% Duració\n  +50% Velocitat",
		"evo_spectre_selfDestruct": "Autodestrucció",
		"evo_spectre_selfDestruct_desc": "Efectes:\n  Dany explosiu: {1}\n\nQuan un Espectre expira, s'autodestrueix causant dany explosiu. Afecta al dany base i es veu afectat pels modificadors de dany explosiu",
