		"overmind_syncronization_desc": "{1} Prob. Crític, {2} Mult. Crític",
		"boss_poet": "El poeta",
		"boss_poet_desc": "Escriu el fragment que presenta el cap.\nPots continuar atacant els enemics mentre ho fas.",
		"boss_cypher": "El Codificador",
		"boss_cypher_desc": "Aquest cap barreja les lletres dels enemics que té a prop.\nDestrueix-lo amb les teves armes.",
		"boss_cerberus": "Cerberus",
		"boss_cerberus_desc": "Aquest enemic et dispara projectils destruïbles.\nDestrueix els tres caps amb les teves armes.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Aquest cap dona voltes al teu voltant sense parar.\nCalcula la trajectòria i dispara als punts fixos del seu camí per encertar-lo amb les teves armes.",
		"boss_gemini": "Gèminis",
		"boss_gemini_desc": "Danya els dos bessons de manera equilibrada.\nEs curaran mútuament amb el temps fins a arribar a la seva salut total.",
		"weapon_repeater_title": "Repetidora",
		"weapon_heatray_title": "Raig de calor",
		"weapon_barrage_title": "Ràfega",
		"weapon_overmind_title": "Ment colmena",
		"weapon_splattershot_title": "Llençababes",
		"weapon_wildcard_title": "Comodí",
		"weapon_spectre_title": "Espectre",
		"weapon_tesla_title": "Mina Tesla",
		"weapon_sentry_title": "Sentinella ",
		"weapon_oscillator_title": "Oscil·lador",
		"weapon_meteor_title": "Meteor",
		"weapon_hunter_title": "Caçador",
		"weapon_chopper_title": "Rebanyadora",
		"weapon_minefield_title": "Camp de mines",
		"weapon_blade_title": "Trampa de fulles",
		"weapon_firestorm_title": "Tempesta de foc",
		"weapon_guardian_title": "Guardià",
		"weapon_orbiter_title": "Orbitador",
		"weapon_frostbite_title": "Gelada ",
		"weapon_bleeding_title": "Sagnat",
		"weapon_blight_title": "Plaga",
		"weapon_static_title": "Estàtica ",
		"weapon_ignite_title": "Cremat",
		"weapon_heatray_requirements": "Completa les Proves de la Repetidora en qualsevol nivell de presagi",
		"weapon_barrage_requirements": "Completa les Proves en nivell 3 de presagi amb qualsevol Arma Principal",
		"weapon_repeater_desc": "Arma devastadora que dispara un seguit de bales en ràfegues curtes.",
		"weapon_heatray_desc": "Dispara un raig constant de llum concentrada i increïblement precisa que causa dany al llarg del temps.",
		"weapon_barrage_desc": "Dispara una ràfega de coets explosius contra un objectiu i el seu entorn. Es recarrega amb el temps.",
		"weapon_overmind_desc": "Comanda un conjunt de drons per portar destrucció als teus enemics.",
		"weapon_splattershot_desc": "Llença unes boles de baba als teus oponents que els debiliten i fan mal.",
		"weapon_wildcard_desc": "El teu proper tret es seleccionarà a l’atzar entre quatre armes possibles, així que dispara amb compte.",
		"weapon_spectre_desc": "Invoca un nombre de ràpids drons de combat cos a cos equivalent al nombre dels glifs superiors coincidents.",
		"weapon_sentry_desc": "Desplega una torreta automàtica que dispara a qualsevol enemic que entri dins del seu abast.",
		"weapon_tesla_desc": "Desplega una torreta elèctrica que infligeix dany en el temps.",
		"weapon_oscillator_desc": "Dispara un corrent oscil·lant de partícules en la direcció del teu objectiu més recent.",
		"weapon_meteor_desc": "Genera periòdicament objectius en ubicacions aleatòries que es poden activar per iniciar un bombardeig orbital.",
		"weapon_hunter_desc": "Invoca un nombre de drons que disparen raigs elèctrics equivalent al nombre dels glifs superiors coincidents.",
		"weapon_chopper_desc": "Genera una fulla giratòria massiva al disparar l'Arma Principal que avança fins a la vora de la pantalla, fent mal a tots els enemics al seu pas.",
		"weapon_minefield_desc": "Invoca mines de moviment lent que exploten al entrar en contacte amb enemics.",
		"weapon_blade_desc": "Desplega una trampa giratòria de quatre fulles.",
		"weapon_firestorm_desc": "Un canó que dispara una ràfega de projectils explosius de curt abast. Gira al voltant de la torreta principal i necessita refredar-se abans de tornar a disparar.",
		"weapon_guardian_desc": "Desplega instantàniament un dron que dispara làsers als enemics. Activa les recàrregues de combustible per reabastir el Guardià, que consumirà combustible i es desactivarà quan s’esgoti.",
		"weapon_orbiter_desc": "Desplega un orbe que orbita al voltant de l’Arma Principal, danyant tot el que troba al seu camí.",
		"weapon_frostbite_desc": "Efecte de botí – no compta com a arma.\n\nEls enemics pateixen dany en el temps quan estan Congelats.",
		"weapon_bleeding_desc": "Efecte d’estat – no compta com a arma.\n\nEls enemics pateixen dany Cinètic en el temps fins que l’efecte expira.",
		"weapon_blight_desc": "Efecte d’estat – no compta com a arma.\n\nEls enemics pateixen dany Químic en el temps i son més lents fins que l’efecte expira.",
		"weapon_static_desc": "Efecte d’estat – no compta com a arma.\n\nEls enemics afectats i els del seu voltant reben dany d'Energia contínuament mentre dura l'efecte.",
		"weapon_ignite_desc": "Efecte d’estat – no compta com a arma.\n\nEls enemics reben dany de Calor de manera contínua mentre dura l’efecte.",
		"weapon_caltrops_desc": "Efecte d’augment – no compta com a arma.\n\nQuan un atac amb armes remotes és crític, genera 12 Obriülls que danyen els enemics que passen, amb una probabilitat augmentada de sagnar segons el seu dany.",
		"weapon_stormBattery_desc": "Efecte d’augment – no compta com a arma.\n\nLa torreta principal infligeix dany elèctric als enemics propers. Cada arma elèctrica equipada augmenta el dany base.",
		"weapon_lightningSparks_desc": "Efecte d’augment – no compta com a arma.\n\nQuan un arma elèctrica fa crític, allibera 6 espurnes elèctriques que escalen el seu dany segons la prob. i el mult. crític.",
		"weapon_darkRelay_desc": "Efecte d’augment – no compta com a arma.\n\nUn projectil rebotarà aleatòriament entre les torretes existents, causant dany elèctric.",
		"weapon_jester_desc": "Efecte de botí – no compta com a arma.\n\nEn recollir un Reintent, causa una quantitat aleatòria de dany entre 0 i 100 a tots els enemics de la pantalla.",
		"weapon_necrobomb_desc": "Efecte de botí - no es considera una arma.\n\nAl destruir un enemic amb dany Crític d'Explosius, provoca una sèrie d'explosions al voltant de la seva posició.",
		"weapon_release_desc": "Efecte de botí - no es considera una arma.\n\nPer errada, infligeix {1} de dany Explosiu a tots els enemics per cada x{2} Seqüència Perfecta.",
		"weapon_retribution_desc": "Efecte d’augment - no es considera una arma.\n\nCada cop que un Escut es destruït, tots els Drons existents s'autodestrueixen infligint dany explosiu.",
		"weapon_fireball_desc": "Efecte d’augment - no es considera una arma.\n\nDisparar l'Arma Principal també llança una Bola de Foc lenta que infligeix dany per calor.",
		"contains_characters": "Completar paraules que continguin els glifs",
		"contains_glyphs": "Completar conjunts que continguin els glifs",
		"starts_with_character": "Completar paraules que comencin amb els glifs",
		"starts_with_glyphs": "Completar conjunts que comencin amb els glifs:",
