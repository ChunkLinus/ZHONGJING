		"item_bonus_drones_desc": "Totes les Armes de drons:\n  Prob. d'aparició d'un dron extra: {1}",
		"item_glassCannon": "Canó de vidre",
		"item_glassCannon_desc": "Totes les Armes:\n  Dany: {2}\n\nArma Principal:\n  Salut màxima: {1}",
		"item_carapace": "Sota la cuirassa",
		"item_carapace_desc": "Totes les Armes:\n  Prob. de botí: {2}\n\nProbabilitat de:\n  Enemics més grans: {1}",
		"item_regeneration": "Regeneració",
		"item_regeneration_desc": "Et cures {1} de la salut màxima quan actives una millora de botí, congelació, dany doble, reintent o escut.",
		"item_DOTCanCrit": "Erosió",
		"item_DOTCanCrit_desc": "Les armes D.P. poden fer crítics.",
		"item_cryotechnics": "Criotècnia",
		"item_cryotechnics_desc": "Millores de Congelació:\n  Prob. d'aparició: {1}",
		"item_warlike": "Bèl·lic",
		"item_warlike_desc": "Millores de Dany doble:\n  Prob. d'aparició: {1}",
		"item_pinata": "Pinyata",
		"item_pinata_desc": "Efecte Global:\n  Freqüència de botí: {1}",
		"item_point_blank": "A frec de roba",
		"item_point_blank_desc": "Els enemics colpejats a prop de l'Arma Principal reben {1} de dany.",
		"item_shatter": "Esmicolar",
		"item_shatter_desc": "Totes les Armes cinètiques guanyen {1} Prob. crític contra enemics congelats.",
		"item_seer": "Profeta",
		"item_seer_desc": "Activar millores de Reintent augmenta el teu abast global un 10% durant 10 segons. Es pot acumular fins a 3 vegades.",
		"item_seer_desc_2": "Si entres a una pantalla de pujada de nivell, evolució o botí sense Reintents, en rebràs 1 automàticament.",
		"item_resilience": "Resiliència",
		"item_resilience_desc": "Activar millores d'Escut augmenta la teva duració global un 10% durant 10 segons. Es pot acumular fins a 3 vegades.",
		"item_resilience_desc_2": "Per cada escut que tinguis, guanya {1} de duració global.",
		"item_gambler": "Apostador",
		"item_gambler_desc": "Afegeix 1 Reintent i augmenta el màxim de Reintents fins a 6.",
		"item_protector": "Protector",
		"item_protector_desc": "Afegeix un Escut i augmenta el màxim d'Escuts fins a 4.",
		"item_flawless": "Impecable",
		"item_flawless_desc": "Cada x{1} Seqüències perfectes també augmenta la teva cadència de foc global un {2}.",
		"item_release": "Catarsi",
		"item_release_desc": "Per errada, provoca {1} de dany explosiu a tots els enemics per cada x{2} Seqüències perfectes.",
		"item_wasting": "Debilitant",
		"item_wasting_desc": "Totes les Armes de D.P.:\n  +35% Cadència de foc",
		"item_wither": "Pansir",
		"item_wither_desc": "Tots els Efectes d'estat:\n  +35% Cadència de foc",
		"consumable_medpack": "Kit de primers auxilis",
		"consumable_medpack_desc": "Afegeix {1} kits de primers auxilis al teu inventari.\n\nEls kits de primers auxilis curen fins a {2} de la salut de l'Arma Principal.",
		"consumable_serum": "Sèrum",
		"consumable_serum_desc": "Afegeix {1} sèrums al teu inventari.\n\nEls Sèrums donen {2} de Prob. crític durant {3} segons.",
		"consumable_warhead": "Ogiva",
		"consumable_warhead_desc": "Afegeix {1} ogives al teu inventari.\n\nLes ogives desencadenen una sèrie de potents explosions que es propaguen des de l'Arma Principal.",
		"weapon_warhead_desc": "Efecte consumible - no compta com a arma.\n\nDesencadena una sèrie de potents explosions que es propaguen des de l'Arma Principal.",
		"consumable_flameWave": "Flamarada",
		"consumable_flameWave_desc": "Afegeix {1} flamarades al teu inventari.\n\nLes flamarades cremen a tots els enemics visibles a canvi del 10% de la salut de l'Arma Principal.",
		"weapon_flameWave_desc": "Efecte consumible - no compta com a arma.\n\nCrema a tots els enemics visibles a canvi del 10% de la salut de l'Arma Principal.",
		"consumable_cryocore": "Crio-nucli",
		"consumable_cryocore_desc": "Afegeix {1} crio-nuclis al teu inventari.\n\nEls crio-nuclis activen la millora de congelació global.",
		"consumable_killPill": "Píndola mortal",
		"consumable_killPill_desc": "Afegeix {1} píndoles mortals al teu inventari.\n\nLes píndoles mortals activen la millora de Dany doble.",
		"consumable_pocketTurret": "Torreta de butxaca",
		"consumable_pocketTurret_desc": "Afegeix {1} Torreta de butxaca al teu inventari.\n\nLa Torreta de butxaca crea una torreta automàtica a prop de grups d'enemics.",
		"weapon_pocket_turret_desc": "Efecte consumible - no compta com a arma.\n\nCrea una torreta automàtica a prop de grups d'enemics.",
		"item_plunder": "Saqueig",
		"item_plunder_desc": "+1 Opció de botí",
		"item_multitargeting": "Multifuncions",
		"item_multitargeting_desc": "Totes les Armes remontes guanyen +1% Prob. crític per cada arma que poseeixis.",
		"item_pickupMagnet": "Imant Gegant",
		"item_pickupMagnet_desc": "Tens un {1} de probabilitat de recollir automàticament les millores quan desapareixen.",
		"item_frostbite": "Gelada",
		"item_frostbite_desc": "Els enemics reben dany en el temps quan estan congelats.",
		"item_necrobomb": "Necrobomba",
		"item_necrobomb_desc": "Al destruir un enemic amb dany crític explosiu, s'activen una sèrie d'explosions al voltant de la seva posició.",
		"item_prize": "Premi",
		"item_prize_desc": "Al destruir un enemic amb dany crític, hi ha un {1} de probabilitat de fer aparèixer millores de Reintent, Escut o Salut.",
		"item_aftershock": "Rèplica",
		"item_aftershock_desc": "El dany crític sempre infligirà un efecte d'estat.",
		"item_vampirism": "Vampirisme",
		"item_vampirism_desc": "Guanya salut igual a un {1} del dany cinètic crític.",
		"item_wisdom": "Saviesa",
		"item_wisdom_desc": "Al recollir un Escut, augmenta 10 baixes a totes les evolucions d'armes.",
		"item_jester": "Bufó",
		"item_jester_desc": "Al recollir un Reintent, provoca una quantitat aleatòria de dany entre 0 i 100 a tots els enemics de la pantalla.",
		"item_jester_2_desc": "Al completar una paraula, genera un dron Bufó que infligeix 0-100% de dany a un objectiu aleatori. 10 segons de recàrreca entre activacions.",
		"item_lastStand": "Última resistència",
		"item_lastStand_desc": "Al destruir-se un Escut, guanya Dany doble.",
		"item_tripleDamage": "Dany triple",
		"item_tripleDamage_desc": "Totes les millores de Dany doble ara son Dany triple.",
		"item_fracture": "Fractura",
		"item_fracture_desc": "Durant la congelació, cada millora de congelació que hauría d'haver aparegut es converteix en una fractura, que infligeix dany a tots els enemics congelats.",
		"item_fracture_desc_2": "Tot el dany a enemics congelats augmenta un {1}.\n\nAquest modificador es multiplicatiu.",
		"item_ascetic": "Asceta",
		"item_ascetic_desc": "Al sortir de la pantalla de botí, guanya un 10% de dany durant 20 segons per cada Reintent no utilitzat.",
		"item_harmonizer": "Harmonitzador",
		"item_harmonizer_desc": "Totes les armes equipades guanyen un nivell d'evolució.",
		"item_immortality": "Immortalitat",
		"item_immortality_desc": "Si la teva Arma Principal està a punt de ser destruïda, es reduirà a 1 de salut en comptes de trencar-se. Aquesta habilitat només es pot utilitzar una vegada cada 2 minuts.",
		"item_immortality_desc_2": "Si la teva Arma Principal està a punt de ser destruïda, es reduirà a 1 de salut en comptes de trencar-se, i tots els enemics dins un radi de 400 metres rebran dany cinètic letal. Aquesta habilitat només es pot utilitzar una vegada cada 2 minuts.",
		"item_enlightenment": "Il·lustració",
		"item_enlightenment_desc": "Al destruir un enemic amb dany crític, guanya +1 baixa per a totes les evolucions d'armes.",
		"item_closer": "Proper",
		"item_closer_desc": "Completar la paraula d'un enemic després de destrui-lo dona +10% de dany durant 10 segons. Es pot acumular fins a 3 vegades.",
		"item_murderous": "Homicida",
		"item_murderous_desc": "Totes les Armes de drons:\n  +50% Dany",
		"item_executioner": "Executant",
		"item_executioner_desc": "Totes les Armes de torreta:\n  +50% Dany",
		"item_degeneration": "Degeneració",
		"item_degeneration_desc": "Totes les Armes remotes:\n  +50% Dany",
		"item_clone": "Clonar",
		"item_clone_desc": "Els consumibles tenen un 30% de probabilitat de replicar-se al utilitzar-los.",
		"augment_category_mainWeapon": "Còdex: Arma Principal",
		"augment_category_turret": "Còdex: Torreta",
		"augment_category_drones": "Còdex: Dron",
		"augment_category_dot": "Còdex: D.P.",
		"augment_category_remote": "Còdex: Remot",
		"augment_category_electric": "Còdex: Elèctric",
		"augment_category_heat": "Còdex: Calor",
		"augment_category_kinetic": "Còdex: Cinètic",
		"augment_armored": "Blindat",
		"augment_armored_desc": "Arma Principal:\n  Salut: +50%",
		"augment_eager": "Apassionat",
		"augment_eager_desc": "Al inici de cada Prova o Mode Infinit, guanya un nivell. Per cada 4 minuts sobreviscuts al Mode Infinit, guanya un nivell.",
		"augment_gambler": "Jugador",
		"augment_gambler_desc": "Cada Reintent que fas servir dona a l'Arma Principal +20% de dany durant 20 segons.",
		"augment_haze": "Boira baixa",
		"augment_haze_desc": "Si tens menys del 50% de salut, guanya un bonus de +50% de Cadència de foc global.",
		"augment_immaculate": "Immaculat",
		"augment_immaculate_desc": "La Seqüència perfecta ara dona +1.5% Prob. crític per acumulació.",
		"augment_devotion": "Devoció ",
		"augment_devotion_desc": "L'Arma Principal guanya +25% de dany per cada ranura d'arma buida. Al menys una de les opcions de cada pantalla de pujada de nivell serà una millora.",
		"augment_armada": "Armada",
		"augment_armada_desc": "Probabilitat del 20% d'invocar un dron adicional quan s'invoca un.",
		"augment_diversity": "Diversitat",
		"augment_diversity_desc": "Per cada arma que no sigui de drons equipada, augmenta la duració de tots els Drons un 20%.",
		"augment_blitzkrieg": "Assalt llampec",
		"augment_blitzkrieg_desc": "Les millores de velocitat dels drons també milloren el seu dany.",
		"augment_retribution": "Revenja",
		"augment_retribution_desc": "Cada vegada que perdis un Escut, tots els drons s'autodestrueixen fent dany explosiu.",
		"augment_scapegoat": "Cap de turc",
		"augment_scapegoat_desc": "Les errades destrueixen aleatoriament un Dron existent en comptes de contar com a una errada.",
		"augment_spoils": "Saqueig",
		"augment_spoils_desc": "Els drons poden deixar millores al desaparèixer.",
		"augment_fortress": "Fortalesa",
		"augment_fortress_desc": "Cada evolució de torreta també atorga +50 de salut màxima a l'Arma Principal.",
		"augment_networked": "Xarxa",
		"augment_networked_desc": "Per cada altra torreta que tinguis, les teves torretes guanyen 10% de cadència de foc fins a un màxim de 50%.",
		"augment_fieldIntel": "Investigació de camp",
		"augment_fieldIntel_desc": "Al activar una millora, reps un 30% d'abast per a totes les torretes desplegades. Aquest efecte no s'acumula.",
		"augment_darkRelay": "Relé carregat",
		"augment_darkRelay_desc": "Un projectil rebota entre totes les torretes desplegades fent dany elèctric.",
		"augment_observer": "Vigilant",
		"augment_observer_desc": "Si no has atacat durant 3 segons, guanya +30% de dany adicional per les torretes fins el teu següent atac.",
		"augment_observer_powerup": "{1} Dany de torretes",
		"augment_weakness": "Punt feble",
		"augment_weakness_desc": "Els enemics dins de l'abast d'una torreta reben un 30% més dany d'altres fonts.",
		"augment_corrosion": "Corrosió",
		"augment_corrosion_desc": "El D.P. ara pot fer crític.",
		"augment_lamprey": "Llamprea",
		"augment_lamprey_desc": "El D.P. causat a prop de l'Arma Principal la cura 1 punt de salut.",
		"augment_tenacity": "Tenacitat",
		"augment_tenacity_desc": "Augmenta la duració de totes les armes de D.P. en un 35%.",
		"augment_afflictors": "Afligidor",
		"augment_afflictors_desc": "Afegeix afligidors a la llista de botí disponible. Cadascun dóna +4% de dany D.P. L'efecte es duplica a prop de l'Arma Principal.",
		"augment_conviction": "Convicció",
		"augment_conviction_desc": "Les armes D.P. guayen un +40% de cadència de foc adicional mentres tinguis el màxims de Reintents.",
		"augment_conviction_powerup": "{1} D.C Cadència de foc",
		"augment_infector": "Contaminant",
		"augment_infector_desc": "Les armes D.P. tenen +3% de probabilitat d'infligir efectes d'estat.",
		"augment_closeCombat": "Cos a cos",
		"augment_closeCombat_desc": "Tot el dany que fagin les teves armes remotes es considera que està a prop de l'Arma Principal.",
		"augment_caltrops": "Obriülls ",
		"augment_caltrops_desc": "Quan un atac amb armes remotes és crític, genera 12 Obriülls que danyen els enemics que passen, amb una probabilitat augmentada de sagnar segons el seu dany.",
		"augment_causticAmmo": "Munició càustica",
		"augment_causticAmmo_desc": "Probabilitat de deixar caure munició càustica - afegeix 10 de dany químic base a les armes remotes durant 20 segons.",
		"augment_piracy": "Pirateria",
		"augment_piracy_desc": "Per cada efecte de botí equipat, augmenta tot el dany remot un 15%.",
		"augment_deliverance": "Salvació",
		"augment_deliverance_desc": "Totes les Armes remotes guanyen +40% d'abast sempre que tinguis el màxim d'Escuts.",
		"augment_deliverance_powerup": "{1} Abast remot",
		"augment_sniper": "Franctirador",
		"augment_sniper_desc": "Les millores de l'abast a les armes remotes també s'aplica al seu dany.",
		"augment_voltaicBurst": "Càrrega voltaica",
		"augment_voltaicBurst_desc": "Les millores a la duració de les armes elèctriques apliquen el 25% del seu valor a la probabilitat d'infligir estàtica.",
		"augment_stormBattery": "Tempesta vigilant",
		"augment_stormBattery_desc": "L'Arma Principal fa dany elèctric als enemics propers. Cada arma elèctrica equipada augmenta el dany base.",
		"augment_lightningSparks": "Espurnes",
		"augment_lightningSparks_desc": "Quan un arma elèctrica fa crític, allibera 6 espurnes elèctriques que escalen el seu dany segons la prob. i el mult. crític.",
		"augment_efficientGrid": "Xarxa eficient",
		"augment_EfficientGrid_desc": "Per cada arma no elèctrica equipada, augmenta la durada de totes les armes elèctriques en un 10%.",
		"augment_violentDischarge": "Descàrrega violenta",
		"augment_violentDischarge_desc": "L'estàtica fa més mal i té més abast. Els enemics que morin a causa de l'estàtica tenen un 50% de probabilitats de passar l'estàtica als enemics propers.",
		"augment_electrifiedTurret": "Torreta electritzada",
		"augment_electrifiedTurret_desc": "L'Arma Principal guanya +5 de dany elèctric base i augmenta el dany de totes les armes elèctriques en un 10%.",
		"augment_pyromancy": "Piromància",
		"augment_pyromancy_desc": "Augmenta el dany de calor en un 2% per cada enemic cremant-se. Al cremar a un enemic fas dany de calor adicional en base a la duració i dany del cremat.",
		"augment_cauterization": "Cauterització",
		"augment_cauterization_desc": "Els bonus d'abast també s'apliquen al dany causat a prop de l'Arma Principal amb armes o efectes de calor.",
		"augment_furnaceCore": "Nucli del forn",
		"augment_furnaceCore_desc": "L'Arma Principal guanya +5 de dany de calor base i augmenta tot el dany de les armes de calor en un 10%.",
		"augment_fireball": "Bola de foc",
		"augment_fireball_desc": "Al disparar l'Arma Principal llences una bola de foc que fa dany de calor als enemics en el seu camí. Només pots tenir 1 bola de foc activa.",
		"augment_flameWave": "Flamarada",
		"augment_flameWave_desc": "Afegeix el consumible Flamarada al teu inventari inicial i llista de botí. Crema a tots els enemics visibles a canvi del 10% de la salut de l'Arma Principal.",
		"augment_blazingGlory": "Glòria abrasadora",
		"augment_blazingGlory_desc": "Els enemics a prop de l'Arma Principal reben +25% de dany de calor adicional i tenen un 12% de probabilitats de cremar-se al rebre dany de calor.",
		"augment_gunslinger": "Pistoler",
		"augment_gunslinger_desc": "Augmenta el màxim de Ràfega de paralues en 5. Cada rang de Ràfega de paraules dona +2.5% de dany Cinètic.",
		"augment_bloodlust": "Set de sang",
		"augment_bloodlust_desc": "Augmenta la Cadència de foc Cinètica en 2% i l'Abast en 1% per cada enemic Sagnant.",
		"augment_infusedAmmo": "Munició imbuïda",
		"augment_infusedAmmo_desc": "Els crítics amb dany Cinètic tenen un 40% de probabilitat d'infligir un Estat aleatori al enemic.",
		"augment_scrapArmaments": "Metralla",
		"augment_scrapArmaments_desc": "Probabilitat de deixar caure Metralla - afegeix 10 al dany Cinètic base a les armes Cinètiques durant 20 segons.",
		"augment_combinedArms": "Armes combinades",
		"augment_combinedArms_desc": "Per cada arma no Cinètica equipada, augmenta tot el dany Cinètic en un 10%.",
		"augment_pocketTurret": "Torreta de butxaca",
		"augment_pocketTurret_desc": "Afegeix un consumible Torreta de butxaca al teu inventari i a la llista de botí. La Torreta de butxaca crea una torreta que es pot recollir al expirar.",
		"wiki_tag_label": "Etiquetes",
		"wiki_name_label": "Nom",
		"wiki_cost_label": "Cost",
		"wiki_description_label": "Descripció",
		"wiki_title": "Wiki Oficial de Glyphica",
		"wiki_subtitle": "Wiki Oficial de Glyphica Typing Survival",
		"wiki_home_title": "Inici",
		"wiki_landingPage_title": "Benvingut, Mecanògraf",
		"wiki_landingPage_intro": "Benvingut a la wiki oficial de Glyphica: Typing Survival! Posa a prova la teva habilitat de tecleig en aquest joc de supervivència d'hordes, on la velocitat i la precisió són les teves millors armes. Arma't amb potents eines per transformar la teva destresa amb el teclat en atacs devastadors contra enemics implacables. Descobreix molt més comprant el joc a Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Aquesta wiki és una guia completa de les característiques, mecàniques i contingut disponibles en la versió d’accés anticipat de Glyphica. El nostre objectiu és mantenir la informació actualitzada a mesura que avancem cap a la versió definitiva, l’1.0. La wiki està organitzada en seccions que trobaràs a la taula de continguts i s’actualitzarà regularment conforme el joc evolucioni.",
		"wiki_tableOfContents_title": "Taula de continguts",
		"wiki_mainWeapons_title": "Armes Principals",
		"wiki_mainWeapons_intro": "Les armes principals son les armes inicials a *Glyphica* i tenen un paper central en el joc. Quan escrius una paraula mostrada sobre un enemic, l'Arma Principal fixa aquest enemic com a objectiu. Cada Arma Principal té efectes i mecàniques úniques, que requereixen estratègies diferents per utilitzar-les amb eficàcia.",
		"wiki_mainWeapons_intro2": "Mentre que algunes armes principals posen l'èmfasi en la velocitat d'escriptura (PPM), d'altres requereixen un plantejament més tàctic. Com qualsevol altre arma al joc, les armes principals poden ser millorades i evolucionades, potenciant-ne les habilitats i efectivitat a mesura que avances.",
		"wiki_mainWeapons_list_title": "Llista d'Armes Principals",
		"wiki_weapons_title": "Armes de nivell",
		"wiki_weapons_intro": "Les armes de nivell s’obtenen durant la partida a mesura que puges de nivell. Un cop seleccionada, l’arma s’afegeix al teu arsenal. Cada arma té un mètode d’activació únic, però la majoria es poden activar escrivint i marcant objectius amb l’Arma Principal.",
		"wiki_weapons_intro2": "Pots aconseguir un màxim de quatre armes per partida. Un cop l’arma s’afegeix al teu arsenal, les seves millores poden aparèixer en el conjunt de millores disponibles en pujar de nivell, cosa que et permet millorar-ne les habilitats a mesura que avances entre les hordes d’enemics.",
		"wiki_weapons_list_title": "Llista d'Armes de nivell",
		"wiki_weapon_evolution_title": "Evolucions",
		"wiki_weapon_upgrade_title": "Millores",
		"wiki_lootItems_title": "Objectes de botí",
		"wiki_lootItems_intro": "Els objectes de botí s’obtenen durant una partida activant un cofre del tresor. Es mostrarà una selecció aleatòria d’objectes de botí, i escollir-ne un t’atorgarà un bonus passiu que es mantindrà actiu fins al final de la partida.",
		"wiki_lootItems_intro2": "Els objectes de botí estan categoritzats com a **comuns**, **poc comuns** i **rars**, la qual cosa determina la seva probabilitat d’aparèixer a la selecció de botí. Derrotar un cap a les Proves recompensa amb un cofre que conté només objectes rars.",
		"wiki_lootItems_rare_title": "Llista de botí rar",
		"wiki_lootItems_uncommon_title": "Llista de botí poc comú",
		"wiki_lootItems_common_title": "Llista de botí comú",
		"wiki_enemies_title": "Enemics",
		"wiki_enemies_intro": "Els enemics a *Glyphica* es generen de manera procedural segons una mètrica interna anomenada **amenaça**, que augmenta a mesura que la partida avança. A les Proves, l’amenaça es multiplica pel nivell actual de la prova, fent que cada nivell sigui progressivament més difícil. Al mode Infinit, l’amenaça es compara amb un sistema d’escala adaptativa basat en el nivell del jugador, i el valor més alt determina la dificultat de l'aparició d'enemics.",
		"wiki_enemies_intro2": "Els enemics també es classifiquen com a **especials** o **èlits**, cadascun amb una categoria pròpia que limita la seva taxa d’aparició dins del nivell global d’amenaça.",
		"wiki_enemies_list_title": "Llista d'enemics",
		"wiki_enemy_variants_title": "Llista de variants",
		"wiki_image_label": "Imatge",
		"wiki_splitter_shard_count": "Nombre de fragments",
		"wiki_splitter_shard_health": "Salut dels fragments",
		"wiki_splitter_shard_damage": "Dany dels fragments",
		"wiki_augments_title": "Augments",
		"wiki_augments_intro": "Els augments són millores permanents que es poden desbloquejar utilitzant Monedes (§), una moneda que s’aconsegueix durant les partides. Al inici de cada partida, els jugadors disposen d’un nombre limitat de ranures per equipar els augments desbloquejats, sent aquest nombre variable segons el nivell de Presagi seleccionat.",
		"wiki_augments_intro2": "Cada augment té normalment condicions específiques que determinen els seus beneficis. Per treure’n el màxim profit, considera les sinergies entre els augments i com s’adapten a la teva estratègia preferida.",
