		"evo_wildcard_fragmentation": "Fragmentació",
		"evo_wildcard_fragmentation_desc": "Quan projectils Cinètics colpegen Esferes de Calor, desencadenen explosions de Calor.\n\nQuan projectils cinètics colpegen enemics Congelats per projectils de Fred, desencadenen explosions de Fred.",
		"evo_wildcard_fragmentation_2": "Fragmentació II",
		"evo_wildcard_fragmentation_2_desc": "Quan projectils Cinètics colpegen enemics, desencadenen explosions Cinètiques.",
		"evo_wildcard_conduit": "Conductor",
		"evo_wildcard_conduit_desc": "Dins l’abast dels projectils Elèctrics, les Esferes de Calor i els enemics Congelats per projectils de Fred causaran dany Elèctric als enemics propers.",
		"evo_wildcard_conduit_2": "Conductor II",
		"evo_wildcard_conduit_2_desc": "Les Esferes de Calor i els enemics Congelats per projectils de Fred sempre causaran dany Elèctric als enemics propers.",
