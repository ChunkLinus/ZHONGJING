		"evo_repeater_frostFang_desc": "Efectes:\n  Dany de Fred: {1}\n  Prob. Congelar: {2}\n\nAfecta al dany base i es veu afectat pels modificadors de dany de Fred.",
		"evo_repeater_frostFang_2": "Ullal de gel II",
		"evo_repeater_frostFang_2_desc": "Efectes:\n  Dany de Fred: {1}\n  Dany Cinètic: {2}\n\nAfecta al dany base.",
		"evo_repeater_ricochet": "Rebot",
		"evo_repeater_ricochet_desc": "Efectes:\n  Cadena de projectils: {1}\n\nEls projectils de la Repetidora reboten a objectius aleatoris propers, causant {2} de dany als objectius posteriors al primer.",
		"evo_repeater_ricochet_2": "Rebot II",
		"evo_repeater_ricochet_2_desc": "Efectes:\n  Cadena de projectils: {1}",
		"evo_repeater_shotgun": "Escopeta",
		"evo_repeater_shotgun_desc": "Efectes:\n  Quantitat de projectils: {1}\n  Dispersió dels projectils: {2}\n  Dany Cinètic: {3}\n\nLa Repetidora ara dispararà un grup de projectils més febles amb una gran dispersió. Els modificadors de dany afecten al dany base.",
		"evo_repeater_shotgun_2": "Escopeta II",
		"evo_repeater_shotgun_2_desc": "Efectes:\n  Quantitat de projectils: {1}\n  Dispersió dels projectils: {2}",
		"evo_repeater_explodingBullets": "Bales explosives",
		"evo_repeater_explodingBullets_desc": "Efectes:\n  Dany explosiu: {1}\n  Dany cinètic: {2}\n\nAfecta al dany base. La Repetidora ara utilitza munició explosiva que infligeix dany explosiu en un petit radi.",
		"evo_repeater_explodingBullets_2": "Bales explosives II",
		"evo_repeater_explodingBullets_2_desc": "Efectes:\n  Dany explosiu: {1}\n  Dany cinètic: {2}\n\nL'abast base de l'explosió de les bales de la Repetidora s'incrementa lleugerament.",
		"evo_heatray_iceBeam": "Raig de gel",
		"evo_heatray_iceBeam_desc": "Efectes:\n  Dany de calor: {1}\n  Dany de fred: {2}\n  Prob. de congelar: {3}\n\nAfecta al dany base. El tipus de dany del Raig de calor passa a ser dany de fred i té més probabilitat de congelar.",
		"evo_heatray_iceBeam_2": "Raig de gel II",
		"evo_heatray_iceBeam_2_desc": "Efectes:\n  Dany de fred: {1}\n\nAfecta al dany base.",
		"evo_heatray_reflection": "Reflex",
		"evo_heatray_reflection_desc_2": "El Raig de calor ara pot atravessar enemics i es reflexa {1} vegades als límits de la pantalla.",
		"evo_heatray_reflection_2": "Reflex II",
		"evo_heatray_reflection_2_desc_2": "El Raig de calor es reflexa {1} vegades als límits de la pantalla.",
		"evo_heatray_doubleBladed": "Doble Fulla",
		"evo_heatray_doubleBladed_desc": "Un altre raig es dispara en direcció oposada. Totes les evolucions i millores s’apliquen a tots dos raigs.",
		"evo_heatray_blaster": "Desintegrador",
		"evo_heatray_blaster_desc": "Efectes:\n  Cadència de foc: {1}\n\nEl Raig de calor ara dispara un projectil làser independent de múltiples impactes en lloc d’un feix constant, però que continua comptant com una arma de dany periòdic (D.P.).",
		"evo_heatray_blaster_2": "Desintegrador II",
		"evo_heatray_blaster_2_desc": "Efectes:\n  Longitud del projectil: {1}\n  Dany: {2}",
		"evo_heatray_solar_tap": "Toc Solar",
		"evo_heatray_solar_tap_desc": "Efecte Global:\n  Tots els efectes/armes de Calor:\n    Prob. d'efectes d'estat: {1}",
		"evo_barrage_rocketArray": "Matriu de coets",
		"evo_barrage_rocketArray_desc": "La Ràfega ara dispararà {1} míssils per barra de munició en lloc de {2}.",
		"evo_barrage_rocketArray_2": "Matriu de coets II",
		"evo_barrage_seismicMunition": "Munició sísmica",
		"evo_barrage_seismicMunition_desc": "Els míssils s’incrusten al terra en lloc de detonar i generen polsos explosius durant els següents segons.",
		"evo_barrage_seismicMunition_2": "Munició sísmica II",
		"evo_barrage_seismicMunition_2_desc": "Polsos de la munició sísmica::\n  Abast: {1}\n  Duració: {2}",
		"evo_barrage_resupply": "Reabastiment",
		"evo_barrage_resupply_desc": "Ara apareixeran subministraments. Activar aquests subministraments recarregarà completament la teva Arma Principal i donarà un augment de dany de {1} al proper tret.",
		"evo_barrage_resupply_2": "Reabastiment II",
		"evo_barrage_resupply_2_desc": "Ara els subministraments també atorguen un augment de {1} a l’abast de l’explosió del proper tret.",
		"evo_barrage_resupply_pickup": "Màxima munició!",
		"evo_barrage_total_saturation": "Saturació màxima",
		"evo_barrage_total_saturation_desc": "Efecte Global:\n  Tots els efectes/armes de Dany Explosiu:\n    Dany: {1}",
		"evo_splattershot_bubble": "Bombolla de llim",
		"evo_splattershot_bubble_desc": "Apareixeràn millores de Bombolles de llim a les zones esquitxades.\n\nQuan s'activen, les Bombolles de llim esclaten, infligint dany en un petit radi i creant zones esquitxades addicionals.",
		"evo_splattershot_bubble_2": "Bombolla de llim II",
		"evo_splattershot_bubble_2_desc": "S'incrementa l'aparició de Bombolles de llim.\n\nLes bombolles tenen un 50% de probabilitat d'esclatar automàticament quan expiren.",
		"evo_splattershot_infestation": "Infestació",
		"evo_splattershot_infestation_desc": "Efectes del Llençababes:\n  Prob. d'efectes d'estat: {1}\n\nEfectes globals:\n  Dany d'efectes d'estat: {2}",
		"evo_splattershot_infestation_2": "Infestació II",
		"evo_splattershot_infestation_2_desc": "Els enemics morts a causa d'efectes d'estat exploten creant una nova zona esquitxada.",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Efectes:\n  Dany químic: {1}\n  Dany de calor: {2}\n\nAfecta al dany base. El tipus de dany del Llençababes passarà a ser de Calor.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Efectes:\n  Dany de calor: {1}\n\nAfecta al dany base.",
		"evo_splattershot_virulence": "Virulència",
		"evo_splattershot_virulence_desc": "Efectes de la zona esquitxada:\n  Duració: {1}\n\nLes zones esquitxades creixen lentament amb el temps.",
		"evo_splattershot_chemical_catalyst": "Catalitzador químic",
		"evo_splattershot_chemical_catalyst_desc": "Efecte Global:\n  Tots els efectes/armes Químics:\n    Duració: {1}",
		"evo_overmind_syncronize": "Sincronitzar",
		"evo_overmind_syncronize_desc": "Cada baixa amb la Ment Colmena té un {1} de probabilitat d'afegir +1 baixa a l'evolució d'una arma aleatoria de drons.",
		"evo_overmind_syncronize_2": "Sincronitzar II",
		"evo_overmind_syncronize_2_desc": "La probabilitat d'afegir +1 baixa a l'evolució d'una arma aleatoria de drons augmenta a {1}.",
		"evo_overmind_shockSpire": "Torre elèctrica",
		"evo_overmind_shockSpire_desc": "Cada 3 enemics fixats simultàniament generen una Torre elèctrica entre ells.\n\nLes Torres elèctriques emeten pulsos periòdics que travessen tota la pantalla i causen dany elèctric.",
		"evo_overmind_shockSpire_2": "Torre elèctrica II",
		"evo_overmind_shockSpire_2_desc": "Efectes:\n  Torres elèctriques:\n    Dany: {1}\n    Duració: {2}",
		"evo_overmind_burningOnes": "Els Ardents",
		"evo_overmind_burningOnes_desc": "Escriure paraules carrega un indicador que genera drons explosius al omplir-se.\n\nEls drons busquen automàticament els enemics i exploten en contacte, causant dany explosiu en un radi reduït.",
		"evo_overmind_burningOnes_2": "Els Ardents II",
		"evo_overmind_burningOnes_2_desc": "Efectes:\n  Els Ardents: {1}\n  Dany explosiu: {1}\n  Abast de l'explosió: {2}",
		"evo_overmind_burningOnes_charge": "Escalfament",
		"evo_overmind_burningOnes_charge_desc": "Sobrecàrrega tèrmica: {1}%",
		"evo_overmind_null_field": "Camp d'anul·lació",
		"evo_overmind_null_field_desc": "Els enemics fixats per la Ment Colmena es veuen alentits i reben {1} de dany dels altres efectes i armes elèctriques.",
		"evo_overmind_null_field_2": "Camp d'anul·lació II",
		"evo_overmind_null_field_2_desc": "Els enemics fixats per la Ment Colmenta també es veuen afectats per estàtica.",
