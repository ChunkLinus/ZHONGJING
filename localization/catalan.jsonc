		"evo_chopper_boomerang": "Bumerang",
		"evo_chopper_boomerang_desc": "La Rebanyadora torna a l'Arma Principal després d'arribar al límit de la pantalla.",
		"evo_chopper_boomerang_2": "Bumerang II",
		"evo_chopper_boomerang_2_desc": "Efectes:\n  Velocitat: {1}\n  Cadència de foc: {2}",
		"evo_chopper_sawLauncher": "Llença-serres",
		"evo_chopper_sawLauncher_desc": "Efectes:\n  Prob. de sagnat: {1}\n  Dany de sagnat: {2}\n  Prob. de sagnat de la Repetidora: {3}\n\nLa Rebanyadora es sustituïda per dos serres més petites amb molta velocitat d'atac, disparades en forma de con.",
		"evo_chopper_sawLauncher_2": "Llença-serres II",
		"evo_chopper_sawLauncher_2_desc": "Efectes:\n  Prob. de sagnat: {1}\n  Dany de sagnat: {2}\n  Prob. de sagnat de la Repetidora: {3}\n\nAugmenta el nombre de serres disparades en 2.",
		"evo_chopper_bloodbath": "Bany de sang",
		"evo_chopper_bloodbath_desc": "Efectes:\n  Dany a enemics sagnant: {1}\n\nEls enemics sagnant eliminats per la Rebanyadora tenen una probabilitat del {2} d'activar Dany doble.",
		"evo_chopper_bloodbath_2": "Bany de sang II",
		"evo_chopper_bloodbath_2_desc": "Efectes:\n  Dany a enemics sagnant: {1}\n\nAugmenta la probabilitat de Dany doble al {2}.",
		"evo_meteor_surveillance": "Vigilància",
		"evo_meteor_surveillance_desc": "Ara el Meteor mostra dos possibles objectius en comptes d'un.",
