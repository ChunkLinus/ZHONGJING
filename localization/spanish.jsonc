		"evo_chopper_flamingBlades": "Cuchillas flamígeras",
		"evo_chopper_flamingBlades_desc": "Efectot:\n  Daño cinético: {1}\n  Daño de calor: {2}\n\nLa Rebanadora ahora hace daño de calor en lugar de daño cinético y pasa a ser un arma calorífica.",
		"evo_chopper_flamingBlades_2": "Cuchillas flamígeras II",
		"evo_chopper_flamingBlades_2_desc": "Efectos:\n  Daño de calor: {1}\n\nEfecto global:\n  Todas las armas y efectos de daño calorífico:\n    Daño: {2}",
		"evo_chopper_boomerang": "Bumerán",
		"evo_chopper_boomerang_desc": "La Rebanadora ahora viaja de vuelta al Arma principal tras alcanzar el borde de la pantalla.",
		"evo_chopper_boomerang_2": "Bumerán II",
		"evo_chopper_boomerang_2_desc": "Efectos:\n  Velocidad: {1}\n  Cadencia de disparo: {2}",
		"evo_chopper_sawLauncher": "Lanzasierras",
		"evo_chopper_sawLauncher_desc": "Efectos:\n  Prob. de sangrado: {1}\n  Daño de sangrado: {2}\n  Prob. de sangrado de la Repetidora: {3}\n\nLa Rebanadora se sustituye por dos sierras más pequeñas con mucha velocidad de ataque que se lanzan en cono.",
		"evo_chopper_sawLauncher_2": "Lanzasierras II",
		"evo_chopper_sawLauncher_2_desc": "Efectos:\n  Prob. de sangrado: {1}\n  Daño de sangrado: {2}\n  Prob. de sangrado de la Repetidora: {3}\n\nAumenta en 2 el número de sierras que disparas.",
		"evo_chopper_bloodbath": "Matanza",
		"evo_chopper_bloodbath_desc": "Efectos:\n  Daño a enemigos sangrantes: {1}\n\nLos enemigos sangrantes que mueren por la Rebanadora tienen una probabilidad del {2} de activar la mejora de daño doble.",
		"evo_chopper_bloodbath_2": "Matanza II",
		"evo_chopper_bloodbath_2_desc": "Efectos:\n  Daño a enemigos sangrantes: {1}\n\nAumenta la probabilidad de daño doble al {2}.",
		"evo_meteor_surveillance": "Vigilancia",
		"evo_meteor_surveillance_desc": "Meteorito te muestra ahora dos posibles objetivos en lugar de uno.",
		"evo_meteor_surveillance_2": "Vigilancia II",
