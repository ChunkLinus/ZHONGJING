		"evo_meteor_iceRain": "Granizo",
		"evo_meteor_iceRain_desc": "Efecto:\n  Daño de frío: {1}\n  Daño explosivo: {2}\n\nEl Meteorito ahora hace daño de frío en lugar de daño explosivo y pasa a ser un arma criogénica",
		"evo_meteor_iceRain_2": "Granizo II",
		"evo_meteor_iceRain_2_desc": "Efectos:\n  Daño de frío: {1}\n\nEfecto global:\n  Todas las armas y efectos criogénicos:\n    Daño: {2}",
		"evo_meteor_relentless": "Inmisericorde",
		"evo_meteor_relentless_desc": "Efectos:\n  Rango: {1}\n  Tasa de disparo: {2}\n\nLos Meteoritos caen de manera continua, avanzando en la dirección de tu último objetivo.",
		"evo_meteor_relentless_2": "Inmisericorde II",
