		"evo_repeater_ricochet_desc": "Efectos:\n  Cadena de proyectiles: {1}\n\nLos proyectiles de la Repetidora rebotan a objetivos aleatorios cercanos y hacen {2} de daño a los objetivos posteriores al primero.",
		"evo_repeater_ricochet_2": "Rebote II",
		"evo_repeater_ricochet_2_desc": "Efectos:\n  Cadena de proyectiles: {1}",
		"evo_repeater_shotgun": "Escopeta",
		"evo_repeater_shotgun_desc": "Efectos:\n  Cantidad de proyectiles: {1}\n  Esparcimiento de los proyectiles: {2}\n  Daño cinético: {3}\n\nLa Repetidora ahora disparará un cúmulo de proyectiles más débiles y con mayor esparcimiento. Los modificadores de daño afectan al daño base.",
		"evo_repeater_shotgun_2": "Escopeta II",
		"evo_repeater_shotgun_2_desc": "Efectos:\n  Cantidad de proyectiles: {1}\n  Esparcimiento de los proyectiles: {2}",
		"evo_repeater_explodingBullets": "Balas explosivas",
		"evo_repeater_explodingBullets_desc": "Efectos:\n  Daño explosivo: {1}\n  Daño cinético: {2}\n\nAfecta al daño base. La Repetidora ahora usa munición explosiva que hace daño explosivo en una pequeña área.",
		"evo_repeater_explodingBullets_2": "Balas explosivas II",
		"evo_repeater_explodingBullets_2_desc": "Efectos:\n  Daño explosivo: {1}\n  Daño cinético: {2}\n\nEl rango de la explosión de las balas de la Repetidora aumenta ligeramente.",
		"evo_heatray_iceBeam": "Rayo de hielo",
		"evo_heatray_iceBeam_desc": "Efectos:\n  Daño de calor: {1}\n  Daño de frío: {2}\n  Probabilidad de congelar: {3}\n\nAfecta al daño base. El tipo de daño del Rayo de calor pasa a ser daño de frío y tiene más posibilidades de congelar.",
		"evo_heatray_iceBeam_2": "Rayo de hielo II",
		"evo_heatray_iceBeam_2_desc": "Efectos:\n  Daño de frío: {1}\n\nAfecta al daño base.",
		"evo_heatray_reflection": "Reflejo",
		"evo_heatray_reflection_desc_2": "El Rayo de calor ahora puede atravesar enemigos y se refleja {1} vez en el borde de la pantalla.",
		"evo_heatray_reflection_2": "Reflejo II",
		"evo_heatray_reflection_2_desc_2": "El Rayo de calor se refleja {1} veces en el borde de la pantalla.",
		"evo_heatray_doubleBladed": "Duplicado",
		"evo_heatray_doubleBladed_desc": "Se dispara otro rayo en la dirección opuesta. Todas las evoluciones y mejoras se aplican a los dos rayos.",
		"evo_heatray_blaster": "Desintegrador",
		"evo_heatray_blaster_desc": "Efectos:\n  Cadencia de disparo: {1}\n\nEl Rayo de calor ahora dispara un proyectil láser independiente que puede golpear a varios objetivos en lugar de un rayo constante, sigue contando como un arma de D.P.",
		"evo_heatray_blaster_2": "Desintegrador II",
		"evo_heatray_blaster_2_desc": "Efectos:\n  Longitud del proyectil: {1}\n  Daño: {2}",
		"evo_heatray_solar_tap": "Carga solar",
		"evo_heatray_solar_tap_desc": "Efecto global:\n  Todas las armas y efectos de calor:\n    Prob. de efecto de estado: {1}",
		"evo_barrage_rocketArray": "Matriz de cohetes",
		"evo_barrage_rocketArray_desc": "La Andanada ahora disparará {1} misiles por cada barra de munición en lugar de {2}.",
		"evo_barrage_rocketArray_2": "Matriz de cohetes II",
		"evo_barrage_seismicMunition": "Munición sísmica",
		"evo_barrage_seismicMunition_desc": "Los misiles se entierran en el suelo en lugar de detonar y generan pulsos explosivos durante unos segundos.",
		"evo_barrage_seismicMunition_2": "Munición sísmica II",
		"evo_barrage_seismicMunition_2_desc": "Pulsos de Munición sismica:\n  Rango: {1}\n  Duración: {2}",
		"evo_barrage_resupply": "Reabastecimiento",
		"evo_barrage_resupply_desc": "Ahora aparecerán cajas de reabastecimiento. Al activarlas recargarás tu arma principal y recibirás una mejora de {1} de daño en tu siguiente disparo.",
		"evo_barrage_resupply_2": "Reabastecimiento II",
		"evo_barrage_resupply_2_desc": "Las cajas de reabastecimiento ahora también dan {1} de rango de explosión en tu siguiente disparo.",
		"evo_barrage_resupply_pickup": "¡Munición al máximo!",
		"evo_barrage_total_saturation": "Obliteración total",
		"evo_barrage_total_saturation_desc": "Efecto global:\n  Todas las armas y efectos explosivos:\n    Daño: {1}",
		"evo_splattershot_bubble": "Pompa de limo",
		"evo_splattershot_bubble_desc": "Aparecerán mejoras de Pompas de limo en los Charcos de babas.\n\nCuando se activan, las Pompas de limo explotan y hacen daño en una pequeña área y además crean más Charcos de babas.",
		"evo_splattershot_bubble_2": "Pompa de limo II",
		"evo_splattershot_bubble_2_desc": "Aumenta la aparición de las Pompas de limo.\n\nLas Pompas de limo tienen un 50% de probabilidades de explotar automáticamente cuando acaba el temporizador.",
		"evo_splattershot_infestation": "Infestación",
		"evo_splattershot_infestation_desc": "Efectos del Lanzababas:\n  Prob. de efectos de estado: {1}\n\nEfectos globales:\n  Daño de los efectos de estado: {2}",
		"evo_splattershot_infestation_2": "Infestación II",
		"evo_splattershot_infestation_2_desc": "Los enemigos que mueran a causa de efectos de estado explotan y dejan Charcos de babas",
		"evo_splattershot_lava": "Lava",
		"evo_splattershot_lava_desc": "Efectos:\n  Daño químico: {1}\n  Daño de calor: {2}\n\nAfecta al daño base. Cambia el tipo de daño del Lanzababas a Calorífico.",
		"evo_splattershot_lava_2": "Lava II",
		"evo_splattershot_lava_2_desc": "Efectos:\n  Daño de calor: {1}\n\nAfecta al daño base.",
		"evo_splattershot_virulence": "Propagación virulenta",
		"evo_splattershot_virulence_desc": "Efectos de los Charcos de babas:\n  Duración: {1}\n\nLos Charcos de babas se extienden poco a poco con el tiempo.",
		"evo_splattershot_chemical_catalyst": "Catalizador alquímico",
		"evo_splattershot_chemical_catalyst_desc": "Efecto global:\n  Todas las armas y efectos químicos:\n    Duración: {1}",
		"evo_overmind_syncronize": "Sincronización",
		"evo_overmind_syncronize_desc": "Con cada baja que consigas con la Mente colmena tienes una probabilidad del {1} de añadir  +1 baja al progreso de evolución de un arma de dron aleatoria.",
		"evo_overmind_syncronize_2": "Sincronización II",
		"evo_overmind_syncronize_2_desc": "La probabilidad de conseguir +1 baja para el progreso de evolución de un arma de dron aleatoria aumenta en {1}.",
		"evo_overmind_shockSpire": "Aguja electrizante",
		"evo_overmind_shockSpire_desc": "Por cada 3 enemigos que estén marcados como objetivo a la vez invocas una Aguja electrizante entre los objetivos.\n\nLas Agujas Electrizantes emiten ondas eléctricas de manera periódica que se desplazan por la pantalla y hacen daño eléctrico.",
		"evo_overmind_shockSpire_2": "Aguja electrizante II",
		"evo_overmind_shockSpire_2_desc": "Efectos:\n  Agujas electrizantes:\n    Daño: {1}\n    Duración: {2}",
		"evo_overmind_burningOnes": "Los Ardientes",
		"evo_overmind_burningOnes_desc": "Al escribir palabras cargas un medidor que despliega drones explosivos cuando se llena.\n\nLos drones marcan a enemigos y explotan al entrar en contacto con ellos, haciendo daño explosivo en un pequeño radio.",
		"evo_overmind_burningOnes_2": "Los Ardientes II",
		"evo_overmind_burningOnes_2_desc": "Efectos:\n  Los Ardientes: {1}\n  Daño explosivo: {1}\n  Rango de la explosión: {2}",
		"evo_overmind_burningOnes_charge": "Calor acaeciente",
		"evo_overmind_burningOnes_charge_desc": "Sobrecarga térmica: {1}%",
		"evo_overmind_null_field": "Campo vacuo",
		"evo_overmind_null_field_desc": "Los enemigos marcados como objetivo por la Mente colmena estarán ralentizados y reciben {1} de daño de otros efectos y armas eléctricas.",
		"evo_overmind_null_field_2": "Campo vacuo II",
		"evo_overmind_null_field_2_desc": "Los enemigos marcados por la Mente colmena también se ven afectados por estática.",
		"evo_wildcard_winter": "Invierno",
		"evo_wildcard_winter_desc": "El Comodín ya no disparará proyectiles de calor.\n\nEfecto global:\n  Todas las armas y efectos de frío:\n    Daño: {1}",
		"evo_wildcard_winter_2": "Invierno II",
		"evo_wildcard_winter_2_desc": "Efecto global:\n  Todas las armas y efectos de frío:\n    Daño: {1}",
		"evo_wildcard_warmth": "Calidez",
		"evo_wildcard_warmth_desc": "El Comodín ya no disparará proyectiles de frío.\n\nEfecto global:\n  Todas las armas y efectos de calor:\n    Daño: {1}",
		"evo_wildcard_warmth_2": "Calidez II",
		"evo_wildcard_warmth_2_desc": "Efecto global:\n  Todas las armas y efectos de calor:\n    Daño: {1}",
		"evo_wildcard_repulsor": "Propulsor",
		"evo_wildcard_repulsor_desc": "El Comodín ya no disparará proyectiles cinéticos.\n\nEfecto global:\n  Todas las armas y efectos eléctricos:\n    Daño: {1}",
		"evo_wildcard_repulsor_2": "Propulsor II",
		"evo_wildcard_repulsor_2_desc": "Efecto global:\n  Todas las armas y efectos eléctricos:\n    Daño: {1}",
		"evo_wildcard_diamond": "Diamante",
		"evo_wildcard_diamond_desc": "El Comodín ya no disparará proyectiles eléctricos.\n\nEfecto global:\n  Todas las armas y efectos cinéticos:\n    Daño: {1}",
		"evo_wildcard_diamond_2": "Diamante II",
		"evo_wildcard_diamond_2_desc": "Efecto global:\n  Todas las armas y efectos cinéticos:\n    Daño: {1}",
		"evo_wildcard_fragmentation": "Fragmentación",
		"evo_wildcard_fragmentation_desc": "Cuando tus proyectiles cinéticos impactan contra orbes de calor desatas una explosión de daño calorífico.\n\nCuando tus proyectiles cinéticos impactan contra enemigos congelados por proyectiles de daño de frío, desatas explosiones de daño de frío.",
		"evo_wildcard_fragmentation_2": "Fragmentación II",
		"evo_wildcard_fragmentation_2_desc": "Cuando tus proyectiles cinéticos impactan contra enemigos desatas explosiones de daño cinético.",
		"evo_wildcard_conduit": "Conductor",
		"evo_wildcard_conduit_desc": "Cuando estén al rango de tus proyectiles eléctricos, los orbes de daño calorífico y los enemigos congelados harán daño eléctrico a los enemigos cercanos.",
		"evo_wildcard_conduit_2": "Conductor II",
		"evo_wildcard_conduit_2_desc": "Los orbes de daño calorífico y los enemigos congelados por proyectiles de daño de frío siempre harán daño eléctrico a los enemigos cercanos.",
		"evo_wildcard_pestilence": "Pestilencia",
		"evo_wildcard_pestilence_desc": "Comodín:\n  Todos los efectos de estado:\n    Probabilidad: {1}",
		"evo_wildcard_pestilence_2": "Pestilencia",
		"evo_wildcard_pestilence_2_desc": "Efecto global:\n  Todos los efectos de estado:\n    Daño: {1}",
		"evo_guardian_toxicWard": "Guardián tóxico",
		"evo_guardian_toxicWard_desc": "Efectos:\n  Daño de calor: {1}\n  Daño químico: {2}\n\nAfecta al daño base. El Guardián pasa a hacer daño químico.",
		"evo_guardian_toxicWard_2": "Guardián tóxico II",
		"evo_guardian_toxicWard_2_desc": "Efectos:\n  Daño químico: {1}\n\nAfecta al daño base.",
		"evo_guardian_experimentalFuel": "Combustible experimental",
		"evo_guardian_experimentalFuel_desc": "Ahora aparecerán mejoras de combustible especial que le dan mejoras temporales al Guardián. Solo puedes tener un bono activo en todo momento.",
		"evo_guardian_experimentalFuel_2": "Combustible experimental II",
		"evo_guardian_experimentalFuel_2_desc": "Aumenta las mejoras del combustible especial en {1} y la duración de la mejora en {2}.",
		"evo_guardian_experimentalFuel_damage": "Combustible experimental",
		"evo_guardian_experimentalFuel_speed": "Combustible experimental",
		"evo_guardian_experimentalFuel_range": "Combustible experimental",
		"evo_guardian_guardianTeam": "Equipo de Guardianes",
		"evo_guardian_guardianTeam_desc": "Efectos:\n  Daño: {1}\n  Drones: {2}\n\nEl Guardián pasa a ser dos drones en lugar de uno.",
		"evo_guardian_guardianTeam_2": "Equipo de Guardianes II",
		"evo_guardian_guardianTeam_2_desc": "Efectos:\n  Daño: {1}\n  Drones: {2}\n\nEl Guardián pasa a ser tres drones en lugar de dos.",
		"evo_blade_bladeRepository": "Repositorio de cuchillas",
		"evo_blade_bladeRepository_2": "Repositorio de cuchillas II",
		"evo_blade_bladeRepository_desc": "También hará aparecer una Trampa de cuchillas junto a los demás glifos existentes.",
		"evo_blade_poisonCoating": "Recubrimiento de veneno",
		"evo_blade_poisonCoating_desc": "Efectos:\n  Daño químico: {1}\n  Prob. de emponzoñar: {2}\n\nAfecta al daño base y se ve afectado por los modificadores de daño químico.",
		"evo_blade_poisonCoating_2": "Recubrimiento de veneno II",
		"evo_blade_poisonCoating_2_desc": "Efectos:\n  Daño químico: {1}\n  Prob. de emponzoñar: {2}\n\nAfecta al daño base.",
		"evo_blade_sawtoothBlade": "Cuchillas con dientes de sierra",
		"evo_blade_sawtoothBlade_desc": "Las Trampas de cuchillas añaden su probabilidad de crítico a su probabilidad de causar sangrado.",
		"evo_blade_sawtoothBlade_2": "Cuchillas con dientes de sierra II",
		"evo_blade_sawtoothBlade_2_desc": "Daño por sangrado aumentado en {1}. Esto se aplica al sangrado aplicado por todas las fuentes y afecta al daño base.",
		"evo_blade_cutting_edge": "Vanguardia armamentística",
		"evo_blade_cutting_edge_desc": "Efecto global:\n  Todas las armas y efectos de torreta:\n    Prob. de crítico: {1}",
		"evo_hunter_hunterElite": "Cazador de élite",
		"evo_hunter_hunterElite_desc": "Cada 12 Cazadores que despliegues aparecerá un Cazador de élite.\n\nCazador de élite:\n  +100% de daño\n  +50% de duración\n  +50% de velocidad\n  +50% de rango",
		"evo_hunter_hunterElite_2": "Cazador de élite II",
		"evo_hunter_hunterElite_2_desc": "Los Cazadores de élite aparecen cada 10 Cazadores.\n\nCazadores de élite:\n  +50% de duración",
		"evo_hunter_electrifiedBolts": "Proyectiles electrificados",
		"evo_hunter_electrifiedBolts_desc": "Efecto:\n  Daño cinético: {1}\n  Daño eléctrico: {2}\n\nLos Cazadores ahora dispararán proyectiles en lugar de descargas eléctricas y pasan a ser un arma cinética.",
		"evo_hunter_electrifiedBolts_2": "Proyectiles electrificados II",
		"evo_hunter_electrifiedBolts_2_desc": "Efectos:\n  Daño cinético: {1}\n\nEfecto global:\n  Todas las armas y efectos cinéticos:\n    Daño: {2}",
		"evo_hunter_chainLightning": "Cadena de relámpagos",
		"evo_hunter_chainLightning_desc": "Los ataques de los Cazadores afectan a 1 enemigo cercano adicional.",
		"evo_hunter_chainLightning_2": "Cadena de relámpagos II",
		"evo_hunter_chainLightning_2_desc": "Los ataques de los Cazadores afectan a 2 enemigos cercanos adicionales.",
		"evo_hunter_predator_strain": "Cepa depredadora",
		"evo_hunter_predator_strain_desc": "Efecto global:\n  Todas las armas y efectos de armas de dron:\n    Duración: {1}",
		"evo_minefield_mineLayer": "Despliegaminas",
		"evo_minefield_mineLayer_2": "Despliegaminas II",
		"evo_minefield_mineLayer_desc": "También desplegará Minas junto a los demás glifos existentes.",
		"evo_minefield_infusion": "Infusionado",
		"evo_minefield_infusion_desc": "Efecto:\n  Daño químico: {1}\n  Daño explosivo: {2}\n\nEl Campo de minas ahora hace daño químico en lugar de daño explosivo y pasa a ser un arma química.",
		"evo_minefield_infusion_2": "Infusionado II",
		"evo_minefield_infusion_2_desc": "Efectos:\n  Daño químico: {1}\n  Prob. de emponzoñar: {2}\n\nEfecto global:\n  Todas las armas y efectos químicos:\n    Daño: {3}",
		"evo_minefield_hunterSeeker": "Minas depredadoras",
		"evo_minefield_hunterSeeker_desc": "Efectos:\n  Velocidad: {1}\n  Rango: {2}\n\nLas Minas se dirigirán automáticamente a objetivos aleatorios.",
		"evo_minefield_hunterSeeker_2": "Minas depredadoras II",
		"evo_minefield_hunterSeeker_2_desc": "Efectos:\n  Minas desplegadas: {1}\n  Velocidad: {2}",
		"evo_minefield_dirtyBomb": "Explosivos mugrientos",
		"evo_minefield_dirtyBomb_desc": "Efectos:\n  Daño químico: {1}\n  Daño del Lanzababas: {2}\n\nLas minas sueltas 3 charcos de babas cuando explotan.",
		"evo_minefield_dirtyBomb_2": "Explosivos mugrientos II",
		"evo_minefield_dirtyBomb_2_desc": "Efectos:\n  Daño químico: {1}\n  Daño del Lanzababas: {2}\n\nLas minas esparcen charcos de babas periódicamente mientras se desplazan.",
		"evo_minefield_recursiveMines": "Minas recursivas",
		"evo_minefield_recursiveMines_desc": "La torreta principal invoca una cantidad de minas igual a la mitad de las que despliega el Campo de minas redondeado hacia abajo. La tasa de aparición depende de la estadística de cadencia de disparo del Campo de minas.",
		"evo_minefield_recursiveMines_2": "Minas recursivas II",
		"evo_minefield_recursiveMines_2_desc": "Las minas recursivas aparecen {1} más rápido e invocan una mna adicional.",
		"evo_sentry_defenseGrid": "Matriz de defensa",
		"evo_sentry_defenseGrid_2": "Matriz de defensa II",
		"evo_sentry_defenseGrid_desc": "Efectos:\n  Torretas: +1",
		"evo_sentry_solidCore": "Núcleo sólido",
		"evo_sentry_solidCore_desc": "Efectos:\n  Daño cinético: {1}\n  Daño de calor: {2}\n\nEl Centinela ahora hace daño cinético en lugar de daño calorífico y cuenta como arma cinética.",
		"evo_sentry_solidCore_2": "Núcleo sólido II",
		"evo_sentry_solidCore_2_desc": "Efectos:\n  Daño cinético: {1}\n\nEfecto global:\n  Todas las armas y efectos cinéticos:\n    Daño: {2}",
		"evo_sentry_watcher_supreme": "Vigilante supremo",
		"evo_sentry_watcher_supreme_desc": "Efecto global:\n  Todas las armas y efectos de torretas:\n    Rango: {1}",
		"evo_sentry_emergencyProtocol": "Protocolo de emergencia",
		"evo_sentry_emergencyProtocol_desc": "Cada vez que se destruye una mejora de escudo el Centinela entrará en el modo Protocolo de emergencia durante {1} segundos.\n\nDurante el Protocolo de emergencia recibe:\n  Rango: {2}\n  Cadencia de disparo: {3}",
		"evo_sentry_emergencyProtocol_2": "Protocolo de emergencia II",
		"evo_sentry_emergencyProtocol_2_desc": "Durante el Protocolo de emergencia recibe:\n  Daño: {1}\n  Velocidad de rotación: {2}",
		"evo_spectre_supercharged": "Supercarga",
		"evo_spectre_supercharged_desc": "Cada 20 Espectros que despliegues aparecerá un SÚPER Espectro.\n\nSúper Espectros:\n  +100% de daño\n  +50% de duración\n  +50% de velocidad",
		"evo_spectre_selfDestruct": "Autodestrucción",
		"evo_spectre_selfDestruct_desc": "Efectos:\n  Daño explosivo: {1}\n\nCuando el Espectro se desactiva, este se autodestruye provocando daño explosivo. Afecta al daño base y se ve afectado por modificadores de daño explosivo.",
		"evo_spectre_selfDestruct_2": "Autodestrucción II",
		"evo_spectre_selfDestruct_2_desc": "Efectos:\n  Daño explosivo: {1}\n  Rango: {2}\n\nAfecta al daño base.",
		"evo_spectre_volatileFuel": "Combustible volátil",
		"evo_spectre_volatileFuel_desc": "Efectos:\n  Velocidad: {1}",
		"evo_spectre_volatileFuel_2": "Combustible volátil II",
		"evo_spectre_volatileFuel_2_desc": "Efectos:\n  Velocidad: {1}\n  Duración: {2}",
		"evo_spectre_stalking_algorithms": "Algoritmos de persecución",
		"evo_spectre_stalking_algorithms_desc": "Efecto global:\n  Todas las armas y efectos de armas de dron:\n    Velocidad: {1}",
		"evo_tesla_abundantCoils": "Bobinas abundantes",
		"evo_tesla_abundantCoils_2": "Bobinas abundantes II",
		"evo_tesla_abundantCoils_desc": "También hará aparecer una Mina Tesla además de los glifos existentes.",
		"evo_tesla_electricalBurn": "Quemadura eléctrica",
		"evo_tesla_electricalBurn_desc": "Efecto:\n  Daño calorífico: {1}\n  Daño eléctrico: {2}\n\nLa Mina Testa ahora hace daño calorífico en lugar de daño eléctrico y pasa a ser un arma de calor.",
		"evo_tesla_electricalBurn_2": "Quemadura eléctrica II",
		"evo_tesla_electricalBurn_2_desc": "Efectos:\n  Daño calorífico: {1}\n\nEfecto global:\n  Todas las y armas y efectos caloríficos:\n    Daño: {2}",
		"evo_tesla_restrictedArea": "Área restringida",
		"evo_tesla_restrictedArea_desc": "Los enemigos en el rango de la Mina Tesla tienen un {1}% más de probabilidades de recibir estática de todas las fuentes de daño eléctrico.",
		"evo_tesla_restrictedArea_2": "Área restringida II",
		"evo_tesla_restrictedArea_2_desc": "El daño de estática aumenta en {1} y el rango en {2}. Esto se aplica a la estática inflingida por todos los medios y afecta al daño base.",
		"evo_tesla_storm_sovereign": "Soberano de la tormenta",
		"evo_tesla_storm_sovereign_desc": "Efecto global:\n  Todas las armas y efectos de torretas:\n    Cadencia de disparo: {1}",
