		"item_bonus_drones_desc": "Todas las armas de dron:\n  Prob. de invocar drones adicionales: {1}",
		"item_glassCannon": "Cañón de cristal",
		"item_glassCannon_desc": "Todas las armas:\n  Daño: {2}\n\nArma principal:\n  Salud máxima: {1}",
		"item_carapace": "Coraza",
		"item_carapace_desc": "Todas las armas:\n  Probabilidad de aparición: {2}\n\nProbabilidad de:\n  Enemigos más grandes: {1}",
		"item_regeneration": "Regeneración",
		"item_regeneration_desc": "Te curas {1} puntos de tu vida máxima cada vez que activas una mejora de Botín, Congelar Daño doble, Reintento o de Escudo",
		"item_DOTCanCrit": "Erosión",
		"item_DOTCanCrit_desc": "Las armas de D.P. pueden causar daños críticos.",
		"item_cryotechnics": "Criotécnicos",
		"item_cryotechnics_desc": "Mejoras de congelación:\n  Probabilidad de aparición: {1}\n\nMejoras de daño doble:\n  -100% de prob. de aparición",
		"item_warlike": "Zafarrancho de combate",
		"item_warlike_desc": "Mejoras de daño doble:\n  Probabilidad de aparición: {1}\n\nMejoras de congelación:\n  -100% de prob. de aparición",
		"item_pinata": "Piñata",
		"item_pinata_desc": "Efecto global:\n  Frecuencia de aparición de botín: {1}",
		"item_point_blank": "A bocajarro",
		"item_point_blank_desc": "Los enemigos a los que aciertes cerca del arma principal reciben {1} de daño.",
		"item_shatter": "Resquebrajar",
		"item_shatter_desc": "Todas las armas cinéticas reciben {1} de probabilidad de crítico contra enemigos congelados.",
		"item_seer": "Vidente",
		"item_seer_desc": "Activar las mejoras de Reintentos aumenta tu rango global en un 10% durante 10 segundos. Se acumula hasta 3 veces.",
		"item_seer_desc_2": "Si no te quedan Reintentos cuando subas de nivel, evoluciones un arma o entres en la pantalla de botín conseguirás 1 Reintento.",
		"item_resilience": "Resiliencia",
		"item_resilience_desc": "Activar las mejoras de Escudo aumenta tu duración global en un 10% durante 10 segundos. Se acumula hasta 3 veces.",
		"item_resilience_desc_2": "Por cada Escudo que tengas, consigues {1} de Duración general.",
		"item_gambler": "Apostador",
		"item_gambler_desc": "Consigue 1 Reintento y aumenta la capacidad máxima de Reintentos que puedes tener a 6.",
		"item_protector": "Protector",
		"item_protector_desc": "Consigue 1 Escudo y aumenta la capacidad máxima de Escudos que puedes tener a 4.",
		"item_flawless": "Impecable",
		"item_flawless_desc": "Cada x{1} Secuencias perfectas aumentan tu cadencia de disparo global en {2}.",
		"item_release": "Catarsis",
		"item_release_desc": "Al cometer un error haces {1} de daño explosivo a todos los enemigos por cada x{2} Secuencia(s) perfecta(s).",
		"item_wasting": "Decadencia",
		"item_wasting_desc": "Todas las armas de D.P. : +35% de cadencia de disparo",
		"item_wither": "Marchitante",
		"item_wither_desc": "Todos los efectos de estado: +35% de cadencia de disparo",
		"consumable_medpack": "Paquete de primeros auxilios",
		"consumable_medpack_desc": "Añade {1} paquetes de primeros auxilios a tu inventario.\n\nLos paquetes de primeros auxilios curan hasta el {2} de la salud de la torreta principal.",
		"consumable_serum": "Suero",
		"consumable_serum_desc": "Añade {1} sueros a tu inventario.\n\nEl suero te da {2} de prob. de crítico durante {3} segundos.",
		"consumable_warhead": "Ojiva",
		"consumable_warhead_desc": "Añade {1} ojivas a tu inventario.\n\nLas ojivas desatan una serie de poderosas explosiones que se desplazan desde el arma principal.",
		"weapon_warhead_desc": "Efecto de consumible - no cuenta como arma.\n\nDesata una serie de poderosas explosiones que se desplazan desde el arma principal.",
		"consumable_flameWave": "Llamarada",
		"consumable_flameWave_desc": "Añade {1} Llamaradas a tu inventario.\n\nLas Llamaradas queman a todos los enemigos en pantalla a cambio del 10% de la vida actual de la torreta principal.",
		"weapon_flameWave_desc": "Efecto de consumible - no cuenta como arma.\n\nQuema a todos los enemigos visibles a cambio del 10% de la vida actual de la torreta principal.",
		"consumable_cryocore": "Crionúcleo",
		"consumable_cryocore_desc": "Añade {1} crionúcleos a tu inventario.\n\nLos crionúcleos activan un efecto de congelado global.",
		"consumable_killPill": "Píldora letal",
		"consumable_killPill_desc": "Añade {1} píldoras letales a tu inventario.\n\nLas píldoras letales activan un efecto de daño doble global.",
		"consumable_pocketTurret": "Torreta de bolsillo",
		"consumable_pocketTurret_desc": "Añade {1} Torreta(s) de bolsillo a tu inventario.\n\nLa Torreta de bolsillo despliega una torreta automática cerca de grupos de enemigos.",
		"weapon_pocket_turret_desc": "Efecto consumible - no cuenta como arma.\n\n Despliega una torreta automática cerca de un grupo de enemigos.",
		"item_plunder": "Saqueador",
		"item_plunder_desc": "+1 Opción de botín",
		"item_multitargeting": "Multiobjetivo",
		"item_multitargeting_desc": "Todas las armas remotas tienen +1% prob. de crítico por cada arma en tu posesión.",
		"item_pickupMagnet": "Imán gigante",
		"item_pickupMagnet_desc": "Recoges las mejoras automáticamente cuando se acaba el tiempo.",
		"item_frostbite": "Escarchado",
		"item_frostbite_desc": "Los enemigos reciben daño periódico cuando están congelados.",
		"item_necrobomb": "Necrobomba",
		"item_necrobomb_desc": "Al destruir a un enemigo con daño explosivo crítico desatas una ráfaga de explosiones alrededor de la zona del enemigo derrotado.",
		"item_prize": "Premio gordo",
		"item_prize_desc": "Al destruir a un enemigo con daño crítico, tienes {1} de probabilidades de que aparezca una mejora de reintento, escudo o salud.",
		"item_aftershock": "Réplica",
		"item_aftershock_desc": "El daño crítico siempre causa efectos de estado.",
		"item_vampirism": "Vampirismo",
		"item_vampirism_desc": "Gana una cantidad de salud igual a {1} del daño cinético crítico.",
		"item_wisdom": "Sabiduría",
		"item_wisdom_desc": "Al conseguir una mejora de Escudo consigues 10 bajas de cara a la evolución de todas tus armas.",
		"item_jester": "Comodín",
		"item_jester_desc": "Al conseguir una mejora de Reintentos haces una cantidad aleatoria de daño entre 0 y 100 a todos los enemigos en pantalla.",
		"item_jester_2_desc": "Al completar una palabra invocas un Dron Comodín que hace entre 0-100% de daño a un objetivo aleatorio. Hay un período de enfriamiento de 10 segundos entre activaciones.",
		"item_lastStand": "Última baza",
		"item_lastStand_desc": "Cuando pierdes un Escudo, ganas una mejora de Daño doble.",
		"item_tripleDamage": "Daño triple",
		"item_tripleDamage_desc": "Todas las mejoras de Daño doble pasan a ser mejoras de Daño triple.",
		"item_fracture": "Fractura",
		"item_fracture_desc": "Mientras estés bajo los efectos de la mejora de Congelar, todas las mejoras de Congelar que aparezcan pasarán a ser mejoras de Fractura que hacen daño a todos los enemigos Congelados.",
		"item_fracture_desc_2": "Todo el daño que hagas a los enemigos congelados aumenta en {1}. Este modificador es multiplicativo.",
		"item_ascetic": "Ascético",
		"item_ascetic_desc": "Cuando salgas de la pantalla de Botín recibirás una mejora de 10% de daño por cada Reintento sin usar que tengas durante 20 segundos.",
		"item_harmonizer": "Armonización",
		"item_harmonizer_desc": "Todas las armas equipadas reciben un nivel de Evolución.",
		"item_immortality": "Inmortalidad",
		"item_immortality_desc": "Si tu Arma principal está a punto de ser destruida está aguantará a 1 punto de vida. Esta habilidad solo se puede activar una vez cada 2 minutos.",
		"item_immortality_desc_2": "Si tu Arma principal está a punto de ser destruida está aguantará a 1 punto de vida y todos los enemigos dentro de un área de 400 metros del arma principal recibirán daño cinético letal. Esta habilidad solo se puede activar una vez cada 2 minutos.",
		"item_enlightenment": "Iluminación",
		"item_enlightenment_desc": "Cuando destruyes a un enemigo con daño crítico, avanzas la evolución de todas tus armas en 1 punto.",
		"item_closer": "Epílogo",
		"item_closer_desc": "Al completar la palabra de un enemigo una vez ha sido destruido recibes una mejora de 10% de daño durante 10 segundos. Este efecto se acumula hasta 3 veces.",
		"item_murderous": "Asesino",
		"item_murderous_desc": "Todas las armas de dron: +50% de daño",
		"item_executioner": "Ejecutor",
		"item_executioner_desc": "Todas las armas de torreta: +50% de daño",
		"item_degeneration": "Degeneración",
		"item_degeneration_desc": "Todas las armas remotas: +50% de daño",
		"item_clone": "Clon",
		"item_clone_desc": "Los consumibles tienen un 30% de probabilidades de volver a generarse al usarse.",
		"augment_category_mainWeapon": "Códice:  Arma Principal",
		"augment_category_turret": "Códice: Torreta",
		"augment_category_drones": "Códice: Drones",
		"augment_category_dot": "Códice: D.P.",
		"augment_category_remote": "Códice: Remoto",
		"augment_category_electric": "Códice: Eléctrico",
		"augment_category_heat": "Códice: Calorífico",
		"augment_category_kinetic": "Códice: Cinético",
		"augment_armored": "Acorazado",
		"augment_armored_desc": "Arma Principal:\n  Salud: +50%",
		"augment_eager": "Impaciente",
		"augment_eager_desc": "Al inicio de cada Prueba o Partida Infinita gana un nivel. Por cada 4 minutos que sobrevivas en el modo Partida infinita gana otro nivel.",
		"augment_gambler": "Jugador",
		"augment_gambler_desc": "Cada Reintento que uses le otorga a tu Arma Principal +20% de daño durante 20 segundos.",
		"augment_haze": "Ofuscado",
		"augment_haze_desc": "Si estás por debajo del 50% de tu vida máxima, obtienes un +50% de Cadencia de Disparo general adicional.",
		"augment_immaculate": "Inmaculado",
		"augment_immaculate_desc": "Las Secuencias Perfectas pasan a darte un +1.5% de Probabilidad de Crítico.",
		"augment_devotion": "Devoción",
		"augment_devotion_desc": "El arma principal consigue un +25% de daño por cada casilla de arma vacía que tengas. Al menos una de las opciones en cada pantalla de subida de nivel será una mejora.",
		"augment_armada": "Armada",
		"augment_armada_desc": "Tienes un 20% de probabilidades de desplegar un dron adicional cada vez que despliegues uno.",
		"augment_diversity": "Diversidad",
		"augment_diversity_desc": "Por cada arma que no sea de drones que tengas equipada, aumenta la duración de los Drones en un 20%.",
		"augment_blitzkrieg": "Asalto Relámpago",
		"augment_blitzkrieg_desc": "Las mejores de velocidad de los drones también mejoran su daño.",
		"augment_retribution": "Venganza",
		"augment_retribution_desc": "Cada vez que pierdas un Escudo, todos los drones se autodestruyen haciendo daño explosivo.",
		"augment_scapegoat": "Chivo expiatorio",
		"augment_scapegoat_desc": "Los errores destruyen un dron al azar en lugar de contar como un error.",
		"augment_spoils": "Saqueo",
		"augment_spoils_desc": "Los drones pueden soltar mejoras al agotar su duración.",
		"augment_fortress": "Fortaleza",
		"augment_fortress_desc": "Cada Evolución de Torreta le otorga +50 de vida máxima a tu Arma Principal.",
		"augment_networked": "Interconexión",
		"augment_networked_desc": "Por cada otra torreta que tengas tus torretas reciben +10% de cadencia de disparo hasta un máximo del 50%.",
		"augment_fieldIntel": "Investigación de Campo",
		"augment_fieldIntel_desc": "Al activar una mejora recibes un +30% de rango para todas las torretas desplegadas. Este efecto no se acumula.",
		"augment_darkRelay": "Relé Cargado",
		"augment_darkRelay_desc": "Un proyectil rebota entre las torretas desplegadas haciendo daño eléctrico.",
		"augment_observer": "Vigilante",
		"augment_observer_desc": "Si no has atacado durante los 3 últimos segundos recibes un 30% de daño adicional para las torretas hasta tu próximo ataque.",
		"augment_observer_powerup": "{1} daño de torreta",
		"augment_weakness": "Punto Débil",
		"augment_weakness_desc": "Los enemigos dentro del rango de tus torretas reciben un 30% más de daño de otras fuentes.",
		"augment_corrosion": "Corrosión",
		"augment_corrosion_desc": "El daño de las armas con D.P. ahora puede ser crítico.",
		"augment_lamprey": "Sanguijuela",
		"augment_lamprey_desc": "El Daño Periódico que hagas cerca de tu arma principal le sana 1 punto de vida.",
		"augment_tenacity": "Tenacidad",
		"augment_tenacity_desc": "Aumenta la duración del efecto de todas las armas de D.P. en un 35%.",
		"augment_afflictors": "Hostigadores",
		"augment_afflictors_desc": "Añade Hostigadores a la lista de Botín disponible. Cada uno te otorga un 4% de D.P. adicional. El efecto se duplica si estás cerca del arma principal.",
		"augment_conviction": "Convicción",
		"augment_conviction_desc": "Las armas de D.P. tienen un +40% de cadencia de disparo adicional mientras tengas el máximo de Reintentos.",
		"augment_conviction_powerup": "{1} cadencia de disparo de D.P.",
		"augment_infector": "Contaminante",
		"augment_infector_desc": "Las armas de D.P. tienen un +3% de probabilidades de provocar efectos de estado.",
		"augment_closeCombat": "Combate de proximidad",
		"augment_closeCombat_desc": "Todo el daño que hagan tus armas remotas se considera que está cerca del arma principal.",
		"augment_caltrops": "Abrojos",
		"augment_caltrops_desc": "Los críticos con armas remotas despliegan 12 abrojos que dañan a los enemigos y tiene prob. de sangrado adicional en base al daño.",
		"augment_causticAmmo": "Munición cáustica",
		"augment_causticAmmo_desc": "Probabilidades de que aparezca la mejora de Munición cáustica que añade 10 puntos de daño químico a las armas remotas durante 20 segundos.",
		"augment_piracy": "Piratería",
		"augment_piracy_desc": "Por cada efecto de botín que tengas equipado aumenta todo el daño remoto en un 15%.",
		"augment_deliverance": "Salvación",
		"augment_deliverance_desc": "Las armas remotas tienen un +40% de rango adicional mientras tengas los escudos al máximo.",
		"augment_deliverance_powerup": "{1} de rango de armas remotas",
		"augment_sniper": "Tirador",
		"augment_sniper_desc": "Las mejoras de rango de armas remotas también se aplica a su daño.",
		"augment_voltaicBurst": "Carga voltaica",
		"augment_voltaicBurst_desc": "Las mejoras de duración de las armas eléctricas aplican el 25% de su valor a la probabilidad de causar estática.",
		"augment_stormBattery": "Tormenta acechante",
		"augment_stormBattery_desc": "La torreta principal causa daño eléctrico a los enemigos cercanos. Cada arma eléctrica equipada aumenta el daño base.",
		"augment_lightningSparks": "Chispas",
		"augment_lightningSparks_desc": "Al dar un golpe crítico con armas eléctricas despliegas 6 chispas eléctricas cuyio daño escala con tu probabilidad y multiplicador de crítico.",
		"augment_efficientGrid": "Cableado eficiente",
		"augment_EfficientGrid_desc": "Por cada arma equipada que no sea eléctrica aumentas la duración de las armas eléctricas en un 10%.",
		"augment_violentDischarge": "Sobrecarga violenta",
		"augment_violentDischarge_desc": "La estática hace más daño y tiene más rango. Los enemigos que mueran a causa de la estática tienen un 50% de probabilidades de pasar la estática a enemigos cercanos.",
		"augment_electrifiedTurret": "Torreta electrificada",
		"augment_electrifiedTurret_desc": "Tu arma principal gana +5 de daño eléctrico base y aumenta todo el daño de las armas eléctricas en un 10%.",
		"augment_pyromancy": "Piromancia",
		"augment_pyromancy_desc": "Aumenta el daño de calor en un 2% por cada enemigo quemándose. Al quemar a un enemigo haces daño de calor adicional en base a la duración y daño de la quemadura.",
		"augment_cauterization": "Cauterización",
		"augment_cauterization_desc": "Las mejoras de rango también se aplican al daño que hagas cerca de la torreta principal con armas y efectos de calor.",
		"augment_furnaceCore": "Núcleo de la caldera",
		"augment_furnaceCore_desc": "La torreta principal gana +5 de daño de calor base y aumenta todo el daño de las armas de calor en un 10%.",
		"augment_fireball": "Bola de fuego",
		"augment_fireball_desc": "Al disparar el arma principal lanzas una Bola de fuego que hace daño de calor a los enemigos a su paso. Solo puedes tener 1 Bola de fuego activa a la vez.",
		"augment_flameWave": "Llamarada",
		"augment_flameWave_desc": "Añade la Llamarada a tu inventario inicial y a las opciones de botín. Quemas a todos los enemigos presentes y pierdes el 10% de la vida actual de la torreta principal.",
		"augment_blazingGlory": "Resplandor de gloria",
		"augment_blazingGlory_desc": "Los enemigos cercanos al arma principal reciben +25% de daño de calor adicional y tienen un +12% de probabilidades de recibir quemaduras al recibir daño de calor.",
		"augment_gunslinger": "Pistolero",
		"augment_gunslinger_desc": "Aumenta el máximo de Racha de palabras en 5. Cada rango que alcances en tu Racha de palabras aumenta tu daño cinético en 2.5%.",
		"augment_bloodlust": "Sed de sangre",
		"augment_bloodlust_desc": "Aumenta la cadencia de disparo de las armas cinéticas en un 2% y el rango en 1% por cada enemigo sangrando.",
		"augment_infusedAmmo": "Munición imbuida",
		"augment_infusedAmmo_desc": "Los golpes críticos de daño cinético tienen una probabilidad del 40% de aplicar un efecto de estado aleatorio a los enemigos.",
		"augment_scrapArmaments": "Metralla",
		"augment_scrapArmaments_desc": "Tienes probabilidades de que aparezca Metralla que añade 10 de daño cinético base a las armas cinéticas durante 20 segundos.",
		"augment_combinedArms": "Armamento combinado",
		"augment_combinedArms_desc": "Por cada arma equipada que no sea cinética aumentas todo el daño cinético que haces en 10%.",
		"augment_pocketTurret": "Torreta de bolsillo",
		"augment_pocketTurret_desc": "Añades una Torreta de bolsillo a tu inventario de consumibles y al botín que pueda aparecer. Despliegas una torreta que podrás recoger cuando termine su efecto.",
		"wiki_tag_label": "Etiquetas",
		"wiki_name_label": "Nombre",
		"wiki_cost_label": "Coste",
		"wiki_description_label": "Descripción",
		"wiki_title": "Wiki Oficial de Glyphica",
		"wiki_subtitle": "La Wiki Oficial de Glyphica Typing Survival",
		"wiki_home_title": "Inicio",
		"wiki_landingPage_title": "Bienvenidos, mecanógrafos",
		"wiki_landingPage_intro": "¡Bienvenidos a la Wiki oficial de Glyphica: Typing Survival! Poned a prueba vuestra habilidad para teclear en este juego de supervivencia de hordas donde la velocidad y la precisión son la clave para salir con vida. Ármate con las mejores herramientas para transformar tu habilidad con el teclado en ataques devastadores para acabar con tus enemigos. Descubre mucho más comprando el juego en Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Esta wiki te servirá de guía para saber todo lo que necesitas del contenido disponible y todas las mecánicas presentes en el Acceso Anticipado de Glyphica. Nuestro objetivo es mantener toda la información del juego actualizada paso a paso mientras alcanzamos la versión definitiva, la 1.0. Esta wiki está dividida en secciones listadas en las tablas de contenido y se irán actualizando a medida que el juego evolucione.",
		"wiki_tableOfContents_title": "Tabla de contenidos",
		"wiki_mainWeapons_title": "Armas principales",
		"wiki_mainWeapons_intro": "Las armas principales son las armas iniciales en *Glyphica* y tienen un papel muy importante en el juego. Cuando escribes una palabra que aparezca sobre el enemigo, el arma principal se apunta al enemigo y se activa. Cada arma principal tiene efectos y mecánicas únicas que requieren de distintas estrategias para ser más eficaces.",
		"wiki_mainWeapons_intro2": "Mientras que hay armas más enfocadas en la velocidad de tecleo (PPM), hay otras que requieren de un planteamiento más táctico. Como cualquier otro arma en el juego, las armas principales se pueden mejorar y pueden evolucionar, mejorando tanto sus habilidades como su efectividad a medida que avanzas.",
		"wiki_mainWeapons_list_title": "Lista de armas principales",
		"wiki_weapons_title": "Armas por nivel",
		"wiki_weapons_intro": "Las armas por nivel se consiguen durante la partida al subir de nivel. Una vez elijas una, este arma aparecerá en tu arsenal. Cada arma tiene un método de activación único aunque la mayoría se activa escribiendo y marcando objetivos con tu arma principal.",
		"wiki_weapons_intro2": "Puedes conseguir hasta un máximo de cuatro armas por nivel. Una vez añadas una a tu arsenal sus mejoras podrán aparecer cuando subas de nivel, así podrás mejorar sus habilidades mientras te abres paso entre las oleadas.",
		"wiki_weapons_list_title": "Lista de armas por nivel",
		"wiki_weapon_evolution_title": "Evoluciones",
		"wiki_weapon_upgrade_title": "Mejoras",
		"wiki_lootItems_title": "Objetos de botín",
		"wiki_lootItems_intro": "Los objetos de botín se consiguen en cofres del tesoro que aparecerán durante la partida. Cuando consigas uno aparecerá una selección aleatoria de objetos y podrás elegir uno para conseguir una mejora pasiva que permanecerá activa el resto de la partida.",
		"wiki_lootItems_intro2": "Los objetos de botín están repartidos entre objetos **comunes**, **poco comunes** y **raros** lo que determinará su probabilidad de aparecer a la hora de elegir botín. Al derrotar a un jefe en una de las Pruebas conseguirás un cofre del tesoro que solo contendrá objetos raros.",
		"wiki_lootItems_rare_title": "Lista de botín raro",
		"wiki_lootItems_uncommon_title": "Lista de botín poco común",
		"wiki_lootItems_common_title": "Lista de botín común",
		"wiki_enemies_title": "Enemigos",
		"wiki_enemies_intro": "Los enemigos en *Glyphica* aparecer de manera procedural acorde a las métricas del nivel de **amenaza**, que va aumentando a medida que progresa la partida. En el modo de Pruebas la amenaza se multiplica por el Nivel de Prueba actual lo que causa que cada nivel sea más difícil. En el modo de Partida Infinita, la amenaza se ajusta a una escala adaptable que depende del nivel del jugador, haciendo que el valor más alto determine la dificultad de los enemigos que aparecen.",
		"wiki_enemies_intro2": "Los enemigos también están repartidos entre enemigos **especiales** y enemigos de **élite**, cada uno tiene su propio límite de tipo que limita su tasa de aparición dentro del marco del nivel de amenaza.",
		"wiki_enemies_list_title": "Lista de enemigos",
		"wiki_enemy_variants_title": "Lista de variantes",
		"wiki_image_label": "Imagen",
		"wiki_splitter_shard_count": "Número de Fragmentos",
		"wiki_splitter_shard_health": "Salud de los Fragmentos",
		"wiki_splitter_shard_damage": "Daño de los Fragmentos",
		"wiki_augments_title": "Aumentos",
		"wiki_augments_intro": "Los aumentos son mejoras permanentes que se pueden desbloquear usando Monedas (§), un tipo de divisa que puedes conseguir en tus partidas. Al comienzo de cada partida, los jugadores tienen un número limitado de huecos para equiparse aumentos que hayan sido desbloqueados y este número varía dependiendo del nivel de Presagio que haya elegido.",
		"wiki_augments_intro2": "Cada aumento tiene unas condiciones específicas que determinan sus beneficios. Para sacar el máximo provecho a tus aumentos necesitarás plantearte las sinergias que puedan tener para que se ajusten a tu estrategia.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Determinación",
		"NEW_ACHIEVEMENT_1_0_DESC": "Sobrevive durante 20 minutos en el modo de Partida Infinita con cualquier arma principal.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Persistencia",
		"NEW_ACHIEVEMENT_1_1_DESC": "Sobrevive durante 30 minutos en el modo de Partida Infinita con cualquier arma principal.",
