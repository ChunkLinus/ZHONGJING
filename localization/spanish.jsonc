		"boss_poet": "El Poeta",
		"boss_poet_desc": "Escribe el mensaje que trae el jefe.\nPodrás seguir marcando a los enemigos como objetivo mientras lo haces.",
		"boss_cypher": "El Enigma",
		"boss_cypher_desc": "Este jefe desordena las letras de los enemigos cercanos.\nPodrás destruirlo con tus armas.",
		"boss_cerberus": "Cerbero",
		"boss_cerberus_desc": "Este jefe te disparará proyectiles que podrás destruir.\nTendrás que acabar con sus tres cabezas con tus armas.",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Este jefe dará vueltas a tu alrededor sin parar.\nTendrás que disparar justo a tiempo a los objetivos estáticos que estarán en su trayectoria para acertarle con tus armas.",
		"boss_gemini": "Geminis",
		"boss_gemini_desc": "Tendrás que dañar a los mellizos por igual.\nSe irán curando mutuamente hasta igualarse la cantidad de vida.",
		"weapon_repeater_title": "Repetidora",
		"weapon_heatray_title": "Rayo de calor",
		"weapon_barrage_title": "Andanada",
		"weapon_overmind_title": "Mente colmena",
		"weapon_splattershot_title": "Lanzababas",
		"weapon_wildcard_title": "Comodín",
		"weapon_spectre_title": "Espectro",
		"weapon_tesla_title": "Mina Tesla",
		"weapon_sentry_title": "Centinela",
		"weapon_oscillator_title": "Oscilador",
		"weapon_meteor_title": "Meteorito",
		"weapon_hunter_title": "Cazador",
		"weapon_chopper_title": "Rebanadora",
		"weapon_minefield_title": "Campo de minas",
		"weapon_blade_title": "Trampa de cuchillas",
		"weapon_firestorm_title": "Deflagradora",
		"weapon_guardian_title": "Guardián",
		"weapon_orbiter_title": "Orbitante",
		"weapon_frostbite_title": "Congelación",
		"weapon_bleeding_title": "Sangrado",
		"weapon_blight_title": "Ponzoña",
		"weapon_static_title": "Estática",
		"weapon_ignite_title": "Quemadura",
		"weapon_heatray_requirements": "Completa las Pruebas de la Repetidora en cualquier nivel de Presagio.",
		"weapon_barrage_requirements": "Completa Pruebas en nivel de Presagio 3 con cualquier arma principal.",
		"weapon_repeater_desc": "Un arma devastadora que dispara balas en ráfagas cortas.",
		"weapon_heatray_desc": "Dispara un rayo constante de luz concentrada increíblemente preciso que hace daño periódico.",
		"weapon_barrage_desc": "Dispara una ráfaga de misiles explosivos al objetivo y a su alrededor. Se recarga con el tiempo.",
		"weapon_overmind_desc": "Ordena a una horda de drones que haga daño de energía a tus enemigos.",
		"weapon_splattershot_desc": "Lanza unas pelotas de baba a tus oponentes que los debilita y les daña.",
		"weapon_wildcard_desc": "El siguiente proyectil será escogido al azar entre 4 posibles armas, dispara con cuidado.",
		"weapon_spectre_desc": "Invoca una cantidad de drones melee veloces equivalente al número de combinaciones de las de arriba.",
		"weapon_sentry_desc": "Despliega una torreta automática que dispara a los enemigos que se pongan a rango.",
		"weapon_tesla_desc": "Despliega una torreta eléctrica que hace daño periódico.",
		"weapon_oscillator_desc": "Dispara un rayo de partículas en la dirección de tu objetivo más reciente.",
		"weapon_meteor_desc": "Invoca marcadores en zonas aleatorias periódicamente que puedes activar para iniciar un bombardeo orbital.",
		"weapon_hunter_desc": "Invoca una cantidad de drones que disparan rayos equivalente al número de combinaciones.",
		"weapon_chopper_desc": "Invoca una cuchilla giratoria enorme que se dispara desde el arma principal y que viaja hasta el borde de la pantalla, causa daño a todos los enemigos a su paso.",
		"weapon_minefield_desc": "Invoca unas minas que se mueven lentamente y explotan al entrar en contacto con los enemigos.",
		"weapon_blade_desc": "Despliega una trampa de cuchillas giratorias.",
		"weapon_firestorm_desc": "Un cañón que dispara una andanada de proyectiles explosivos de corto alcance. Gira en torno a la torreta principal y tiene un pequeño enfriamiento para poder disparar de nuevo.",
		"weapon_guardian_desc": "Despliega instantáneamente un dron que dispara láseres a los enemigos. Activa las mejoras de Combustible para repostar el combustible del Guardián, este consumirá combustible y se desactivará cuando acabe con las reservas.",
		"weapon_orbiter_desc": "Invoca un orbe que orbita el arma principal, causando daños a todo lo que se cruza en su camino.",
		"weapon_frostbite_desc": "Efecto de botín - no cuenta como arma.\n\nLos enemigos reciben daño periódico mientras están congelados.",
		"weapon_bleeding_desc": "Efecto de estado - no cuenta como arma.\n\nLos enemigos reciben daño cinético periódico hasta que se pasa el efecto.",
		"weapon_blight_desc": "Efecto de estado - no cuenta como arma.\n\nLos enemigos reciben daño químico periódico y se ralentizan hasta que se pasa el efecto.",
		"weapon_static_desc": "Efecto de estado - no cuenta como arma.\n\nLos enemigos reciben daño eléctrico periódico y este se propaga a enemigos cercanos hasta que se pasa el efecto.",
		"weapon_ignite_desc": "Efecto de estado - no cuenta como arma.\n\nLos enemigos reciben daño de calor periódico hasta que se pasa el efecto.",
		"weapon_caltrops_desc": "Efecto de aumento - no cuenta como arma.\n\nAl dar un golpe crítico con armas remotas despliegas 12 abrojos que dañan a los enemigos que pasen por la zona, este daño cuenta con probabilidad de sangrado adicional en base al daño.",
		"weapon_stormBattery_desc": "Efecto de aumento - no cuenta como arma.\n\nLa torreta principal hace daño eléctrico a los enemigos cercanos. Cada arma eléctrica que tengas equipada aumenta el daño base.",
		"weapon_lightningSparks_desc": "Efecto de aumento - no cuenta como arma.\n\nAl dar un golpe crítico con armas eléctricas despliegas 6 Centellas cuyo daño escala por tu probabilidad de crítico y tu multiplicador de crítico.",
		"weapon_darkRelay_desc": "Efecto de aumento - no cuenta como arma.\n\nInvoca un proyectil que rebota al azar entre las torretas existentes y hace daño eléctrico.",
		"weapon_jester_desc": "Efecto de botín - no cuenta como arma.\n\nAl recoger un Reintento haces una cantidad de daño aleatoria entre 0 y 100 a todos los enemigos en pantalla.",
		"weapon_necrobomb_desc": "Efecto de botín - no cuenta como arma.\n\nAl destruir a un enemigo con daño explosivo crítico desencadenas una serie de explosiones cerca del enemigo derrotado.",
		"weapon_release_desc": "Efecto de botín - no cuenta como arma.\n\nEn caso de tener una errata, haces {1} de daño explosivo a todos los enemigos por cada x{2} Secuencias Perfectas.",
		"weapon_retribution_desc": "Efecto de aumento - no cuenta como arma.\n\nCada vez que se destruye un escudo todos los drones presentes se autodestruyen y hacen daño explosivo.",
		"weapon_fireball_desc": "Efecto de aumento - no cuenta como arma.\n\nCuando disparas el arma principal también lanzas una Bola de fuego ques se desplaza lentamente y hace daño de calor.",
		"contains_characters": "Completar palabras que contengan los glifos",
		"contains_glyphs": "Completar las combinaciones que contengan los glifos",
		"starts_with_character": "Completar palabras que empiecen con los glifos",
		"starts_with_glyphs": "Completar las combinaciones que empiecen con los glifos",
