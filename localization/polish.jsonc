		"evo_minefield_mineLayer_desc": "oprócz istniejących liter będzie również tworzyć miny.",
		"evo_minefield_infusion": "Infuzja",
		"evo_minefield_infusion_desc": "Efekt:\n Obrażenia chemiczne: {1}\n Obrażenia wybuchowe: {2}\n\nPole Minowe zadaje teraz obrażenia chemiczne zamiast wybuchowych i jest traktowane jako broń chemiczna.",
		"evo_minefield_infusion_2": "Infuzja II",
		"evo_minefield_infusion_2_desc": "Efekty:\n Obrażenia chemiczne: {1}\n Szansa na Zarazę: {2}\n\nEfekt globalny:\n Wszystkie efekty/bronie chemiczne:\n Obrażenia: {3}",
		"evo_minefield_hunterSeeker": "Łowca Poszukiwacz",
		"evo_minefield_hunterSeeker_desc": "Efekty:\n  Szybkość: {1}\n  Zasięg: {2}\n\nMiny zyskują zdolność naprowadzania na losowe cele.",
		"evo_minefield_hunterSeeker_2": "Łowca Poszukiwacz II",
