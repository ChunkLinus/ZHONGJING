		"item_point_blank": "Strzał w Twarz",
		"item_point_blank_desc": "Wrogowie trafieni w pobliżu broni głównej otrzymują {1} obrażeń.",
		"item_shatter": "Roztrzaskanie",
		"item_shatter_desc": "Wszystkie bronie kinetyczne zyskują {1} szansy na trafienie krytyczne przeciwko zamrożonym wrogom.",
		"item_seer": "Widzący",
		"item_seer_desc": "Aktywacja opcji ponownego losowania zwiększa globalny zasięg o 10% na 10 sek. Kumuluje się do 3 razy.",
		"item_seer_desc_2": "Jeśli masz 0 ponownych losowań po wejściu na ekran awansu, ewolucji lub łupów, będziesz mieć 1 powtórzenie.",
		"item_resilience": "Odporność",
		"item_resilience_desc": "Aktywacja tarczy zwiększa globalny czas działania o 10% na 10 sek. Kumuluje się do 3 razy.",
		"item_resilience_desc_2": "Za każdą posiadaną tarczę zyskujesz {1} globalnego czasu działania.",
		"item_gambler": "Hazardzista",
		"item_gambler_desc": "Dodaje 1 ponowne losowanie i zwiększa ich maksymalną liczbę do 6.",
		"item_protector": "Obrońca",
		"item_protector_desc": "Dodaje 1 tarczę i zwiększa ich maksymalną liczbę do 4.",
		"item_flawless": "Bezbłędny",
		"item_flawless_desc": "Każde x{1} bonusu za Zero Błędów zwiększy także prędkość ataku o {2}.",
		"item_release": "Uwolnienie",
		"item_release_desc": "Przy pomyłce, zadaj {1} obrażeń wybuchowych wszystkim wrogom za każde {2} bonusu Zero Błędów.",
		"item_wasting": "Marnotrawstwo",
		"item_wasting_desc": "Wszystkie bronie D.O.T.: +35% szybkostrzelności",
		"item_wither": "Usychanie",
		"item_wither_desc": "Wszystkie efekty stanu: +35% szybkostrzelności",
		"consumable_medpack": "Apteczka",
		"consumable_medpack_desc": "Dodaje Apteczki do ekwipunku w liczbie {1}. Medpacki leczą do {2} maksymalnego zdrowia głównej wieżyczki.",
		"consumable_serum": "Serum",
		"consumable_serum_desc": "Dodaje Serum do ekwipunku w liczbie {1}. Serum daje {2} szansy na trafienie krytyczne przez {3} sek.",
		"consumable_warhead": "Głowica",
		"consumable_warhead_desc": "Dodaje Głowice do ekwipunku w l.czbie {1} Głowice wyzwalają serię potężnych eksplozji, które rozchodzą się od broni głównej.",
		"weapon_warhead_desc": "Efekt zużywalny - nie liczy się jako broń.\n\nUwalnia serię potężnych eksplozji, które rozchodzą się od broni głównej.",
		"consumable_flameWave": "Fala Płomieni",
		"consumable_flameWave_desc": "Dodaje {1} Fale Płomieni do ekwipunku.\n\nFale Płomieni podpalają wszystkich widocznych wrogów kosztem 10% aktualnego zdrowia Głównej Wieżyczki.",
		"weapon_flameWave_desc": "Efekt zużywalny - nie liczy się jako broń.\n\nPodpala wszystkich widocznych wrogów kosztem 10% aktualnego zdrowia głównej wieżyczki.",
		"consumable_cryocore": "Kriordzeń",
		"consumable_cryocore_desc": "Dodaje Kriordzeń do ekwipunku w liczbie {1}.\n\\Kriordzeń wywołuje efekt Zamrożenia.",
		"consumable_killPill": "Pigułka Szału",
		"consumable_killPill_desc": "Dodaje Pigułke Szału do ekwipunku w liczbie {1}.\nPigułka Szału wywołuje efekt Podwójnych Obrażeń.",
		"consumable_pocketTurret": "Kieszonkowa Wieżyczka",
		"consumable_pocketTurret_desc": "Dodaje {1} Kieszonkową Wieżyczkę do ekwipunku.\n\nKieszonkowa Wieżyczka przywołuje automatyczną wieżyczkę w pobliżu grup wrogów.",
		"weapon_pocket_turret_desc": "Efekt zużywalny – nie liczy się jako broń.\n\nPrzywołuje automatyczną wieżyczkę w pobliżu grup wrogów.",
		"item_plunder": "Grabież",
		"item_plunder_desc": "+1 opcja łupów",
		"item_multitargeting": "Wielokierunkowość",
		"item_multitargeting_desc": "Wszystkie bronie zdalne otrzymują +1% szansy na trafienie krytyczne za każdą posiadaną broń.",
		"item_pickupMagnet": "Gigantyczny Magnes",
		"item_pickupMagnet_desc": "Masz {1} szansy na automatyczne zbieranie łupów po ich wygaśnięciu.",
		"item_frostbite": "Odmrożenie",
		"item_frostbite_desc": "Zamrożeni wrogowie otrzymują obrażenia rozłożone w czasie.",
		"item_necrobomb": "Nekrobomba",
		"item_necrobomb_desc": "Zniszczenie wroga za pomocą obrażeń krytycznych wybuchowych wywołuje serię eksplozji wokół pokonanego wroga.",
		"item_prize": "Nagroda",
		"item_prize_desc": "Zniszczenie wroga przy użyciu obrażeń krytycznych daje {1} szans na pojawienie się łupu ponownego losowania, tarczy lub zdrowia.",
		"item_aftershock": "Wstrząs wtórny",
		"item_aftershock_desc": "Obrażenia krytyczne zawsze wywołują efekt stanu.",
		"item_vampirism": "Wampiryzm",
		"item_vampirism_desc": "Zyskujesz zdrowie równe {1} obrażeń od krytycznych obrażeń kinetycznych.",
		"item_wisdom": "Mądrość",
		"item_wisdom_desc": "Po podniesieniu tarczy zyskujesz 10 pkt. zabójstw do wszystkich ewolucji broni.",
		"item_jester": "Błazen",
		"item_jester_desc": "Po podniesieniu ponownego losowania zadaje losową liczbę obrażeń od 0 do 100 wszystkim wrogom na ekranie.",
		"item_jester_2_desc": "Po ukończeniu słowa pojawia się Dron-Błazen, który zadaje losowemu celowi 0-100% życia wroga jako obrażenia. Czas odnowienia między aktywacjami wynosi 10 sekund.",
		"item_lastStand": "Ostatni Bastion",
		"item_lastStand_desc": "Po zniszczeniu tarczy otrzymujesz wzmocnienie podwójnych obrażeń.",
		"item_tripleDamage": "Potrójne Obrażenia",
		"item_tripleDamage_desc": "Wszystkie przedmioty dające podwójne obrażenia dają teraz potrójne obrażenia.",
		"item_fracture": "Złamanie",
		"item_fracture_desc": "Podczas zamrożenia każde kolejne zamrożenie, staje się złamaniem, które zadaje obrażenia każdemu zamrożonemu wrogowi.",
		"item_fracture_desc_2": "Wszystkie obrażenia zadawane zamrożonym wrogom zostają zwiększone o {1}. Modyfikator jest mnożnikowy.",
		"item_ascetic": "Asceta",
		"item_ascetic_desc": "Po wyjściu z ekranu łupów otrzymujesz +10% obrażeń za każde niewykorzystane ponowne losowanie przez 20 sek.",
		"item_harmonizer": "Harmonizer",
		"item_harmonizer_desc": "Wszystkie wyekwipowane bronie otrzymują jeden poziom ewolucji.",
		"item_immortality": "Nieśmiertelność",
		"item_immortality_desc": "Jeśli broń główna ma zostać zniszczona, zamiast tego pozostanie jej 1 pkt. zdrowia. Ta umiejętność odnawia się 2 minuty.",
		"item_immortality_desc_2": "Jeśli twoja broń główna ma zostać zniszczona, zamiast tego zostanie zredukowana do 1 pkt. zdrowia, a wszyscy wrogowie w promieniu 400 metrów od broni głównej otrzymają śmiertelne obrażenia kinetyczne. Umiejętności tej można użyć tylko raz na 2 minuty.",
		"item_enlightenment": "Oświecenie",
		"item_enlightenment_desc": "Za zniszczenie wroga obrażeniami krytycznymi otrzymujesz +1 zabójstw do ewolucji każdej broni.",
		"item_closer": "Bliżej",
		"item_closer_desc": "Dopełnienie słowa wroga po jego zniszczeniu daje +10% do obrażeń przez 10 sek. Kumuluje się maksymalnie 3 razy.",
		"item_murderous": "Morderczy",
		"item_murderous_desc": "Wszystkie bronie dronów: +50% obrażeń",
		"item_executioner": "Egzekutor",
		"item_executioner_desc": "Wszystkie bronie wieżyczki: +50% obrażeń",
		"item_degeneration": "Degeneracja",
		"item_degeneration_desc": "Wszystkie bronie zdalne: +50% obrażeń",
		"item_clone": "Klon",
		"item_clone_desc": "Przedmioty zużywalne mają 30% szans na samoreplikację przy użyciu.",
		"augment_category_mainWeapon": "Kodeks: Broń główna",
		"augment_category_turret": "Kodeks: Wieżyczka",
		"augment_category_drones": "Kodeks: Drony",
		"augment_category_dot": "Codex: D.O.T.",
		"augment_category_remote": "Codex: Zdalne",
		"augment_category_electric": "Codex: Elektryczne",
		"augment_category_heat": "Codex: Cieplne",
		"augment_category_kinetic": "Codex: Kinetyczne",
		"augment_armored": "Opancerzony",
		"augment_armored_desc": "Broń główna:\n  Zdrowie: +50%",
		"augment_eager": "Chętny",
		"augment_eager_desc": "Na początku każdej próby lub gry bez końca zdobądź poziom. Zdobywaj poziom za każde 4 minuty przeżyte w trybie bez końca.",
		"augment_gambler": "Hazardzista",
		"augment_gambler_desc": "Każde ponowne losowanie zapewnia broni głównej +20% obrażeń przez 20 sek.",
		"augment_haze": "Zamglenie",
		"augment_haze_desc": "Jeśli masz mniej niż 50% zdrowia, zyskujesz +50% globalnej premii do szybkostrzelności.",
		"augment_immaculate": "Nieskazitelność",
		"augment_immaculate_desc": "Zero błędów daje +1,5% szansy na trafienie krytyczne za bonus.",
		"augment_devotion": "Poświęcenie",
		"augment_devotion_desc": "Broń główna otrzymuje +25% obrażeń za każdy pusty slot na broń. Przynajmniej jedna opcja podczas awansu będzie ulepszeniem.",
		"augment_armada": "Armada",
		"augment_armada_desc": "20% szansy na pojawienie się dodatkowego drona za każdym razem, gdy pojawi się jeden.",
		"augment_diversity": "Różnorodność",
		"augment_diversity_desc": "Za każdą broń inną niż dron zwiększa czas działania wszystkich dronów o 20%.",
		"augment_blitzkrieg": "Blitzkrieg",
		"augment_blitzkrieg_desc": "Ulepszenia prędkości dronów mają również zastosowanie do obrażeń zadawanych przez drony.",
		"augment_retribution": "Zemsta",
		"augment_retribution_desc": "Za każdym razem, gdy tarcza zostanie zniszczona, wszystkie istniejące drony ulegają autodestrukcji, zadając obrażenia wybuchowe.",
		"augment_scapegoat": "Kozioł Ofiarny",
		"augment_scapegoat_desc": "Błędy losowo niszczą istniejącego drona, zamiast liczyć się jako błędny wpis.",
		"augment_spoils": "Łupy",
		"augment_spoils_desc": "Drony mogą upuszczać łupy po wygaśnięciu.",
		"augment_fortress": "Twierdza",
		"augment_fortress_desc": "Każda ewolucja wieżyczki zapewnia również +50 pkt. maksymalnego zdrowia broni głównej.",
		"augment_networked": "Sieć Zintegrowana",
		"augment_networked_desc": "Każda inna wieżyczka zapewnia +10% szybkostrzelności wszystkim wieżyczkom, maksymalnie do +50%.",
		"augment_fieldIntel": "Wywiad Polowy",
		"augment_fieldIntel_desc": "Aktywacja łupu zapewnia +30% zasięgu wszystkim istniejącym wieżyczkom. Efekt ten nie kumuluje się.",
		"augment_darkRelay": "Mroczny Przekaźnik",
		"augment_darkRelay_desc": "Pocisk odbija się losowo między istniejącymi wieżyczkami, zadając obrażenia elektryczne.",
		"augment_observer": "Obserwator",
		"augment_observer_desc": "Jeśli nie atakowałeś przez 3 sekundy, otrzymujesz +30% obrażeń od wieżyczek do następnego ataku.",
		"augment_observer_powerup": "{1} Obrażenia wieżyczki",
		"augment_weakness": "Słabość",
		"augment_weakness_desc": "Wrogowie w zasięgu wieżyczki otrzymują 30% więcej obrażeń z innych źródeł.",
		"augment_corrosion": "Korozja",
		"augment_corrosion_desc": "Obrażenia D.O.T. mogą być teraz krytyczne.",
		"augment_lamprey": "Pijawka",
		"augment_lamprey_desc": "Obrażenia D.O.T. zadawane w pobliżu broni głównej leczą ją o 1 pkt. ",
		"augment_tenacity": "Wytrwałość",
		"augment_tenacity_desc": "Zwiększa czas działania wszystkich broni D.O.T. o 35%.",
		"augment_afflictors": "Cierpienie",
		"augment_afflictors_desc": "Dodaje do puli łupów Cierpienie. Każde zwiększa obrażenia D.O.T. o 4%, podwajane blisko broni głównej.",
		"augment_conviction": "Przekonanie",
		"augment_conviction_desc": "Broń D.O.T. otrzymuje +40% szybkostrzelności, o ile masz maksymalną liczbę ponownych losowań.",
		"augment_conviction_powerup": "{1} Szybkostrzelność D.O.T.",
		"augment_infector": "Infektor",
		"augment_infector_desc": "Broń D.O.T. ma +3% szans na efekty statusowe.",
		"augment_closeCombat": "Walka Wręcz",
		"augment_closeCombat_desc": "Wszystkie obrażenia zadawane z dystansu są uznawane za bliskie broni głównej.",
		"augment_caltrops": "Kolczatka",
		"augment_caltrops_desc": "Trafienie krytyczne bronią zdalną przywołuje 12 kolców, zadające obrażenia przechodzącym wrogom. Szansa na krwawienie kolców zależy od ich obrażeń.",
		"augment_causticAmmo": "Żrąca Amunicja",
		"augment_causticAmmo_desc": "Szansa na upuszczenie Żrącej Amunicji, która dodaje 10 obrażeń chemicznych do broni zdalnej na 20 sek.",
		"augment_piracy": "Piractwo",
		"augment_piracy_desc": "Za każdy wyposażony efekt łupu zwiększa wszystkie obrażenia zadawane przez broń Zdalną o 15%.",
		"augment_deliverance": "Wybawienie",
		"augment_deliverance_desc": "Wszystkie bronie zdalne zyskują +40% zasięgu, o ile masz maksymalną tarczę.",
		"augment_deliverance_powerup": "{1} Zasięg Zdalny",
		"augment_sniper": "Snajper",
		"augment_sniper_desc": "Ulepszenia zasięgu broni zdalnej mają również zastosowanie do obrażeń.",
		"augment_voltaicBurst": "Rozbłysk Woltaiczny",
		"augment_voltaicBurst_desc": "Ulepszenia czasu działania elektryczności zwiększają również o 25% ich wartość szansę na wyładowanie elektryczne.",
		"augment_stormBattery": "Bateria Burzowa",
		"augment_stormBattery_desc": "Główna wieżyczka zadaje obrażenia elektryczne pobliskim wrogom. Każda broń elektryczna zwiększa obrażenia bazowe.",
		"augment_lightningSparks": "Iskry",
		"augment_lightningSparks_desc": "Trafienie krytyczne bronią elektryczną uwalnia 6 Iskier, których obrażenia skalują się wraz z szansą na trafienie krytyczne i mnożnikiem trafień krytycznych.",
		"augment_efficientGrid": "Efektywna Instalacja",
		"augment_EfficientGrid_desc": "Za każdą broń nieelektryczną w ekwipunku zwiększa czas działania wszystkich broni elektrycznych o 10%.",
		"augment_violentDischarge": "Gwałtowne Wyładowanie",
		"augment_violentDischarge_desc": "Wyładowania zadają większe obrażenia i mają większy zasięg. Wrogowie zabici przez Wyładowanie mają 50% szans na rozprzestrzenienie Wyładowania na pobliskich wrogów.",
		"augment_electrifiedTurret": "Naelektryzowana Wieżyczka",
		"augment_electrifiedTurret_desc": "Broń główna otrzymuje +5 bazowych obrażeń elektrycznych i zwiększa wszystkie obrażenia zadawane przez broń elektryczną o 10%.",
		"augment_pyromancy": "Piromancja",
		"augment_pyromancy_desc": "Zwiększa obrażenia od ciepła o 2% za każdego podpalonego wroga. Podpalenie wroga zadaje dodatkowe obrażenia od ciepła zależne od czasu trwania podpalenia i jego obrażeń.",
		"augment_cauterization": "Kauteryzacja",
		"augment_cauterization_desc": "Premia do zasięgu ma również zastosowanie do obrażeń od ciepła zadawanych w pobliżu broni głównej.",
		"augment_furnaceCore": "Rdzeń Pieca",
		"augment_furnaceCore_desc": "Główna Wieżyczka zyskuje +5 bazowych obrażeń od ciepła. Wszystkie obrażenia od ciepła zwiększone o 10%.",
		"augment_fireball": "Kula Ognia",
		"augment_fireball_desc": "Wystrzelenie broni głównej uwalnia wolno poruszającą się kulę ognia, która zadaje obrażenia od ciepła wrogom znajdującym się na jej drodze. Aktywna maks. 1 kula ognia.",
		"augment_flameWave": "Fala Płomieni",
		"augment_flameWave_desc": "Dodaje przedmiot zużywalny Fala Płomieni do ekwipunku i puli łupów. Podpala wszystkich wrogów i zużywa 10% aktualnego zdrowia.",
		"augment_blazingGlory": "Płonąca Chwała",
		"augment_blazingGlory_desc": "Wrogowie w pobliżu broni głównej otrzymują +25% obrażeń od ciepła i mają dodatkowe 12% szans na podpalenie od obrażeń od ciepła.",
		"augment_gunslinger": "Rewolwerowiec",
		"augment_gunslinger_desc": "Zwiększa maksymalną Gorączkę Słowną o 5. Każdy poziom Gorączki daje +2.5% obrażeń kinetycznych.",
		"augment_bloodlust": "Żądza Krwi",
		"augment_bloodlust_desc": "Zwiększa szybkostrzelność kinetyczną o 2% i zasięg o 1% za każdego krwawiącego wroga.",
		"augment_infusedAmmo": "Nasycona Amunicja",
		"augment_infusedAmmo_desc": "Trafienia krytyczne zadające obrażenia kinetyczne mają 40% szans na nałożenie losowego efektu stanu na wroga.",
		"augment_scrapArmaments": "Odłamki",
		"augment_scrapArmaments_desc": "Szansa na upuszczenie Odłamków — dodają 10 bazowych obrażeń kinetycznych broniom kinetycznym na 20 sekund.",
		"augment_combinedArms": "Łączone Siły",
		"augment_combinedArms_desc": "Za każdą wyposażoną broń niekinetyczną zwiększa wszystkie obrażenia kinetyczne o 10%.",
		"augment_pocketTurret": "Kieszonkowa Wieżyczka",
		"augment_pocketTurret_desc": "Dodaje zużywalną Kieszonkową Wieżyczkę do ekwipunku i puli łupów. Kieszonkowa Wieżyczka przywołuje wieżyczkę i może zostać podniesiona po wygaśnięciu.",
		"wiki_tag_label": "Tagi",
		"wiki_name_label": "Nazwa",
		"wiki_cost_label": "Koszt",
		"wiki_description_label": "Opis",
		"wiki_title": "Oficjalna Wiki Glyphica",
		"wiki_subtitle": "Oficjalna Wiki gry Glyphica Typing Survival",
		"wiki_home_title": "Strona główna",
		"wiki_landingPage_title": "Witaj graczu",
		"wiki_landingPage_intro": "Witamy na oficjalnej wiki gry Glyphica: Typing Survival! Sprawdź swoje umiejętności pisania na klawiaturze w grze o przetrwaniu, w której szybkość i dokładność są twoją ostateczną bronią. Wyposaż się w potężne narzędzia, które przekształcą twoje umiejętności pisania na klawiaturze w niszczycielskie ataki przeciwko nieustępliwym wrogom. Dowiedz się więcej i pobierz grę na Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "Niniejsza wiki służy jako kompleksowy przewodnik po funkcjach, mechanice i zawartości dostępnej we wczesnej wersji gry Glyphica. Naszym celem jest aktualizowanie informacji w miarę postępów w kierunku pełnej wersji 1.0. Wiki jest podzielona na sekcje wymienione w spisie treści i będzie regularnie aktualizowana w miarę rozwoju gry.",
		"wiki_tableOfContents_title": "Spis treści",
		"wiki_mainWeapons_title": "Broń główna",
		"wiki_mainWeapons_intro": "Broń główna jest bronią startową w grze *Glyphica* i odgrywa kluczową rolę w rozgrywce. Po wpisaniu słowa wyświetlanego nad wrogiem, broń główna namierza tego wroga jako cel. Każda broń główna ma unikalne efekty i mechanikę, wymagając różnych strategii, aby skutecznie z niej korzystać.",
		"wiki_mainWeapons_intro2": "Podczas gdy niektóre bronie główne kładą nacisk na szybkość pisania (WPM), inne wymagają bardziej taktycznego podejścia. Podobnie jak inne bronie w grze, broń główną można ulepszać i rozwijać, zwiększając jej możliwości i skuteczność w miarę postępów.",
		"wiki_mainWeapons_list_title": "Lista broni głównych",
		"wiki_weapons_title": "Bronie z awansu",
		"wiki_weapons_intro": "Bronie z awansu są zdobywane podczas gry w miarę zdobywania kolejnych poziomów. Po wybraniu broń jest dodawana do arsenału gracza. Każda broń ma unikalną metodę aktywacji, ale większość z nich można aktywować poprzez pisanie i celowanie za pomocą broni głównej.",
		"wiki_weapons_intro2": "W ten sposób można zdobyć maksymalnie cztery bronie. Po dodaniu broni do arsenału, jej ulepszenia stają się dostępne w puli ulepszeń, umożliwiając zwiększenie jej skuteczności w miarę postępów.",
		"wiki_weapons_list_title": "Lista broni z awansu",
		"wiki_weapon_evolution_title": "Ewolucje",
		"wiki_weapon_upgrade_title": "Ulepszenia",
		"wiki_lootItems_title": "Łupy",
		"wiki_lootItems_intro": "Łupy można zdobyć podczas gry, aktywując skrzynię ze skarbami. Zostanie wyświetlony losowy wybór przedmiotów z łupów, a wybranie jednego z nich zapewnia pasywną premię, która pozostaje aktywna przez resztę danej rozgrywki.",
		"wiki_lootItems_intro2": "Przedmioty z łupów są kategoryzowane jako **pospolite**, **niepospolite** i **rzadkie**, co określa prawdopodobieństwo ich pojawienia się w wyborze łupów. Pokonanie bossa w trybie próbnym nagradza skrzynią skarbów zawierającą tylko rzadkie przedmioty.",
		"wiki_lootItems_rare_title": "Lista rzadkich łupów",
		"wiki_lootItems_uncommon_title": "Lista nietypowych łupów",
		"wiki_lootItems_common_title": "Lista zwykłych łupów",
		"wiki_enemies_title": "Wrogowie",
		"wiki_enemies_intro": "Wrogowie w *Glyphica* odradzają się proceduralnie w oparciu o wewnętrzny wskaźnik zwany **zagrożeniem**, który wzrasta wraz z postępem gry. W trybie próby zagrożenie jest mnożone przez aktualny poziom próby, dzięki czemu każdy poziom jest coraz trudniejszy. W trybie bez końca zagrożenie jest porównywane z adaptacyjnym systemem skalowania opartym na poziomie gracza, przy czym wyższa wartość określa wielkość fal.",
		"wiki_enemies_intro2": "Wrogowie są również podzieleni na **specjalnych** i **elitarnych**, z których każdy ma własny limit klasy, który ogranicza ich częstotliwość pojawiania się w ramach ogólnego poziomu zagrożenia.",
		"wiki_enemies_list_title": "Lista wrogów",
		"wiki_enemy_variants_title": "Lista wariantów",
		"wiki_image_label": "Obraz",
		"wiki_splitter_shard_count": "Liczba odłamków",
		"wiki_splitter_shard_health": "Zdrowie odłamków",
		"wiki_splitter_shard_damage": "Obrażenia od odłamków",
		"wiki_augments_title": "Wzmocnienia",
		"wiki_augments_intro": "Rozszerzenia to stałe ulepszenia, które można odblokować za pomocą monet (§), waluty zdobywanej podczas rozgrywki. Na początku każdej gry gracze mają ograniczoną liczbę miejsc na wyposażenie odblokowanych ulepszeń, przy czym liczba dostępnych miejsc różni się w zależności od wybranego poziomu Objawienia.",
		"wiki_augments_intro2": "Aby jak najlepiej wykorzystać swoje ulepszenia, należy rozważyć synergie między nimi i dostosować je do preferowanej strategii.",
		"NEW_ACHIEVEMENT_1_0_NAME": "Determinacja",
		"NEW_ACHIEVEMENT_1_0_DESC": "Przetrwaj 20 minut w trybie bez końca z dowolną bronią główną.",
		"NEW_ACHIEVEMENT_1_1_NAME": "Wytrwałość",
		"NEW_ACHIEVEMENT_1_1_DESC": "Przetrwaj 30 minut w trybie bez końca z dowolną bronią główną.",
		"NEW_ACHIEVEMENT_1_2_NAME": "Mistrzostwo Działka",
		"NEW_ACHIEVEMENT_1_2_DESC": "Osiągnij 500 dps za pomocą Działka.",
		"NEW_ACHIEVEMENT_1_3_NAME": "Mistrzostwo Wartownika",
		"NEW_ACHIEVEMENT_1_3_DESC": "Osiągnij 500 dps za pomocą Wartownika.",
		"NEW_ACHIEVEMENT_1_4_NAME": "Mistrzostwo Widma",
		"NEW_ACHIEVEMENT_1_4_DESC": "Osiągnij 500 dps Widmem.",
		"NEW_ACHIEVEMENT_1_5_NAME": "Mistrzostwo Łowcy",
		"NEW_ACHIEVEMENT_1_5_DESC": "Osiągnij 500 dps Łowcą.",
		"NEW_ACHIEVEMENT_1_6_NAME": "Mistrzostwo Oscylatora",
		"NEW_ACHIEVEMENT_1_6_DESC": "Osiągnij 500 dps Oscylatorem.",
		"NEW_ACHIEVEMENT_1_7_NAME": "Mistrzostwo Siekacza",
		"NEW_ACHIEVEMENT_1_7_DESC": "Osiągnij 500 dps Siekaczem.",
		"NEW_ACHIEVEMENT_1_8_NAME": "Mistrzostwo Min",
		"NEW_ACHIEVEMENT_1_8_DESC": "Osiągnij 500 dps Minami.",
		"NEW_ACHIEVEMENT_1_9_NAME": "Mistrzostwo Ostrzy",
		"NEW_ACHIEVEMENT_1_9_DESC": "Osiągnij 500 dps Pułapką z Ostrzami.",
		"NEW_ACHIEVEMENT_1_10_NAME": "Mistrzostwo Tesli",
		"NEW_ACHIEVEMENT_1_10_DESC": "Osiągnij 500 dps Miną Tesli.",
		"NEW_ACHIEVEMENT_1_11_NAME": "Pisarz",
		"NEW_ACHIEVEMENT_1_11_DESC": "Osiągnij 500 pkt. wskaźnika Bez Błędów.",
		"NEW_ACHIEVEMENT_1_12_NAME": "Perfekcjonista",
		"NEW_ACHIEVEMENT_1_12_DESC": "Osiągnij 1000 pkt. wskaźnika Bez Błędów.",
		"NEW_ACHIEVEMENT_1_13_NAME": "Mistrzostwo Promienia Ciepła",
		"NEW_ACHIEVEMENT_1_13_DESC": "Osiągnij 500 dps Promieniem Ciepła.",
		"NEW_ACHIEVEMENT_1_14_NAME": "Mistrzostwo Meteorów",
		"NEW_ACHIEVEMENT_1_14_DESC": "Osiągnij 500 dps Meteorami.",
		"NEW_ACHIEVEMENT_1_15_NAME": "Mistrzostwo Gradu",
		"NEW_ACHIEVEMENT_1_15_DESC": "Osiągnij 500 dps Gradem.",
		"NEW_ACHIEVEMENT_1_16_NAME": "Mistrzostwo Rozpryskowe",
		"NEW_ACHIEVEMENT_1_16_DESC": "Osiągnij 500 dps Rozpryskowym.",
		"NEW_ACHIEVEMENT_1_17_NAME": "Mistrzostwo Strażnika",
