		"level_up_heal": "Niewielkie Uzdrowienie",
		"level_up_heal_desc": "Zapewnia niewielką ilość zdrowia",
		"evo_repeater_frostFang": "Kieł Mrozu",
		"evo_repeater_frostFang_desc": "Efekty:\n  Obrażenia od zimna: {1}\n  Szansa na zamrożenie: {2} \n\nWpływa na obrażenia bazowe i modyfikatory obrażeń od zimna.",
		"evo_repeater_frostFang_2": "Kieł Mrozu II",
		"evo_repeater_frostFang_2_desc": "Efekty:\n  Obrażenia od zimna: {1}\n  Obrażenia kinetyczne: {2}\n\nWpływa na obrażenia bazowe.",
		"evo_repeater_ricochet": "Rykoszet",
		"evo_repeater_ricochet_desc": "Efekty:\n  Łańcuch pocisków: {1}\n\nPociski Działka odbijają się rykoszetem do losowych pobliskich celów, zadając {2} obrażeń od pierwszego trafienia.",
		"evo_repeater_ricochet_2": "Rykoszet II",
		"evo_repeater_ricochet_2_desc": "Efekty:\n  Łańcuch pocisków: {1}.",
		"evo_repeater_shotgun": "Strzelba",
		"evo_repeater_shotgun_desc": "Efekty:\n  Liczba pocisków: {1}\n  Rozrzut pocisków: {2}\n  Obrażenia kinetyczne: {3}\n\nDziałko wystrzeliwuje teraz grupę słabszych pocisków o dużym rozrzucie. Modyfikator obrażeń wpływa na obrażenia bazowe.",
		"evo_repeater_shotgun_2": "Strzelba II",
		"evo_repeater_shotgun_2_desc": "Efekty:\n  Liczba pocisków: {1}\n  Rozrzut pocisków: {2}",
		"evo_repeater_explodingBullets": "Eksplodujące Pociski",
		"evo_repeater_explodingBullets_desc": "Efekty:\n  Obrażenia wybuchowe: {1} \n  Obrażenia kinetyczne: {2}\n\nWpływa na obrażenia bazowe. Działko używa teraz amunicji eksplodującej, która zadaje obrażenia wybuchowe w małym promieniu.",
		"evo_repeater_explodingBullets_2": "Eksplodujące Pociski II",
		"evo_repeater_explodingBullets_2_desc": "Efekty:\n  Obrażenia od eksplozji: {1}\n  Obrażenia kinetyczne: {2}\n\nZasięg eksplozji pocisków Działka został nieznacznie zwiększony.",
		"evo_heatray_iceBeam": "Lodowa Wiązka",
		"evo_heatray_iceBeam_desc": "Efekty:\n  Obrażenia od ciepła: {1}\n  Obrażenia od zimna: {2}\n  Szansa na zamrożenie: {3}\n\nWpływa na obrażenia bazowe. Obrażenia zadawane przez Promień Ciepła stają się obrażeniami od zimna i mają zwiększoną szansę na zamrożenie.",
		"evo_heatray_iceBeam_2": "Lodowa Wiązka II",
		"evo_heatray_iceBeam_2_desc": "Efekty:\n  Obrażenia od zimna: {1}\n\nWpływa na obrażenia bazowe.",
		"evo_heatray_reflection": "Reflektor",
		"evo_heatray_reflection_desc_2": "Promień Ciepła przechodzi teraz przez wrogów i odbija się od krawędzi ekranu określoną liczbę razy: {1}.",
		"evo_heatray_reflection_2": "Reflektor II",
		"evo_heatray_reflection_2_desc_2": "Promień Ciepła odbija się teraz od krawędzi ekranu określoną liczbę razy: {1}.",
		"evo_heatray_doubleBladed": "Podwójny Pryzmat",
		"evo_heatray_doubleBladed_desc": "Kolejna wiązka wystrzeliwana jest w przeciwnym kierunku. Wszystkie ewolucje i ulepszenia dotyczą obu wiązek.",
		"evo_heatray_blaster": "Blaster",
		"evo_heatray_blaster_desc": "Efekty:\n  Szybkostrzelność: {1}\n\nPromień Cieplny wystrzeliwuje teraz niezależny pocisk laserowy z wieloma trafieniami zamiast stałej wiązki. Trafienia nadal liczą się jako D.O.T.",
		"evo_heatray_blaster_2": "Blaster II",
		"evo_heatray_blaster_2_desc": "Efekty:\n  Długość pocisku: {1}\n  Obrażenia: {2}",
		"evo_heatray_solar_tap": "Podpięcie Solarne",
		"evo_heatray_solar_tap_desc": "Efekt globalny:\n  Wszystkie efekty/bronie cieplne:\n    Szansa na efekt statusu: {1}",
		"evo_barrage_rocketArray": "Matryca Rakiet",
		"evo_barrage_rocketArray_desc": "Na każdy pasek amunicji, Grad wystrzeliwuje zmienioną liczbę pocisków, {1} zamiast standardowej liczby {2}.",
		"evo_barrage_rocketArray_2": "Matryca Rakiet II",
		"evo_barrage_seismicMunition": "Amunicja Sejsmiczna",
		"evo_barrage_seismicMunition_desc": "Pociski wbijają się w ziemię i generują impulsy przez kilka następnych sekund.",
		"evo_barrage_seismicMunition_2": "Amunicja Sejsmiczna II",
		"evo_barrage_seismicMunition_2_desc": "Impulsy amunicji sejsmicznej:\n  Zasięg: {1}\n  Czas trwania: {2}",
		"evo_barrage_resupply": "Zaopatrzenie",
		"evo_barrage_resupply_desc": "Od teraz będą pojawiać się skrzynki z zaopatrzeniem. Ich aktywacja spowoduje pełne przeładowanie broni głównej i doda {1} obrażeń do następnego strzału.",
		"evo_barrage_resupply_2": "Zaopatrzenie II",
		"evo_barrage_resupply_2_desc": "Zaopatrzenie zapewnia teraz {1} premię do zasięgu eksplozji przy następnym strzale.",
		"evo_barrage_resupply_pickup": "Maksimum amunicji!",
		"evo_barrage_total_saturation": "Pełna Saturacja",
		"evo_barrage_total_saturation_desc": "Efekt globalny:\n  Wszystkie efekty/bronie wybuchowe:\n    Obrażenia: {1}",
		"evo_splattershot_bubble": "Śluzowa Bańka",
		"evo_splattershot_bubble_desc": "Bańki śluzu pojawiają się w strefach rozprysku. Po aktywacji bańki śluzu wybuchają, zadając obrażenia w niewielkim promieniu i tworząc dodatkowe strefy rozprysku.",
		"evo_splattershot_bubble_2": "Śluzowa Bańka II",
		"evo_splattershot_bubble_2_desc": "Zwiększona częstotliwość występowania śluzowych baniek. Śluzowe bańki mają 50% szans na automatyczne pęknięcie po wygaśnięciu.",
		"evo_splattershot_infestation": "Infestacja",
		"evo_splattershot_infestation_desc": "Efekty Rozpryskowego Strzału:\n  Szansa na efekt stanu: {1}\n\nEfekty globalne:\n Obrażenia od efektów stanu: {2}",
		"evo_splattershot_infestation_2": "Zarażenie II",
		"evo_splattershot_infestation_2_desc": "Wrogowie zabici przez efekty stanu eksplodują, tworząc strefy rozprysków.",
		"evo_splattershot_lava": "Lawa",
		"evo_splattershot_lava_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n  Obrażenia od ciepła: {2}\n\nWpływa na obrażenia bazowe. Typ obrażeń Strzału Rozpryskowego zmieni się na ciepło.",
		"evo_splattershot_lava_2": "Lawa II",
		"evo_splattershot_lava_2_desc": "Efekty: Obrażenia od ciepła: {1}\n\nWpływa na obrażenia bazowe.",
		"evo_splattershot_virulence": "Zjadliwość",
		"evo_splattershot_virulence_desc": "Efekt Strefy Rozprysków:\n  Czas trwania: {1}\n\nStrefy rozprysków z czasem powoli się powiększają.",
		"evo_splattershot_chemical_catalyst": "Chemiczny Katalizator",
		"evo_splattershot_chemical_catalyst_desc": "Efekt globalny:\n  Wszystkie efekty/bronie chemiczne:\n    Czas trwania: {1}",
		"evo_overmind_syncronize": "Synchronizacja",
		"evo_overmind_syncronize_desc": "Każde zabicie za pomocą Overmind ma {1} szansę na dodanie +1 zabicia do postępu ewolucji losowej broni dronowej.",
		"evo_overmind_syncronize_2": "Synchronizacja II",
		"evo_overmind_syncronize_2_desc": "Szansa na dodanie +1 zabójstwa do postępu ewolucji losowej broni dronowej zwiększona do {1}.",
		"evo_overmind_shockSpire": "Rażąca Szpica",
		"evo_overmind_shockSpire_desc": "Każde 3 wrogów wybrane jednocześnie powoduje pojawienie się między nimi Rażącej Szpicy.\n\nSzpice emitują okresowe impulsy elektryczne, które przemierzają cały ekran i zadają obrażenia elektryczne.",
		"evo_overmind_shockSpire_2": "Rażąca Szpica II",
		"evo_overmind_shockSpire_2_desc": "Efekty:\n  Rażące Szpice:\n    Obrażenia: {1}\n    Czas trwania: {2}",
		"evo_overmind_burningOnes": "Płonąca Eskadra",
		"evo_overmind_burningOnes_desc": "Wpisywanie słów ładuje pasek, który po zapełnieniu generuje wybuchowe drony.\n\nDrony namierzają wrogów i wybuchają przy kontakcie, zadając obrażenia od wybuchów w niewielkim promieniu.",
		"evo_overmind_burningOnes_2": "Płonąca Eskadra II",
		"evo_overmind_burningOnes_2_desc": "Efekty:\n  Płonąca Eskadra: {1}\n  Obrażenia od wybuchu: {1}\n  Zasięg wybuchu: {2}",
		"evo_overmind_burningOnes_charge": "Akumulacja Ciepła",
		"evo_overmind_burningOnes_charge_desc": "Przeciążenie termiczne: {1}%",
		"evo_overmind_null_field": "Pole Zerowe",
		"evo_overmind_null_field_desc": "Wrogowie wybrani przez Overmind są spowalniani i otrzymują {1} obrażeń od innych efektów i broni elektrycznych.",
		"evo_overmind_null_field_2": "Pole Zerowe II",
		"evo_overmind_null_field_2_desc": "Wrogowie wybrani przez Overmind, są również pod wpływem efektu statycznego, gdy są na celowniku.",
		"evo_wildcard_winter": "Zima",
		"evo_wildcard_winter_desc": "Dzika Karta nie będzie już wystrzeliwać pocisków Ciepła.\n\nEfekt globalny:\n Wszystkie efekty/bronie Zimna:\n Obrażenia: {1}",
		"evo_wildcard_winter_2": "Zima II",
		"evo_wildcard_winter_2_desc": "Efekt globalny:\n Wszystkie efekty/bronie Zimna:\n Obrażenia: {1}",
		"evo_wildcard_warmth": "Ciepło",
		"evo_wildcard_warmth_desc": "Dzika Karta nie będzie już wystrzeliwać pocisków Zimna.\n\nEfekt globalny:\n Wszystkie efekty/bronie Ciepła:\n Obrażenia: {1}",
		"evo_wildcard_warmth_2": "Ciepło II",
		"evo_wildcard_warmth_2_desc": "Efekt globalny:\n Wszystkie efekty/bronie Ciepła:\n Obrażenia: {1}",
		"evo_wildcard_repulsor": "Repulsor",
		"evo_wildcard_repulsor_desc": "Dzika Karta nie będzie już wystrzeliwać pocisków Kinetycznych.\n\nEfekt globalny:\n Wszystkie efekty/bronie Elektryczne:\n Obrażenia: {1}",
		"evo_wildcard_repulsor_2": "Repulsor II",
		"evo_wildcard_repulsor_2_desc": "Efekt globalny:\n Wszystkie efekty/bronie Elektryczne:\n Obrażenia: {1}",
		"evo_wildcard_diamond": "Diament",
		"evo_wildcard_diamond_desc": "Dzika Karta nie będzie już wystrzeliwać pocisków Elektrycznych.\n\nEfekt globalny:\n Wszystkie efekty/bronie Kinetyczne:\n Obrażenia: {1}",
		"evo_wildcard_diamond_2": "Diament II",
		"evo_wildcard_diamond_2_desc": "Efekt globalny:\n Wszystkie efekty/bronie Kinetyczne:\n Obrażenia: {1}",
		"evo_wildcard_fragmentation": "Fragmentacja",
		"evo_wildcard_fragmentation_desc": "Gdy pociski Kinetyczne trafią Kule Ciepła, wywołują eksplozje Ciepła.\n\nGdy pociski Kinetyczne trafią wrogów zamrożonych przez pociski Zimna, wywołują eksplozje Zimna.",
		"evo_wildcard_fragmentation_2": "Fragmentacja II",
		"evo_wildcard_fragmentation_2_desc": "Gdy pociski Kinetyczne trafiają wrogów, wywołują eksplozje Kinetyczne.",
		"evo_wildcard_conduit": "Przewodnik",
		"evo_wildcard_conduit_desc": "W zasięgu pocisków Elektrycznych, Kule Ciepła oraz wrogowie zamrożeni przez pociski Zimna zadają wrogom w pobliżu obrażenia Elektryczne.",
		"evo_wildcard_conduit_2": "Przewodnik II",
		"evo_wildcard_conduit_2_desc": "Kule Ciepła oraz wrogowie zamrożeni przez pociski Zimna zawsze zadają wrogom w pobliżu obrażenia Elektryczne.",
		"evo_wildcard_pestilence": "Zaraza",
		"evo_wildcard_pestilence_desc": "Dzika Karta:\n Wszystkie efekty stanu:\n Szansa: {1}",
		"evo_wildcard_pestilence_2": "Zaraza II",
		"evo_wildcard_pestilence_2_desc": "Efekt globalny:\n Wszystkie efekty stanu:\n Obrażenia: {1}",
		"evo_guardian_toxicWard": "Oddział Toksyczny",
		"evo_guardian_toxicWard_desc": "Efekty:\n  Obrażenia od ciepła: {1}\n  Obrażenia chemiczne: {2}\n\nWpływa na obrażenia bazowe. Typ obrażeń zadawanych przez Strażnika zmienia się na chemiczne.",
		"evo_guardian_toxicWard_2": "Oddział Toksyczny II",
		"evo_guardian_toxicWard_2_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n\nWpływa na obrażenia podstawowe.",
		"evo_guardian_experimentalFuel": "Eksperymentalne Paliwo",
		"evo_guardian_experimentalFuel_desc": "Pojawiają się specjalne zbiorniki paliwa, które zapewniają dronom Strażnika tymczasowe wzmocnienie. Tylko jedno z tych wzmocniń może być aktywne przez cały czas.",
		"evo_guardian_experimentalFuel_2": "Eksperymentalne Paliwo II",
		"evo_guardian_experimentalFuel_2_desc": "Premia do specjalnych zbiorników paliwa {1} i czas trwania wzmocnienia {2}.",
		"evo_guardian_experimentalFuel_damage": "Eksperymentalne Paliwo",
		"evo_guardian_experimentalFuel_speed": "Eksperymentalne Paliwo",
		"evo_guardian_experimentalFuel_range": "Eksperymentalne Paliwo",
		"evo_guardian_guardianTeam": "Drużyna Strażników",
		"evo_guardian_guardianTeam_desc": "Efekty:\n  Obrażenia: {1}\n  Drony: {2}\n\nStrażnik obsługuje dwa drony zamiast jednego.",
		"evo_guardian_guardianTeam_2": "Drużyna Strażników II",
		"evo_guardian_guardianTeam_2_desc": "Efekty:\n  Obrażenia: {1}\n  Drony: {2}\n\nStrażnik obsługuje trzy drony zamiast dwóch.",
		"evo_blade_bladeRepository": "Repozytorium Ostrzy",
		"evo_blade_bladeRepository_2": "Repozytorium Ostrzy II",
		"evo_blade_bladeRepository_desc": "oprócz istniejących liter, będzie również generować Pułapkę z Ostrzami.",
		"evo_blade_poisonCoating": "Pokrycie Trucizną",
		"evo_blade_poisonCoating_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n  Szansa na zarazę: {2}\n\nWpływa na obrażenia bazowe i modyfikatory obrażeń chemicznych.",
		"evo_blade_poisonCoating_2": "Pokrycie Trucizną II",
		"evo_blade_poisonCoating_2_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n  Szansa na zarazę: {2}}\n\nWpływa na obrażenia bazowe.",
		"evo_blade_sawtoothBlade": "Ostrza Piłokształtne",
		"evo_blade_sawtoothBlade_desc": "Pułapka z Ostrzami dodaje swoją szansę na trafienie krytyczne do szansy na wywołanie krwawienia.",
		"evo_blade_sawtoothBlade_2": "Ostrza Piłokształtne II",
		"evo_blade_sawtoothBlade_2_desc": "Obrażenia od krwawienia zostają zwiększone o {1}. Dotyczy to krwawienia zadawanego przez wszystkie źródła i wpływa na obrażenia bazowe.",
		"evo_blade_cutting_edge": "Ostrze Postępu",
		"evo_blade_cutting_edge_desc": "Efekt globalny:\n  Wszystkie efekty/bronie wieżyczek:\n    Szansa na trafienie krytyczne: {1}",
		"evo_hunter_hunterElite": "Elita Łowców",
		"evo_hunter_hunterElite_desc": "Co 12 Łowca jest Elitą.\n\nElita Łowców:\n  +100% Obrażeń\n  +50% Czasu Trwania\n  +50% Szybkość\n  +50% Zasięg.",
		"evo_hunter_hunterElite_2": "Elita Łowców II",
