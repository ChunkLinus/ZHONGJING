		"overmind_constructing_drone_desc": "{1} Drony w kolejce",
		"overmind_syncronization": "Synchronizacja",
		"overmind_syncronization_desc": "{1} Szansa na trafienie krytyczne, {2} Współczynnik trafienia krytycznego",
		"boss_poet": "Poeta",
		"boss_poet_desc": "Wpisz twórczość bossa.\nNadal możesz atakować wrogów w tym czasie.",
		"boss_cypher": "Szyfrant",
		"boss_cypher_desc": "Ten boss szyfruje litery znajdujące się w jego pobliżu.\nZniszcz go za pomocą broni.",
		"boss_cerberus": "Cerber",
		"boss_cerberus_desc": "Ten boss strzela w ciebie pociskami.\nZniszcz wszystkie trzy głowy aby go pokonać!",
		"boss_jormungandr": "Jörmungandr",
		"boss_jormungandr_desc": "Ten boss okrąża cię w nieskończoność. Strzelaj w ustalone cele na jego drodze, aby go trafić.",
		"boss_gemini": "Gemini",
		"boss_gemini_desc": "Zadaje obu bliźniakom równe obrażenia. W miarę upływu czasu bliźniaki leczą się nawzajem do poziomu własnego zdrowia.",
		"weapon_repeater_title": "Działko",
		"weapon_heatray_title": "Promień Cieplny",
		"weapon_barrage_title": "Grad",
		"weapon_overmind_title": "Overmind",
		"weapon_splattershot_title": "Rozpryskowy",
		"weapon_wildcard_title": "Dzika Karta",
		"weapon_spectre_title": "Widmo",
		"weapon_tesla_title": "Mina Tesli",
		"weapon_sentry_title": "Wartownik",
		"weapon_oscillator_title": "Oscylator",
		"weapon_meteor_title": "Meteor",
		"weapon_hunter_title": "Łowca",
		"weapon_chopper_title": "Siekacz",
		"weapon_minefield_title": "Pole Minowe",
		"weapon_blade_title": "Pułapka z Ostrzami",
		"weapon_firestorm_title": "Nawałnica Ognia",
		"weapon_guardian_title": "Strażnik",
		"weapon_orbiter_title": "Orbiter",
		"weapon_frostbite_title": "Odmrożenie",
		"weapon_bleeding_title": "Krwawienie",
		"weapon_blight_title": "Zaraza",
		"weapon_static_title": "Wyładowanie",
		"weapon_ignite_title": "Podpalenie",
		"weapon_heatray_requirements": "Ukońćz Próbę z Działkiem na dowolnym Objawieniu.",
		"weapon_barrage_requirements": "Ukończ Próbę na Objawieniu poziomu 3, z dowolną bronią.",
		"weapon_repeater_desc": "Niszczycielska broń, która wystrzeliwuje wiele pocisków w krótkich seriach.",
		"weapon_heatray_desc": "Wystrzeliwuje stałą wiązkę niezwykle precyzyjnego, skoncentrowanego światła, które zadaje obrażenia w czasie.",
		"weapon_barrage_desc": "Wystrzeliwuje salwę wybuchowych rakiet w cel i jego otoczenie. Ładuje się z czasem.",
		"weapon_overmind_desc": "Dowodzi szeregiem pół-autonomicznych dronów, które zadają wrogom ciężkie obrażenia.",
		"weapon_splattershot_desc": "Wystrzeliwuje kulki mazi, okaleczając i zadając obrażenia wrogom.",
		"weapon_wildcard_desc": "Następny strzał jest wybierany losowo spośród czterech możliwych broni, więc strzelaj ostrożnie.",
		"weapon_spectre_desc": "Powoduje pojawienie się szybkich dronów walczących wręcz, odpowiadających liczbie dopasowanych liter.",
		"weapon_sentry_desc": "Rozmieszcza automatyczną wieżyczkę strzelającą do każdego wroga, który znajdzie się w jej zasięgu.",
		"weapon_tesla_desc": "Rozmieszcza elektryczną wieżyczkę, która zadaje obrażenia w czasie.",
		"weapon_oscillator_desc": "Wystrzeliwuje oscylujący strumień cząsteczek w kierunku ostatniego celu.",
		"weapon_meteor_desc": "Okresowo tworzy znaczniki celów w losowych lokalizacjach, które można aktywować, aby rozpocząć bombardowanie orbitalne.",
		"weapon_hunter_desc": "Tworzy drony wystrzeliwujące wiązkę elektryczną odpowiadającą liczbie dopasowanych liter.",
		"weapon_chopper_desc": "Tworzy masywne wirujące ostrze, które leci do krawędzi ekranu.",
		"weapon_minefield_desc": "Tworzy wolno poruszające się miny, które wybuchają w kontakcie z wrogami.",
		"weapon_blade_desc": "Uruchamia wirującą, czteroramienną ostrze-pułapkę.",
		"weapon_firestorm_desc": "Działo wystrzeliwujące pociski wybuchowe krótkiego zasięgu. Okrąża główną wieżyczkę i wymaga czasu odnowienia przed ponownym wystrzeleniem.",
		"weapon_guardian_desc": "Rozmieszcza drona, który strzela laserami we wrogów. Aktywuj zbiorniki paliwa, aby zatankować Strażnika, który dezaktywuje się, gdy jego bak jest pusty.",
		"weapon_orbiter_desc": "wystrzeliwuje kulę, która krąży wokół broni głównej, niszcząc wszystko na swojej drodze.",
		"weapon_frostbite_desc": "Efekt łupu - nie liczy się jako broń. Wrogowie otrzymują obrażenia w czasie, gdy są zamrożeni.",
		"weapon_bleeding_desc": "Efekt stanu - nie liczy się jako broń.\n\nWrogowie otrzymują obrażenia kinetyczne przez pewien czas, dopóki efekt nie wygaśnie.",
		"weapon_blight_desc": "Efekt stanu - nie liczy się jako broń.\n\nWrogowie otrzymują obrażenia chemiczne i są spowolnieni do czasu wygaśnięcia efektu.",
		"weapon_static_desc": "Efekt stanu - nie liczy się jako broń.\n\nWrogowie otrzymują obrażenia energetyczne przez pewien czas i zadają obrażenia energetyczne pobliskim wrogom do czasu wygaśnięcia efektu.",
		"weapon_ignite_desc": "Efekt stanu - nie liczy się jako broń.\n\nWrogowie otrzymują obrażenia od ciepła przez pewien czas, aż do wygaśnięcia efektu.",
		"weapon_caltrops_desc": "Efekt wzmocnienia - nie liczy się jako broń.\n\\Przy trafieniu krytycznym bronią zdalną pojawia się 12 kolców, które zadają obrażenia pobliskim wrogom i zwiększają swoją szansę na krwawienie w zależności od zadawanych obrażeń.",
		"weapon_stormBattery_desc": "Efekt wzmocnienia - nie liczy się jako broń.\n\nGłówna wieżyczka zadaje obrażenia elektryczne pobliskim wrogom. Każda wyposażona broń elektryczna zwiększa obrażenia bazowe.",
		"weapon_lightningSparks_desc": "Efekt wzmocnienia - nie liczy się jako broń.\n\\Przy trafieniu krytycznym bronią elektryczną uwalnianych jest 6 Iskier, których obrażenia skalują się wraz z szansą na trafienie krytyczne i mnożnikiem trafień krytycznych.",
		"weapon_darkRelay_desc": "Efekt wzmocnienia - nie liczy się jako broń. Pocisk odbija się losowo między istniejącymi wieżyczkami, zadając obrażenia elektryczne.",
		"weapon_jester_desc": "Efekt łupu - nie liczy się jako broń. \n\\Po podniesieniu ponownego losowani zadaje losową liczbę obrażeń od 0 do 100 wszystkim wrogom na ekranie.",
		"weapon_necrobomb_desc": "Efekt łupu - nie liczy się jako broń. \n\nWywołuje serię eksplozji wokół pozycji poległego wroga po zniszczeniu wroga przez trafienie krytyczne od obrażeń wybuchowych.",
		"weapon_release_desc": "Efekt łupu - nie liczy się jako broń.\n\\W przypadku błędnego wpisania zadaje {1} obrażeń od eksplozji wszystkim wrogom za każde x{2} zero błędów.",
		"weapon_retribution_desc": "Efekt wzmocnienia - nie liczy się jako broń.\n\nZa każdym razem, gdy osłona zostanie zniszczona, wszystkie istniejące drony ulegają samozniszczeniu, zadając obrażenia wybuchowe.",
		"weapon_fireball_desc": "Efekt dodatkowy - nie liczy się jako broń. \n\nUruchomienie broni głównej powoduje również wystrzelenie powolnej kuli ognia, która zadaje obrażenia od ciepła.",
		"contains_characters": "Uzupełnianie słów zawierających litery",
		"contains_glyphs": "Uzupełnianie zestawów zawierających litery",
		"starts_with_character": "Uzupełnianie słów zaczynających się od liter",
		"starts_with_glyphs": "Uzupełnianie zestawów zaczynających się od liter:",
		"enemy_drone_title": "Dron",
		"enemy_shieldDrone_title": "Dron Tarczownik",
		"enemy_stalker_title": "Prześladowca",
		"enemy_shooter_title": "Strzelec",
		"enemy_splitter_title": "Rozszczepiacz",
		"enemy_warder_title": "Strażnik",
		"enemy_swarmer_title": "Rój",
		"enemy_drone_desc": "Drony to wrogowie, którzy nieubłaganie zbliżają się do głównej broni. Mogą pojawić się w dwóch ulepszonych formach:<br>Powiększony: Potraja ich zdrowie, czyniąc trudniejszymi do pokonania.<br>Przyspieszony: Podwaja ich prędkość ruchu, zwiększając pilność ich eliminacji.",
		"enemy_shieldDrone_desc": "Dron Tarczownik to wariant wrogiego drona, który posiada regenerującą się tarczę. Reprezentują go dwa paski zdrowia: górną tarczę, która zaczyna się regenerować, jeśli nie otrzyma obrażeń przez określony czas, oraz zwykły pasek życia.",
		"enemy_stalker_desc": "Prześladowca to wariant wroga, który początkowo pojawia się z ukrytą większością słowa. W miarę pisania słowo stopniowo się ujawnia, wymagając uważnego i szybkiego pisania.",
		"enemy_shooter_desc": "Strzelec to wróg, który zatrzymuje się na krawędzi poziomu i nieustannie wystrzeliwuje wytrzymałe pociski w kierunku głównej broni, dopóki nie zostanie zniszczony.",
		"enemy_splitter_desc": "Rozszczepiacz początkowo wygląda jak pojedynczy wróg, ale w rzeczywistości składa się z wielu części. Gdy jedna z części zostanie zniszczona, Rozdzielacz traci swoją integralność, powodując, że jego elementy stają się pojedynczymi wrogami.",
		"enemy_warder_desc": "Strażnik to elitarny przeciwnik, który pojawia się w późnej fazie gry. Posiada on obracającą się tarczę, która blokuje obrażenia od kierunku, w którym tarcza jest aktualnie skierowana. Dodatkowo roztacza aurę ochronną na pobliskich wrogów, czyniąc ich niewrażliwymi, dopóki nie zostanie pokonany.",
		"enemy_swarmer_desc": "Rój to elitarny przeciwnik, który okresowo wystrzeliwuje grupy mniejszych wrogów w kierunku głównej broni. Robi to tak długo, aż zostanie zniszczony.",
		"main_upgrade_health_common": "Wzmocnienie",
