		"evo_sentry_emergencyProtocol": "Protokół Awaryjny",
		"evo_sentry_emergencyProtocol_desc": "Za każdym razem, gdy wzmocnienie tarczy zostanie zniszczone, Wartownik przejdzie w tryb Protokołu Awaryjnego na {1} sekund.\n\nPodczas Protokołu Awaryjnego:\n  Zasięg: {2}\n  Szybkostrzelność: {3}.",
		"evo_sentry_emergencyProtocol_2": "Protokół Awaryjny II",
		"evo_sentry_emergencyProtocol_2_desc": "Podczas Protokołu Awaryjengo:\n  Obrażenia: {1}\n  Prędkość obrotu: {2}",
		"evo_spectre_supercharged": "Doładowanie",
		"evo_spectre_supercharged_desc": "Co 20 widmo jest SUPERwidmem.\n\nSuperwidma:\n  +100% Obrażeń\n  +50% Czasu Trwania\n  +50% Szybkość",
		"evo_spectre_selfDestruct": "Samozniszczenie",
