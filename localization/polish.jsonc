		"evo_minefield_dirtyBomb": "Brudna Bomba",
		"evo_minefield_dirtyBomb_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n  Obrażenia od Rozpryskowej broni:\n\nMiny tworzą 3 kałuże mazi, gdy wybuchają.",
		"evo_minefield_dirtyBomb_2": "Brudna Bomba II",
		"evo_minefield_dirtyBomb_2_desc": "Efekty:\n  Obrażenia chemiczne: {1}\n  Obrażenia od Rozpryskowej broni: {2}\n\nPodczas ruchu miny okresowo wystrzeliwują kałużę mazi.",
		"evo_minefield_recursiveMines": "Miny Rekursywne",
		"evo_minefield_recursiveMines_desc": "Główna wieżyczka tworzy ilość min równą połowie liczby min, zaokrągloną w dół. Częstotliwość pojawiania się min zależy od szybkostrzelności.",
		"evo_minefield_recursiveMines_2": "Miny Rekursywne II",
		"evo_minefield_recursiveMines_2_desc": "Miny rekursywne tworzą się szybciej o {1} i tworzą jedną dodatkową minę.",
