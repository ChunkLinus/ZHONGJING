		"level_up_heal": "スモールヒール",
		"level_up_heal_desc": "ヘルスを少量回復する。",
		"evo_repeater_frostFang": "フロストファング",
		"evo_repeater_frostFang_desc": "効果:\n  冷気ダメージ: {1}\n  凍結確率: {2}\n\n基本ダメージが影響し、冷気ダメージを受ける。",
		"evo_repeater_frostFang_2": "フロストファングⅡ",
		"evo_repeater_frostFang_2_desc": "効果:\n  冷気ダメージ: {1}\n  キネティックダメージ: {2}\n\n基本ダメージに影響する。",
		"evo_repeater_ricochet": "跳弾",
		"evo_repeater_ricochet_desc": "効果:\n  発射チェーン: {1}\n\n反射体は近くのランダムなターゲットへ跳ね返り、最初の攻撃以降のヒットで {2} ダメージを与える。",
		"evo_repeater_ricochet_2": "跳弾Ⅱ",
		"evo_repeater_ricochet_2_desc": "効果:\n  発射チェーン: {1}",
		"evo_repeater_shotgun": "ショットガン",
		"evo_repeater_shotgun_desc": "効果:\n  発射体の数: {1}\n  発射体の広がり: {2}\n  キネティックダメージ: {3}\n\nリピーターは、大きな広がりを持つ弱い発射体のクラスターを発射するようになる。ダメージ修正値は基本ダメージに影響する。",
		"evo_repeater_shotgun_2": "ショットガンⅡ",
		"evo_repeater_shotgun_2_desc": "効果:\n  発射物の数: {1}\n  発射物の拡散: {2}",
		"evo_repeater_explodingBullets": "爆発弾",
		"evo_repeater_explodingBullets_desc": "効果:\n  爆発ダメージ: {1}\n  キネティックダメージ: {2}\n\nリピーターは狭い範囲に爆発ダメージを与える爆発性弾薬を使用する。これは基本ダメージに影響する。",
		"evo_repeater_explodingBullets_2": "爆発弾Ⅱ",
		"evo_repeater_explodingBullets_2_desc": "効果:\n  爆発ダメージ: {1}\n  キネティックダメージ: {2}\n\n爆発範囲が増加する。",
		"evo_heatray_iceBeam": "アイスビーム",
		"evo_heatray_iceBeam_desc": "効果:\n  熱ダメージ: {1}\n  冷気ダメージ: {2}\n  凍結の確率: {3}\n\nヒートビームのダメージタイプは冷気に変わり、凍結を与える確率が上昇する。これは基本ダメージに影響する。",
		"evo_heatray_iceBeam_2": "アイスビームⅡ",
		"evo_heatray_iceBeam_2_desc": "効果:\n  冷気ダメージ: {1}\n\n基本ダメージに影響する。",
		"evo_heatray_reflection": "反射",
		"evo_heatray_reflection_desc_2": "ヒートビームは敵を貫通して、画面の端で{1}を反射するようになる。",
		"evo_heatray_reflection_2": "反射Ⅱ",
		"evo_heatray_reflection_2_desc_2": "ヒートビームは、画面の端で{1}を反射するようになる。",
		"evo_heatray_doubleBladed": "ダブルブレード",
		"evo_heatray_doubleBladed_desc": "もう１つのビームを反対方向へ発射する。全ての進化とアップグレードは両方のビームに適用される。",
		"evo_heatray_blaster": "ブラスター",
		"evo_heatray_blaster_desc": "効果:\n  連射速度: {1}\n\nヒートレイは、マルチヒットレーザー弾を発射し、定常ビームではなく、依然としてD.O.T.武器としてカウントされる。",
		"evo_heatray_blaster_2": "ブラスターⅡ",
		"evo_heatray_blaster_2_desc": "効果:\n  射程: {1}\n  ダメージ: {2}",
		"evo_heatray_solar_tap": "ソーラータップ",
		"evo_heatray_solar_tap_desc": "全体効果:\n  すべての熱系効果／武器:\n    状態異常付与確率: {1}",
		"evo_barrage_rocketArray": "ロケットアレイ",
		"evo_barrage_rocketArray_desc": "アサルトロケットは、弾薬バーごとに{2}発ではなく{1}発のミサイルを発射するようになる。",
		"evo_barrage_rocketArray_2": "ロケットアレイⅡ",
		"evo_barrage_seismicMunition": "地震弾",
		"evo_barrage_seismicMunition_desc": "ミサイルは爆発せず地面に埋まり、数秒間にわたって爆発的なパルスを発生させる。",
		"evo_barrage_seismicMunition_2": "地震弾Ⅱ",
		"evo_barrage_seismicMunition_2_desc": "地震弾パルス:\n  範囲: {1}\n  持続時間: {2}",
		"evo_barrage_resupply": "再補給",
		"evo_barrage_resupply_desc": "補給アイテムが出現し、起動するとメインウェポンが完全にリロードされ、次の一発に{1}のダメージボーナスが付与される。",
		"evo_barrage_resupply_2": "再補給Ⅱ",
		"evo_barrage_resupply_2_desc": "補給アイテムは、次の一発に{1}の爆発範囲ボーナスも付与するようになる。",
		"evo_barrage_resupply_pickup": "MAX弾薬！",
		"evo_barrage_total_saturation": "トータルサチュレーション",
		"evo_barrage_total_saturation_desc": "全体効果:\n  すべての爆発系効果／武器:\n    ダメージ: {1}",
		"evo_splattershot_bubble": "スライムバブル",
		"evo_splattershot_bubble_desc": "スライムバブルのピックアップはスプラッターゾーン内に出現する。\n\nアクティブ化されると、スライムバブルは破裂し、小さな半径内でダメージを与え、追加のスプラッターゾーンを作成する。",
		"evo_splattershot_bubble_2": "スライムバブルⅡ",
		"evo_splattershot_bubble_2_desc": "スライムバブルの発生数が増加する。\n\nスライムバブルは、期限が切れると自動的に破裂する確率が50%になる。",
		"evo_splattershot_infestation": "侵入",
		"evo_splattershot_infestation_desc": "スプラッターショットの効果:\n  ステータス効果の確率: {1}\n\nグローバル効果:\n  ステータス効果のダメージ: {2}",
		"evo_splattershot_infestation_2": "侵入Ⅱ",
		"evo_splattershot_infestation_2_desc": "ステータスエフェクトで倒された敵はスプラッターゾーンで爆発する。",
		"evo_splattershot_lava": "溶岩",
		"evo_splattershot_lava_desc": "効果:\n  ケミカルダメージ: {1}\n  熱ダメージ: {2}\n\nスプラッターショットのダメージタイプが熱になる。基本ダメージに影響する。",
		"evo_splattershot_lava_2": "溶岩Ⅱ",
		"evo_splattershot_lava_2_desc": "効果:\n  熱ダメージ: {1}\n\n基本ダメージに影響する。",
		"evo_splattershot_virulence": "疫病",
		"evo_splattershot_virulence_desc": "スプラッターゾーン効果:\n  持続時間: {1}\n\nスプラッターゾーンは時間とともに徐々に大きくなる。",
		"evo_splattershot_chemical_catalyst": "ケミカルカタリスト",
		"evo_splattershot_chemical_catalyst_desc": "全体効果:\n  すべての化学系効果／武器:\n    持続時間: {1}",
		"evo_overmind_syncronize": "シンクロナイズ",
		"evo_overmind_syncronize_desc": "オーバーマインドで敵を倒すたびに、{1}の確率でランダムなドローン兵器の進化にキル数を+1します。",
		"evo_overmind_syncronize_2": "シンクロナイズII",
		"evo_overmind_syncronize_2_desc": "ランダムなドローン兵器の進化にキル数を+1する確率が{1}に増加する。",
		"evo_overmind_shockSpire": "ショックスパイア",
		"evo_overmind_shockSpire_desc": "3体の敵を同時にターゲットすると、その間にショックスパイアを1つ生成します。\n\nショックスパイアは、画面全体を横断する定期的な電撃パルスを発し、電撃ダメージを与える。",
		"evo_overmind_shockSpire_2": "ショックスパイアII",
		"evo_overmind_shockSpire_2_desc": "効果：\n  ショックスパイア：\n    ダメージ：{1}\n    持続時間：{2}",
		"evo_overmind_burningOnes": "バーニングワン",
		"evo_overmind_burningOnes_desc": "単語を入力することでゲージが溜まり、満タンになると爆発するドローンが出現します。\n\nドローンは敵を追尾し、接触すると爆発して、狭い範囲に爆発ダメージを与えます。",
		"evo_overmind_burningOnes_2": "バーニングワンII",
		"evo_overmind_burningOnes_2_desc": "効果：\n  バーニングワン：{1}\n  爆発ダメージ：{1}\n  爆発範囲：{2}",
		"evo_overmind_burningOnes_charge": "蓄熱",
		"evo_overmind_burningOnes_charge_desc": "サーマルオーバーロード：{1}%",
		"evo_overmind_null_field": "ナルフィールド",
		"evo_overmind_null_field_desc": "オーバーマインドに狙われた敵は移動速度が低下し、他の電撃効果や武器から受けるダメージが{1}増加する。",
		"evo_overmind_null_field_2": "ナルフィールドII",
		"evo_overmind_null_field_2_desc": "オーバーマインドに狙われた敵は、ターゲットされている間、スタン状態にもなる。",
		"evo_wildcard_winter": "ウィンター",
		"evo_wildcard_winter_desc": "ワイルドカードは、熱属性の弾を発射しなくなる。\n\nグローバル効果：\n\n  全ての冷気エフェクト／武器：\n    ダメージ：{1}\n",
		"evo_wildcard_winter_2": "ウィンターII",
		"evo_wildcard_winter_2_desc": "グローバル効果：\n　全ての冷気効果／武器：\n    ダメージ：{1}",
		"evo_wildcard_warmth": "ウォームス",
		"evo_wildcard_warmth_desc": "ワイルドカードは冷気投射を発射しなくなります。\n\nグローバル効果：\n  すべての熱属性/武器：\n    ダメージ：{1}",
		"evo_wildcard_warmth_2": "ウォームスII",
		"evo_wildcard_warmth_2_desc": "グローバル効果：\n 全ての熱効果/武器：\n ダメージ：{1}",
		"evo_wildcard_repulsor": "リパルサー",
		"evo_wildcard_repulsor_desc": "ワイルドカードはキネティック投射を発射しなくなります。\n\nグローバル効果：\n  すべての電気効果/武器：\n    ダメージ：{1}",
		"evo_wildcard_repulsor_2": "リパルサーII",
		"evo_wildcard_repulsor_2_desc": "グローバル効果：\n  全ての電気効果/武器：\n    ダメージ：{1}",
		"evo_wildcard_diamond": "ダイアモンド",
		"evo_wildcard_diamond_desc": "ワイルドカードは電気投射を発射しなくなります。\n\nグローバル効果：\n  全てのキネティック効果/武器：\n    ダメージ：{1}",
		"evo_wildcard_diamond_2": "ダイアモンドII",
		"evo_wildcard_diamond_2_desc": "グローバル効果：\n  全ての電気効果/武器：\n    ダメージ：{1}",
		"evo_wildcard_fragmentation": "フラグメンテーション",
		"evo_wildcard_fragmentation_desc": "キネティック投射が熱オーブに命中すると、熱爆発を誘発します。\n\nキネティック投射が冷気投射で凍結した敵に命中すると、冷気爆発を誘発します。",
		"evo_wildcard_fragmentation_2": "フラグメンテーションII",
		"evo_wildcard_fragmentation_2_desc": "キネティック投射が敵に命中すると、キネティック爆発を誘発します。",
		"evo_wildcard_conduit": "コンジット",
		"evo_wildcard_conduit_desc": "電気投射の範囲内では、熱オーブおよび冷気投射で凍結した敵が、近くの敵に電気ダメージを与えます。",
		"evo_wildcard_conduit_2": "コンジットII",
		"evo_wildcard_conduit_2_desc": "熱オーブおよび冷気投射で凍結した敵は、常に近くの敵に電気ダメージを与えます。",
		"evo_wildcard_pestilence": "ペスティレンス",
		"evo_wildcard_pestilence_desc": "ワイルドカード：\n  全てのステータス効果：\n    確率：{1}",
		"evo_wildcard_pestilence_2": "ペスティレンスII",
		"evo_wildcard_pestilence_2_desc": "グローバル効果：\n  全てのステータス効果：\n    ダメージ：{1}",
		"evo_guardian_toxicWard": "トキシックワード",
		"evo_guardian_toxicWard_desc": "効果:\n  熱ダメージ: {1}\n  キネティックダメージ: {2}\n\n ガーディアンのダメージタイプがキネティックダメージに変わり。",
		"evo_guardian_toxicWard_2": "トキシックワードⅡ",
		"evo_guardian_toxicWard_2_desc": "効果:\n  キネティックダメージ: {1}\n\n基本ダメージに影響する。",
		"evo_guardian_experimentalFuel": "実験的な燃料",
		"evo_guardian_experimentalFuel_desc": "特別な燃料アイテムが出現し、ガーディアンに一時的なボーナスを付与する。ボーナスは一回に1つだけ有効にできる。",
		"evo_guardian_experimentalFuel_2": "実験的な燃料Ⅱ",
		"evo_guardian_experimentalFuel_2_desc": "すべての特別な燃料アイテムは、ボーナスを{1}と効果の持続時間を{2}延長する。",
		"evo_guardian_experimentalFuel_damage": "実験的な燃料",
		"evo_guardian_experimentalFuel_speed": "実験的な燃料",
		"evo_guardian_experimentalFuel_range": "実験的な燃料",
		"evo_guardian_guardianTeam": "ガーディアンチーム",
		"evo_guardian_guardianTeam_desc": "効果:\n  ダメージ: {1}\n  ドローン: {2}\n\nガーディアンは１台から２台のドローンに変わる。",
		"evo_guardian_guardianTeam_2": "ガーディアンチームⅡ",
		"evo_guardian_guardianTeam_2_desc": "効果:\n  ダメージ: {1}\n  ドローン: {2}\n\nガーディアンは２台から３台のドローンに変わる。",
		"evo_blade_bladeRepository": "ブレード・レポジトリ",
		"evo_blade_bladeRepository_2": "ブレード・レポジトリⅡ",
		"evo_blade_bladeRepository_desc": "は既存のグリフに加えてブレードトラップも生み出す。",
		"evo_blade_poisonCoating": "ポイズン・コーティング",
		"evo_blade_poisonCoating_desc": "効果:\n  ケミカルダメージ: {1}\n  ブライト確率: {2}\n\n基本ダメージに影響し、ケミカルダメージ修正の影響を受ける。",
		"evo_blade_poisonCoating_2": "ポイズン・コーティング　Ⅱ",
		"evo_blade_poisonCoating_2_desc": "効果:\n  ケミカルダメージ: {1}\n  ブライト確率: {2}\n\n基本ダメージに影響する。",
		"evo_blade_sawtoothBlade": "ノコギリ刃",
