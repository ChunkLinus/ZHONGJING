		"evo_repeater_frostFang": "霜咬",
		"evo_repeater_frostFang_desc": "效果：\n  冰冻伤害：{1}\n  冰冻几率：{2}\n\n影响基础伤害并受冰冻伤害系数影响。",
		"evo_repeater_frostFang_2": "霜咬II",
		"evo_repeater_frostFang_2_desc": "效果：\n  冰冻伤害：{1}\n  动能伤害：{2}\n\n影响基础伤害。",
		"evo_repeater_ricochet": "反弹",
		"evo_repeater_ricochet_desc": "效果：\n  投掷物连锁：{1}\n\n连发枪投掷物会反弹到附近目标上，第一次命中后，后续造成{2}伤害",
		"evo_repeater_ricochet_2": "反弹II",
		"evo_repeater_ricochet_2_desc": "效果：\n  投掷物连锁：{1}",
		"evo_repeater_shotgun": "霰弹枪",
		"evo_repeater_shotgun_desc": "效果：\n  投掷物计数：{1}\n  投掷物散布：{2}\n  动能伤害：{3}\n\n连发枪会发射散布范围更大但是更弱的投掷物。伤害系数影响基础伤害。",
		"evo_repeater_shotgun_2": "霰弹枪II",
		"evo_repeater_shotgun_2_desc": "效果：\n  投掷物计数：{1}\n  投掷物散布：{2}",
		"evo_repeater_explodingBullets": "爆炸弹头",
		"evo_repeater_explodingBullets_desc": "效果：\n  爆炸伤害：{1}\n  动能伤害：{2}\n\n影响基础伤害。连发枪会装填爆炸子弹，对小范围内的目标造成爆炸伤害。",
		"evo_repeater_explodingBullets_2": "爆炸弹头II",
		"evo_repeater_explodingBullets_2_desc": "效果：\n  爆炸伤害：{1}\n  动能伤害：{2}\n\n连发枪子弹的影响范围略微扩大。",
		"evo_heatray_iceBeam": "冰冻射线",
		"evo_heatray_iceBeam_desc": "效果：\n  高温伤害：{1}\n  冰冻伤害：{2}\n  冰冻几率：{3}\n\n影响基础伤害。高温射线伤害类型会变为冰冻类型，对敌人施加冰冻几率会提高。",
		"evo_heatray_iceBeam_2": "冰冻射线II",
		"evo_heatray_iceBeam_2_desc": "效果：\n  冰冻伤害：{1}\n\n影响基础伤害。",
		"evo_heatray_reflection": "反射",
		"evo_heatray_reflection_desc_2": "高温射线可以i穿过敌人并在屏幕边缘反射{1}。",
		"evo_heatray_reflection_2": "反射II",
		"evo_heatray_reflection_2_desc_2": "高温射线可以i在屏幕边缘反射{1}。",
		"evo_heatray_doubleBladed": "双刃",
		"evo_heatray_doubleBladed_desc": "同时朝反方向发射光束，所有进化和升级效果都会作用于两个方向的光束。",
		"evo_heatray_blaster": "爆破手",
		"evo_heatray_blaster_desc": "效果：\n  射速：{1}\n  高温射线会发射的独立的镭射光束，攻击多个目标，而不在发射持续的光束，但该武器仍算作持续伤害类武器。",
		"evo_heatray_blaster_2": "爆破手II",
		"evo_heatray_blaster_2_desc": "效果：\n  光束长度：{1}\n  伤害：{2}",
		"evo_heatray_solar_tap": "烈阳之触",
		"evo_heatray_solar_tap_desc": "全局效果：\n所有高温效果/武器：\n    状态效果几率：{1}",
		"evo_barrage_rocketArray": "火箭阵列",
		"evo_barrage_rocketArray_desc": "火力网会基于每个弹药条发射{1}，而非基于{2}。",
		"evo_barrage_rocketArray_2": "火箭阵列II",
		"evo_barrage_seismicMunition": "地动山摇",
		"evo_barrage_seismicMunition_desc": "接下来的几秒内，导弹会被部署入地底而非直接引爆并生成爆炸性冲击波。",
		"evo_barrage_seismicMunition_2": "地动山摇II",
		"evo_barrage_seismicMunition_2_desc": "地爆冲击：\n 范围： {1}\n 持续时间： {2}",
		"evo_barrage_resupply": "重新供给",
		"evo_barrage_resupply_desc": "现在战场会生成供给拾取道具。激活这些拾取道具会自动为你的主武器装填并让下一次攻击的伤害提升{1}。",
		"evo_barrage_resupply_2": "重新供给II",
		"evo_barrage_resupply_2_desc": "供给拾取道具会让下一次攻击的爆炸范围{1}。",
		"evo_barrage_resupply_pickup": "弹药如山！",
		"evo_barrage_total_saturation": "完全饱和",
		"evo_barrage_total_saturation_desc": "全局效果：\n所有爆炸效果/武器：\n    伤害：{1}",
		"evo_splattershot_bubble": "史莱姆泡泡",
		"evo_splattershot_bubble_desc": "在溅射区域内会生成史莱姆泡泡拾取道具\n\n在激活后，史莱姆泡泡会爆炸，对周遭小范围内的敌人造成伤害并生成额外的溅射区域。",
		"evo_splattershot_bubble_2": "史莱姆泡泡II",
		"evo_splattershot_bubble_2_desc": "提升史莱姆泡泡的生成几率。\n\n当泡泡失效时，有50%的几率自动爆炸。",
		"evo_splattershot_infestation": "感染",
		"evo_splattershot_infestation_desc": "溅射射击效果：\n  施加状态效果几率：{1}\n\n全局效果：\n  状态效果伤害：{2}",
		"evo_splattershot_infestation_2": "感染II",
		"evo_splattershot_infestation_2_desc": "被状态效果杀死的敌人会爆炸并生成溅射区域",
		"evo_splattershot_lava": "岩浆",
		"evo_splattershot_lava_desc": "效果：\n  化学伤害：{1}\n  高温伤害：{2}\n\n影响基础伤害。溅射射击的伤害类型会变为高温伤害。",
		"evo_splattershot_lava_2": "岩浆II",
		"evo_splattershot_lava_2_desc": "效果：\n  高温伤害：{1}\n\n影响基础伤害。",
		"evo_splattershot_virulence": "致病",
		"evo_splattershot_virulence_desc": "溅射区域效果：\n  持续时间：{1}\n\n溅射区域的范围会随着时间不断扩大。",
		"evo_splattershot_chemical_catalyst": "催化剂",
		"evo_splattershot_chemical_catalyst_desc": "全局效果：\n所有化学效果/武器：\n    持续时间：{1}",
		"evo_overmind_syncronize": "同步",
		"evo_overmind_syncronize_desc": "以集群意识击败的1个敌人后，有{1}几率为随机的无人机类武器的进化进度+1。",
		"evo_overmind_syncronize_2": "同步II",
		"evo_overmind_syncronize_2_desc": "以集群意识击败的1个敌人后，有{1}几率为随机的无人机类武器的进化进度+1，提升至{1}。",
		"evo_overmind_shockSpire": "激能螺旋",
		"evo_overmind_shockSpire_desc": "集群意识每瞄准3个敌人，在这些敌人间生成一个激能螺旋。\n\n激能螺旋会周期性地释放电能脉冲，在整个屏幕中穿梭并造成电击伤害。",
		"evo_overmind_shockSpire_2": "激能螺旋II",
		"evo_overmind_shockSpire_2_desc": "效果：激能螺旋：\n   伤害：{1}\n   持续时间：{2}",
		"evo_overmind_burningOnes": "燃烧者",
		"evo_overmind_burningOnes_desc": "拼写单词会为计量表充能，充满时生成自爆无人机。\n\n无人机会自动索敌，接触时爆炸，造成小范围爆炸伤害。",
		"evo_overmind_burningOnes_2": "燃烧者II",
		"evo_overmind_burningOnes_2_desc": "效果：\n  燃烧者：{1}\n  爆炸伤害：{1}\n  爆炸范围：{2}",
		"evo_overmind_burningOnes_charge": "积累热量",
		"evo_overmind_burningOnes_charge_desc": "过热：{1}%",
		"evo_overmind_null_field": "空域",
		"evo_overmind_null_field_desc": "集群意识瞄准的敌人会被减速并受到来自其他电击效果和武器的{1}伤害。",
		"evo_overmind_null_field_2": "空域II",
		"evo_overmind_null_field_2_desc": "集群意识瞄准的敌人会受到禁锢效果的影响。",
		"evo_wildcard_winter": "寒冬",
		"evo_wildcard_winter_desc": "任意卡不会再发射高温类投掷物\n\n全局效果：\n 所有冰冻效果/武器：\n 伤害： {1}",
		"evo_wildcard_winter_2": "寒冬II",
		"evo_wildcard_winter_2_desc": "全局效果：\n 所有冰冻效果/武器：\n 伤害： {1}",
		"evo_wildcard_warmth": "暖流",
		"evo_wildcard_warmth_desc": "任意卡不会再发射冰冻类投掷物\n\n全局效果：\n 所有高温效果/武器：\n 伤害： {1}",
		"evo_wildcard_warmth_2": "暖流II",
		"evo_wildcard_warmth_2_desc": "全局效果：\n 所有高温效果/武器：\n 伤害： {1}",
		"evo_wildcard_repulsor": "反重力",
		"evo_wildcard_repulsor_desc": "任意卡不会再发射动能类投掷物\n\n全局效果：\n 所有电击效果/武器：\n 伤害： {1}",
		"evo_wildcard_repulsor_2": "反重力II",
		"evo_wildcard_repulsor_2_desc": "全局效果：\n 所有电击效果/武器：\n 伤害： {1}",
		"evo_wildcard_diamond": "钻石",
		"evo_wildcard_diamond_desc": "任意卡不会再发射电击类投掷物\n\n全局效果：\n 所有动能效果/武器：\n 伤害： {1}",
		"evo_wildcard_diamond_2": "钻石II",
		"evo_wildcard_diamond_2_desc": "全局效果：\n 所有动能效果/武器：\n 伤害： {1}",
		"evo_wildcard_fragmentation": "能量碎裂",
		"evo_wildcard_fragmentation_desc": "当动能类投掷物击中高温球，触发高温爆炸。\n\n当动能类投掷物击中因冰冻投掷物而被冻住的敌人时，触发冰冻爆炸。",
		"evo_wildcard_fragmentation_2": "能量碎裂II",
		"evo_wildcard_fragmentation_2_desc": "当动能类投掷物击中敌人，触发动能爆炸。",
		"evo_wildcard_conduit": "导管",
		"evo_wildcard_conduit_desc": "在动能类投掷物的范围内，高温球和因冰冻投掷物而被冻住的敌人会对附近的敌人造成动能伤害。",
		"evo_wildcard_conduit_2": "导管II",
		"evo_wildcard_conduit_2_desc": "高温球和因冰冻投掷物而被冻住的敌人会对附近的敌人造成动能伤害。",
		"evo_wildcard_pestilence": "瘟疫蔓延",
		"evo_wildcard_pestilence_desc": "任意卡：所有状态效果：\n 几率： {1}",
		"evo_wildcard_pestilence_2": "瘟疫蔓延II",
		"evo_wildcard_pestilence_2_desc": "全局效果：\n所有状态效果：\n 伤害： {1}",
		"evo_guardian_toxicWard": "毒性守卫",
		"evo_guardian_toxicWard_desc": "效果：\n  高温伤害：{1}\n  化学伤害：{2}\n\n影响基础伤害。守卫伤害类型变为化学伤害。",
		"evo_guardian_toxicWard_2": "毒性守卫II",
		"evo_guardian_toxicWard_2_desc": "效果：\n  化学伤害：{1}\n\n影响基础伤害。",
		"evo_guardian_experimentalFuel": "实验性燃料",
		"evo_guardian_experimentalFuel_desc": "特殊的燃料拾取道具会为守卫提供暂时的加成。只有一种加成可以一直生效。",
		"evo_guardian_experimentalFuel_2": "实验性燃料II",
		"evo_guardian_experimentalFuel_2_desc": "所有特殊燃料拾取道具加成{1}，加成持续时间{2}。",
		"evo_guardian_experimentalFuel_damage": "实验性燃料",
		"evo_guardian_experimentalFuel_speed": "实验性燃料",
		"evo_guardian_experimentalFuel_range": "实验性燃料",
		"evo_guardian_guardianTeam": "守卫小队",
		"evo_guardian_guardianTeam_desc": "效果：\n  伤害：{1}\n  无人机：{2}\n\n守卫现在是两架无人机，而非一架。",
		"evo_guardian_guardianTeam_2": "守卫小队II",
		"evo_guardian_guardianTeam_2_desc": "效果：\n  伤害：{1}\n  无人机：{2}\n\n守卫现在是三架无人机，而非两架。",
		"evo_blade_bladeRepository": "利刃贮藏",
		"evo_blade_bladeRepository_2": "利刃贮藏II",
		"evo_blade_bladeRepository_desc": "除了现存的字母外，额外生成一个利刃陷阱。",
		"evo_blade_poisonCoating": "剧毒外衣",
		"evo_blade_poisonCoating_desc": "效果：\n  化学伤害：{1}\n  疫病几率：{2}\n\n影响基础伤害，受化学伤害系数影响。",
		"evo_blade_poisonCoating_2": "剧毒外衣II",
		"evo_blade_poisonCoating_2_desc": "效果：\n  化学伤害：{1}\n  疫病几率：{2}\n\n影响基础伤害。",
		"evo_blade_sawtoothBlade": "链锯刃",
		"evo_blade_sawtoothBlade_desc": "利刃陷阱的流血几率会额外加上其暴击几率。",
		"evo_blade_sawtoothBlade_2": "链锯刃II",
		"evo_blade_sawtoothBlade_2_desc": "流血伤害提升{1}。该效果会作用于任意来源的流血伤害并影响基础伤害。",
		"evo_blade_cutting_edge": "锋刃",
		"evo_blade_cutting_edge_desc": "全局效果：\n所有炮塔效果/武器：\n    暴击几率：{1}",
		"evo_hunter_hunterElite": "精英猎手",
		"evo_hunter_hunterElite_desc": "每次生成的第12个猎手会成为精英猎手。\n\n精英猎手：\n  +100%伤害\n+50%持续时间\n+50%速度\n+50%攻击范围",
		"evo_hunter_hunterElite_2": "精英猎手II",
		"evo_hunter_hunterElite_2_desc": "每次生成的第1０个猎手会成为精英猎手。\n\n精英猎手：\n  +50%持续时间",
		"evo_hunter_electrifiedBolts": "电能镖",
		"evo_hunter_electrifiedBolts_desc": "效果：\n 动能伤害：{1}\n电击伤害：{2}\n\n猎手现在会发射投掷物而非释放电流，并被视作动能武器。",
		"evo_hunter_electrifiedBolts_2": "电能镖II",
		"evo_hunter_electrifiedBolts_2_desc": "效果：\n 动能伤害：{1}\n\n全局效果：\n 所有动能效果/武器:\n 伤害：{2}",
		"evo_hunter_chainLightning": "闪电链",
		"evo_hunter_chainLightning_desc": "猎手的攻击会额外攻击附近的1个敌人。",
		"evo_hunter_chainLightning_2": "闪电链II",
		"evo_hunter_chainLightning_2_desc": "猎手的攻击会额外攻击附近的2个敌人。",
		"evo_hunter_predator_strain": "高压猎食者",
		"evo_hunter_predator_strain_desc": "全局效果：\n所有无人机效果/武器：\n    持续时间：{1}",
		"evo_minefield_mineLayer": "地雷部署者",
		"evo_minefield_mineLayer_2": "地雷部署者II",
		"evo_minefield_mineLayer_desc": "除了现存的字母外，额外生成地雷。",
		"evo_minefield_infusion": "注入",
		"evo_minefield_infusion_desc": "效果：\n 化学伤害：{1}\n 爆炸伤害：{2}\n\n地雷阵现在会造成化学伤害而非爆炸伤害，并被视作化学武器。",
		"evo_minefield_infusion_2": "注入II",
		"evo_minefield_infusion_2_desc": "效果：\n 化学伤害：{1}\n\n疫病几率：\n 所有化学效果/武器：\n 伤害：{3}",
		"evo_minefield_hunterSeeker": "猎手追踪者",
		"evo_minefield_hunterSeeker_desc": "效果：\n  速度：{1}\n  攻击范围：{2}\n\n地雷会自动追踪随机的目标。",
		"evo_minefield_hunterSeeker_2": "猎手追踪者II",
		"evo_minefield_hunterSeeker_2_desc": "效果：\n  生成地雷：{1}\n  速度：{2}",
		"evo_minefield_dirtyBomb": "脏弹",
		"evo_minefield_dirtyBomb_desc": "效果：\n 化学伤害：{1}\n 溅射枪伤害: {2}\n\n地雷爆炸时生成3滩粘球。",
		"evo_minefield_dirtyBomb_2": "脏弹II",
		"evo_minefield_dirtyBomb_2_desc": "效果：\n 化学伤害：{1}\n 溅射枪伤害: {2}\n\n移动时，地雷会周期性地发射一滩粘球。",
		"evo_minefield_recursiveMines": "回归地雷",
		"evo_minefield_recursiveMines_desc": "主炮塔会根据【地雷阵】的地雷数量周期性地生成地雷（数量向下取整）。生成速率由【地雷阵】的射速决定。",
		"evo_minefield_recursiveMines_2": "回归地雷II",
		"evo_minefield_recursiveMines_2_desc": "回归地雷的生成速度提高{1}并会额外生成1个。",
		"evo_sentry_defenseGrid": "防御网格",
		"evo_sentry_defenseGrid_2": "防御网格II",
		"evo_sentry_defenseGrid_desc": "效果：\n  炮塔：+1",
		"evo_sentry_solidCore": "坚固核心",
		"evo_sentry_solidCore_desc": "效果：\n动能伤害：{1}\n  高温伤害：{2}\n\n哨兵现在会造成动能伤害而非高热伤害，并被视作动能武器\n",
		"evo_sentry_solidCore_2": "坚固核心II",
		"evo_sentry_solidCore_2_desc": "效果：\n  动能伤害：{1}\n\n全局效果：\n  所有动能效果/武器:\n 伤害：{2}",
		"evo_sentry_watcher_supreme": "至高观察者",
		"evo_sentry_watcher_supreme_desc": "全局效果\n所有炮塔效果/武器：\n   范围：{1}",
		"evo_sentry_emergencyProtocol": "紧急情况协议",
		"evo_sentry_emergencyProtocol_desc": "当一个护盾增强器被摧毁时，哨兵会进入紧急情况协议模式，持续{1}秒。\n\n紧急情况协议生效时：\n  攻击范围：{2}\n  射速：{3}",
		"evo_sentry_emergencyProtocol_2": "紧急情况协议II",
		"evo_sentry_emergencyProtocol_2_desc": "紧急情况协议生效时：\n  伤害：{2}\n  旋转速度：{3}",
		"evo_spectre_supercharged": "超级充能",
		"evo_spectre_supercharged_desc": "每次生成的第20个幽灵会成为超级幽灵。\n\n超级幽灵：\n  +100%伤害\n+50%持续时间\n+50%速度",
		"evo_spectre_selfDestruct": "自毁",
		"evo_spectre_selfDestruct_desc": "效果：\n  爆炸伤害：{1}\n\n幽灵消失时会自毁，造成爆炸伤害。影响基础伤害并受到爆炸伤害系数影响。",
		"evo_spectre_selfDestruct_2": "自毁II",
		"evo_spectre_selfDestruct_2_desc": "效果：\n  爆炸伤害：{1}\n  攻击范围：{2}\n\n影响基础伤害。",
		"evo_spectre_volatileFuel": "挥发性燃料",
		"evo_spectre_volatileFuel_desc": "效果：\n  速度：{1}",
		"evo_spectre_volatileFuel_2": "挥发性燃料II",
		"evo_spectre_volatileFuel_2_desc": "效果：\n  速度：{1}\n  持续时间：{2}",
		"evo_spectre_stalking_algorithms": "追踪算法",
		"evo_spectre_stalking_algorithms_desc": "全局效果：\n所有无人机效果/武器：\n    速度：{1}",
		"evo_tesla_abundantCoils": "线圈束",
		"evo_tesla_abundantCoils_2": "线圈束II",
		"evo_tesla_abundantCoils_desc": "除了现存的字母外，额外生成一个特斯拉地雷。",
		"evo_tesla_electricalBurn": "电流灼烧",
		"evo_tesla_electricalBurn_desc": "效果：\n 高温伤害：{1}\n 电击伤害：{2}\n 特斯拉地雷现在会造成高温伤害而非电击伤害，并被视作高温武器。",
		"evo_tesla_electricalBurn_2": "电流灼烧II",
		"evo_tesla_electricalBurn_2_desc": "效果：\n 高温伤害：{1}\n\n全局效果：\n 所有高温效果/武器：\n 伤害：{2}",
		"evo_tesla_restrictedArea": "限制区域",
		"evo_tesla_restrictedArea_desc": "位于特斯拉地雷范围内的敌人受到电击伤害时，被禁锢的几率提升{1}",
		"evo_tesla_restrictedArea_2": "限制区域II",
		"evo_tesla_restrictedArea_2_desc": "禁锢伤害提升{1}，攻击范围提升{2}。该效果会作用于任意来源的禁锢伤害并影响基础伤害。",
		"evo_tesla_storm_sovereign": "风暴统治",
		"evo_tesla_storm_sovereign_desc": "全局效果：\n所有炮塔效果/武器：\n    射速：{1}",
		"evo_chopper_dualWield": "双持",
		"evo_chopper_dualWield_desc": "效果：\n  屠夫数量+1",
		"evo_chopper_flamingBlades": "烈火刀",
		"evo_chopper_flamingBlades_desc": "效果：\n 动能伤害：{1}\n 高温伤害：{2}\n 屠夫现在会造成高温伤害而非动能伤害，并被视作高温武器。",
		"evo_chopper_flamingBlades_2": "烈火刀II",
		"evo_chopper_flamingBlades_2_desc": "效果：\n 高温伤害：{1}\n\n全局效果：\n 所有高温效果/武器：\n 伤害：{2}",
		"evo_chopper_boomerang": "回旋镖",
		"evo_chopper_boomerang_desc": "屠夫在到达屏幕边缘后会返回主武器处。",
		"evo_chopper_boomerang_2": "回旋镖II",
		"evo_chopper_boomerang_2_desc": "效果：\n  速度：{1}\n  射速：{2}",
		"evo_chopper_sawLauncher": "锯齿发射器",
		"evo_chopper_sawLauncher_desc": "效果：\n 流血几率： {1}\n 流血伤害： {2}\n 连发枪流血几率： {3}\n\n用两把高攻速锯齿刃代替屠夫，对锥形区域内目标造成伤害。",
		"evo_chopper_sawLauncher_2": "锯齿发射器II",
		"evo_chopper_sawLauncher_2_desc": "效果：\n 流血几率： {1}\n 流血伤害： {2}\n 连发枪流血伤害： {3}\n\n多发射2把锯齿刃。",
		"evo_chopper_bloodbath": "浴血",
		"evo_chopper_bloodbath_desc": "效果：\n 对流血敌人的伤害： {1}\n\n受流血状态影响的敌人在被屠夫击杀后，有{2}几率在一段时间内触发全局双倍伤害。",
		"evo_chopper_bloodbath_2": "浴血II",
		"evo_chopper_bloodbath_2_desc": "效果：\n 对流血敌人的伤害： {1}\n\n对{2}造成双倍伤害的几率提升。",
		"evo_meteor_surveillance": "监管者",
		"evo_meteor_surveillance_desc": "彗星会获得两个目标选项而非一个。",
		"evo_meteor_surveillance_2": "监管者II",
		"evo_meteor_surveillance_2_desc": "彗星会获得三个目标选项而非两个。",
		"evo_meteor_iceRain": "冰雨",
		"evo_meteor_iceRain_desc": "效果：\n 冰冻伤害：{1}\n 爆炸伤害：{2}\n 彗星现在会造成冰冻伤害而非爆炸伤害，并被视作冰冻武器。",
		"evo_meteor_iceRain_2": "冰雨II",
		"evo_meteor_iceRain_2_desc": "效果：\n 冰冻伤害：{1}\n\n全局效果：\n 所有冰冻效果/武器：\n 伤害：{2}",
		"evo_meteor_relentless": "不休",
		"evo_meteor_relentless_desc": "效果：\n  攻击范围：{1}\n  射速：{2}\n\n彗星会向你上一个目标的位置不断来袭。",
