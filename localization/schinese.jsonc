		"NEW_ACHIEVEMENT_4_0_NAME": "环游者精通",
		"NEW_ACHIEVEMENT_4_0_DESC": "使用环游者时，DPS达到500。",
		"NEW_ACHIEVEMENT_4_1_NAME": "火力全开",
		"NEW_ACHIEVEMENT_4_1_DESC": "用连发枪通关试炼模式（恶兆VI）。",
		"NEW_ACHIEVEMENT_4_2_NAME": "滋滋滋",
